          "shape": "named",
          "base": [
            "claxedo-lifecycle"
          ],
          "entries": {
            "PreInvocation": {
              "type": "command",
              "command": "bash {{antigravity-hook.sh|sh}} PreInvocation",
              "timeout": 3
            },
            "Stop": {
              "type": "command",
              "command": "bash {{antigravity-hook.sh|sh}} Stop",
              "timeout": 3
            }
