        "wrapper": "# Ensure status is cleared even if Claude crashes, hits a limit, or is killed\ncleanup() {\n  EXIT_CODE=$?\n  if [ \"$EXIT_CODE\" -eq 0 ]; then\n    echo '{\"hook_event_name\":\"Idle\"}' | bash {{notify|sh}} >/dev/null 2>&1 &\n  else\n    echo '{\"hook_event_name\":\"Error\"}' | bash {{notify|sh}} >/dev/null 2>&1 &\n  fi\n}\ntrap cleanup EXIT\n\n# Do not use exec here \u2014 exec replaces the shell process, which\n# prevents the EXIT trap from firing.\n\"$REAL_BIN\" {{arg0}} {{arg1|sh}} \"$@\"",
        "artifacts": [
          {
            "file": "claude-settings.json",
            "content": "{\n  \"hooks\": {\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"{{notify|sh}} --harness=claude\"\n          }\n        ]\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"{{notify|sh}} --harness=claude\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"{{notify|sh}} --harness=claude\"\n          }\n        ]\n      }\n    ],\n    \"PostToolUseFailure\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"{{notify|sh}} --harness=claude\"\n          }\n        ]\n      }\n    ],\n    \"PermissionRequest\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"{{notify|sh}} --harness=claude\"\n          }\n        ]\n      }\n    ],\n    \"PermissionDenied\": [\n      {\n        \"matcher\": \"*\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"{{notify|sh}} --harness=claude\"\n          }\n        ]\n      }\n    ]\n  }\n}\n",
            "mode": 420
          }
        ],
