            "content": "#!/bin/bash\n# Claxedo agent notification hook v1\nset -uo pipefail\n\nEVENT=\"${1:-}\"\n# Copilot runs this project hook in every session; only a Claxedo tab reports status.\n[ -n \"${CLAXEDO_TAB_ID:-}\" ] || { printf '{}\\n'; exit 0; }\n# Drain stdin with timeout if present\nif [ ! -t 0 ]; then\n  read -r -t 0.1 _UNUSED 2>/dev/null || true\nfi\n\nif [ -n \"$EVENT\" ]; then\n  printf '{\"hook_event_name\":\"%s\"}' \"$EVENT\" | \"{{notify}}\" --harness=copilot >/dev/null 2>&1 || true\nfi\n\nprintf '{}\\n'\nexit 0\n",
