{
  "name": "@claxedo/desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "homepage": "https://claxedo.ai",
  "author": {
    "name": "Claxedo",
    "email": "hello@claxedo.ai"
  },
  "scripts": {
    "test:contract": "bun test ./scripts/contract.test.ts",
    "test:diagnostics-release": "bun test ./src/main/diagnostics ./src/shared/diagnostics-transport.test.ts ./scripts/performance-diagnostics-smoke.test.ts ./scripts/verify-diagnostics-dependencies.test.ts ./scripts/verify-diagnostics-privacy.test.ts",
    "verify:diagnostics-dependencies": "bun ./scripts/verify-diagnostics-dependencies.ts",
    "verify:diagnostics-privacy": "bun ./scripts/verify-diagnostics-privacy.ts",
    "smoke:diagnostics": "bun ./scripts/performance-diagnostics-smoke.ts",
    "smoke:diagnostics:packaged": "bun ./scripts/performance-diagnostics-smoke.ts --packaged",
    "perf:startup": "bun ./scripts/startup-perf.ts",
    "test": "mkdir -p .artifacts/unit && bun test ./src ./scripts --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml",
    "typecheck": "tsgo -b",
    "verify:desktop-parity": "bun ./scripts/capture-default-screenshot.ts",
    "predev": "bun ./scripts/predev.ts",
    "dev": "GOMAXPROCS=2 electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "bun ./scripts/build.ts",
    "build:inner": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "bun ./scripts/package.ts",
    "package:inner": "electron-builder --config electron-builder.config.ts",
    "package:mac": "bun ./scripts/package.ts --mac",
    "package:mac:inner": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "bun ./scripts/package.ts --win",
    "package:win:inner": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "bun ./scripts/package.ts --linux",
    "package:linux:inner": "electron-builder --linux --config electron-builder.config.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@claxedo/app": "workspace:*",
    "@claxedo/local-server": "workspace:*",
    "@claxedo/workspace-runtime": "workspace:*",
    "@lydell/node-pty": "catalog:",
    "@opencode-ai/session-ui": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "4.4.0",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.15.4",
    "better-sqlite3": "13.0.1",
    "electron-log": "5.4.4",
    "electron-store": "10.1.0",
    "electron-updater": "6.8.9",
    "electron-window-state": "5.0.3",
    "jsonc-parser": "3.3.1",
    "marked": "15.0.12",
    "node-pty": "1.1.0",
    "pidtree": "1.0.0",
    "pidusage": "4.0.1",
    "posthog-node": "4.18.0",
    "solid-js": "1.9.12",
    "tree-kill": "1.2.2"
  },
  "optionalDependencies": {
    "@vscode/windows-process-tree": "0.8.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.63.0",
    "@agentclientprotocol/codex-acp": "1.1.7",
    "@tailwindcss/vite": "4.1.11",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "electron": "43.2.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "react-grab": "0.1.32",
    "typescript-legacy": "npm:typescript@5.8.2",
    "typescript": "catalog:",
    "vite": "7.1.4",
    "vite-plugin-solid": "2.11.10"
  }
}
