{
  "name": "@opencode-ai/claxedo-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "homepage": "https://claxedo.ai",
  "author": {
    "name": "Claxedo",
    "email": "hello@claxedo.ai"
  },
  "scripts": {
    "test:contract": "bun test ./scripts/contract.test.ts",
    "test": "bun test ./src",
    "typecheck": "tsgo -b",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "bun ./scripts/build.ts",
    "build:inner": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "bun ./scripts/package.ts",
    "package:inner": "electron-builder --config electron-builder.config.ts",
    "package:mac": "bun ./scripts/package.ts --mac",
    "package:mac:inner": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "bun ./scripts/package.ts --win",
    "package:win:inner": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "bun ./scripts/package.ts --linux",
    "package:linux:inner": "electron-builder --linux --config electron-builder.config.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@medv/finder": "^4.0.0",
    "@opencode-ai/app": "workspace:*",
    "@opencode-ai/claxedo-app": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "0.15.4",
    "better-sqlite3": "^12.0.0",
    "electron-log": "^5",
    "electron-store": "^10",
    "electron-updater": "^6",
    "electron-window-state": "^5.0.3",
    "jsonc-parser": "^3",
    "marked": "^15",
    "node-pty": "^1.0.0",
    "solid-js": "catalog:",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "electron": "40.4.1",
    "electron-builder": "^26",
    "electron-vite": "^5",
    "happy-dom": "20.8.3",
    "typescript": "~5.6.2",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
