{
  "name": "@claxedo/desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "homepage": "https://claxedo.ai",
  "author": {
    "name": "Claxedo",
    "email": "hello@claxedo.ai"
  },
  "scripts": {
    "test:contract": "bun test ./scripts/contract.test.ts",
    "test:diagnostics-release": "bun test ./src/main/diagnostics ./src/shared/diagnostics-transport.test.ts ./scripts/performance-diagnostics-smoke.test.ts ./scripts/verify-diagnostics-dependencies.test.ts ./scripts/verify-diagnostics-privacy.test.ts",
    "test:native-rich-content": "cargo test --manifest-path ./native/rich-content-renderer/Cargo.toml --locked",
    "verify:diagnostics-dependencies": "bun ./scripts/verify-diagnostics-dependencies.ts",
    "verify:diagnostics-privacy": "bun ./scripts/verify-diagnostics-privacy.ts",
    "smoke:diagnostics": "bun ./scripts/performance-diagnostics-smoke.ts",
    "smoke:diagnostics:packaged": "bun ./scripts/performance-diagnostics-smoke.ts --packaged",
    "perf:startup": "bun ./scripts/startup-perf.ts",
    "test": "bun run test:broad && bun run test:bundle-single && bun run test:server-boot && bun run test:compile-cache",
    "test:broad": "mkdir -p .artifacts/unit && node ../../scripts/test-deadline.mjs bun test ./src ./scripts --max-concurrency=1 --path-ignore-patterns='**/bundle-single-instance.test.ts' --path-ignore-patterns='**/claxedo-server-boot.test.ts' --path-ignore-patterns='**/opencode-compile-cache-boot.test.ts' --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml",
    "test:bundle-single": "mkdir -p .artifacts/unit && node ../../scripts/test-deadline.mjs bun test ./scripts/bundle-single-instance.test.ts --max-concurrency=1 --reporter=junit --reporter-outfile=.artifacts/unit/bundle-single-junit.xml",
    "test:server-boot": "mkdir -p .artifacts/unit && node ../../scripts/test-deadline.mjs bun test ./scripts/claxedo-server-boot.test.ts --max-concurrency=1 --reporter=junit --reporter-outfile=.artifacts/unit/server-boot-junit.xml",
    "test:compile-cache": "mkdir -p .artifacts/unit && node ../../scripts/test-deadline.mjs bun test ./scripts/opencode-compile-cache-boot.test.ts --max-concurrency=1 --reporter=junit --reporter-outfile=.artifacts/unit/compile-cache-junit.xml",
    "typecheck": "tsgo -b",
    "verify:desktop-parity": "bun ./scripts/capture-default-screenshot.ts",
    "predev": "bun ./scripts/predev.ts",
    "dev": "GOMAXPROCS=2 electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build:rich-content": "bun ./scripts/build-rich-content-renderer.ts",
    "build": "bun ./scripts/build.ts",
    "build:inner": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "bun ./scripts/package.ts",
    "package:inner": "electron-builder --config electron-builder.config.ts",
    "package:mac": "bun ./scripts/package.ts --mac",
    "package:mac:inner": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "bun ./scripts/package.ts --win",
    "package:win:inner": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "bun ./scripts/package.ts --linux",
    "package:linux:inner": "electron-builder --linux --config electron-builder.config.ts",
    "smoke:u8-packaged": "bun ./scripts/u8-packaged-smoke.ts",
    "smoke:u8-signed-activation": "bun ./scripts/u8-signed-activation-smoke.ts",
    "verify:u8-package-boundary": "bun ./scripts/verify-u8-package-boundary.ts",
    "qualify:u8-release": "bun ./scripts/u8-release-qualification.ts",
    "verify:closure": "bun ../../script/product-boundary/verify.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@claxedo/app": "workspace:*",
    "@claxedo/host-connector": "workspace:*",
    "@claxedo/local-server": "workspace:*",
    "@claxedo/workspace-runtime": "workspace:*",
    "@lydell/node-pty": "catalog:",
    "@opencode-ai/session-ui": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@solid-primitives/i18n": "3.0.0-next.4",
    "@solid-primitives/storage": "5.0.0-next.4",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.18",
    "@solidjs/web": "2.0.0-rc.3",
    "better-sqlite3": "13.0.1",
    "electron-log": "5.4.4",
    "electron-store": "10.1.0",
    "electron-updater": "6.8.9",
    "electron-window-state": "5.0.3",
    "jsonc-parser": "3.3.1",
    "pidtree": "1.0.0",
    "pidusage": "4.0.1",
    "posthog-node": "4.18.0",
    "solid-js": "2.0.0-rc.3",
    "tree-kill": "1.2.2"
  },
  "optionalDependencies": {
    "@vscode/windows-process-tree": "0.8.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.63.0",
    "@agentclientprotocol/codex-acp": "1.1.7",
    "@tailwindcss/vite": "4.1.11",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "electron": "43.2.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "react-grab": "0.1.32",
    "typescript-legacy": "npm:typescript@5.8.2",
    "typescript": "catalog:",
    "vite": "7.1.4",
    "@solidjs/vite-plugin": "3.0.0-next.34"
  }
}
