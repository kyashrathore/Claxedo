{
  "name": "@claxedo/desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "homepage": "https://claxedo.ai",
  "author": {
    "name": "Claxedo",
    "email": "hello@claxedo.ai"
  },
  "scripts": {
    "test:contract": "bun test ./scripts/contract.test.ts",
    "test": "bun test ./src",
    "typecheck": "tsgo -b",
    "verify:desktop-parity": "bun ./scripts/capture-default-screenshot.ts",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "bun ./scripts/build.ts",
    "build:inner": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "bun ./scripts/package.ts",
    "package:inner": "electron-builder --config electron-builder.config.ts",
    "package:mac": "bun ./scripts/package.ts --mac",
    "package:mac:inner": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "bun ./scripts/package.ts --win",
    "package:win:inner": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "bun ./scripts/package.ts --linux",
    "package:linux:inner": "electron-builder --linux --config electron-builder.config.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@claxedo/app": "workspace:0.0.59",
    "@opencode-ai/session-ui": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "4.3.3",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.15.4",
    "electron-log": "5.4.3",
    "electron-store": "10.1.0",
    "electron-updater": "6.8.3",
    "electron-window-state": "5.0.3",
    "better-sqlite3": "12.10.0",
    "jsonc-parser": "3.3.1",
    "marked": "15.0.12",
    "node-pty": "1.1.0",
    "react-grab": "0.1.32",
    "solid-js": "1.9.10",
    "tree-kill": "1.2.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "electron": "40.4.1",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "typescript": "5.6.3",
    "vite": "7.1.4",
    "vite-plugin-solid": "2.11.10"
  }
}
