{
  "name": "@claxedo/local-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "The desktop-local Claxedo server: local project, file, diff, PTY, process, session, provider, configuration, credential, and harness-dispatch routes over an embedded Workspace Runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/claxedo-local-server"
  },
  "exports": {
    "./agent-plugins/local-composition": {
      "types": "./src/agent-plugins/local-composition.ts",
      "bun": "./src/agent-plugins/local-composition.ts",
      "development": "./src/agent-plugins/local-composition.ts",
      "import": "./src/agent-plugins/local-composition.ts",
      "default": "./src/agent-plugins/local-composition.ts"
    },
    "./self-hosted-execution": {
      "types": "./src/self-hosted-execution.ts",
      "bun": "./src/self-hosted-execution.ts",
      "development": "./src/self-hosted-execution.ts",
      "import": "./dist/self-hosted-execution.js",
      "default": "./dist/self-hosted-execution.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "development": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "smoke:build": "node ./scripts/smoke-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ./node_modules/vitest/vitest.mjs run --reporter=default --reporter=junit --outputFile.junit=.artifacts/unit/junit.xml",
    "verify:closure": "bun ../../script/product-boundary/verify.ts"
  },
  "dependencies": {
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/agent-sdk-runtime": "workspace:*",
    "@claxedo/egress-broker": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@claxedo/mcp": "workspace:*",
    "@claxedo/opencode-server-adapter": "workspace:*",
    "@claxedo/sandbox-contract": "workspace:*",
    "@claxedo/server-core": "workspace:*",
    "@claxedo/workspace-runtime": "workspace:*",
    "@hono/node-ws": "1.3.1",
    "@lydell/node-pty": "catalog:",
    "better-sqlite3": "13.0.1",
    "hono": "4.10.7",
    "smol-toml": "1.7.1",
    "tokentracker-cli": "0.91.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "1.19.11",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tsconfig/node-lts": "22.0.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.13",
    "typescript": "catalog:",
    "vitest": "2.1.9"
  }
}
