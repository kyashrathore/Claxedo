{
  "name": "@claxedo/workspace-runtime",
  "version": "0.5.1",
  "description": "Per-workspace host runtime for agent sessions, terminals, processes, files, diffs, and relay attachment.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/workspace-runtime"
  },
  "homepage": "https://github.com/kyashrathore/Claxedo/tree/dev/packages/workspace-runtime",
  "bugs": "https://github.com/kyashrathore/Claxedo/issues",
  "keywords": [
    "agents",
    "workspace",
    "runtime",
    "pty",
    "relay"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.mjs",
      "development": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "bun": "./dist/relay.mjs",
      "development": "./dist/relay.mjs",
      "import": "./dist/relay.mjs",
      "default": "./dist/relay.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "bun": "./dist/client.mjs",
      "development": "./dist/client.mjs",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "bun": "./dist/host.mjs",
      "development": "./dist/host.mjs",
      "import": "./dist/host.mjs",
      "default": "./dist/host.mjs"
    },
    "./exposure": {
      "types": "./dist/exposure.d.ts",
      "bun": "./dist/exposure.mjs",
      "development": "./dist/exposure.mjs",
      "import": "./dist/exposure.mjs",
      "default": "./dist/exposure.mjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "bun": "./dist/config.mjs",
      "development": "./dist/config.mjs",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "bun": "./dist/routes.mjs",
      "development": "./dist/routes.mjs",
      "import": "./dist/routes.mjs",
      "default": "./dist/routes.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "bun": "./dist/testing.mjs",
      "development": "./dist/testing.mjs",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "docs/api-manifest.json",
    "docs/agent.md",
    "dist",
    "!dist/bundle-staging",
    "!dist/bundle-staging/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --import ./src/text-imports.mjs --import tsx --watch src/workspace-relay-e2e-entry.ts",
    "start": "node --import ./src/text-imports.mjs --import tsx src/workspace-relay-e2e-entry.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsx scripts/build.ts",
    "verify:publish": "tsx scripts/verify-publish.ts",
    "prepublishOnly": "npm run build && npm run verify:publish",
    "test": "bun test --path-ignore-patterns='**/store.test*' && node --import tsx --test src/store.test.ts"
  },
  "dependencies": {
    "@claxedo/agent-extensions": "0.5.1",
    "@claxedo/agent-sdk-runtime": "0.5.1",
    "@claxedo/agent-event-runtime": "0.5.1",
    "@claxedo/workspace-relay": "0.5.1",
    "@claxedo/workspace-relay-protocol": "0.5.1",
    "@claxedo/workgraph": "0.1.0",
    "@agentclientprotocol/sdk": "1.0.0",
    "@anthropic-ai/claude-agent-sdk": "0.2.76",
    "@hono/node-server": "1.19.11",
    "@hono/node-ws": "1.3.1",
    "better-sqlite3": "12.10.0",
    "hono": "4.12.12",
    "jose": "6.0.11",
    "node-pty": "1.1.0",
    "jsonc-parser": "3.3.1",
    "portless": "0.11.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.17.8",
    "@tsconfig/node-lts": "22.0.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.13",
    "esbuild": "0.25.12",
    "rollup": "4.62.2",
    "rollup-plugin-dts": "6.4.1",
    "tsx": "4.22.3",
    "typescript": "catalog:"
  }
}
