{
  "name": "@claxedo/workspace-runtime",
  "version": "0.8.0",
  "description": "Per-workspace host runtime for agent sessions, terminals, processes, files, diffs, and relay attachment.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/workspace-runtime"
  },
  "homepage": "https://github.com/kyashrathore/Claxedo/tree/dev/packages/workspace-runtime",
  "bugs": "https://github.com/kyashrathore/Claxedo/issues",
  "keywords": [
    "agents",
    "workspace",
    "runtime",
    "pty",
    "relay"
  ],
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "workspace-runtime": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./relay": {
      "development": "./src/relay.ts",
      "bun": "./src/relay.ts",
      "types": "./dist/relay.d.ts",
      "import": "./dist/relay.mjs",
      "default": "./dist/relay.mjs"
    },
    "./client": {
      "development": "./src/client.ts",
      "bun": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./host": {
      "development": "./src/host.ts",
      "bun": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.mjs",
      "default": "./dist/host.mjs"
    },
    "./exposure": {
      "development": "./src/exposure.ts",
      "bun": "./src/exposure.ts",
      "types": "./dist/exposure.d.ts",
      "import": "./dist/exposure.mjs",
      "default": "./dist/exposure.mjs"
    },
    "./config": {
      "development": "./src/config.ts",
      "bun": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./routes": {
      "development": "./src/routes.ts",
      "bun": "./src/routes.ts",
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.mjs",
      "default": "./dist/routes.mjs"
    },
    "./http": {
      "development": "./src/http.ts",
      "bun": "./src/http.ts",
      "types": "./dist/http.d.ts",
      "import": "./dist/http.mjs",
      "default": "./dist/http.mjs"
    },
    "./route-contribution": {
      "development": "./src/route-contribution.ts",
      "bun": "./src/route-contribution.ts",
      "types": "./dist/route-contribution.d.ts",
      "import": "./dist/route-contribution.mjs",
      "default": "./dist/route-contribution.mjs"
    },
    "./testing": {
      "development": "./src/testing.ts",
      "bun": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    },
    "./opencode": {
      "development": "./src/opencode.ts",
      "bun": "./src/opencode.ts",
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.mjs",
      "default": "./dist/opencode.mjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "docs/api-manifest.json",
    "docs/agent.md",
    "docs/architecture.md",
    "dist",
    "scripts/install-opencode-node.mjs",
    "!dist/bundle-staging",
    "!dist/bundle-staging/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --import ./src/text-imports.mjs --import tsx --watch src/workspace-relay-e2e-entry.ts",
    "start": "node --import ./src/text-imports.mjs --import tsx src/workspace-relay-e2e-entry.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build": "tsx scripts/build.ts",
    "verify:publish": "tsx scripts/verify-publish.ts",
    "prepublishOnly": "npm run build && npm run verify:publish",
    "postinstall": "node scripts/install-opencode-node.mjs",
    "test": "mkdir -p .artifacts/unit && node ../../scripts/test-deadline.mjs bun test --path-ignore-patterns='**/store.test*' --path-ignore-patterns='**/real-spawn.test*' --path-ignore-patterns='**/workspace-relay-e2e*' --path-ignore-patterns='**/workspace-relay-host-tunnel*' --timeout 30000 --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml && node ../../scripts/test-deadline.mjs bun test src/workspace-relay-e2e.test.ts src/workspace-relay-host-tunnel.test.ts --timeout 120000 --reporter=junit --reporter-outfile=.artifacts/unit/junit-relay.xml && node ../../scripts/test-deadline.mjs node --import ./src/text-imports.mjs --import tsx --test src/store.test.ts src/pty/real-spawn.test.ts src/pi-native.node-test.ts",
    "test:performance": "bun test ./perf/runtime-store.perf.ts",
    "test:opencode-node": "node ../../scripts/test-deadline.mjs node scripts/node-sdk-smoke.mjs && node ../../scripts/test-deadline.mjs node scripts/node-host-smoke.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@anthropic-ai/sdk": "0.115.0",
    "@claxedo/agent-event-runtime": "workspace:*",
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/agent-sdk-runtime": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@claxedo/workspace-relay": "workspace:*",
    "@claxedo/workspace-relay-protocol": "workspace:*",
    "@hono/node-server": "1.19.11",
    "@lydell/node-pty": "1.2.0-beta.14",
    "@hono/node-ws": "1.3.1",
    "@xterm/addon-serialize": "0.15.0-beta.289",
    "@xterm/addon-unicode11": "0.10.0-beta.289",
    "@xterm/headless": "6.1.0-beta.289",
    "better-sqlite3": "13.0.1",
    "fuzzysort": "3.1.0",
    "hono": "4.10.7",
    "jose": "6.0.11",
    "jsonc-parser": "3.3.1",
    "ws": "8.21.0",
    "zod": "4.4.3",
    "zod-to-json-schema": "3.25.2",
    "@opencode-ai/sdk": "0.0.0-beta-18684",
    "@opencode-ai/schema": "0.0.0-beta-18684",
    "@opencode-ai/plugin": "0.0.0-beta-18684",
    "koffi": "3.1.6"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "22.0.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.13",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "rollup": "4.62.2",
    "rollup-plugin-dts": "6.4.1",
    "tsx": "4.22.3",
    "typescript": "5.8.2"
  }
}
