{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": false,
    "types": ["bun"],
    "lib": ["ESNext", "DOM"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.vitest.ts", "src/**/*.typecheck.ts"]
}
