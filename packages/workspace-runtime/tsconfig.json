{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": false,
    "lib": ["ESNext", "DOM"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.vitest.ts", "src/**/*.typecheck.ts"]
}
