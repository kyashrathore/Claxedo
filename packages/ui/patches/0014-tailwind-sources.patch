Subject: Tailwind entry: explicit sources, test fixtures excluded

What: utilities are generated from explicit @source entries instead of the whole
monorepo, and test files are excluded.
Why: fixture strings in tests registered as candidates, e.g. "[file:src/a.ts]"
emitted `.\[file\:src\/a\.ts\]{file:src/a.ts}` into the shipped CSS (the esbuild
"file is not a known CSS property" warnings).

diff --git a/src/styles/tailwind/index.css b/src/styles/tailwind/index.css
index d8b0b2a1a0c4db9f4c005da4463c2bd559d7fb4b..ea58deb120e9a5ce0cb57e6aae60354a50009267 100644
--- a/src/styles/tailwind/index.css
+++ b/src/styles/tailwind/index.css
@@ -1,7 +1,23 @@
 @layer theme, base, components, utilities;
 
 @import "tailwindcss/theme.css" layer(theme);
-@import "tailwindcss/utilities.css" layer(utilities) source("../../../../");
+@import "tailwindcss/utilities.css" layer(utilities) source(none);
+@source "../../";
+@source "../../../../claxedo-app/src";
+@source "../../../../claxedo-desktop/src/renderer";
+/* Test files never contribute runtime markup, but their fixture strings DO
+   register as candidates — e.g. prompt-preview.test.ts's "[file:src/a.ts]"
+   emitted a literal `.\[file\:src\/a\.ts\]{file:src/a.ts}` arbitrary-property
+   utility into the shipped CSS (the esbuild "file is not a known CSS property"
+   build warnings). Keep them out of the scan. */
+@source not "../../**/*.test.*";
+@source not "../../../../claxedo-app/src/**/*.test.*";
+@source not "../../../../claxedo-desktop/src/renderer/**/*.test.*";
+/* Same garbage-candidate mechanism, but from doc comments in shipped source
+   (prompt-preview.ts documents its "[file:<path>]" / "[image:<filename>]"
+   output format), so a file exclusion cannot catch these two. */
+@source not inline("[file:<path>]");
+@source not inline("[image:<filename>]");
 @import "./utilities.css";
 
 @import "../index.css";
