@@ -0,0 +1,98 @@
+.ui-radio-list {
+  display: flex;
+  flex-direction: column;
+}
+
+.ui-radio-list-item {
+  /* The control centres on the first text line, so a row that wraps keeps it
+     beside the label instead of halfway down the row. */
+  --radio-list-line-height: 20px;
+  --radio-list-control-size: 14px;
+
+  display: flex;
+  align-items: flex-start;
+  gap: 8px;
+  min-width: 0;
+
+  .ui-radio-list-item-control {
+    align-items: center;
+    aspect-ratio: 1;
+    background-color: transparent;
+    border: 1px solid var(--border-weak-base);
+    border-radius: var(--radius-pill);
+    box-sizing: border-box;
+    display: flex;
+    flex-shrink: 0;
+    height: var(--radio-list-control-size);
+    justify-content: center;
+    margin-top: calc((var(--radio-list-line-height) - var(--radio-list-control-size)) / 2);
+    transition:
+      border-color 180ms ease-out,
+      box-shadow 180ms ease-out;
+    width: var(--radio-list-control-size);
+  }
+
+  .ui-radio-list-item-indicator {
+    background-color: var(--icon-strong-base);
+    border-radius: var(--radius-pill);
+    height: 6px;
+    width: 6px;
+  }
+
+  .ui-radio-list-item-text {
+    display: flex;
+    flex: 1;
+    flex-direction: column;
+    gap: 2px;
+    min-width: 0;
+  }
+
+  .ui-radio-list-item-label {
+    cursor: default;
+    line-height: var(--radio-list-line-height);
+    user-select: none;
+  }
+
+  .ui-radio-list-item-description {
+    line-height: var(--radio-list-line-height);
+    user-select: none;
+  }
+
+  &[data-checked] .ui-radio-list-item-control {
+    border-color: var(--border-strong-base);
+  }
+
+  &:hover:not([data-disabled]) .ui-radio-list-item-control {
+    border-color: var(--border-hover);
+  }
+
+  [data-slot="radio-list-item-input"]:focus-visible ~ .ui-radio-list-item-control {
+    border-color: var(--border-focus);
+    box-shadow: var(--shadow-xs-border-focus);
+  }
+
+  &[data-invalid] .ui-radio-list-item-control,
+  &[data-invalid][data-checked] .ui-radio-list-item-control,
+  &[data-invalid]:hover:not([data-disabled]) .ui-radio-list-item-control {
+    border-color: var(--border-critical-selected);
+  }
+
+  &[data-invalid] .ui-radio-list-item-indicator {
+    background-color: var(--icon-critical-base);
+  }
+
+  &[data-disabled] {
+    cursor: not-allowed;
+
+    .ui-radio-list-item-control {
+      border-color: var(--border-disabled);
+    }
+
+    /* The words are the caller's, in the caller's own colour, so fading them is
+       the only way this sheet can say the row is not a choice. A cursor the
+       pointer has to arrive at first cannot say it. */
+    .ui-radio-list-item-text {
+      opacity: 0.55;
+    }
+  }
+}
