+  const [trigger, setTriggerState] = createSignal<{ element: HTMLElement | undefined; props: ComponentProps<typeof DropdownMenu.Trigger> }>()
+  const [portal, setPortal] = createSignal<ComponentProps<typeof DropdownMenu.Portal>>()
