+++ b/src/v2/components/text-shimmer-v2.css
@@ -1,9 +1,3 @@
-* {
-  -webkit-font-smoothing: antialiased;
-  -moz-osx-font-smoothing: grayscale;
-  text-rendering: geometricPrecision;
-}
-
 [data-component="text-shimmer-v2"] {
   --_step: 45ms;
   --_duration: 1200ms;
@@ -62,7 +56,7 @@
   opacity: 1;
 }
 
-[data-component="text-shimmer-v2"] .ui-text-shimmer-v2-shimmer[data-run="true"] {
