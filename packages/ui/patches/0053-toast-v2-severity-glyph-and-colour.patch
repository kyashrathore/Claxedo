Subject: toast-v2: error, warning and success toasts carry their severity

What: a toast with `variant` "error" or "warning" draws a warning triangle and a
"success" toast a tick in the icon slot, unless the caller passes its own
`icon`, and the slot takes v2's state colour for the variant
(`--v2-state-fg-danger`, `-warning`, `-success`). `warning` joins the variant
union.
Why: toast-v2 only turned the variant into a `toast-v2--<variant>` class, which
its sheet never styles, so an error toast looked exactly like a neutral one.
The original toast drew the warning glyph for errors and a check for success.

diff --git a/src/v2/components/toast-v2.css b/src/v2/components/toast-v2.css
index db173489a9..486eb61360 100644
--- a/src/v2/components/toast-v2.css
+++ b/src/v2/components/toast-v2.css
@@ -65,6 +65,18 @@
     color: var(--v2-icon-icon-base);
   }
 
+  &.toast-v2--success > [data-icon] {
+    color: var(--v2-state-fg-success);
+  }
+
+  &.toast-v2--warning > [data-icon] {
+    color: var(--v2-state-fg-warning);
+  }
+
+  &.toast-v2--error > [data-icon] {
+    color: var(--v2-state-fg-danger);
+  }
+
   > [data-content] {
     grid-column: 1;
     grid-row: 1;
diff --git a/src/v2/components/toast-v2.tsx b/src/v2/components/toast-v2.tsx
index 99b97acdd5..ab257fc44e 100644
--- a/src/v2/components/toast-v2.tsx
+++ b/src/v2/components/toast-v2.tsx
@@ -128,6 +128,30 @@ function CloseIcon() {
   )
 }
 
+function SuccessIcon() {
+  return (
+    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
+      <path d="M3.5 8.25L6.5 11.25L12.5 4.75" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
+    </svg>
+  )
+}
+
+function WarningIcon() {
+  return (
+    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
+      <path d="M8 2.5L14 13H2L8 2.5Z" stroke="currentColor" stroke-linejoin="round" />
+      <path d="M8 6.5V9.25" stroke="currentColor" stroke-linecap="round" />
+      <circle cx="8" cy="11.1" r="0.6" fill="currentColor" />
+    </svg>
+  )
+}
+
+function severityIcon(variant: ToastV2Options["variant"]) {
+  if (variant === "success") return <SuccessIcon />
+  if (variant === "error" || variant === "warning") return <WarningIcon />
+  return undefined
+}
+
