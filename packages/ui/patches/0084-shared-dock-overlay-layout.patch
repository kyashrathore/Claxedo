+[data-component="dock-layout"] {
+  position: relative;
+  isolation: isolate;
+}
+
+[data-slot="dock-layout-overlay"] {
+  position: absolute;
+  inset-inline: 0;
+  bottom: 100%;
+  padding-inline: inherit;
+}
+
+[data-slot="dock-layout-base"] {
