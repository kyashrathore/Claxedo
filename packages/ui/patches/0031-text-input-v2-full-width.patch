--- a/src/v2/components/textarea-v2.css
+++ b/src/v2/components/textarea-v2.css
@@ -1,3 +1,7 @@
+.ui-textarea-v2.textarea-v2--full-width {
+  width: 100%;
+}
+
 .ui-textarea-v2 {
   box-sizing: border-box;
   display: flex;
