   animation-fill-mode: both;
   animation-delay: calc(var(--_step) * var(--_index) * -1);
-  will-change: background-position;
+}
+
+/* The band moves by transform, never by background-position: a background-position
+   sweep repaints the text on the main thread every frame (240 paints/s for three rows),
+   while transform animations run on the compositor. The sweep carries the band as a mask
+   and the peak copy inside it moves back by the same distance, so the glyphs stay put
+   while the band crosses them. The swept copy clips to its own box because the sweep is
+   3.6 times as wide as the text, which would otherwise widen the scroll area and the
+   compositor's offscreen pass. Both copies paint through background-clip: text, because
+   plain text colour rasterizes glyph edges differently and would not match. */
+[data-component="text-shimmer-v2"] .ui-text-shimmer-v2-sweep {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: 0;
+  width: calc(var(--_size) * 100%);
+  mask-image: linear-gradient(
+    var(--_angle),
+    transparent calc(50% - var(--_spread)),
+    #000 50%,
+    transparent calc(50% + var(--_spread))
+  );
+  animation-name: text-shimmer-v2-sweep;
+}
+
+[data-component="text-shimmer-v2"] .ui-text-shimmer-v2-peak {
+  display: block;
+  white-space: pre;
+  background-image: var(--_peak);
+  -webkit-background-clip: text;
+  background-clip: text;
+  animation-name: text-shimmer-v2-peak;
 }
 
 @keyframes text-shimmer-v2-sweep {
