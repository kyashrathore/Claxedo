{
  "name": "@claxedo/workspace-relay",
  "version": "0.7.0",
  "type": "module",
  "description": "Relay/tunnel server that routes authenticated traffic to workspace runtimes: JWT workspace tokens, header-stripping trust boundary, Bun and Cloudflare adapters",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/workspace-relay"
  },
  "keywords": [
    "claxedo",
    "relay",
    "tunnel",
    "workspaces"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.mjs",
      "development": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "workspace-relay": "dist/main.mjs"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun run --hot src/main.ts",
    "build": "tsx scripts/build.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "mkdir -p .artifacts/unit && bun test src --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "@claxedo/workspace-relay-protocol": "0.7.0",
    "hono": "4.10.7",
    "jose": "6.0.11",
    "posthog-node": "4.18.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "1.3.13",
    "esbuild": "0.25.12",
    "tsx": "4.22.3",
    "typescript": "catalog:",
    "@daytona/sdk": "0.192.0",
    "wrangler": "4.114.0"
  }
}
