{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    // No `DOM`: every file here runs under Bun, and `bun-types` yields its own
    // globals to `lib.dom` whenever `lib.dom` is loaded
    // (`Bun.__internal.UseLibDomIfAvailable`). That hands the bench the
    // browser's `new WebSocket(url, protocols)`, which cannot send headers, in
    // place of Bun's `new WebSocket(url, { headers })`, the form `lib/ws.ts`
    // calls.
    "lib": ["ESNext"],
    "types": ["bun"]
  },
  "include": ["."],
  "references": []
}
