{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "lib": ["ESNext", "DOM"],
    "types": ["bun"]
  },
  "include": ["."],
  // W7.2: `bench/` was never typechecked by any script or workflow (the package
  // `typecheck` covers `src` only), so it has drifted. `setup-separate.ts` is
  // the one file that does not compile — 12 errors, all implicit-`any` and
  // Daytona SDK signature drift in a densely-written cloud PROVISIONING script
  // that needs `DAYTONA_API_KEY` and is only ever run by hand from the RUNBOOK.
  //
  // Excluded rather than fixed, deliberately: the point of this ticket is to get
  // the credential-free CI gate typechecked and enforced, and rewriting an
  // owner-triggered provisioning script is a different change with a different
  // reviewer. Everything on the gate path — `local-dry-run.ts`, `loadgen.ts`,
  // `cf-dev-smoke.ts`, `local-dialin.ts`, and all of `lib/` — IS checked, which
  // is what stops the gate itself from rotting.
  //
  // Deleting this line is the fix; it should fail with those 12 errors until
  // someone does the work.
  "exclude": ["setup-separate.ts"],
  "references": []
}
