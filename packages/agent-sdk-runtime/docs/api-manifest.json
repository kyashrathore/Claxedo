      "status": "integration",
      "purpose": "MCP config resolution helpers."
    },
    "@claxedo/agent-sdk-runtime/subagent-admission": {
      "status": "integration",
      "purpose": "Parent-scoped subagent observation admission."
    },
    "@claxedo/agent-sdk-runtime/harnesses": {
      "status": "stable",
      "purpose": "Public harness factory functions."
    },
    "@claxedo/agent-sdk-runtime/harnesses/acp": {
      "status": "stable",
      "purpose": "ACP harness factory without loading native harness adapters."
    },
    "@claxedo/agent-sdk-runtime/harnesses/claude": {
      "status": "stable",
      "purpose": "Claude harness factory."
    },
    "@claxedo/agent-sdk-runtime/harnesses/codex": {
      "status": "stable",
      "purpose": "Codex harness factory."
    },
    "@claxedo/agent-sdk-runtime/harnesses/cursor": {
      "status": "stable",
      "purpose": "Cursor harness factory."
    },
    "@claxedo/agent-sdk-runtime/harnesses/pi": {
      "status": "stable",
      "purpose": "Pi harness factory."
    },
    "@claxedo/agent-sdk-runtime/adapters": {
      "status": "advanced",
      "purpose": "Public advanced adapter contracts and adapter helper types."
    },
    "@claxedo/agent-sdk-runtime/message-page": {
      "status": "integration",
      "purpose": "Bounded transcript-page contracts and projections."
    },
    "@claxedo/agent-sdk-runtime/stores/memory": {
      "status": "stable",
      "purpose": "In-memory runtime store for tests, demos, and ephemeral hosts."
    },
    "@claxedo/agent-sdk-runtime/stores/sqlite": {
      "status": "stable",
      "purpose": "Local durable runtime store."
    },
    "@claxedo/agent-sdk-runtime/stores/session-start": {
      "status": "integration",
      "purpose": "Durable session creation ownership on a host-supplied SQLite database."
    }
  },
