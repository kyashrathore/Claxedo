      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "Change identity for a held projection, so a renewed placeholder counts as a change."
    },
    "isProviderUnavailable": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "Whether a projection says the selected account cannot be bound, where refusing the turn would be wrong."
    },
    "providerBinding": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "The binding a harness may launch on; refuses a selected account the provider will not accept instead of falling back to the machine's login."
    },
    "ProviderCredentialUnavailableError": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "class",
      "purpose": "Raised when the operator's selected account for a provider exists but cannot be bound."
    },
    "ProviderProjectionExpiredError": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "class",
      "purpose": "Raised when a placeholder's lifetime ran out before the harness was spawned, so the vendor's 401 is never attributed to the stored account."
    },
    "liveProviderBinding": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "The binding to launch on, refusing one whose lifetime has already run out."
    },
    "projectionRenewalDueAt": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "When a projection map's earliest placeholder must be replaced, read from its own lifetime rather than a fixed interval."
    },
    "projectionRenewalDue": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "Whether a held projection is due for replacement, or the caller says the process lost track of time."
    }
