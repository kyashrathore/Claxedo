    },
    "providerBinding": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "The binding a harness may launch on; refuses a selected account the provider will not accept instead of falling back to the machine's login."
    },
    "providerProjection": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "Validate one provider projection: the broker base URL, placeholder, auth mode and expiry a harness receives in place of a credential."
    },
    "providerProjectionKey": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "Change identity for a held projection, so a renewed placeholder counts as a change."
    },
    "providerProjectionRecord": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "Validate a providerId-keyed map of provider projections, as the runtime config snapshot carries it."
