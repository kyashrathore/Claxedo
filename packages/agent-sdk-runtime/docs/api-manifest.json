{
  "package": "@claxedo/agent-sdk-runtime",
  "version": "0.10.0",
  "rootPolicy": "stable shared runtime types, session config helpers and the store contract",
  "stabilityLabels": {
    "stable": "Intended public API for external hosts.",
    "integration": "Public harness/transport adapter API. Import from explicit subpaths.",
    "compatibility": "Bridge for OpenCode or legacy Claxedo shapes.",
    "advanced": "Public advanced API for host integrations that need lower-level runtime surfaces."
  },
  "entrypoints": {
    "@claxedo/agent-sdk-runtime": {
      "status": "stable",
      "purpose": "Shared runtime types, session config helpers and the durable store contract."
    },
    "@claxedo/agent-sdk-runtime/compat-events": {
      "status": "compatibility",
      "purpose": "Claxedo client-presentation event bridge."
    },
    "@claxedo/agent-sdk-runtime/status": {
      "status": "compatibility",
      "purpose": "Session status normalization helpers."
    },
    "@claxedo/agent-sdk-runtime/provider-projection": {
      "status": "integration",
      "purpose": "Provider credential projection contracts and the record validator applied to pushed provider rows."
    },
    "@claxedo/agent-sdk-runtime/adapters": {
      "status": "advanced",
      "purpose": "Store contract types, recovery scope helpers and goal capability helpers."
    },
    "@claxedo/agent-sdk-runtime/message-page": {
      "status": "integration",
      "purpose": "Bounded transcript-page contracts and projections."
    },
    "@claxedo/agent-sdk-runtime/turn-page": {
      "status": "integration",
      "purpose": "The pages of turns a transcript reads, the first one included: every part of each turn with its tools sent as headers, the fill chosen by an estimate of their lines, and the viewport and cursor queries every producer parses."
    },
    "@claxedo/agent-sdk-runtime/turn-outline": {
      "status": "integration",
      "purpose": "A transcript's outline of turns without their content, folded from the rows any store reads for it."
    },
    "@claxedo/agent-sdk-runtime/stores/memory": {
      "status": "stable",
      "purpose": "In-memory runtime store for tests, demos, and ephemeral hosts."
    },
    "@claxedo/agent-sdk-runtime/stores/sqlite": {
      "status": "stable",
      "purpose": "Local durable runtime store."
    },
    "@claxedo/agent-sdk-runtime/stores/session-start": {
      "status": "integration",
      "purpose": "Durable session creation ownership on a host-supplied SQLite database."
    }
  },
  "docs": {
