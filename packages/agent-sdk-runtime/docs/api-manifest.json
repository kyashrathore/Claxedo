      "purpose": "When a projection map's earliest placeholder must be replaced, read from its own lifetime rather than a fixed interval."
    },
    "providerBinding": {
      "import": "@claxedo/agent-sdk-runtime",
      "kind": "function",
      "purpose": "The binding a harness may launch on; refuses a selected account the provider will not accept instead of falling back to the machine's login."
