{
  "name": "@claxedo/agent-sdk-runtime",
  "version": "0.8.0",
  "type": "module",
  "description": "AgentRuntime facade over native SDK harnesses and configured agent connections",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/agent-sdk-runtime"
  },
  "keywords": [
    "claxedo",
    "agents",
    "runtime",
    "claude",
    "codex",
    "harness"
  ],
