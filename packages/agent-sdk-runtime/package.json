{
  "name": "@claxedo/agent-sdk-runtime",
  "version": "0.10.0",
  "type": "module",
  "description": "AgentRuntime facade over native SDK harnesses and configured agent connections",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/agent-sdk-runtime"
  },
  "keywords": [
    "claxedo",
    "agents",
    "runtime",
    "claude",
    "codex",
    "harness"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./compat-events": {
      "development": "./src/compat-events.ts",
      "bun": "./src/compat-events.ts",
      "types": "./dist/compat-events.d.ts",
      "import": "./dist/compat-events.mjs",
      "default": "./dist/compat-events.mjs"
    },
    "./status": {
      "development": "./src/status.ts",
      "bun": "./src/status.ts",
      "types": "./dist/status.d.ts",
      "import": "./dist/status.mjs",
      "default": "./dist/status.mjs"
    },
    "./provider-projection": {
      "development": "./src/provider-projection.ts",
      "bun": "./src/provider-projection.ts",
      "types": "./dist/provider-projection.d.ts",
      "import": "./dist/provider-projection.mjs",
      "default": "./dist/provider-projection.mjs"
    },
    "./adapters": {
      "development": "./src/adapters.ts",
      "bun": "./src/adapters.ts",
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.mjs",
      "default": "./dist/adapters.mjs"
    },
    "./message-page": {
      "development": "./src/message-page.ts",
      "bun": "./src/message-page.ts",
      "types": "./dist/message-page.d.ts",
      "import": "./dist/message-page.mjs",
      "default": "./dist/message-page.mjs"
    },
    "./turn-page": {
      "development": "./src/turn-page.ts",
      "bun": "./src/turn-page.ts",
      "types": "./dist/turn-page.d.ts",
      "import": "./dist/turn-page.mjs",
      "default": "./dist/turn-page.mjs"
    },
    "./turn-outline": {
      "development": "./src/turn-outline.ts",
      "bun": "./src/turn-outline.ts",
      "types": "./dist/turn-outline.d.ts",
      "import": "./dist/turn-outline.mjs",
      "default": "./dist/turn-outline.mjs"
    },
    "./stores/session-start": {
      "development": "./src/session-start-store.ts",
      "bun": "./src/session-start-store.ts",
      "types": "./dist/session-start-store.d.ts",
      "import": "./dist/session-start-store.mjs",
      "default": "./dist/session-start-store.mjs"
    }
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check:api-manifest": "bun scripts/validate-api-manifest.ts",
    "check:package": "bun scripts/check-package.ts",
    "check:source-shape": "bun scripts/check-source-shape.ts && bun x oxlint -c scripts/oxlint.json --disable-nested-config --quiet src",
    "prepublishOnly": "bun run verify:publish",
    "verify:public-api": "bun test src/public-api.test.ts",
    "verify:publish": "bun run build && bun scripts/verify-publish.ts && npm pack --dry-run --ignore-scripts >/dev/null",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "mkdir -p .artifacts/unit && node ../../scripts/test-deadline.mjs bun test src --timeout 20000 --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/helpers": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "esbuild": "0.25.12",
    "typescript": "catalog:"
  }
}
