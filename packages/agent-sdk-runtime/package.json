  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check:api-manifest": "bun scripts/validate-api-manifest.ts",
    "check:package": "bun scripts/check-package.ts",
    "check:source-shape": "bun scripts/check-source-shape.ts && bunx oxlint -c scripts/oxlint.json --disable-nested-config --quiet src",
    "pi:install": "bun scripts/install-pinned-pi.ts",
    "test:architecture": "bun test src/architecture-ratchets.test.ts",
    "prepublishOnly": "bun run verify:publish",
    "verify:public-api": "bun test src/public-api.test.ts",
    "verify:publish": "bun run build && bun scripts/verify-publish.ts && npm pack --dry-run --ignore-scripts >/dev/null",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "mkdir -p .artifacts/unit && node ../../scripts/test-deadline.mjs bun test src --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@anthropic-ai/sdk": "0.115.0",
    "@claxedo/agent-event-runtime": "workspace:*",
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@cursor/sdk": "1.0.24",
    "smol-toml": "1.7.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "13.0.1"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "esbuild": "0.25.12",
    "typescript": "catalog:"
  }
}
