{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-runtime-stats-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  "browser": {
    "binding": "BROWSER",
  },
  "d1_databases": [
    {
      "binding": "REPORTS",
      "database_name": "agent-runtime-stats-reports",
      "database_id": "34b7271d-3cc2-457c-a1a4-8981b072ec8d",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "CREATE_REPORT_LIMITER",
      "namespace_id": "347214",
      "simple": {
        "limit": 6,
        "period": 60,
      },
    },
  ],
}
