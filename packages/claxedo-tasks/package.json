{
  "name": "@claxedo/tasks",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Optional Tasks and Presets kit: personal execution presets, project-owned tasks with subtasks and linked sessions, their rules, store ports, HTTP routes and client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/claxedo-tasks"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "bun": "./src/http/index.ts",
      "development": "./src/http/index.ts",
      "import": "./src/http/index.ts",
      "default": "./src/http/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "bun": "./src/client/index.ts",
      "development": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "bun": "./src/mcp/index.ts",
      "development": "./src/mcp/index.ts",
      "import": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    },
    "./conformance": {
      "types": "./src/conformance/index.ts",
      "bun": "./src/conformance/index.ts",
      "development": "./src/conformance/index.ts",
      "import": "./src/conformance/index.ts",
      "default": "./src/conformance/index.ts"
    },
    "./test-support": {
      "types": "./src/test-support/index.ts",
      "bun": "./src/test-support/index.ts",
      "development": "./src/test-support/index.ts",
      "import": "./src/test-support/index.ts",
      "default": "./src/test-support/index.ts"
    }
  },
  "claxedo": {
    "id": "claxedo-tasks",
    "name": "Tasks",
    "version": "1.0.0",
    "app": "./src/app/index.ts",
    "requires": ["tasks"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:closure": "bun ../../script/product-boundary/verify.ts",
    "test": "mkdir -p .artifacts/unit && node ../../script/test-deadline.mjs bun test src --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@claxedo/mcp": "workspace:*",
    "@claxedo/plugin-api": "workspace:*",
    "hono": "4.12.34",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "1.19.11",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "1.3.13",
    "typescript": "catalog:"
  }
}
