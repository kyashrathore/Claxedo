{
  "name": "@claxedo/web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "bun run sync:framework",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "bun run sync:framework && bun run check:redirects",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "astro": "astro",
    "sync:framework": "bun scripts/sync-framework-docs.ts",
    "check:framework": "bun scripts/sync-framework-docs.ts --check",
    "generate:redirects": "bun scripts/generate-redirects.ts",
    "check:redirects": "bun scripts/generate-redirects.ts --check",
    "check:release-artifacts": "bun scripts/verify-release-artifacts.ts",
    "test": "mkdir -p .artifacts/unit && node ../../scripts/test-deadline.mjs bun test test --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.37.7",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "astro": "5.18.2",
    "mermaid": "11.16.0",
    "posthog-js": "1.407.2",
    "typescript": "5.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.13"
  }
}
