---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Claxedo — The parallel AI workspace built on OpenCode. Run multiple AI coding workflows at once with multi-pane layout, instant agent terminals, and workspace-aware AI context." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preload" as="image" href="/screenshots/hero-attached-review.png" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ===== OpenCode Design Language ===== */
  :root {
    color-scheme: light;

    --bg: hsl(0, 20%, 99%);
    --bg-weak: hsl(0, 8%, 97%);
    --bg-strong: hsl(0, 5%, 12%);
    --bg-strong-hover: hsl(0, 5%, 18%);

    --text: hsl(0, 1%, 39%);
    --text-strong: hsl(0, 5%, 12%);
    --text-weak: hsl(0, 1%, 60%);
    --text-weaker: hsl(0, 3%, 88%);
    --text-inverted: hsl(0, 20%, 99%);

    --accent: hsl(62, 84%, 88%);
    --accent-hover: hsl(62, 84%, 80%);
    --accent-text: hsl(0, 5%, 12%);

    --border: hsl(0, 1%, 85%);

    --success: hsl(140, 60%, 40%);

    --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    --bw: 2px;
    --nav-bg: hsl(0, 20%, 99%);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;

      --bg: hsl(0, 9%, 7%);
      --bg-weak: hsl(0, 6%, 10%);
      --bg-strong: hsl(0, 15%, 94%);
      --bg-strong-hover: hsl(0, 15%, 97%);

      --text: hsl(0, 4%, 71%);
      --text-strong: hsl(0, 15%, 94%);
      --text-weak: hsl(0, 2%, 49%);
      --text-weaker: hsl(0, 3%, 28%);
      --text-inverted: hsl(0, 9%, 7%);

      --accent: hsl(62, 100%, 90%);
      --accent-hover: hsl(62, 100%, 82%);
      --accent-text: hsl(0, 9%, 7%);

      --border: hsl(0, 4%, 23%);

      --success: hsl(140, 60%, 50%);

      --nav-bg: hsl(0, 9%, 7%);
    }
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    font-size: 14px;
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
  }

  code, .mono {
    font-family: var(--font-mono);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
  }

  img {
    max-width: 100%;
    display: block;
  }

  .container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .container-wide {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--bg-strong);
    border: none;
    color: var(--text-inverted);
    font-weight: 500;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    transition: background 0.15s;
    line-height: 1.4;
  }

  .btn-primary:hover {
    background: var(--bg-strong-hover);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: transparent;
    border: var(--bw) solid var(--border);
    color: var(--text-strong);
    font-weight: 500;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    transition: background 0.15s, border-color 0.15s;
    line-height: 1.4;
  }

  .btn-secondary:hover {
    background: var(--bg-weak);
  }
</style>
