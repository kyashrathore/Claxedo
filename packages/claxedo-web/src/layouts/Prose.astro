---
import Layout from "./Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"

interface Props {
  frontmatter: {
    title: string
    description?: string
    noindex?: boolean
  }
}

const { frontmatter } = Astro.props
const { title, description, noindex } = frontmatter
---

<Layout title={title} description={description} noindex={noindex}>
  <div class="page-frame">
    <Nav />
    <section class="section prose">
      <div class="container">
        <slot />
      </div>
    </section>
    <Footer />
  </div>
</Layout>

<style is:global>
  .prose .container { max-width: 60rem; }

  .prose h1 {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.05;
    font-weight: 650;
    letter-spacing: -0.04em;
    color: var(--text-strong);
    text-wrap: balance;
    margin-bottom: 1rem;
  }

  .prose h2 {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--text-strong);
    margin: 2.5rem 0 1rem;
    text-wrap: balance;
  }

  .prose p {
    color: var(--text);
    line-height: 1.7;
    margin: 0.75rem 0;
    text-wrap: pretty;
  }

  .prose blockquote {
    margin: 1.25rem 0;
    padding: 0.75rem 1.1rem;
    border-left: var(--bw) solid var(--accent);
    background: var(--bg-weak);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .prose blockquote p { margin: 0.2rem 0; }

  .prose hr {
    border: none;
    border-top: var(--bw) solid var(--border);
    margin: 2.25rem 0;
  }

  .prose strong { color: var(--text-strong); }

  .prose a {
    color: var(--text-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Wide comparison tables scroll horizontally instead of blowing out the page. */
  .prose table {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 12.5px;
    scrollbar-width: thin;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 6px 10px;
    text-align: left;
    white-space: nowrap;
    vertical-align: top;
  }

  .prose thead th {
    background: var(--bg-weak);
    color: var(--text-strong);
    font-weight: 600;
    position: sticky;
    top: 0;
  }

  .prose tbody td:first-child,
  .prose tbody td strong { color: var(--text-strong); }
</style>
