---
/**
 * A Mughal star jali drawn in SVG: stone pierced by an eight-pointed star in
 * every cell and a small diamond where four cells meet. The stone is the page's
 * ink, so the screen stays invisible until light passes behind it.
 */
const cell = 96
const cells = 31
const c = cell / 2
const tip = 39
const notch = tip * Math.SQRT1_2 / Math.cos(Math.PI / 8)
const star = Array.from({ length: 16 }, (_, i) => {
  const radius = i % 2 === 0 ? tip : notch
  const angle = (i * Math.PI) / 8
  return `${(c + radius * Math.cos(angle)).toFixed(2)} ${(c + radius * Math.sin(angle)).toFixed(2)}`
})
const gem = 13
const diamond = (x: number, y: number) => `M${x - gem} ${y}L${x} ${y - gem}L${x + gem} ${y}L${x} ${y + gem}Z`
const stone = `M0 0H${cell}V${cell}H0Z M${star.join("L")}Z ${[[0, 0], [cell, 0], [0, cell], [cell, cell]].map(([x, y]) => diamond(x, y)).join(" ")}`
---

<div class="backdrop jali" aria-hidden="true">
  <span class="pool"></span>
  <span class="beam"></span>
  <svg class="screen" width={cell * cells} height={cell * 12} viewBox={`0 0 ${cell * cells} ${cell * 12}`}>
    <defs>
      <pattern id="jali-cell" width={cell} height={cell} patternUnits="userSpaceOnUse">
        <path d={stone} fill="#0f0f0f" fill-rule="evenodd" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#jali-cell)" />
  </svg>
</div>

<style>
  .jali { overflow: hidden; background: #0f0f0f; }
  .pool, .beam { position: absolute; }
  .pool {
    inset: 0;
    background: radial-gradient(48% 70% at 50% 34%, rgb(255 243 222 / .24), rgb(255 243 222 / .07) 55%, transparent 82%);
  }
  .beam {
    inset: -10% -60%;
    background: linear-gradient(105deg, transparent 40%, rgb(255 246 230 / .5) 48.5%, rgb(255 246 230 / .5) 51.5%, transparent 60%);
    opacity: 0;
  }
  .screen {
    position: absolute;
    top: -3rem;
    left: 50%;
    max-width: none;
    translate: -50% 0;
    scale: var(--jali-scale, 1);
    transform-origin: 50% 0;
  }
  .jali::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(transparent, #0f0f0f);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pool { animation: settle 1.2s 1s ease-out both; }
    .beam { animation: sweep 1.8s .2s cubic-bezier(.45, 0, .25, 1) both; }
    @keyframes sweep {
      0% { opacity: 0; translate: -45% 0; }
      12% { opacity: 1; }
      78% { opacity: 1; }
      100% { opacity: 0; translate: 45% 0; }
    }
    @keyframes settle { from { opacity: 0; } }
  }
  @media (max-width: 47.99rem) {
    .jali { --jali-scale: .62; }
  }
</style>
