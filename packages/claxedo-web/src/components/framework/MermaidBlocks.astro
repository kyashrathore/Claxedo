{/* Renders ```mermaid fences (which Expressive Code leaves as code frames)
    as inline SVG diagrams, restyled to the docs' neutral ink palette. */}
<script>
  const blocks = document.querySelectorAll('.expressive-code pre[data-language="mermaid"]')
  if (blocks.length > 0) renderAll(blocks)

  async function renderAll(pres: NodeListOf<Element>) {
    const { default: mermaid } = await import("mermaid")
    const dark = document.documentElement.dataset.theme !== "light"
    const styles = getComputedStyle(document.documentElement)
    const token = (name: string, fallback: string) => styles.getPropertyValue(name).trim() || fallback

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "loose", // required for the click-to-package-page links
      theme: "base",
      themeVariables: {
        fontFamily: token("--sl-font", "sans-serif"),
        fontSize: "14px",
        primaryColor: token("--sl-color-gray-6", dark ? "#1c1c1c" : "#f2f2f2"),
        primaryTextColor: token("--sl-color-white", dark ? "#ededed" : "#171717"),
        primaryBorderColor: token("--sl-color-gray-4", dark ? "#3a3a3a" : "#aeaeae"),
        lineColor: token("--sl-color-gray-3", "#808080"),
        clusterBkg: dark ? "#161616" : "#fafafa",
        clusterBorder: token("--sl-color-gray-5", dark ? "#282828" : "#dbdbdb"),
        edgeLabelBackground: token("--sl-color-black", dark ? "#101010" : "#f8f8f8"),
      },
    })

    let n = 0
    for (const pre of pres) {
      const source = [...pre.querySelectorAll(".ec-line")]
        .map((line) => line.textContent ?? "")
        .join("\n")
        .trim()
      if (!source) continue
      const frame = pre.closest(".expressive-code") ?? pre
      try {
        const { svg } = await mermaid.render(`mermaid-${n++}`, source)
        const host = document.createElement("div")
        host.className = "mermaid-diagram not-content"
        host.innerHTML = svg
        // Diagram sources use docs-site-rooted paths; this route serves the
        // same pages under /framework.
        for (const link of host.querySelectorAll("a")) {
          const href = link.getAttribute("href") ?? link.getAttribute("xlink:href")
          if (href?.startsWith("/") && !href.startsWith("/framework")) {
            link.setAttribute("href", `/framework${href}`)
            link.removeAttribute("xlink:href")
          }
        }
        frame.replaceWith(host)
      } catch {
        // Leave the code block as-is if the source fails to parse.
      }
    }
  }
</script>

<style is:global>
  .mermaid-diagram { margin-block: 1.5rem; display: flex; justify-content: center; }
  .mermaid-diagram svg { max-width: 100%; height: auto; }
</style>
