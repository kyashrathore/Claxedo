---
import { Code } from "astro:components"
import { requireClaim } from "../../content/claims"
import { marketingActions } from "../../content/routes"
import claudeIcon from "../../../../ui/src/assets/icons/file-types/claude.svg"
import codexIcon from "../../../../ui/src/assets/icons/provider/openai.svg"
import geminiIcon from "../../../../ui/src/assets/icons/file-types/gemini-ai.svg"
import opencodeIcon from "../../../../ui/src/assets/icons/provider/opencode.svg"
const frameworkRuntime = requireClaim("framework-runtime")
const harnesses = [
  { label: "Claude Code", note: "Chat UI + terminal", icon: claudeIcon.src },
  { label: "Codex", note: "Chat UI + terminal", icon: codexIcon.src },
  { label: "Gemini CLI", note: "Terminal", icon: geminiIcon.src },
  { label: "OpenCode", note: "Chat UI + terminal", icon: opencodeIcon.src },
]
const essentialPathSource = `const runtime = createAgentRuntime({
  store: createMemoryRuntimeStore(),
  harnesses: [harnessFactory(pick)],
})

const session = await runtime.sessions.create({
  directory: dir,
  harness: { id: pick.id, access: pick.access },
  model: { providerID: pick.id, modelID: "default" },
})

const events = runtime.events.subscribe({ sessionId: session.id })
await runtime.turns.start({ sessionId: session.id, agent: "", text: prompt })
`
const capabilities = [
  ["@claxedo/workspace-runtime", "Workspace runtime", "One host contract for sessions, terminals, files, processes, and git — the same surface whether the workspace runs locally or on a machine you control.", "/framework/packages/workspace-runtime"],
  ["@claxedo/agent-sdk-runtime", "Agent runtime", "The AgentRuntime facade over coding-agent harnesses — create sessions, start turns, and stream session events through one API across Claude Code, Codex, OpenCode, and more.", "/framework/packages/agent-sdk-runtime"],
  ["@claxedo/agent-event-runtime", "Normalized events", "A single event vocabulary across supported harness adapters, so clients read one stream instead of every harness's native protocol.", "/framework/packages/agent-event-runtime"],
  ["@claxedo/workspace-relay", "Relay", "Authenticated reach to a workspace host without opening a public inbound port — verified forwarding between client and host.", "/framework/packages/workspace-relay"],
  ["@claxedo/connections", "Connections", "Capability-scoped access to external systems — each connection grants only the access a turn actually needs.", "/framework/packages/connections"],
  ["@claxedo/channels", "Channels", "Route GitHub, Slack, Telegram, Discord, and WhatsApp messages into agent sessions, with dedup, session resolution, and approval bridging.", "/framework/packages/channels"],
  ["@claxedo/agent-extensions", "Extensions", "Skills, MCP servers, plugins, and instructions resolved through explicit scopes, then synced into each workspace or sandbox.", "/framework/concepts/extensions"],
  ["@claxedo/workgraph", "WorkGraph", "Durable Streams, Tasks, and Attempts with decisions and evidence, so work outlives any single session or reconnect.", "/framework/packages/workgraph"],
  ["@claxedo/mcp", "MCP server", "An MCP server and CLI that exposes Claxedo documents, WorkGraph, processes, logs, sessions, and browser tools to any MCP client.", "/framework/packages/mcp"],
]
const ecosystem = ["More agents via ACP", "MCP servers", "Skills", "Your AI provider", "Your sandbox provider"]
const handoff = [
  ["Guide", "Start with the product model", "/framework/guides/introduction"],
  ["Reference", "Routes, tools, and events", "/framework/api/overview"],
  ["Packages", "Composable TypeScript modules", "/framework/packages"],
  ["Integrations", "Harness and capability boundaries", "/framework/integrations"],
]
---

<section class="fw-hero">
  <div class="fw-hero-inner">
    <p class="fw-badge"><span aria-hidden="true"></span>Framework preview</p>
    <p class="eyebrow">Open-source workspace foundation</p>
    <h1 class="display">The open-source foundation behind Claxedo.</h1>
    <p class="fw-lead">A TypeScript workspace and integration layer around existing coding-agent harnesses: runtime, normalized events, extensions, relay, connections, WorkGraph, and deployment contracts.</p>
    <div class="actions">
      <a class="btn-primary" href="/framework/guides/introduction">See docs</a>
    </div>
    <div class="status-line" aria-label="Framework principles"><span>Harness neutral</span><span>Explicit placement boundaries</span></div>
  </div>
</section>

<section class="section">
  <div class="section-inner fw-split">
    <div>
      <p class="eyebrow">01 · The essential path</p>
      <h2 class="section-title">Bring a harness into a real workspace.</h2>
      <p class="section-copy">Create an Agent Runtime, open a session against an authenticated harness, subscribe to normalized events, and start a turn — the whole essential path through the public API.</p>
      <a class="feature-link" href="/framework/guides/see-it-in-action">See it in action <span aria-hidden="true">→</span></a>
    </div>
    <div class="fw-code"><Code code={essentialPathSource} lang="ts" theme="css-variables" /></div>
  </div>
</section>

<section class="section">
  <div class="section-inner fw-split">
    <div>
      <p class="eyebrow">02 · Continuity</p>
      <h2 class="section-title">State crosses reconnect boundaries deliberately.</h2>
      <p class="section-copy">{frameworkRuntime.publicWording}</p>
    </div>
    <div class="fw-flow">
      <span>CLIENT</span><b>authenticated connection</b>
      <span>RELAY</span><b>verified forwarding</b>
      <span>WORKSPACE HOST</span>
    </div>
  </div>
</section>

<section class="section dark-band">
  <div class="section-inner">
    <p class="eyebrow">03 · Bring your existing stack</p>
    <h2 class="section-title">Keep the harnesses and tools you already use.</h2>
    <div class="fw-harness">
      {harnesses.map((h) => (
        <article><img src={h.icon} alt="" /><span><b>{h.label}</b><small>{h.note}</small></span></article>
      ))}
      <article class="fw-harness-any"><span class="fw-glyph" aria-hidden="true">›_</span><span><b>Any agent CLI</b><small>First-class terminal</small></span></article>
      <article class="fw-harness-more"><span class="fw-glyph" aria-hidden="true">+</span><span><b>More through ACP</b><small>Bring a compatible agent</small></span></article>
    </div>
    <div class="fw-chips">{ecosystem.map((item) => <i>{item}</i>)}</div>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    <p class="eyebrow">04 · Capability catalog</p>
    <h2 class="section-title">Compose the workspace layer you need.</h2>
    <p class="section-copy fw-grid-lead">Each capability is a composable TypeScript package with its own documented boundary. Take one, or the whole workspace layer.</p>
    <div class="fw-grid">{capabilities.map(([pkg, title, description, href]) => (
      <a href={href}><code class="fw-pkg">{pkg}</code><strong>{title}</strong><p>{description}</p><small>Read the contract <span aria-hidden="true">→</span></small></a>
    ))}</div>
  </div>
</section>

<section class="section dark-band">
  <div class="section-inner fw-split">
    <div>
      <p class="eyebrow">05 · Architecture + placement</p>
      <h2 class="section-title">One workspace model. Explicit boundaries.</h2>
      <p class="section-copy">Local and connected compositions decide where clients, coordination, model execution, and tools run. Each package documents its own boundary so product composition does not become an implicit framework promise.</p>
    </div>
    <div class="fw-arch">
      <div><small>CLIENT</small><strong>Desktop / Web</strong></div>
      <i aria-hidden="true">↕</i>
      <div><small>COORDINATION</small><strong>Server / Relay</strong></div>
      <i aria-hidden="true">↕</i>
      <div><small>EXECUTION</small><strong>Workspace Host</strong></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    <p class="eyebrow">06 · Keep reading</p>
    <h2 class="section-title">From first workspace to package contract.</h2>
    <div class="fw-grid fw-grid-handoff">{handoff.map(([title, description, href]) => (
      <a href={href}><strong>{title}</strong><small>{description}</small></a>
    ))}</div>
    <div class="actions"><a class="btn-primary" href={marketingActions.cloud.href} data-analytics-event={marketingActions.cloud.event} data-analytics-placement="framework-landing">Open Claxedo <span aria-hidden="true">↗</span></a></div>
  </div>
</section>

<style>
  /* Framework landing reuses the main-site primitives (.section, .eyebrow,
     .section-title, .section-copy, .btn-*, .dark-band, .feature-link). Only
     the landing-specific compositions are styled here, on the site tokens. */
  .fw-hero { padding: clamp(3.5rem, 8vw, 7rem) var(--gutter) clamp(3rem, 6vw, 5rem); overflow: hidden; }
  .fw-hero-inner { max-width: 72rem; margin-inline: auto; }
  .fw-hero .display { max-width: 20ch; margin-bottom: 1.4rem; }
  .fw-badge { display: inline-flex; align-items: center; gap: .5rem; margin: 0 0 1.6rem; padding: .4rem .75rem; border: 1px solid var(--line-strong); border-radius: 100px; background: var(--surface); color: var(--ink-soft); font: 500 .68rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .fw-badge span { width: .42rem; height: .42rem; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 22%, transparent); }
  .fw-lead { max-width: 44rem; margin-bottom: 2rem; color: var(--ink-soft); font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 1.65; text-wrap: pretty; }

  .fw-split { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .fw-split .feature-link { margin-top: 1.75rem; }

  /* Code excerpt reads as a product surface, matching .feature-visual.
     Shiki renders its own <pre>; blend its background into the site surface. */
  .fw-code {
    align-self: start; overflow: hidden; border: 1px solid var(--line-strong); border-radius: var(--radius-lg); box-shadow: 0 0 0 1px var(--line), 0 24px 56px -28px rgb(0 0 0 / .65);
    /* Shiki `css-variables` theme token palette (github-dark-flavored). */
    --astro-code-color-text: #c9d1d9;
    --astro-code-color-background: #0e0e0e;
    --astro-code-foreground: #c9d1d9;
    --astro-code-background: #0e0e0e;
    --astro-code-token-keyword: #ff7b72;
    --astro-code-token-function: #d2a8ff;
    --astro-code-token-string: #a5d6ff;
    --astro-code-token-string-expression: #a5d6ff;
    --astro-code-token-constant: #79c0ff;
    --astro-code-token-parameter: #ffa657;
    --astro-code-token-punctuation: #c9d1d9;
    --astro-code-token-comment: #8b949e;
    --astro-code-token-link: #a5d6ff;
  }
  .fw-code :global(pre) { margin: 0; padding: 1.5rem; overflow: auto; background: #0e0e0e !important; font-family: var(--font-mono); font-size: .78rem; line-height: 1.85; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .fw-code :global(pre)::-webkit-scrollbar { height: 8px; width: 8px; }
  .fw-code :global(pre)::-webkit-scrollbar-track { background: transparent; }
  .fw-code :global(pre)::-webkit-scrollbar-thumb { border-radius: 100px; background: var(--line-strong); }
  .fw-code :global(pre)::-webkit-scrollbar-thumb:hover { background: var(--ink-faint); }
  .fw-code :global(code) { font-family: inherit; }

  /* Continuity flow: alternating hosts and hops. */
  .fw-flow { align-self: start; display: grid; overflow: hidden; text-align: center; border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .fw-flow span { padding: 1.05rem; background: var(--surface); color: var(--ink); font: 500 .72rem/1 var(--font-mono); letter-spacing: .04em; }
  .fw-flow span + span { border-top: 1px solid var(--line); }
  .fw-flow b { padding: .5rem; color: var(--ink-faint); font: .64rem/1 var(--font-mono); font-weight: 400; border-block: 1px solid var(--line); }

  /* Harness cards echo the homepage .harness-grid: provider logo + label. */
  .fw-harness { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin-top: 3rem; }
  .fw-harness article { min-height: 6.75rem; display: flex; align-items: center; gap: 1.1rem; padding: 1.2rem 1.4rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); transition: transform .18s ease, border-color .18s ease; }
  .fw-harness article:hover { transform: translateY(-2px); border-color: var(--line-strong); }
  .fw-harness img { width: 1.9rem; height: 1.9rem; flex: 0 0 auto; object-fit: contain; filter: grayscale(1) brightness(0) invert(1); opacity: .92; }
  .fw-harness article > span:last-child { display: grid; gap: .3rem; }
  .fw-harness b { font-size: .92rem; font-weight: 500; }
  .fw-harness small { color: var(--ink-faint); font: .6rem/1.4 var(--font-mono); }
  .fw-glyph { width: 1.9rem; flex: 0 0 auto; color: var(--ink-soft); font: 500 1.35rem/1 var(--font-mono); text-align: center; }
  .fw-harness-more { border-style: dashed; }
  .fw-harness-more .fw-glyph, .fw-harness-more b { color: var(--ink-soft); }

  /* Secondary stack chips below the harness cards. */
  .fw-chips { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: .8rem; }
  .fw-chips i { padding: .6rem .9rem; border: 1px solid var(--line); border-radius: 100px; background: var(--surface); color: var(--ink-soft); font: 500 .74rem/1 var(--font-mono); font-style: normal; transition: border-color .18s ease, color .18s ease; }
  .fw-chips i:hover { border-color: var(--line-strong); color: var(--ink); }

  /* Capability + handoff cards mirror .continuity-grid. */
  .fw-grid-lead { margin-top: 1.2rem; }
  .fw-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin-top: 2.5rem; }
  .fw-grid a { display: flex; flex-direction: column; min-height: 14rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); text-decoration: none; transition: transform .18s ease, border-color .18s ease; }
  .fw-grid a:hover { transform: translateY(-2px); border-color: var(--line-strong); }
  .fw-pkg { width: fit-content; margin-bottom: .9rem; padding: .28rem .55rem; border-radius: var(--radius-sm); background: var(--accent-soft); color: var(--accent-text); font: 500 .68rem/1 var(--font-mono); letter-spacing: -.01em; }
  .fw-grid strong { font: 500 1.1rem/1.25 var(--font-sans); letter-spacing: -.02em; }
  .fw-grid p { margin: .6rem 0 0; color: var(--ink-soft); font-size: .88rem; line-height: 1.55; }
  .fw-grid small { margin-top: auto; padding-top: 1rem; color: var(--ink-faint); font: .64rem/1 var(--font-mono); }
  .fw-grid small span { display: inline-block; transition: transform .18s ease; }
  .fw-grid a:hover small span { transform: translateX(3px); }
  .fw-grid-handoff { margin-top: 3rem; }
  .fw-grid-handoff a { min-height: 8rem; }
  .fw-grid-handoff strong { font-size: 1.2rem; }

  /* Architecture map mirrors .placement-map arrows. */
  .fw-arch { align-self: start; display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: .5rem; }
  .fw-arch > div { min-height: 7.5rem; display: grid; place-content: center; gap: .5rem; padding: 1rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); text-align: center; }
  .fw-arch small { color: var(--ink-faint); font: .6rem/1 var(--font-mono); letter-spacing: .06em; }
  .fw-arch strong { font: 500 .95rem/1.2 var(--font-sans); }
  .fw-arch i { color: var(--ink-faint); font-size: 1.1rem; font-style: normal; }

  .section .actions { margin-top: 2.5rem; }

  @media (max-width: 60rem) {
    .fw-split { grid-template-columns: 1fr; gap: 2rem; }
    .fw-harness, .fw-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 42rem) {
    .fw-harness, .fw-grid { grid-template-columns: 1fr; }
    .fw-arch { grid-template-columns: 1fr; }
    .fw-arch i { transform: rotate(90deg); }
  }
</style>
