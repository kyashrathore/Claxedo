---
import { contact, github } from "../config"
import { routes } from "../content/routes"
---

<footer class="footer">
  <div class="footer-grid">
    <div class="footer-brand">
      <h2>Claxedo</h2>
      <p>Your agents, tools, and sandboxes in one fast workspace.</p>
    </div>
    <div class="footer-col">
      <h3>Product</h3>
      <a href={routes.download}>Download app</a>
      <a href={routes.pricing}>Pricing</a>
      <a href={routes.compare}>Compare</a>
      <a href={routes.agentRuntimeStudy}>Agent runtime study</a>
    </div>
    <div class="footer-col">
      <h3>Company</h3>
      <a href={github}>GitHub</a>
      <a href={contact}>Discord</a>
      <a href={routes.privacy}>Privacy</a>
      <a href={routes.terms}>Terms</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Claxedo</span>
  </div>
</footer>
