---
import { codexSymbol, DEMO_ICONS } from "../content/codex-icons"

const symbols = DEMO_ICONS.map(codexSymbol).join("")
---

<svg class="codex-icon-sprite" aria-hidden="true" set:html={symbols} />

<style>
  .codex-icon-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
</style>
