---
import type { Competitor } from "../content/competitors"
interface Props { competitor: Competitor }
const { competitor } = Astro.props
---

<section class="card sources" aria-labelledby="comparison-sources">
  <h2 id="comparison-sources">First-party sources</h2>
  <ul>{competitor.sources.map((source) => <li><a class="quiet-link" href={source.href}>{source.label}</a></li>)}</ul>
  <dl><div><dt>Content owner</dt><dd>{competitor.owner}</dd></div><div><dt>Last reviewed</dt><dd><time datetime={competitor.lastReviewed}>{competitor.lastReviewed}</time></dd></div><div><dt>Review due</dt><dd><time datetime={competitor.nextReview}>{competitor.nextReview}</time></dd></div></dl>
</section>

<style>
  .sources { padding: 1.75rem; }
  .sources h2 { margin: 0 0 1rem; font-size: 1.5rem; letter-spacing: -.015em; }
  .sources ul { display: grid; gap: .4rem; margin: 0; padding-left: 1.1rem; color: var(--ink-soft); }
  .sources :global(.quiet-link) { color: var(--ink-body); font-size: .9375rem; }
  .sources dl { display: grid; grid-template-columns: repeat(3, 1fr); margin: 1.75rem 0 0; padding-top: 1rem; border-top: 1px solid var(--line); }
  .sources dt { color: var(--ink-soft); font-size: .8125rem; }
  .sources dd { margin: .25rem 0 0; font-size: .9375rem; }
  @media (max-width: 42rem) { .sources dl { grid-template-columns: 1fr; gap: 1rem; } }
</style>
