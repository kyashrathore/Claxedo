---
import type { Competitor } from "../content/competitors"

interface Props { competitor: Competitor }
const { competitor } = Astro.props
---

<div class="comparison-table" role="table" aria-label={`Claxedo and ${competitor.name} comparison boundary`}>
  <div class="comparison-row comparison-head" role="row"><span role="columnheader">Decision area</span><span role="columnheader">{competitor.name}</span><span role="columnheader">Claxedo</span></div>
  <div class="comparison-row" role="row"><strong role="rowheader">Product center</strong><span>{competitor.intendedFor}</span><span>A connected workspace around coding-agent harnesses.</span></div>
  <div class="comparison-row" role="row"><strong role="rowheader">Genuine overlap</strong><span class="wide">{competitor.overlap}</span></div>
  <div class="comparison-row" role="row"><strong role="rowheader">Decision boundary</strong><span class="wide">{competitor.boundary}</span></div>
</div>

<style>
  .comparison-table { margin-top: 3rem; border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
  .comparison-row { display: grid; grid-template-columns: .65fr 1fr 1fr; background: var(--surface); }
  .comparison-row + .comparison-row { border-top: 1px solid var(--line); }
  .comparison-row > * { min-width: 0; padding: 1.1rem 1.2rem; }
  .comparison-row > * + * { border-left: 1px solid var(--line); }
  .comparison-row strong, .comparison-head { font: 500 .68rem/1.4 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .comparison-row span { color: var(--ink-soft); font-size: .9rem; }
  .comparison-head { background: var(--surface-raised); color: var(--ink-faint); }
  .wide { grid-column: 2 / -1; }
  @media (max-width: 42rem) { .comparison-row { grid-template-columns: 1fr; } .comparison-row > * + * { border-left: 0; border-top: 1px solid var(--line); } .wide { grid-column: auto; } .comparison-head { display: none; } }
</style>
