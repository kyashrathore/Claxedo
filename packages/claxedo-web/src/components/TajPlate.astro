---
import dither from "../assets/home/daniell-taj-dither.webp"

interface Props {
  /** Where the dome sits: centred under a centred headline, or right of a left-aligned one. */
  dome?: "center" | "right"
}

const { dome = "center" } = Astro.props
---

<div class:list={["backdrop", "daniell", { "dome-right": dome === "right" }]} aria-hidden="true">
  <img src={dither.src} width={dither.width} height={dither.height} alt="" decoding="async" data-daniell />
  <noscript><style>.daniell img { opacity: 1; }</style></noscript>
</div>

<script>
  const field = document.querySelector<HTMLImageElement>("[data-daniell]")
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches
  const reveal = (image: HTMLImageElement) => {
    const { naturalWidth: width, naturalHeight: height } = image
    const source = document.createElement("canvas")
    source.width = width
    source.height = height
    const read = source.getContext("2d")!
    read.drawImage(image, 0, 0)
    const bits = read.getImageData(0, 0, width, height).data
    const canvas = document.createElement("canvas")
    canvas.width = width
    canvas.height = height
    canvas.className = "field"
    image.after(canvas)
    const draw = canvas.getContext("2d")!
    const frame = draw.createImageData(width, height)
    const order = new Float32Array(width * height).map(() => Math.random())
    const start = performance.now()
    const step = (now: number) => {
      const progress = Math.min(1, (now - start) / 1200)
      const settled = 1 - (1 - progress) ** 3
      for (let i = 0; i < order.length; i++) {
        const on = order[i] < settled ? bits[i * 4 + 3] > 0 : Math.random() < 0.34
        frame.data[i * 4] = frame.data[i * 4 + 1] = frame.data[i * 4 + 2] = 170
        frame.data[i * 4 + 3] = on ? 255 : 0
      }
      draw.putImageData(frame, 0, 0)
      if (progress < 1) requestAnimationFrame(step)
      else {
        image.style.opacity = "1"
        canvas.remove()
      }
    }
    requestAnimationFrame(step)
  }
  if (field) {
    if (still) field.style.opacity = "1"
    else if (field.complete) reveal(field)
    else field.addEventListener("load", () => reveal(field), { once: true })
  }
</script>

<style>
  /*
   * The plate hangs from the demo window's top edge: `--cut` is the image row
   * that lands on that edge, `--rise` how far the plate reaches above it. The
   * dome's finial is row 288, its bulb starts near row 336 and the terrace is
   * row 376, so a cut near 358 lets the top of the bulb peek over the window.
   */
  .daniell {
    --dot: 2px;
    --tuck: 2rem;
    --rise: var(--band);
    --cut: 358;
    --shift: 11.5rem;
    position: absolute;
    left: 50%;
    bottom: calc(100% - var(--tuck));
    width: 100vw;
    height: calc(var(--rise) + var(--tuck));
    translate: -50% 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%);
    mask-image: linear-gradient(to bottom, transparent, #000 45%);
  }
  .daniell img, .daniell :global(.field) {
    position: absolute;
    left: calc(50% + var(--shift));
    top: calc(var(--rise) - var(--cut) * var(--dot));
    width: calc(var(--dot) * 960);
    max-width: none;
    height: auto;
    aspect-ratio: 960 / 609;
    translate: -50% 0;
    image-rendering: pixelated;
  }
  .daniell img { opacity: 0; }
  /* Beside a left-aligned headline the whole Taj can stand up the right side; over the text column it keeps to the band. */
  .dome-right {
    --rise: var(--beside);
    --cut: 376;
    --shift: 36rem;
    -webkit-mask-image: linear-gradient(to bottom, transparent calc(100% - var(--tuck) - var(--band)), #000 calc(100% - var(--tuck) - var(--band) / 2)), linear-gradient(to right, transparent var(--clear), #000 calc(var(--clear) + 8rem));
    mask-image: linear-gradient(to bottom, transparent calc(100% - var(--tuck) - var(--band)), #000 calc(100% - var(--tuck) - var(--band) / 2)), linear-gradient(to right, transparent var(--clear), #000 calc(var(--clear) + 8rem));
  }
  @media (max-width: 47.99rem) {
    .daniell, .dome-right {
      --dot: 1px;
      --rise: var(--band);
      --cut: 372;
      --shift: 4.8rem;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%);
      mask-image: linear-gradient(to bottom, transparent, #000 45%);
    }
  }
</style>
