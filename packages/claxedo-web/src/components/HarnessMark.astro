---
import { HARNESS_BRAND_ARTWORK } from "../../../ui/src/components/harness-brand-artwork"

interface Props {
  name: "claude" | "codex" | "cursor" | "pi" | "opencode"
}

const { name } = Astro.props
const artwork = HARNESS_BRAND_ARTWORK[name === "codex" ? "openai" : name]
---

<svg viewBox="0 0 20 20" aria-hidden="true" data-harness-mark={name} set:html={artwork} />

<style>
  svg{width:1em;height:1em;flex:0 0 1em;display:block;fill:currentColor;stroke:none}
</style>
