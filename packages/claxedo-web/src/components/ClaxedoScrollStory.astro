---
import DownloadMenu from "./DownloadMenu.astro"
import ClaxedoAppReplica from "./ClaxedoAppReplica.astro"
import HarnessMark from "./HarnessMark.astro"
import SandboxProviderMark from "./SandboxProviderMark.astro"
import { contact, github } from "../config"
import { routes } from "../content/routes"

const providers = [
  { id: "exe", label: "exe.dev", fields: [{ label: "API Token", secret: true }] },
  { id: "daytona", label: "Daytona", fields: [{ label: "API Key", secret: true }] },
  { id: "modal", label: "Modal", fields: [{ label: "Token ID", secret: true }, { label: "Token Secret", secret: true }] },
  { id: "vercel", label: "Vercel", fields: [{ label: "Access Token", secret: true }, { label: "Team ID" }, { label: "Project ID" }] },
  { id: "cloudflare", label: "Cloudflare", fields: [{ label: "API Token", secret: true }, { label: "Worker URL" }] },
  { id: "box", label: "Box", fields: [{ label: "API Key", secret: true }] },
] as const

---

<section class="story" aria-label="Why Claxedo" data-scroll-story>
  <div class="story-intro">
    <p>One workspace, without the compromises</p>
    <h2>Use the agents you already trust.<br /><span>Change everything around them.</span></h2>
  </div>

  <article id="performance" class="feature" data-story-step="performance">
    <header class="feature-heading">
      <div><span>01</span><h2>Claxedo is faster than T3 Code.</h2></div>
      <div><p><strong>36 wins out of 40 measurements.</strong> Sessions switch 3.47× faster, while Claxedo leaves 6.6× less memory behind.</p><small>Same machine. Packaged builds. Identical frozen sessions. The benchmark is published and repeatable.</small></div>
    </header>
    <div class="feature-canvas benchmark-canvas" aria-label="Claxedo versus T3 Code benchmark results">
      <div class="benchmark-summary">
        <div><span class="claxedo-mark" aria-hidden="true"></span><p><b>Claxedo vs T3 Code</b><small>Published app benchmark · user-flow p95</small></p></div>
        <p><strong>90%</strong><span>of measurements won</span></p>
      </div>
      <div class="benchmark-pitch"><p><strong>3.47×</strong><span>faster session switching</span></p><p><strong>6.6×</strong><span>less retained memory</span></p><p><strong>1.45×</strong><span>faster app startup</span></p></div>
    </div>
  </article>

  <article id="sandboxes" class="feature" data-story-step="sandboxes">
    <header class="feature-heading">
      <div><span>02</span><h2>Your sandbox is a setting, not a platform decision.</h2></div>
      <div><p>Bring the provider you already run. Claxedo prepares the workspace and syncs its skills, MCP servers, plugins, and scoped credentials before the agent starts.</p><small>One provider at a time. Change it whenever you need.</small></div>
    </header>
    <div class="feature-canvas settings-canvas" role="region" aria-label="Claxedo Sandbox Provider settings" data-sandbox-demo data-provider-active="exe">
      <div class="settings-copy"><h3>Sandbox Providers</h3><p>Manage sandbox providers and network access for cloud workspaces.</p></div>
      <section class="settings-section">
        <h4>Provider</h4>
        <div class="settings-row">
          <span><b>Provider</b><small>Cloud workspaces run on one provider at a time.</small></span>
          <div class="provider-select" data-provider-select>
            <button type="button" class="provider-trigger" data-provider-trigger aria-label="Sandbox provider" aria-haspopup="listbox" aria-expanded="false">
              <span class="provider-logo-stack">{providers.map((provider) => <span data-provider-logo={provider.id}><SandboxProviderMark id={provider.id} /></span>)}</span><span data-provider-trigger-label>exe.dev</span><i>⌄</i>
            </button>
            <div class="provider-options" data-provider-options role="listbox" aria-label="Sandbox providers" hidden>
              {providers.map((provider, index) => <button type="button" role="option" aria-selected={index === 0 ? "true" : "false"} data-provider-option={provider.id} data-provider-label={provider.label}><span class="provider-option-logo"><SandboxProviderMark id={provider.id} /></span><span>{provider.label}</span><i>{index === 0 ? "✓" : ""}</i></button>)}
            </div>
          </div>
        </div>
      </section>
      <section class="settings-section">
        <h4>Credentials</h4>
        <div class="credentials-card">
          <div class="credential-title"><span class="provider-logo-stack large">{providers.map((provider) => <span data-provider-logo={provider.id}><SandboxProviderMark id={provider.id} /></span>)}</span><span><b data-provider-name>exe.dev</b><small data-provider-status>Not configured</small></span></div>
          <div class="credential-fields">
            {providers.map((provider, index) => (
              <div class="credential-fieldset" data-driver-fields={provider.id} hidden={index !== 0}>
                {provider.fields.map((field) => <label><span>{field.label}</span><input type={"secret" in field && field.secret ? "password" : "text"} placeholder={field.label} aria-label={field.label} /></label>)}
              </div>
            ))}
          </div>
          <div class="credential-actions"><button type="button" data-save-provider disabled>Save</button><button type="button" class="ghost" data-remove-provider hidden>Remove</button></div>
        </div>
      </section>
      <div class="provider-list" aria-label="Supported sandbox providers">{providers.map((provider) => <span><SandboxProviderMark id={provider.id} /><b>{provider.label}</b></span>)}</div>
    </div>
  </article>

  <article id="chat" class="feature" data-story-step="chat">
    <header class="feature-heading">
      <div><span>03</span><h2>One chat surface. Every harness underneath.</h2></div>
      <div><p>Claude, Codex, Cursor, Pi, and OpenCode use the same focused session surface. Harness, model, and effort are one ordered decision—exactly where you send the prompt.</p><small>No separate “provider dashboard.” No context-moving ceremony.</small></div>
    </header>
    <div class="feature-canvas harness-canvas" role="region" aria-label="Claxedo chat harness and model picker" data-chat-demo data-open-section="model">
      <div class="chat-context" aria-hidden="true"><div class="chat-user">Keep the current app shell and use Codex for the implementation.</div><p>I’ll preserve the Claxedo interaction patterns and work through the real application boundaries.</p><span>▣&nbsp; Read 8 files</span></div>
      <div class="harness-popover" aria-label="Select harness, model and effort">
        <button type="button" class="picker-section" data-picker-section="harness" aria-expanded="false"><i>›</i><b>Harness</b><span data-current-harness>Codex</span></button>
        <div class="picker-panel harness-options" data-picker-panel="harness" hidden>
          <small>Native SDK</small>
          <button type="button" data-harness="Claude"><i><HarnessMark name="claude" /></i><span><b>Claude</b></span><em></em></button>
          <button type="button" data-harness="Codex" class="selected"><i><HarnessMark name="codex" /></i><span><b>Codex</b></span><em>✓</em></button>
          <button type="button" data-harness="Cursor"><i><HarnessMark name="cursor" /></i><span><b>Cursor</b></span><em></em></button>
          <small>Direct</small>
          <button type="button" data-harness="Pi"><i><HarnessMark name="pi" /></i><span><b>Pi</b></span><em></em></button>
          <button type="button" data-harness="OpenCode"><i><HarnessMark name="opencode" /></i><span><b>OpenCode</b></span><em></em></button>
        </div>
        <button type="button" class="picker-section" data-picker-section="model" aria-expanded="true"><i>›</i><b>Model</b><span data-current-model>GPT-5.6-Luna</span></button>
        <div class="picker-panel model-options" data-picker-panel="model">
          <label><span>⌕</span><input type="search" placeholder="Search models" aria-label="Search models" /></label>
          <small>Codex App Server · configured</small>
          <button type="button" data-model="GPT-5.5"><span><b>GPT-5.5</b><small>Frontier model for complex coding and research.</small></span><em></em></button>
          <button type="button" data-model="GPT-5.6-Luna" class="selected"><span><b>GPT-5.6-Luna</b><small>Fast and affordable agentic coding model.</small></span><em>✓</em></button>
          <button type="button" data-model="GPT-5.6-Sol"><span><b>GPT-5.6-Sol</b><small>Latest frontier agentic coding model.</small></span><em></em></button>
          <button type="button" data-model="GPT-5.6-Terra"><span><b>GPT-5.6-Terra</b><small>Balanced agentic coding model for everyday work.</small></span><em></em></button>
        </div>
        <button type="button" class="picker-section" data-picker-section="effort" aria-expanded="false"><i>›</i><b>Effort</b><span data-current-effort>Low</span></button>
        <div class="picker-panel effort-options" data-picker-panel="effort" hidden>
          {(["Low", "Medium", "High", "Xhigh", "Max", "Ultra"] as const).map((effort, index) => <button type="button" data-effort={effort} class:list={[{ selected: index === 0 }]}><span>{effort}</span><em>{index === 0 ? "✓" : ""}</em></button>)}
        </div>
      </div>
      <div class="composer-crop"><span>Ask anything, / for commands, @ for context...</span><div><button type="button">＋</button><button type="button">Workspace write</button><i></i><button type="button" data-composer-picker><span class="composer-harness-mark"><HarnessMark name="codex" /></span> <b data-composer-model>GPT-5.6-Luna</b> <small data-composer-effort>Low</small>⌄</button><button type="button" class="send">↑</button></div></div>
    </div>
  </article>

  <article id="terminal" class="feature" data-story-step="terminal">
    <header class="feature-heading">
      <div><span>04</span><h2>Prefer the real CLI? Keep the real CLI.</h2></div>
      <div><p>Claude Code and Codex remain real terminal processes, side by side inside the same workbench. The sidebar, compact tabs, session status, and account controls are the same Claxedo you use everywhere else.</p><small>Drag the divider. Hide the sidebar. Open the workspace menu.</small></div>
    </header>
    <div class="terminal-replica"><ClaxedoAppReplica canvasOnly initialSurface="terminal" /></div>
  </article>

  <article id="control-plane" class="feature" data-story-step="control-plane">
    <header class="feature-heading">
      <div><span>05</span><h2>Deploy once. Put every workspace within reach.</h2></div>
      <div><p>A $5 Cloudflare Worker becomes the remote control plane for your team. Enroll machines once, reach every project from anywhere, and keep the agents running where the code lives.</p><small>Remote control today. Multiplayer next.</small></div>
    </header>
    <div class="feature-canvas deploy-canvas" role="region" aria-label="Deploy Claxedo control plane" data-deploy-demo data-state="ready">
      <div class="deploy-grid" aria-hidden="true"></div>
      <div class="cloud-node"><span class="claxedo-mark"></span><b>Claxedo Worker</b><small>Cloudflare · $5 / month</small><i data-deploy-status>Ready to deploy</i></div>
      <div class="machine machine-one"><i>▣</i><span><b>Yash’s Mac</b><small>3 workspaces</small></span></div>
      <div class="machine machine-two"><i>▣</i><span><b>Build machine</b><small>12 workspaces</small></span></div>
      <div class="machine machine-three"><i>□</i><span><b>Phone</b><small>Remote control</small></span></div>
      <svg class="deploy-lines" viewBox="0 0 1000 520" preserveAspectRatio="none" aria-hidden="true"><path d="M500 260C380 260 355 130 218 130"/><path d="M500 260C620 260 645 130 782 130"/><path d="M500 260C500 360 500 390 500 430"/></svg>
      <button type="button" class="deploy-button" data-deploy-button><span data-deploy-button-label>Deploy control plane</span><small>One command · your Cloudflare account</small></button>
      <div class="deployed-message"><i>✓</i><span><b>Control plane online</b><small>3 devices · 15 workspaces reachable</small></span></div>
    </div>
  </article>

  <section class="faq" aria-labelledby="faq-title">
    <div class="faq-heading"><span>FAQ</span><h2 id="faq-title">The practical questions.</h2></div>
    <div class="faq-list">
      <details open><summary>Does Claxedo replace Claude Code, Codex, or OpenCode?<span>＋</span></summary><p>No. Claxedo is the workspace around them. You keep the real harness, model access, terminal process, and session history.</p></details>
      <details><summary>Can I use my own sandbox provider?<span>＋</span></summary><p>Yes. Configure any supported provider once and Claxedo syncs the skills, MCP servers, plugins, and scoped credentials that workspace needs.</p></details>
      <details><summary>Do chat and terminal sessions stay in sync?<span>＋</span></summary><p>They are first-class views of the same workspace. Switch sessions or tabs without losing the transcript, draft, tools, or terminal process.</p></details>
      <details><summary>What does the $5 Cloudflare deployment run?<span>＋</span></summary><p>It runs the remote control plane for your team. Your agents and code remain on the machines or sandboxes you choose.</p></details>
      <details><summary>Is multiplayer available now?<span>＋</span></summary><p>Remote control is available first. Shared multiplayer sessions are the next collaboration layer.</p></details>
    </div>
  </section>

  <footer class="closing">
    <div><span class="brand-mark"></span><h2>Every agent. Any sandbox.<br />One workspace.</h2></div>
    <div><DownloadMenu placement="closing" /><a href={github}>GitHub ↗</a></div>
    <p><span>© {new Date().getFullYear()} Claxedo</span><span><a href={contact}>Discord</a><a href={routes.privacy}>Privacy</a><a href={routes.terms}>Terms</a></span></p>
  </footer>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-sandbox-demo]")) {
    const trigger = root.querySelector<HTMLButtonElement>("[data-provider-trigger]")
    const options = root.querySelector<HTMLElement>("[data-provider-options]")
    const setOpen = (open: boolean) => {
      if (options) options.hidden = !open
      trigger?.setAttribute("aria-expanded", String(open))
    }
    const update = (id: string, label: string) => {
      root.querySelectorAll<HTMLElement>("[data-driver-fields]").forEach((item) => item.hidden = item.dataset.driverFields !== id)
      root.querySelectorAll<HTMLElement>("[data-provider-name]").forEach((item) => item.textContent = label)
      root.dataset.providerActive = id
      const triggerLabel = root.querySelector<HTMLElement>("[data-provider-trigger-label]")
      if (triggerLabel) triggerLabel.textContent = label
      root.querySelectorAll<HTMLButtonElement>("[data-provider-option]").forEach((item) => {
        const selected = item.dataset.providerOption === id
        item.setAttribute("aria-selected", String(selected))
        const mark = item.querySelector("i")
        if (mark) mark.textContent = selected ? "✓" : ""
      })
      const save = root.querySelector<HTMLButtonElement>("[data-save-provider]")
      if (save) save.disabled = true
    }
    trigger?.addEventListener("click", () => setOpen(trigger.getAttribute("aria-expanded") !== "true"))
    root.querySelectorAll<HTMLButtonElement>("[data-provider-option]").forEach((option) => option.addEventListener("click", () => {
      update(option.dataset.providerOption ?? "exe", option.dataset.providerLabel ?? "exe.dev")
      setOpen(false)
      trigger?.focus()
    }))
    root.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return
      setOpen(false)
      trigger?.focus()
    })
    root.querySelectorAll<HTMLInputElement>("input").forEach((input) => input.addEventListener("input", () => {
      const visible = root.querySelector<HTMLElement>("[data-driver-fields]:not([hidden])")
      const fields = [...(visible?.querySelectorAll<HTMLInputElement>("input") ?? [])]
      const save = root.querySelector<HTMLButtonElement>("[data-save-provider]")
      if (save) save.disabled = !fields.length || fields.some((field) => !field.value.trim())
    }))
    root.querySelector<HTMLButtonElement>("[data-save-provider]")?.addEventListener("click", () => {
      const status = root.querySelector<HTMLElement>("[data-provider-status]")
      const remove = root.querySelector<HTMLButtonElement>("[data-remove-provider]")
      if (status) status.textContent = "Credentials configured"
      if (remove) remove.hidden = false
    })
    root.querySelector<HTMLButtonElement>("[data-remove-provider]")?.addEventListener("click", () => {
      root.querySelectorAll<HTMLInputElement>("input").forEach((input) => input.value = "")
      const status = root.querySelector<HTMLElement>("[data-provider-status]")
      const remove = root.querySelector<HTMLButtonElement>("[data-remove-provider]")
      if (status) status.textContent = "Not configured"
      if (remove) remove.hidden = true
    })
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-chat-demo]")) {
    const openSection = (section: string) => {
      root.dataset.openSection = section
      root.querySelectorAll<HTMLButtonElement>("[data-picker-section]").forEach((button) => button.setAttribute("aria-expanded", String(button.dataset.pickerSection === section)))
      root.querySelectorAll<HTMLElement>("[data-picker-panel]").forEach((panel) => panel.hidden = panel.dataset.pickerPanel !== section)
    }
    root.querySelectorAll<HTMLButtonElement>("[data-picker-section]").forEach((button) => button.addEventListener("click", () => openSection(button.dataset.pickerSection ?? "model")))
    root.querySelectorAll<HTMLButtonElement>("[data-harness]").forEach((button) => button.addEventListener("click", () => {
      root.querySelectorAll<HTMLButtonElement>("[data-harness]").forEach((item) => { const selected = item === button; item.classList.toggle("selected", selected); const mark = item.querySelector("em"); if (mark) mark.textContent = selected ? "✓" : "" })
      const label = button.dataset.harness ?? "Claude"
      const current = root.querySelector<HTMLElement>("[data-current-harness]")
      if (current) current.textContent = label
      openSection("model")
    }))
    root.querySelectorAll<HTMLButtonElement>("[data-model]").forEach((button) => button.addEventListener("click", () => {
      root.querySelectorAll<HTMLButtonElement>("[data-model]").forEach((item) => { const selected = item === button; item.classList.toggle("selected", selected); const mark = item.querySelector("em"); if (mark) mark.textContent = selected ? "✓" : "" })
      const label = button.dataset.model ?? "Default"
      root.querySelectorAll<HTMLElement>("[data-current-model], [data-composer-model]").forEach((item) => item.textContent = label)
    }))
    root.querySelectorAll<HTMLButtonElement>("[data-effort]").forEach((button) => button.addEventListener("click", () => {
      root.querySelectorAll<HTMLButtonElement>("[data-effort]").forEach((item) => { const selected = item === button; item.classList.toggle("selected", selected); const mark = item.querySelector("em"); if (mark) mark.textContent = selected ? "✓" : "" })
      const label = button.dataset.effort ?? "Low"
      root.querySelectorAll<HTMLElement>("[data-current-effort], [data-composer-effort]").forEach((item) => item.textContent = label)
    }))
    root.querySelector<HTMLButtonElement>("[data-composer-picker]")?.addEventListener("click", () => openSection("model"))
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-deploy-demo]")) {
    root.querySelector<HTMLButtonElement>("[data-deploy-button]")?.addEventListener("click", () => {
      if (root.dataset.state !== "ready") return
      root.dataset.state = "deploying"
      const label = root.querySelector<HTMLElement>("[data-deploy-button-label]")
      const status = root.querySelector<HTMLElement>("[data-deploy-status]")
      if (label) label.textContent = "Deploying…"
      if (status) status.textContent = "Provisioning Worker"
      window.setTimeout(() => {
        root.dataset.state = "online"
        if (status) status.textContent = "Online · encrypted relay"
      }, 900)
    })
  }
</script>

<style>
  .story{--app-bg:#101010;--app-title:#121212;--app-surface:rgba(255,255,255,.031);--app-raised:rgba(255,255,255,.059);--app-hover:rgba(255,255,255,.078);--app-strong:rgba(255,255,255,.936);--app-text:rgba(255,255,255,.618);--app-weak:rgba(255,255,255,.422);--app-weaker:rgba(255,255,255,.284);--app-border:#282828;--app-peach:#fab283;background:#101010;color:var(--app-strong);padding-top:clamp(4.5rem,10vw,9rem)}
  .story-intro,.feature,.closing{width:min(calc(100% - 2 * var(--gutter)),78rem);margin-inline:auto}.story-intro{padding-bottom:clamp(7rem,15vw,13rem)}.story-intro>p{margin:0 0 1.5rem;color:var(--app-weaker);font:500 .65rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase}.story-intro h2{max-width:23ch;margin:0;color:var(--app-strong);font:450 clamp(2.6rem,5.8vw,5.4rem)/1.04 var(--font-sans);letter-spacing:-.06em}.story-intro h2 span{color:var(--app-weak)}
  .feature{padding:clamp(5rem,11vw,9.5rem) 0;border-top:1px solid var(--app-border);scroll-margin-top:4rem}.feature-heading{display:grid;grid-template-columns:minmax(0,.9fr) minmax(20rem,1.1fr);gap:clamp(3rem,10vw,11rem);align-items:start;margin:0 1.5rem clamp(3rem,6vw,5rem)}.feature-heading>div:first-child{display:grid;grid-template-columns:2rem 1fr;gap:1rem}.feature-heading>div:first-child>span{padding-top:.7rem;color:var(--app-weaker);font:.63rem var(--font-mono)}.feature-heading h2{max-width:15ch;margin:0;color:var(--app-strong);font:450 clamp(2rem,4vw,3.7rem)/1.03 var(--font-sans);letter-spacing:-.05em}.feature-heading p{max-width:38rem;margin:0 0 1.2rem;color:var(--app-text);font-size:clamp(1rem,1.55vw,1.2rem);line-height:1.55}.feature-heading p strong{color:var(--app-strong);font-weight:500}.feature-heading small{display:block;color:var(--app-weak);font:.72rem/1.6 var(--font-mono)}
  .feature-canvas{position:relative;min-height:32rem;border-top:1px solid var(--app-border);border-bottom:1px solid var(--app-border);background:#0d0d0d;overflow:hidden}.feature-canvas button,.feature-canvas input,.feature-canvas select{font:inherit}
