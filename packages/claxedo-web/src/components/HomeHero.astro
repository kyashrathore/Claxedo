---
import ClaxedoAppReplica from "./ClaxedoAppReplica.astro"
import TajPlate from "./TajPlate.astro"
import { routes } from "../content/routes"

interface Props {
  title: string
  subtitle: string
  align?: "center" | "left"
}

const { title, subtitle, align = "center" } = Astro.props
---

<section class:list={["hero", align]}>
  <div class="intro">
    <h1>{title}</h1>
    <p class="lede">{subtitle}</p>
    <a class="quiet-link" href={routes.app}>Open in browser</a>
  </div>
  <div class="stage">
    <TajPlate dome={align === "left" ? "right" : "center"} />
    <div class="window"><ClaxedoAppReplica /></div>
  </div>
</section>

<style>
  .hero { --window-h: clamp(30rem, 48vw, 44rem); --band: 3rem; --beside: 24rem; --clear: calc(var(--edge) + 50rem); position: relative; isolation: isolate; padding-top: clamp(2rem, 3.5vw, 2.5rem); }
  .intro { display: grid; justify-items: center; gap: 0; width: var(--width); margin-inline: auto; text-align: center; }
  h1 { max-width: 12em; margin: 0; font-size: clamp(2.5rem, 4.4vw, 4rem); line-height: 1.06; letter-spacing: -.025em; }
  .lede { max-width: 34rem; margin: 1rem 0 1.25rem; color: #3a3a3a; font-size: 1.25rem; line-height: 1.45; text-wrap: balance; }
  .intro .quiet-link { color: #3a3a3a; font-size: 1rem; }
  .left .intro { justify-items: start; text-align: left; }
  .left .lede { text-wrap: pretty; }

  .stage { position: relative; width: min(100% - 2 * var(--edge), 72rem); margin: var(--band) auto 0; }
  .window { position: relative; z-index: 1; height: var(--window-h); }

  @media (prefers-reduced-motion: no-preference) {
    .intro, .stage { animation: rise .8s cubic-bezier(.2, .7, .2, 1) both; }
    .stage { animation-delay: .12s; }
    @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  }
  @media (max-width: 47.99rem) {
    .lede { font-size: 1.125rem; }
    .hero { --window-h: 32rem; }
  }
</style>
