---
import ClaxedoAppReplica from "./ClaxedoAppReplica.astro"
import TajPlate from "./TajPlate.astro"

interface Props {
  title: string
  subtitle: string
}

const { title, subtitle } = Astro.props
---

<section class="hero">
  <TajPlate />
  <div class="intro">
    <h1>{title}</h1>
    <p class="lede">{subtitle}</p>
  </div>
  <div class="stage">
    <div class="window"><ClaxedoAppReplica /></div>
  </div>
</section>

<style>
  /*
   * The plate is laid out against the hero's box, as it was under the centred
   * headline, pill and link: the intro keeps that block's height so the plate
   * and the window stay where they were.
   */
  .hero { --window-h: clamp(30rem, 48vw, 44rem); --h1: clamp(2.5rem, 4.4vw, 4rem); position: relative; isolation: isolate; padding-top: clamp(2rem, 3.5vw, 2.5rem); }
  .hero > :global(.backdrop) { position: absolute; inset: 0 0 calc(var(--window-h) * .55); z-index: -1; }
  .intro { display: grid; align-content: start; justify-items: start; width: var(--width); min-height: calc(var(--h1) * 1.06 + 11.25rem); margin-inline: auto; }
  h1 { max-width: 12em; margin: 0; font-size: var(--h1); line-height: 1.06; letter-spacing: -.025em; }
  .lede { max-width: 34rem; margin: 1rem 0 0; color: #3a3a3a; font-size: 1.25rem; line-height: 1.45; text-wrap: pretty; }

  .stage { position: relative; width: var(--width); margin: clamp(8rem, 12vw, 11rem) auto 0; }
  .window { position: relative; z-index: 1; height: var(--window-h); }

  @media (prefers-reduced-motion: no-preference) {
    .intro, .stage { animation: rise .8s cubic-bezier(.2, .7, .2, 1) both; }
    .stage { animation-delay: .12s; }
    @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  }
  @media (max-width: 47.99rem) {
    .lede { font-size: 1.125rem; }
    .hero { --window-h: 32rem; }
    .intro { min-height: calc(var(--h1) * 1.06 * 2 + 10.85rem); }
  }
</style>
