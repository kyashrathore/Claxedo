---
import ClaxedoAppReplica from "./ClaxedoAppReplica.astro"
import MacDownload from "./MacDownload.astro"
import TajPlate from "./TajPlate.astro"
import { routes } from "../content/routes"

interface Props {
  title: string
  subtitle: string
}

const { title, subtitle } = Astro.props
---

<section class="hero">
  <div class="intro">
    <h1>{title}</h1>
    <p class="lede">{subtitle}</p>
    <MacDownload placement="hero" />
    <a class="quiet-link" href={routes.app}>Open in browser</a>
  </div>
  <div class="stage">
    <TajPlate />
    <div class="window"><ClaxedoAppReplica /></div>
  </div>
</section>

<style>
  .hero { --window-h: clamp(30rem, 48vw, 44rem); --stage-gap: 11rem; padding-top: 1.75rem; }
  .intro { display: grid; justify-items: center; gap: 0; width: var(--width); margin-inline: auto; text-align: center; }
  h1 { max-width: 12em; margin: 0; font-size: clamp(2.5rem, 4.4vw, 4rem); line-height: 1.06; letter-spacing: -.025em; }
  .lede { max-width: 34rem; margin: .75rem 0 1.5rem; color: #3a3a3a; font-size: 1.25rem; line-height: 1.45; text-wrap: balance; }
  .intro .quiet-link { margin-top: .5rem; color: #3a3a3a; font-size: .875rem; }

  .stage { position: relative; width: min(100% - 2 * var(--edge), 72rem); margin: var(--stage-gap) auto 0; }
  .window { position: relative; z-index: 1; height: var(--window-h); }

  @media (prefers-reduced-motion: no-preference) {
    .intro, .window { animation: rise .8s cubic-bezier(.2, .7, .2, 1) both; }
    .window { animation-delay: .12s; }
    @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  }
  @media (max-width: 47.99rem) {
    .lede { font-size: 1.125rem; }
    .hero { --window-h: 32rem; --stage-gap: 5rem; }
  }
</style>
