---
import { github } from "../config"
import { commercialNavigation } from "../content/site"

interface Props {
  active?: "home" | "pricing" | "download" | "compare" | "framework"
}

const { active } = Astro.props
---

<nav class="nav" aria-label="Primary" data-open="false">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Claxedo home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>Claxedo</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">Menu</button>

    <div class="nav-menu" id="site-menu">
      <div class="nav-links">
        {commercialNavigation.map((item) => (
          <a href={item.href} aria-current={active === item.key ? "page" : undefined}>{item.label}</a>
        ))}
      </div>

      <div class="nav-actions">
        <a class="nav-github" href={github} aria-label="Claxedo on GitHub" target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>(".nav")
  const toggle = nav?.querySelector<HTMLButtonElement>(".menu-toggle")

  toggle?.addEventListener("click", () => {
    const open = nav?.dataset.open !== "true"
    if (nav) nav.dataset.open = String(open)
    toggle.setAttribute("aria-expanded", String(open))
  })

  const close = () => {
    if (!nav || !toggle) return
    nav.dataset.open = "false"
    toggle.setAttribute("aria-expanded", "false")
  }

  nav?.querySelectorAll<HTMLElement>("a, button[data-copy-deployment-prompt]").forEach((item) => item.addEventListener("click", close))
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || nav?.dataset.open !== "true") return
    close()
    toggle?.focus()
  })
</script>
