---
import DownloadMenu from "./DownloadMenu.astro"
import { github } from "../config"
import { marketingActions } from "../content/routes"
import { commercialNavigation } from "../content/site"

interface Props {
  active?: "home" | "pricing" | "download" | "compare" | "framework"
}

const { active } = Astro.props
---

<nav class="nav" aria-label="Primary" data-open="false">
  <a href="/" class="nav-logo" aria-label="Claxedo home">
    <span class="brand-mark" aria-hidden="true"></span>
    <span>Claxedo</span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">Menu</button>

  <div class="nav-links" id="site-menu">
    {commercialNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href="/compare" aria-current={active === "compare" ? "page" : undefined}>Compare</a>
    <a href={github}>GitHub</a>
  </div>

  <div class="nav-actions">
    <a
      class="btn-secondary"
      href={marketingActions.framework.href}
      data-analytics-event={marketingActions.framework.event}
      data-analytics-placement="header"
    >Open-source framework</a>
    <DownloadMenu placement="header" />
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>(".nav")
  const toggle = nav?.querySelector<HTMLButtonElement>(".menu-toggle")

  toggle?.addEventListener("click", () => {
    const open = nav?.dataset.open !== "true"
    if (nav) nav.dataset.open = String(open)
    toggle.setAttribute("aria-expanded", String(open))
  })
</script>
