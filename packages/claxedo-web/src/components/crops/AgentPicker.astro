---
import HarnessMark from "../HarnessMark.astro"
import Icon from "../Icon.astro"
import "../../styles/app-theme.css"

const agents = [
  { mark: "claude", name: "Claude Code", model: "Opus 5" },
  { mark: "codex", name: "Codex", model: "GPT-5.6-Sol", selected: true },
  { mark: "cursor", name: "Cursor", model: "Composer 1" },
  { mark: "opencode", name: "OpenCode", model: "GPT-5.4" },
  { mark: "pi", name: "Pi", model: "Sonnet 5" },
] as const
const models = ["GPT-5.5", "GPT-5.6-Luna", "GPT-5.6-Sol", "GPT-5.6-Terra"]
const efforts = ["Low", "Medium", "High", "Max"]
---

<div class="picker app-theme" role="img" aria-label="The agent picker: Claude Code, Codex, Cursor, OpenCode and Pi, each with its model and effort">
  <div class="app-card agents">
    <p class="head">Agent</p>
    {agents.map((agent) => (
      <div class:list={["row", { selected: "selected" in agent }]}>
        <span class="mark"><HarnessMark name={agent.mark} /></span>
        <b>{agent.name}</b>
        <small>{agent.model}</small>
        <Icon name="chevron-right" />
      </div>
    ))}
  </div>
  <div class="app-card models">
    <p class="head">Codex model</p>
    {models.map((model) => (
      <div class:list={["row", { selected: model === "GPT-5.6-Sol" }]}><b>{model}</b>{model === "GPT-5.6-Sol" && <Icon name="check" />}</div>
    ))}
    <p class="head effort-head">Effort</p>
    <div class="efforts">{efforts.map((effort) => <span class:list={{ selected: effort === "High" }}>{effort}</span>)}</div>
  </div>
</div>

<style>
  .picker { position: relative; width: 100%; height: 100%; }
  .agents { position: absolute; top: 0; left: 0; width: min(100%, 22rem); padding: 6px; }
  .models { position: absolute; top: 22%; left: min(62%, 19.5rem); width: 14.5rem; padding: 6px; }
  .head { margin: 0; padding: 8px 10px 6px; color: var(--text-weak); font-size: 12px; }
  .row { display: flex; align-items: center; gap: 12px; min-height: 40px; padding: 0 10px; border-radius: 8px; color: var(--text-weaker); }
  .row.selected { background: var(--surface-base-hover); }
  .row b { flex: 1; color: var(--text-strong); font-weight: 400; font-size: 14px; }
  .row small { color: var(--text-weak); font-size: 12.5px; }
  .models .row { min-height: 34px; }
  .models .row :global(svg) { color: var(--text-strong); }
  .mark { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; background: var(--surface-base-hover); color: var(--text-strong); font-size: 14px; }
  .effort-head { margin-top: 4px; border-top: 1px solid var(--border); padding-top: 10px; }
  .efforts { display: flex; gap: 4px; padding: 0 6px 8px; }
  .efforts span { flex: 1; padding: 5px 0; border-radius: 6px; color: var(--text-weak); font-size: 12px; text-align: center; }
  .efforts .selected { background: var(--send-bg); color: var(--send-ink); }
</style>
