---
import Icon from "../Icon.astro"
import { standup } from "../demo-content"
import "../../styles/app-theme.css"

const [project] = standup
const rows = [
  ["Yesterday", project.yesterday[0].text],
  ["Today", project.today[0].text],
  ["Blocked", project.blocked[0].text],
] as const
---

<div class="app-card standup-card app-theme" role="img" aria-label="Standup, an app plugin Claude Code built from one prompt and you turned on">
  <p class="kind"><Icon name="document-text" />App plugin</p>
  <b class="title">Standup</b>
  <p class="by">Built by Claude Code from one prompt</p>
  {rows.map(([label, text]) => <div class="row"><span>{label}</span><p>{text}</p></div>)}
  <p class="on"><Icon name="check" />Turned on by you</p>
</div>

<style>
  .standup-card { width: 20.5rem; padding: 16px 18px 14px; }
  .kind { display: flex; align-items: center; gap: 6px; margin: 0 0 8px; color: var(--text-weak); font-size: 12px; }
  .title { display: block; font-size: 20px; font-weight: 400; letter-spacing: -.01em; }
  .by { margin: 2px 0 12px; color: var(--text-weak); font-size: 12.5px; }
  .row { display: grid; grid-template-columns: 4.75rem 1fr; gap: 10px; padding: 9px 0; border-top: 1px solid var(--border); }
  .row span { color: var(--text-weak); font-size: 12px; }
  .row p { margin: 0; color: var(--text-base); font-size: 12.5px; line-height: 1.45; }
  .on { display: flex; align-items: center; gap: 6px; margin: 0; padding-top: 10px; border-top: 1px solid var(--border); color: var(--success); font-size: 12px; }
</style>
