---
import "../../styles/app-theme.css"

const account = ["Usage", "Organization", "Connections", "Machines"]
const app = ["Language", "Appearance", "Notifications", "Keybindings"]
const members = [
  { initial: "M", name: "Maya Chen", you: true, role: "Owner", tint: "#d9e4ec" },
  { initial: "D", name: "Dev Patel", role: "Admin", tint: "#e7e0f1" },
  { initial: "S", name: "Sam Okafor", role: "Member", tint: "#e2eee3" },
  { initial: "L", name: "Lena Brandt", role: "Member", tint: "#f3e6dc" },
]
---

<div class="org app-theme" role="img" aria-label="Your team in a self-hosted Claxedo: four teammates with their roles, and an invite button">
  <div class="app-card settings">
    <nav>
      {account.map((item) => <span class:list={{ active: item === "Organization" }}>{item}</span>)}
      <i></i>
      {app.map((item) => <span>{item}</span>)}
    </nav>
    <div class="pane">
      <header><b class="title">Organization</b><span class="invite">Invite teammates</span></header>
      <p>Everyone on your team, one workspace.</p>
      <div class="members">
        {members.map((member) => (
          <div class="member">
            <span class="avatar" style={`background:${member.tint}`}>{member.initial}</span>
            <b>{member.name}</b>
            <small>{"you" in member ? "You" : ""}</small>
            <em>{member.role}</em>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .org { position: relative; width: 100%; height: 100%; }
  .settings { position: absolute; top: 0; left: 0; width: 30rem; display: grid; grid-template-columns: 8.5rem 1fr; overflow: hidden; }
  nav { display: grid; align-content: start; gap: 2px; padding: 12px 8px; background: var(--rail-bg); border-right: 1px solid var(--border); }
  nav span { padding: 6px 10px; border-radius: 6px; color: var(--text-base); }
  nav .active { background: var(--surface-raised); color: var(--text-strong); }
  nav i { height: 1px; margin: 6px 10px; background: var(--border); }
  .pane { padding: 18px 18px 20px; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .title { font-size: 18px; font-weight: 500; }
  .invite { padding: 5px 11px; border-radius: 7px; background: var(--send-bg); color: var(--send-ink); font-size: 12px; }
  .pane p { margin: 4px 0 14px; color: var(--text-weak); font-size: 12.5px; }
  .members { display: grid; border-radius: 10px; box-shadow: 0 0 0 1px var(--border); }
  .member { display: flex; align-items: center; gap: 10px; padding: 9px 12px; }
  .member + .member { border-top: 1px solid var(--border); }
  .avatar { display: grid; place-items: center; width: 24px; height: 24px; flex: none; border-radius: 50%; color: #3b4a5a; font-size: 12px; }
  .member b { font-weight: 400; }
  .member small { flex: 1; color: var(--text-weaker); font-size: 12px; }
  .member em { padding: 2px 8px; border-radius: 999px; background: var(--surface-base-hover); color: var(--text-base); font-size: 11.5px; font-style: normal; }
</style>
