---
import Icon from "../Icon.astro"
import "../../styles/app-theme.css"

const rows = [
  { icon: "folder-add", label: "New Project" },
  { icon: "marketplace", label: "Marketplace" },
  { icon: "checklist", label: "Tasks" },
] as const
---

<div class="app-card rail app-theme" role="img" aria-label="The app's sidebar with a new Standup item under New Project, Marketplace and Tasks">
  {rows.map((row) => <p class="row"><Icon name={row.icon} />{row.label}</p>)}
  <p class="row added"><Icon name="document-text" />Standup<span class="tag">New</span></p>
  <p class="label">Projects</p>
  <p class="row"><Icon name="folder" />Claxedo</p>
  <p class="row"><Icon name="folder" />formlink</p>
</div>

<style>
  .rail { width: 100%; padding: 8px; background: var(--rail-bg); }
  .row { display: flex; align-items: center; gap: 10px; margin: 0; padding: 7px 10px; border-radius: 7px; color: var(--text-base); font-size: 13.5px; }
  .row :global(svg) { color: var(--text-weak); }
  .added { background: var(--background-base); color: var(--text-strong); box-shadow: 0 0 0 1px var(--border), 0 4px 14px -6px rgb(15 20 30 / .18); }
  .added :global(svg) { color: var(--text-strong); }
  .tag { margin-left: auto; padding: 1px 7px; border-radius: 999px; background: var(--surface-base-hover); color: var(--text-weak); font-size: 11px; }
  .label { margin: 10px 10px 2px; color: var(--text-weaker); font-size: 11.5px; }
</style>
