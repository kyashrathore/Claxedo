---
import Icon from "../Icon.astro"
import { standup } from "../demo-content"
import "../../styles/app-theme.css"

const [project] = standup
const columns = [["Yesterday", project.yesterday], ["Today", project.today], ["Blocked", project.blocked]] as const
---

<div class="standup app-theme" role="img" aria-label="Standup, a page an agent built as an app plugin: yesterday, today and what's blocked, from this workspace's sessions">
  <div class="app-card page">
    <header>
      <div><b>Standup</b><span>From this workspace's sessions</span></div>
      <small>App plugin</small>
    </header>
    <h3><Icon name="folder" />{project.project}</h3>
    <div class="columns">
      {columns.map(([label, items]) => (
        <section>
          <small>{label}</small>
          {items.map((item) => <p>{item.text}</p>)}
        </section>
      ))}
    </div>
  </div>
</div>

<style>
  .standup { position: relative; width: 100%; height: 100%; }
  .page { position: absolute; top: 0; left: 0; width: 30rem; padding: 18px 18px 22px; }
  header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  header div { display: grid; gap: 2px; }
  header b { font-size: 18px; font-weight: 500; }
  header span { color: var(--text-weak); font-size: 12.5px; }
  header small { padding: 3px 9px; border-radius: 999px; background: var(--surface-base-hover); color: var(--text-weak); font-size: 11px; }
  h3 { display: flex; align-items: center; gap: 8px; margin: 18px 0 10px; font-size: 13px; font-weight: 500; }
  h3 :global(svg) { color: var(--text-weak); }
  .columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  section { display: grid; align-content: start; gap: 8px; }
  section small { color: var(--text-weak); font-size: 11.5px; }
  section p { margin: 0; padding: 8px 10px; border-radius: 8px; background: var(--surface-base-hover); color: var(--text-base); font-size: 12px; line-height: 1.45; }
</style>
