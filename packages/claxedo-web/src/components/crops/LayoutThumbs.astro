---
import HarnessMark from "../HarnessMark.astro"
import "../../styles/app-theme.css"

const sessions = ["Fix usage meter", "Add a Standup page", "Rotate relay tokens", "Draft release notes", "What is this project?"]
const tabs = sessions.slice(0, 3)
---

<div class="thumbs app-theme" role="img" aria-label="The same workspace twice: sessions listed in a sidebar, and the same sessions as tabs across the top">
  <figure>
    <div class="app-card window">
      <div class="bar"><span class="dots"><i></i><i></i><i></i></span></div>
      <div class="body">
        <div class="rail">
          <small>Claxedo</small>
          {sessions.map((title, index) => <span class:list={{ on: index === 0 }}>{title}</span>)}
        </div>
        <div class="chat">
          <b>Fix usage meter</b>
          <p class="ask">The meter undercounts Codex turns.</p>
          <p class="reply"><span class="mark"><HarnessMark name="codex" /></span>Found it. Usage is a running total, so the meter keeps the latest one.</p>
        </div>
      </div>
    </div>
    <figcaption>Sidebar</figcaption>
  </figure>
  <figure>
    <div class="app-card window">
      <div class="bar"><span class="dots"><i></i><i></i><i></i></span>{tabs.map((title, index) => <span class:list={["tab", { on: index === 0 }]}>{title}</span>)}</div>
      <div class="body">
        <div class="chat">
          <b>Fix usage meter</b>
          <p class="ask">The meter undercounts Codex turns.</p>
          <p class="reply"><span class="mark"><HarnessMark name="codex" /></span>Found it. Usage is a running total, so the meter keeps the latest one.</p>
        </div>
      </div>
    </div>
    <figcaption>Tabs</figcaption>
  </figure>
</div>

<style>
  .thumbs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; }
  figure { display: grid; gap: 12px; min-width: 0; margin: 0; }
  figcaption { color: #ffffff; font-size: 14px; text-align: center; text-shadow: 0 1px 12px rgb(8 24 48 / .45); }
  .window { overflow: hidden; font-size: 11.5px; }
  .bar { display: flex; align-items: center; gap: 4px; height: 30px; padding: 0 8px; border-bottom: 1px solid var(--border); background: var(--rail-bg); }
  .dots { display: flex; gap: 4px; margin-right: 6px; }
  .dots i { width: 7px; height: 7px; border-radius: 50%; background: #d8d8da; }
  .tab { min-width: 0; padding: 4px 8px; overflow: hidden; border-radius: 6px; color: var(--text-weak); white-space: nowrap; text-overflow: ellipsis; }
  .tab.on { background: var(--background-base); color: var(--text-strong); box-shadow: 0 0 0 1px var(--border); }
  .body { display: flex; height: 190px; }
  .rail { display: grid; align-content: start; gap: 2px; width: 44%; padding: 8px 6px; border-right: 1px solid var(--border); background: var(--rail-bg); }
  .rail small { padding: 2px 6px 4px; color: var(--text-weaker); font-size: 11px; }
  .rail span { padding: 4px 6px; overflow: hidden; border-radius: 5px; color: var(--text-base); white-space: nowrap; text-overflow: ellipsis; }
  .rail span.on { background: var(--surface-base-hover); color: var(--text-strong); }
  .chat { display: grid; align-content: start; gap: 8px; flex: 1; min-width: 0; padding: 10px 12px; }
  .chat b { font-weight: 500; font-size: 12px; }
  .ask { justify-self: end; max-width: 88%; margin: 0; padding: 6px 9px; border-radius: 9px; background: var(--bubble-bg); color: var(--text-strong); }
  .reply { display: flex; gap: 6px; margin: 0; color: var(--text-base); line-height: 1.45; }
  .mark { flex: none; font-size: 13px; color: var(--text-strong); }
  @media (max-width: 47.99rem) {
    .thumbs { grid-template-columns: 1fr; gap: 10px; }
    .body { height: 124px; }
    .rail span:nth-of-type(n + 4) { display: none; }
    figcaption { display: none; }
  }
</style>
