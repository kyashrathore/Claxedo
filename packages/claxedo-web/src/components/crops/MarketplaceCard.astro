---
import Icon from "../Icon.astro"
import "../../styles/app-theme.css"

const plugins = [
  { mark: "C7", name: "context7", text: "Up-to-date documentation lookup, pulled from source repositories into your agent's context.", action: "Enabled" },
  { mark: "Co", name: "composio", text: "Connect and operate a thousand external apps from your agent.", action: "Add" },
  { mark: "Fd", name: "frontend-design", text: "A skill for building distinctive, production-grade interfaces.", action: "Add" },
]
const facts = [
  ["Status", "Enabled"],
  ["Where", "Local, Cloud"],
  ["Harnesses", "Claude Code, Codex, Cursor, OpenCode"],
]
---

<div class="market app-theme" role="img" aria-label="The Marketplace: context7 is enabled locally and in the cloud for Claude Code, Codex, Cursor and OpenCode">
  <div class="app-card list">
    <label><Icon name="magnifying-glass" /><span>Search plugins</span></label>
    {plugins.map((plugin) => (
      <div class="plugin">
        <i>{plugin.mark}</i>
        <div><b>{plugin.name}</b><p>{plugin.text}</p></div>
        <span class:list={["action", { on: plugin.action === "Enabled" }]}>{plugin.action}</span>
      </div>
    ))}
  </div>
  <div class="app-card facts">
    <b class="title">context7</b>
    {facts.map(([label, value]) => <div class="fact"><span>{label}</span><b>{value}</b></div>)}
    <p class="note"><Icon name="check" />On every machine your team uses</p>
  </div>
</div>

<style>
  .market { position: relative; width: 100%; height: 100%; }
  .list { position: absolute; top: 0; left: 0; width: 25rem; padding: 8px; }
  label { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; padding: 8px 10px; border-radius: 8px; background: var(--surface-base-hover); color: var(--text-weaker); }
  .plugin { display: flex; align-items: flex-start; gap: 12px; padding: 12px 10px; border-bottom: 1px solid var(--border); }
  .plugin:last-child { border-bottom: 0; }
  .plugin i { display: grid; place-items: center; width: 30px; height: 30px; flex: none; border-radius: 8px; background: var(--surface-raised); color: var(--text-base); font-size: 11px; font-style: normal; }
  .plugin div { flex: 1; min-width: 0; }
  .plugin b { font-weight: 500; }
  .plugin p { margin: 2px 0 0; color: var(--text-weak); font-size: 12px; line-height: 1.45; }
  .action { flex: none; padding: 4px 10px; border-radius: 999px; box-shadow: 0 0 0 1px var(--border); color: var(--text-base); font-size: 12px; }
  .action.on { box-shadow: none; background: var(--surface-base-hover); color: var(--success); }
  .facts { position: absolute; top: 46%; left: min(50%, 13rem); width: 16rem; padding: 14px 16px; }
  .title { display: block; margin-bottom: 8px; font-size: 15px; font-weight: 400; }
  .fact { display: grid; grid-template-columns: 5.5rem 1fr; gap: 8px; padding: 7px 0; border-top: 1px solid var(--border); }
  .fact span { color: var(--text-weak); font-size: 12px; }
  .fact b { font-size: 12px; font-weight: 400; }
  .note { display: flex; align-items: center; gap: 6px; margin: 8px 0 0; color: var(--success); font-size: 12px; }
</style>
