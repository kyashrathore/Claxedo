              <label class="file-search"><CodexIcon name="magnifying-glass" /><input type="search" aria-label="Search files" placeholder="Search files..." /></label>
              {['.agents','.artifacts','.claude','.claxedo','.codex','.context','.crabbox','.cursor','.github','.husky','.opencode','.turborepo','.vercel','.vscode','.workspace-runtime','.worktrees','.wrangler','docs','packages'].map((name) => <button type="button" class:list={["repo-row", { changed: name === '.github', active: name === 'docs' }]} data-repo-folder={name} aria-expanded="false"><CodexIcon name="chevron-right" class="repo-chevron" /><CodexIcon name="folder" class="repo-folder" /><b>{name}</b><i></i></button>)}
              <div class="repo-children" data-repo-children hidden><span>README.md</span><span>index.ts</span></div>
              <button type="button" class="show-more">Show 24 more</button>
            </aside>
          </div>
          <div class="panel-view" data-panel-view="files" hidden><label class="file-search"><CodexIcon name="magnifying-glass" /><input type="search" aria-label="Search files" placeholder="Search files" /></label><div class="tree-row"><span><CodexIcon name="chevron-down" /></span><CodexIcon name="folder" /><b>packages</b></div><div class="tree-row indent"><span><CodexIcon name="chevron-down" /></span><CodexIcon name="folder" /><b>claxedo-app</b></div><div class="tree-row indent-2"><span></span><small>TS</small><b>session-selection.ts</b></div><div class="tree-row indent-2"><span></span><small>TSX</small><b>composer.tsx</b></div></div>
          <div class="panel-view" data-panel-view="processes" hidden><div class="process-head">Running processes <span>2</span></div><div class="process-row"><i></i><div><b>bun run dev</b><small>localhost:4321</small></div><button type="button">•••</button></div><div class="process-row"><i></i><div><b>Claxedo daemon</b><small>pid 2593</small></div><button type="button">•••</button></div></div>
