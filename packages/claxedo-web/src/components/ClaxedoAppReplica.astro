---
import HarnessMark from "./HarnessMark.astro"

const sessions = [
  { title: "Fix usage meter", age: "now" },
  { title: "Migrate relay tokens to EdDSA", age: "12m" },
  { title: "Flaky sidebar spec on Windows", age: "1h" },
  { title: "Cut cold start under 1.4s", age: "3h" },
  { title: "Write release notes", age: "1d" },
]

const turn = {
  user: "The usage meter undercounts Codex turns. Yesterday's session shows 41k tokens in the meter and 118k on the OpenAI dashboard. Find where it goes wrong, don't just scale it.",
  opening: "Tracing one usage event from the Codex adapter through to the meter, with yesterday's session replayed from its event log.",
  finding: "Found it. Codex reports usage as a running total for the whole session, and the meter adds every event as if it were a delta. The meter has to keep the latest total, not the sum.",
  result: "Yesterday's session now reads 118,204 tokens against the dashboard's 118k. I added a fixture so this exact shape stays covered.",
}
---

<div
  class="app"
  role="img"
  aria-label="The Claxedo app: a Codex session fixing a usage meter, with the project rail on the left and the composer below the transcript."
>
  <div class="titlebar">
    <div class="titlebar-rail">
      <span class="lights"><i></i><i></i><i></i></span>
      <svg viewBox="0 0 16 16"><rect x="2.25" y="2.75" width="11.5" height="10.5" rx="1.6"></rect><path d="M5.7 2.75v10.5"></path></svg>
    </div>
    <div class="titlebar-main">
      <svg class="phone-only" viewBox="0 0 16 16"><rect x="2.25" y="2.75" width="11.5" height="10.5" rx="1.6"></rect><path d="M5.7 2.75v10.5"></path></svg>
      <b class="phone-only">{sessions[0].title}</b>
      <span class="titlebar-actions">
        <svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"></path></svg>
        <svg viewBox="0 0 16 16"><rect x="2.5" y="2.75" width="11" height="10.5" rx="1.7"></rect><path d="m5 6 2 2-2 2m4 0h2"></path></svg>
        <svg viewBox="0 0 16 16"><rect x="2.25" y="2.75" width="11.5" height="10.5" rx="1.6"></rect><path d="M10.3 2.75v10.5"></path></svg>
      </span>
    </div>
  </div>

  <div class="body">
    <div class="rail">
      <div class="rail-global">
        <span><svg viewBox="0 0 16 16"><path d="m3 4.5 1.5 1.5L7 3.5M3 9.5 4.5 11 7 8.5M9 5h4M9 10h4"></path></svg>Tasks</span>
        <span><svg viewBox="0 0 16 16"><path d="M5 6V4.8A3 3 0 0 1 8 2a3 3 0 0 1 3 2.8V6m-7 0h8l-.5 7h-7z"></path></svg>Marketplace</span>
      </div>
      <div class="rail-projects">
        <small>Projects</small>
        <span class="project"><svg viewBox="0 0 16 16"><path d="M2 5.5h12v7.5H2zM2 5.5l2-2h4l1.2 2"></path></svg>claxedo</span>
        {sessions.map((session, index) => (
          <span class:list={["session", { active: index === 0 }]}><span>{session.title}</span><small>{session.age}</small></span>
        ))}
        <span class="project"><svg viewBox="0 0 16 16"><path d="M2 5.5h12v7.5H2zM2 5.5l2-2h4l1.2 2"></path></svg>formlink</span>
      </div>
      <div class="rail-account"><svg viewBox="0 0 16 16"><path d="M2.5 4h11v7.2h-11zm3 9h5M8 11v2"></path></svg>Not signed in</div>
    </div>

    <div class="chat">
      <div class="transcript">
        <p class="session-title">{sessions[0].title}</p>
        <p class="user">{turn.user}</p>
        <p class="assistant">{turn.opening}</p>
        <p class="tool"><svg viewBox="0 0 16 16"><path d="M4 2.5h5l3 3v8H4zM9 2.5v3h3"></path></svg>Read 9 files</p>
        <p class="tool"><svg viewBox="0 0 16 16"><rect x="2.5" y="3" width="11" height="10" rx="1.5"></rect><path d="m5 6 2 2-2 2m4 0h2"></path></svg>Replayed yesterday's session</p>
        <p class="assistant">{turn.finding}</p>
        <p class="tool"><svg viewBox="0 0 16 16"><rect x="2.5" y="3" width="11" height="10" rx="1.5"></rect><path d="m5 6 2 2-2 2m4 0h2"></path></svg>Ran the meter tests, 42 passed</p>
        <p class="assistant">{turn.result}</p>
      </div>
      <div class="composer">
        <span class="composer-input">Ask anything, / for commands, @ for context…</span>
        <span class="composer-controls">
          <span class="round"><svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"></path></svg></span>
          <span class="permission"><svg viewBox="0 0 16 16"><path d="M8 2 3.5 4v3.5c0 3 1.8 5 4.5 6.5 2.7-1.5 4.5-3.5 4.5-6.5V4z"></path></svg>Permissions</span>
          <span class="harness"><HarnessMark name="codex" />Codex<svg viewBox="0 0 16 16"><path d="m4.5 6.5 3.5 3 3.5-3"></path></svg></span>
          <span class="send"><svg viewBox="0 0 16 16"><path d="M8 12V4m-4 4 4-4 4 4"></path></svg></span>
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  .app {
    --app-bg: #0d0d0d;
    --app-rail: #181818;
    --app-border: #303030;
    --app-row-active: #303030;
    --app-bubble: #212121;
    --app-composer: #212121;
    --app-composer-edge: rgba(255, 255, 255, 0.1);
    --app-strong: #f2f2f2;
    --app-text: #d0d0d0;
    --app-weak: #a3a3a3;
    --app-weaker: #747474;
    --app-send: #f2f2f2;
    --app-send-ink: #0d0d0d;
    --app-edge: rgba(255, 255, 255, 0.12);
    --app-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 38rem;
    border-radius: 12px;
    background: var(--app-bg);
    box-shadow: 0 0 0 1px var(--app-edge), var(--app-shadow);
    color: var(--app-text);
    font: 13px/1.55 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    overflow: hidden;
    user-select: none;
  }

  @media (prefers-color-scheme: light) {
    .app {
      --app-bg: #ffffff;
      --app-rail: #f9f9f9;
      --app-border: #ededed;
      --app-row-active: rgba(26, 28, 31, 0.07);
      --app-bubble: #f3f3f3;
      --app-composer: #ffffff;
      --app-composer-edge: #d8d8d8;
      --app-strong: #1a1c1f;
      --app-text: #4f4f4f;
      --app-weak: #696a6c;
      --app-weaker: #8c8d8f;
      --app-send: #1a1c1f;
      --app-send-ink: #ffffff;
      --app-edge: rgba(0, 0, 0, 0.1);
      --app-shadow: 0 40px 80px -48px rgba(0, 0, 0, 0.25);
    }
  }

  svg { width: 16px; height: 16px; flex: 0 0 16px; fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  p { margin: 0; }

  .titlebar { display: flex; height: 36px; flex: 0 0 36px; border-bottom: 1px solid var(--app-border); color: var(--app-weak); }
  .titlebar-rail { display: flex; align-items: center; gap: 14px; width: 260px; flex: 0 0 260px; padding-left: 14px; border-right: 1px solid var(--app-border); background: var(--app-rail); }
  .lights { display: flex; gap: 8px; }
  .lights i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .titlebar-main { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; padding: 0 12px; }
  .titlebar-main b { min-width: 0; overflow: hidden; color: var(--app-strong); font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
  .titlebar-actions { display: flex; gap: 14px; margin-left: auto; }
  .phone-only { display: none; }

  .body { display: flex; flex: 1; min-height: 0; }
  .rail { display: flex; flex-direction: column; width: 260px; flex: 0 0 260px; overflow: hidden; border-right: 1px solid var(--app-border); background: var(--app-rail); }
  .rail-global { display: grid; gap: 2px; padding: 8px 6px; border-bottom: 1px solid var(--app-border); }
  .rail-global span, .project, .session, .rail-account { display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 10px; border-radius: 6px; white-space: nowrap; }
  .rail-global span { color: var(--app-strong); }
  .rail-global svg, .project svg, .rail-account svg { color: var(--app-weak); }
  .rail-projects { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; flex: 1; gap: 1px; padding: 14px 6px; }
  .rail-projects > small { padding: 0 10px 6px; color: var(--app-weak); font-size: 12px; }
  .project { color: var(--app-strong); font-weight: 500; }
  .session { justify-content: space-between; padding-left: 34px; color: var(--app-strong); }
  .session > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .session small { color: var(--app-weaker); font-size: 11.5px; }
  .session.active { background: var(--app-row-active); }
  .rail-account { margin: 8px 6px; color: var(--app-strong); }

  .chat { position: relative; display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .transcript { display: grid; align-content: start; gap: 14px; width: min(100%, 44rem); margin: 0 auto; padding: 18px 24px 0; }
  .session-title { height: 32px; display: flex; align-items: center; color: var(--app-strong); font-size: 14px; font-weight: 500; }
  .user { justify-self: end; max-width: min(82%, 60ch); padding: 8px 12px; border-radius: 16px; background: var(--app-bubble); color: var(--app-strong); }
  .assistant { color: var(--app-text); text-wrap: pretty; }
  .tool { display: flex; align-items: center; gap: 8px; margin: -4px 0; color: var(--app-weak); }
  .tool svg { color: var(--app-weaker); }

  .chat::after { content: ""; position: absolute; inset: auto 0 0; height: 9rem; background: linear-gradient(transparent, var(--app-bg) 55%); }
  .composer { position: absolute; z-index: 1; left: 50%; bottom: 14px; display: flex; flex-direction: column; gap: 10px; width: min(100% - 32px, 42rem); padding: 14px 12px 10px 16px; border-radius: 20px; background: var(--app-composer); box-shadow: 0 0 0 1px var(--app-composer-edge), 0 8px 24px -12px rgba(0, 0, 0, 0.3); transform: translateX(-50%); }
  .composer-input { color: var(--app-weaker); }
  .composer-controls { display: flex; align-items: center; gap: 12px; color: var(--app-weak); }
  .round, .send { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; }
  .round { margin-left: -6px; }
  .permission, .harness { display: flex; align-items: center; gap: 6px; }
  .harness { margin-left: auto; color: var(--app-strong); }
  .harness svg:last-child { width: 14px; height: 14px; flex-basis: 14px; color: var(--app-weak); }
  .send { background: var(--app-send); color: var(--app-send-ink); }

  @media (max-width: 47.99rem) {
    .app { height: 34rem; }
    .titlebar-rail, .rail { display: none; }
    .phone-only { display: block; }
    .transcript { padding: 12px 16px 0; }
    .session-title { display: none; }
    .user { max-width: 90%; }
    .permission { display: none; }
  }
</style>
