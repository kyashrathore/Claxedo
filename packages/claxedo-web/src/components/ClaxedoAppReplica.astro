---
import HarnessMark from "./HarnessMark.astro"

export interface ReplicaSession { id: string; title: string; user: string; responses: readonly string[]; tools: readonly string[]; context: string; branch: string; surface?: "chat" | "terminal"; harness?: "codex" | "claude" | "cursor" | "pi" | "opencode" }
interface Props { canvasOnly?: boolean; initialSurface?: "chat" | "terminal"; sessions?: readonly ReplicaSession[] }
const { canvasOnly = false, initialSurface = "chat", sessions } = Astro.props

const demoSessions = [
  { id: "sandbox-provider-flag", title: "I need to test cloud sandbox usage thing...", user: "I need to test cloud sandbox usage thing works or not.\n\ncurrently setting sandbox provider is behind flag but still sees option to select local/cloud in session composer. lets first fix that", responses: ["I’ll trace the sandbox-provider flag from configuration through the session composer, identify why the provider selector is still rendered, then patch the canonical visibility logic and run focused checks.", "The selector is currently governed only by platform and transport. The recent UI flag hides the Settings section, while the default config hard-codes sandbox enabled, so that flag cannot affect the composer.", "I’m checking the intended config contract before wiring the visibility gate."], tools: ["Worked for 2m 48s", "Read 14 files", "Tracing sandbox-provider visibility"], context: "packages/claxedo-app", branch: "fix/sandbox-provider-flag" },
  { id: "sandbox-usage-limits", title: "usage limit is not working", user: "Show the active sandbox quota before starting a cloud workspace and keep provider errors actionable.", responses: ["I’m tracing the workspace creation boundary so quota comes from the selected provider instead of a UI estimate.", "The provider response already carries the canonical limit. I’ll surface it in the create flow and preserve the original error when the provider rejects a workspace.", "The settings and launch paths now read the same provider state. I’m verifying Daytona and Cloudflare independently."], tools: ["Worked for 1m 36s", "Changed 4 files", "Running provider contract tests"], context: "packages/claxedo-app", branch: "fix/sandbox-limits" },
  { id: "new-session", title: "New Session", user: "Start a fresh implementation session in this workspace.", responses: ["What would you like to work on?", "I’ll keep the implementation scoped to this project and preserve the current workspace state.", "Ready when you are."], tools: ["New local session", "Workspace ready", "Waiting for prompt"], context: "packages/claxedo-app", branch: "main" },
  { id: "release-planning", title: "I am planning releasing claxedo...", user: "I am planning releasing Claxedo. Help me verify the release path.", responses: ["I’ll walk the release contract from packaged app through update metadata and hosted downloads.", "The desktop artifacts and update manifest have one canonical owner.", "I’m checking the signed release path now."], tools: ["Worked for 3m 12s", "Read release workflow", "Checking artifacts"], context: "packages/claxedo-app", branch: "release/desktop" },
  { id: "done", title: "done", user: "Finish the remaining checks and summarize the result.", responses: ["The requested changes are complete and the focused checks pass.", "I’ve preserved the existing contracts and removed the replaced path.", "The work is ready for review."], tools: ["Ran focused checks", "Build passed", "Ready for review"], context: "packages/claxedo-app", branch: "main" },
] as const

const terminalSessions = [
  { id: "terminal-codex", title: "Codex", surface: "terminal", harness: "codex", user: "", responses: ["", "", ""], tools: ["", "", ""], context: "packages/claxedo-app", branch: "main" },
  { id: "terminal-claude", title: "Claude", surface: "terminal", harness: "claude", user: "", responses: ["", "", ""], tools: ["", "", ""], context: "packages/claxedo-app", branch: "main" },
] as const
const canvasSessions: readonly ReplicaSession[] = initialSurface === "terminal" ? terminalSessions : (sessions ?? demoSessions)
---

<section class:list={["hero", { "canvas-only": canvasOnly }]} id={canvasOnly ? undefined : "product"} aria-labelledby={canvasOnly ? undefined : "hero-title"} aria-label={canvasOnly ? "Claxedo terminal application canvas" : undefined}>
  <div class="app-window" data-app-replica data-sidebar="closed" data-surface={initialSurface} data-panel="closed" data-panel-width="split" data-panel-view-active="changes" data-environment="expanded" data-account="closed" data-composer-menu="closed" data-active-session={canvasSessions[0].id} data-demo-sessions={JSON.stringify(canvasSessions)}>
    <svg class="replica-icon-sprite" aria-hidden="true">
      <symbol id="replica-layout-right-partial" viewBox="0 0 20 20"><g transform="rotate(180 10 10)"><path d="M16.835 8.66301C16.835 7.71885 16.8347 7.05065 16.792 6.52824C16.7605 6.14232 16.7073 5.86904 16.6299 5.65227L16.5439 5.45207C16.32 5.01264 15.9796 4.64498 15.5615 4.3886L15.3779 4.28606C15.1308 4.16013 14.8165 4.08006 14.3018 4.03801C13.7794 3.99533 13.1112 3.99504 12.167 3.99504H7.83301C6.88885 3.99504 6.22065 3.99533 5.69824 4.03801C5.31232 4.06954 5.03904 4.12266 4.82227 4.20012L4.62207 4.28606C4.18264 4.50996 3.81498 4.85035 3.55859 5.26848L3.45605 5.45207C3.33013 5.69922 3.25006 6.01354 3.20801 6.52824C3.16533 7.05065 3.16504 7.71885 3.16504 8.66301V11.3271C3.16504 12.2712 3.16533 12.9394 3.20801 13.4618C3.25006 13.9766 3.33013 14.2909 3.45605 14.538L3.55859 14.7216C3.81498 15.1397 4.18266 15.4801 4.62207 15.704L4.82227 15.79C5.03904 15.8674 5.31234 15.9205 5.69824 15.9521C6.22065 15.9947 6.88885 15.995 7.83301 15.995H12.167C13.1112 15.995 13.7794 15.9947 14.3018 15.9521C14.8164 15.91 15.1308 15.8299 15.3779 15.704L15.5615 15.6015C15.9797 15.3451 16.32 14.9774 16.5439 14.538L16.6299 14.3378C16.7074 14.121 16.7605 13.8478 16.792 13.4618C16.8347 12.9394 16.835 12.2712 16.835 11.3271V8.66301ZM5.00195 13.3329V6.66692C5.00195 6.29965 5.29972 6.00188 5.66699 6.00188C6.03412 6.00204 6.33203 6.29975 6.33203 6.66692V13.3329C6.33203 13.7001 6.03412 13.9978 5.66699 13.998C5.29972 13.998 5.00195 13.7002 5.00195 13.3329ZM18.165 11.3271C18.165 12.2493 18.1653 12.9811 18.1172 13.5702C18.0745 14.0924 17.9916 14.5472 17.8125 14.9648L17.7295 15.1415C17.394 15.8 16.8834 16.3511 16.2568 16.7353L15.9814 16.8896C15.5157 17.1268 15.0069 17.2285 14.4102 17.2773C13.821 17.3254 13.0893 17.3251 12.167 17.3251H7.83301C6.91071 17.3251 6.17898 17.3254 5.58984 17.2773C5.06757 17.2346 4.61294 17.1508 4.19531 16.9716L4.01855 16.8896C3.36014 16.5541 2.80898 16.0434 2.4248 15.4169L2.27051 15.1415C2.03328 14.6758 1.93158 14.167 1.88281 13.5702C1.83468 12.9811 1.83496 12.2493 1.83496 11.3271V8.66301C1.83496 7.74072 1.83468 7.00898 1.88281 6.41985C1.93157 5.82309 2.03329 5.31432 2.27051 4.84856L2.4248 4.57317C2.80898 3.94666 3.36012 3.436 4.01855 3.10051L4.19531 3.0175C4.61285 2.83843 5.06771 2.75548 5.58984 2.71281C6.17898 2.66468 6.91071 2.66496 7.83301 2.66496H12.167C13.0893 2.66496 13.821 2.66468 14.4102 2.71281C15.0069 2.76157 15.5157 2.86329 15.9814 3.10051L16.2568 3.25481C16.8833 3.63898 17.394 4.19012 17.7295 4.84856L17.8125 5.02531C17.9916 5.44285 18.0745 5.89771 18.1172 6.41985C18.1653 7.00898 18.165 7.74072 18.165 8.66301V11.3271Z" /></g></symbol>
      <symbol id="replica-layout-right-full" viewBox="0 0 20 20"><g transform="rotate(180 10 10)"><path d="M6.83496 3.99992C6.38353 4.00411 6.01421 4.0122 5.69824 4.03801C5.31232 4.06954 5.03904 4.12266 4.82227 4.20012L4.62207 4.28606C4.18264 4.50996 3.81498 4.85035 3.55859 5.26848L3.45605 5.45207C3.33013 5.69922 3.25006 6.01354 3.20801 6.52824C3.16533 7.05065 3.16504 7.71885 3.16504 8.66301V11.3271C3.16504 12.2712 3.16533 12.9394 3.20801 13.4618C3.25006 13.9766 3.33013 14.2909 3.45605 14.538L3.55859 14.7216C3.81498 15.1397 4.18266 15.4801 4.62207 15.704L4.82227 15.79C5.03904 15.8674 5.31234 15.9205 5.69824 15.9521C6.01398 15.9779 6.383 15.986 6.83398 15.9902L6.83496 3.99992ZM18.165 11.3271C18.165 12.2493 18.1653 12.9811 18.1172 13.5702C18.0745 14.0924 17.9916 14.5472 17.8125 14.9648L17.7295 15.1415C17.394 15.8 16.8834 16.3511 16.2568 16.7353L15.9814 16.8896C15.5157 17.1268 15.0069 17.2285 14.4102 17.2773C13.821 17.3254 13.0893 17.3251 12.167 17.3251H7.83301C6.91071 17.3251 6.17898 17.3254 5.58984 17.2773C5.06757 17.2346 4.61294 17.1508 4.19531 16.9716L4.01855 16.8896C3.36014 16.5541 2.80898 16.0434 2.4248 15.4169L2.27051 15.1415C2.03328 14.6758 1.93158 14.167 1.88281 13.5702C1.83468 12.9811 1.83496 12.2493 1.83496 11.3271V8.66301C1.83496 7.74072 1.83468 7.00898 1.88281 6.41985C1.93157 5.82309 2.03329 5.31432 2.27051 4.84856L2.4248 4.57317C2.80898 3.94666 3.36012 3.436 4.01855 3.10051L4.19531 3.0175C4.61285 2.83843 5.06771 2.75548 5.58984 2.71281C6.17898 2.66468 6.91071 2.66496 7.83301 2.66496H12.167C13.0893 2.66496 13.821 2.66468 14.4102 2.71281C15.0069 2.76157 15.5157 2.86329 15.9814 3.10051L16.2568 3.25481C16.8833 3.63898 17.394 4.19012 17.7295 4.84856L17.8125 5.02531C17.9916 5.44285 18.0745 5.89771 18.1172 6.41985C18.1653 7.00898 18.165 7.74072 18.165 8.66301V11.3271ZM8.16406 15.995H12.167C13.1112 15.995 13.7794 15.9947 14.3018 15.9521C14.8164 15.91 15.1308 15.8299 15.3779 15.704L15.5615 15.6015C15.9797 15.3451 16.32 14.9774 16.5439 14.538L16.6299 14.3378C16.7074 14.121 16.7605 13.8478 16.792 13.4618C16.8347 12.9394 16.835 12.2712 16.835 11.3271V8.66301C16.835 7.71885 16.8347 7.05065 16.792 6.52824C16.7605 6.14232 16.7073 5.86904 16.6299 5.65227L16.5439 5.45207C16.32 5.01264 15.9796 4.64498 15.5615 4.3886L15.3779 4.28606C15.1308 4.16013 14.8165 4.08006 14.3018 4.03801C13.7794 3.99533 13.1112 3.99504 12.167 3.99504H8.16406C8.16407 3.99667 8.16504 3.99829 8.16504 3.99992L8.16406 15.995Z" /></g></symbol>
      <symbol id="replica-panel-expand" viewBox="0 0 20 20"><path d="M4.33496 11C4.33496 10.6327 4.63273 10.335 5 10.335C5.36727 10.335 5.66504 10.6327 5.66504 11V14.335H9L9.13379 14.3486C9.43692 14.4106 9.66504 14.6786 9.66504 15C9.66504 15.3214 9.43692 15.5894 9.13379 15.6514L9 15.665H5C4.63273 15.665 4.33496 15.3673 4.33496 15V11ZM14.335 9V5.66504H11C10.6327 5.66504 10.335 5.36727 10.335 5C10.335 4.63273 10.6327 4.33496 11 4.33496H15L15.1338 4.34863C15.4369 4.41057 15.665 4.67857 15.665 5V9C15.665 9.36727 15.3673 9.66504 15 9.66504C14.6327 9.66504 14.335 9.36727 14.335 9Z" /></symbol>
      <symbol id="replica-panel-restore" viewBox="0 0 20 20"><g transform="scale(1.25)"><path d="M6.1664 8.80845C6.7325 8.80845 7.1918 9.26774 7.1918 9.83384V13.3338C7.19155 13.6236 6.9562 13.8592 6.6664 13.8592C6.37672 13.8591 6.14126 13.6235 6.14101 13.3338V10.5936L2.70547 14.0379C2.50071 14.243 2.16753 14.2435 1.9623 14.0389C1.75709 13.8342 1.75665 13.501 1.96133 13.2957L5.39101 9.85923H2.6664C2.37672 9.85909 2.14126 9.6235 2.14101 9.33384C2.14101 9.04397 2.37657 8.80858 2.6664 8.80845H6.1664Z"/><path d="M13.2943 1.96274C13.4989 1.75743 13.8311 1.75731 14.0365 1.96177C14.2419 2.16637 14.243 2.49854 14.0385 2.70395L10.6127 6.14145H13.3334C13.6233 6.14145 13.8588 6.37689 13.8588 6.66684C13.8587 6.95674 13.6233 7.19223 13.3334 7.19223H9.8334C9.26734 7.19223 8.80807 6.73288 8.80801 6.16684V2.66684C8.80801 2.37689 9.04345 2.14145 9.3334 2.14145C9.62335 2.14145 9.85879 2.37689 9.85879 2.66684V5.41098L13.2943 1.96274Z"/></g></symbol>
    </svg>
    <header class="shell-header">
      <div class="rail-titlebar">
        <div class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></div>
        <button type="button" class="icon-button rail-hide" data-sidebar-toggle aria-label="Hide Sidebar" aria-pressed="true">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.25" y="2.75" width="11.5" height="10.5" rx="1.6"></rect><path d="M5.7 2.75v10.5"></path></svg>
        </button>
      </div>
      <div class="header-columns">
        <div class="workbench-l1">
          <div class="closed-chrome">
            <div class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></div>
            <button type="button" class="icon-button" data-sidebar-toggle aria-label="Show Sidebar" aria-pressed="false">
              <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.25" y="2.75" width="11.5" height="10.5" rx="1.6"></rect><path d="M5.7 2.75v10.5"></path></svg>
            </button>
            <span class="drag-gap"></span>
          </div>
          <nav class="compact-tabs" role="tablist" aria-label="Workbench panes">
            {canvasSessions.slice(0, 2).map((session, index) => (
              <div class="compact-tab" data-selected={index === 0 ? "true" : "false"}>
                <button type="button" class="tab-prefix" tabindex="-1" aria-label={`Claxedo / ${session.title}`} data-session-tab-id={session.id}>{session.harness ? <span class="tab-harness-mark"><HarnessMark name={session.harness} /></span> : <span class="tab-project-mark">C</span>}<i></i></button>
                <button type="button" class="tab-title" role="tab" aria-selected={index === 0 ? "true" : "false"} data-session-tab-id={session.id}>{session.title}</button>
                <button type="button" class="tab-close" aria-label={`Close ${session.title}`}><svg viewBox="0 0 16 16"><path d="m5 5 6 6m0-6-6 6"></path></svg></button>
              </div>
            ))}
          </nav>
          <div class="header-drag"></div>
          <div class="scope-actions">
            <button type="button" class="icon-button" data-surface-button="new" aria-label="New Session"><svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"></path></svg></button>
            <button type="button" class="icon-button" data-surface-button="terminal" aria-label="New Terminal"><svg viewBox="0 0 16 16"><rect x="2.5" y="2.75" width="11" height="10.5" rx="1.7"></rect><path d="m5 6 2 2-2 2m4 0h2"></path></svg></button>
            <button type="button" class="icon-button" aria-label="More actions"><svg viewBox="0 0 16 16"><path d="m4.5 6.5 3.5 3 3.5-3"></path></svg></button>
          </div>
          <button type="button" class="icon-button workspace-toggle" data-workspace-toggle aria-label="Open workspace panel" aria-pressed="false">
            <svg class="source-fill-icon" viewBox="0 0 20 20"><use href="#replica-layout-right-partial"></use></svg>
          </button>
        </div>
        <div class="workspace-l1">
          <div class="workspace-tabs">
            <button type="button" class="workspace-tab active" data-panel-button="changes"><svg viewBox="0 0 16 16"><rect x="3" y="3" width="10" height="10" rx="1.5"></rect><path d="M5.5 6h5M5.5 9h3"></path></svg><span>Review</span><i>×</i></button>
            <button type="button" class="workspace-tab" data-panel-button="files"><svg viewBox="0 0 16 16"><path d="M4 2.5h5l3 3V13.5H4zM9 2.5v3h3"></path></svg><span>Files</span></button>
            <button type="button" class="icon-button" aria-label="New workspace tab"><svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"></path></svg></button>
          </div>
          <span></span>
          <button type="button" class="icon-button panel-width-toggle" data-panel-maximize aria-label="Maximize workspace panel" aria-pressed="false"><svg class="source-fill-icon panel-expand-icon" viewBox="0 0 20 20"><use href="#replica-panel-expand"></use></svg><svg class="source-fill-icon panel-restore-icon" viewBox="0 0 20 20"><use href="#replica-panel-restore"></use></svg></button>
          <button type="button" class="icon-button" data-panel-close aria-label="Close workspace panel"><svg class="source-fill-icon" viewBox="0 0 20 20"><use href="#replica-layout-right-full"></use></svg></button>
        </div>
      </div>
    </header>

    <div class="app-body">
      <aside class="project-rail" aria-label="Projects and sessions">
        <div class="rail-global">
          <button type="button"><svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"></path></svg><span>New Project</span></button>
          <button type="button"><svg viewBox="0 0 16 16"><path d="M5 6V4.8A3 3 0 0 1 8 2a3 3 0 0 1 3 2.8V6m-7 0h8l-.5 7h-7z"></path></svg><span>Marketplace</span></button>
        </div>
        <div class="rail-divider"></div>
        <div class="rail-scroll">
          <span class="rail-label">Projects</span>
          <button type="button" class="project-row"><svg viewBox="0 0 16 16"><path d="M2 5.5h12v7.5H2zM2 5.5l2-2h4l1.2 2"></path></svg><b>agent-app-benchmark</b></button>
          <button type="button" class="project-row"><svg viewBox="0 0 16 16"><path d="M2 5.5h12v7.5H2zM2 5.5l2-2h4l1.2 2"></path></svg><b>Claxedo</b></button>
          <div class="session-list">
            {canvasSessions.map((session, index) => <button type="button" class:list={["session-row", { active: index === 0 }]} data-session-id={session.id}><span>{session.title}</span><small>{index === 0 ? "now" : `${index + 7}h`}</small></button>)}
            <button type="button" class="load-row">Load more</button>
          </div>
          <button type="button" class="project-row second-project"><svg viewBox="0 0 16 16"><path d="M2 5.5h12v7.5H2zM2 5.5l2-2h4l1.2 2"></path></svg><b>formlink</b></button>
          <div class="session-list"><button type="button" class="session-row"><span>Project overview</span><small>9h</small></button></div>
        </div>
        <div class="workspace-account-wrap">
          <div class="workspace-account-menu" aria-label="Workspace menu">
            <div class="account-identity"><span><svg viewBox="0 0 16 16"><path d="M2.5 4h11v7.2h-11zm3 9h5M8 11v2"></path></svg></span><b>Local workspace</b></div>
            <i></i>
            <button type="button"><svg viewBox="0 0 16 16"><path d="m8 2 6 11H2zm0 4v3m0 2.2v.2"></path></svg><span>Diagnostics</span></button>
            <button type="button"><svg viewBox="0 0 16 16"><path d="M3 12a5.5 5.5 0 1 1 10 0M8 8l3-2"></path></svg><span>Usage</span></button>
            <button type="button"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="2"></circle><path d="M8 2v2m0 8v2M2 8h2m8 0h2M3.8 3.8l1.4 1.4m5.6 5.6 1.4 1.4m0-8.4-1.4 1.4m-5.6 5.6-1.4 1.4"></path></svg><span>Settings</span></button>
            <button type="button"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6"></circle><path d="M6.5 6a1.6 1.6 0 0 1 3 .8c0 1.2-1.5 1.4-1.5 2.7m0 2v.1"></path></svg><span>Help</span></button>
          </div>
          <button type="button" class="workspace-account" data-account-toggle aria-expanded="false"><span class="account-device"><svg viewBox="0 0 16 16"><path d="M2.5 4h11v7.2h-11zm3 9h5M8 11v2"></path></svg></span><span>Local workspace</span><svg class="account-chevron" viewBox="0 0 16 16"><path d="m4.5 9.5 3.5-3 3.5 3"></path></svg></button>
        </div>
      </aside>

      <div class="stage-columns">
        <main class="workbench">
          <section class="session-surface chat-surface" aria-label="Claxedo graphical session">
            <div class="session-content">
              <div class="timeline-scroll">
                <div class="timeline-column">
                  <div class="session-name-row"><slot name="title-prefix" /><h2 data-session-title>{canvasSessions[0].title}</h2><button type="button" aria-label="Session options"><svg viewBox="0 0 16 16"><circle cx="3" cy="8" r="1"></circle><circle cx="8" cy="8" r="1"></circle><circle cx="13" cy="8" r="1"></circle></svg></button></div>
                  <article class="message user-message"><div data-transcript-user>{canvasSessions[0].user}</div></article>
                  <article class="message assistant-message"><p data-transcript-response="0">{canvasSessions[0].responses[0]}</p></article>
                  <button type="button" class="turn-fold" data-tool-card="0" aria-expanded="false"><svg viewBox="0 0 16 16"><path d="m6 4 4 4-4 4"></path></svg><b data-transcript-tool="0">{canvasSessions[0].tools[0]}</b><i></i></button>
                  <button type="button" class="tool-summary" data-tool-card="1" aria-expanded="false"><svg viewBox="0 0 16 16"><rect x="2.5" y="3" width="11" height="10" rx="1.5"></rect><path d="m5 6 2 2-2 2m4 0h2"></path></svg><b data-transcript-tool="1">{canvasSessions[0].tools[1]}</b><span>⌄</span></button>
                  <article class="message assistant-message"><p data-transcript-response="1">{canvasSessions[0].responses[1]}</p></article>
                  <button type="button" class="tool-summary" data-tool-card="2" aria-expanded="false"><svg viewBox="0 0 16 16"><path d="M3 3h10v10H3zM3 7h10M7 3v10"></path></svg><b data-transcript-tool="3">{canvasSessions[0].tools[3] ?? "Read config defaults"}</b><span>⌄</span></button>
                  <article class="message assistant-message"><p data-transcript-response="2">{canvasSessions[0].responses[2]}</p></article>
                  <button type="button" class="tool-summary running" data-tool-card="3" aria-expanded="false"><i></i><b data-transcript-tool="2">{canvasSessions[0].tools[2]}</b><span>⌄</span></button>
                  <slot name="timeline-extra" />
                </div>
              </div>

              <aside class="environment-card" aria-label="Session environment">
                <div class="environment-expanded">
                  <header><b>Environment</b><button type="button" data-environment-toggle aria-label="Collapse Environment"><svg viewBox="0 0 16 16"><path d="m5 4 4 4-4 4m4-8 4 4-4 4"></path></svg></button></header>
                  <div class="env-facts">
