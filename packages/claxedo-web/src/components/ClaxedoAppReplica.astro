---
import HarnessMark from "./HarnessMark.astro"
import CodexIcon from "./CodexIcon.astro"
import CodexIconSprite from "./CodexIconSprite.astro"

export interface ReplicaSession { id: string; title: string; user: string; responses: readonly string[]; tools: readonly string[]; context: string; branch: string; place?: string; surface?: "chat" | "terminal"; harness?: "codex" | "claude" | "cursor" | "pi" | "opencode"; project?: "formlink" }
const demoSessions = [
  { id: "usage-meter", title: "Fix usage meter", harness: "codex", place: "This computer", user: "The usage meter undercounts Codex turns: 41k tokens in the meter, 118k on the dashboard. Find where it goes wrong, don't just scale it.", responses: ["Tracing one usage event from the Codex adapter to the meter, with yesterday's session replayed from its event log.", "Found it. Codex reports usage as a running total for the session, and the meter added every event as a delta. It has to keep the latest total, not the sum.", "Yesterday's session now reads 118,204 tokens against the dashboard's 118k. I added a fixture so this exact shape stays covered."], tools: ["Worked for 48s", "Replayed yesterday's session", "Running the meter tests", "Read 9 files"], context: "packages/claxedo-app", branch: "fix/usage-meter" },
  { id: "standup", title: "Add a Standup page", harness: "claude", place: "This computer", user: "Add a Standup page to the app that lists what every session in this project did today.", responses: ["I'll build it as an app plugin with the Claxedo tools, so it lives in your sidebar.", "The page reads today's sessions through the app's own server and groups them by project.", "Standup is registered. Approve it once and it shows up in the sidebar; every save I make after that goes live."], tools: ["Worked for 1m 04s", "claxedo · app_plugin_create", "claxedo · app_plugin_add", "claxedo · app_plugin_check"], context: "plugins/standup", branch: "main" },
  { id: "relay-tokens", title: "Rotate relay tokens", harness: "codex", place: "Daytona sandbox", user: "Rotate the relay tokens to EdDSA. Keep the old verifier for exactly one release.", responses: ["Reading the token contract and both verifier paths first.", "New tokens are EdDSA, and the old verifier stays for one release so links already sent keep working.", "Both verifiers pass the contract suite in the sandbox."], tools: ["Worked for 1m 12s", "Edited 4 files", "Running the contract suite", "Read the token contract"], context: "packages/workspace-relay", branch: "chore/eddsa-tokens" },
  { id: "release-notes", title: "Draft release notes", harness: "cursor", place: "studio-mac", user: "Draft the release notes for this week from the merged pull requests. Group them by what a user notices.", responses: ["Reading every pull request merged since the last tag.", "Fourteen pull requests landed: four new features, seven fixes and three changes.", "The notes are in RELEASE_NOTES.md, grouped into New, Fixed and Changed, with each item linked to its pull request."], tools: ["Worked for 2m 10s", "Listed 14 merged pull requests", "Writing RELEASE_NOTES.md", "Read the last tag"], context: "packages/claxedo-desktop", branch: "release/notes" },
  { id: "formlink-overview", title: "What is this project?", harness: "opencode", project: "formlink", place: "This computer", user: "What is this project, and what would you fix first?", responses: ["Reading the README, the route table and the last twenty commits before answering.", "Formlink is a form builder: a Hono API, a Solid editor, and a shared schema package. Validation lives in three places and they disagree.", "I would make the shared schema the only validator, so the API and the editor reject the same input."], tools: ["Worked for 58s", "Read README", "Reading git log", "Read 24 files"], context: "apps/formlink", branch: "main" },
] as const

const terminalSessions = [
  { id: "terminal-codex", title: "Codex", surface: "terminal", harness: "codex", user: "", responses: ["", "", ""], tools: ["", "", ""], context: "packages/claxedo-app", branch: "main" },
  { id: "terminal-claude", title: "Claude", surface: "terminal", harness: "claude", user: "", responses: ["", "", ""], tools: ["", "", ""], context: "packages/claxedo-app", branch: "main" },
] as const
const canvasSessions: readonly ReplicaSession[] = [...demoSessions, ...terminalSessions]
const claxedoSessions = canvasSessions.filter((session) => !session.project && session.surface !== "terminal")
const terminalRows = canvasSessions.filter((session) => session.surface === "terminal")
const formlinkSessions = canvasSessions.filter((session) => session.project === "formlink")

interface BoardCard { number: number; title: string; preset: string; harness: NonNullable<ReplicaSession["harness"]>; mark?: string; live?: boolean }
const boardColumns: readonly { key: string; label: string; cards: readonly BoardCard[] }[] = [
  { key: "backlog", label: "Backlog", cards: [
    { number: 18, title: "Rotate relay verifier behind a flag", preset: "Reviewer", harness: "codex", mark: "relay-verifier" },
    { number: 17, title: "Usage meter parity with provider dashboard", preset: "Fixer", harness: "claude" },
  ] },
  { key: "todo", label: "To do", cards: [
    { number: 16, title: "Connections API contract tests", preset: "Tester", harness: "codex" },
  ] },
  { key: "doing", label: "In progress", cards: [
    { number: 15, title: "Ship connections API", preset: "Builder", harness: "claude", live: true },
    { number: 14, title: "Migrate relay tokens to EdDSA", preset: "Builder", harness: "codex", live: true },
  ] },
  { key: "needs_you", label: "Needs you", cards: [
    { number: 13, title: "Approve permission bump for box-1", preset: "Builder", harness: "claude" },
  ] },
  { key: "done", label: "Done", cards: [
    { number: 12, title: "Sync setup to every agent", preset: "Builder", harness: "claude" },
  ] },
]
---

<section class="hero canvas-only" aria-label="Interactive preview of the Claxedo app">
  <div class="app-window" data-app-replica data-demo data-sidebar="open" data-surface="chat" data-panel="closed" data-panel-width="split" data-panel-view-active="changes" data-environment="expanded" data-account="closed" data-composer-menu="closed" data-active-session={canvasSessions[0].id} data-demo-sessions={JSON.stringify(canvasSessions)}>
    <CodexIconSprite />
    <header class="shell-header">
      <div class="rail-titlebar">
        <div class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></div>
        <button type="button" class="icon-button rail-hide" data-sidebar-toggle aria-label="Hide Sidebar" aria-pressed="true">
          <CodexIcon name="layout-left-partial" />
        </button>
      </div>
      <div class="header-columns">
        <div class="workbench-l1">
          <div class="closed-chrome">
            <div class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></div>
            <button type="button" class="icon-button" data-sidebar-toggle aria-label="Show Sidebar" aria-pressed="false">
              <CodexIcon name="layout-left-partial" />
            </button>
            <span class="drag-gap"></span>
          </div>
          <nav class="compact-tabs" role="tablist" aria-label="Workbench panes">
            {claxedoSessions.slice(0, 2).map((session, index) => (
              <div class="compact-tab" data-selected={index === 0 ? "true" : "false"}>
                <button type="button" class="tab-prefix" tabindex="-1" aria-label={`Claxedo / ${session.title}`} data-session-tab-id={session.id}>{session.harness ? <span class="tab-harness-mark"><HarnessMark name={session.harness} /></span> : <span class="tab-project-mark">C</span>}<i></i></button>
                <button type="button" class="tab-title" role="tab" aria-selected={index === 0 ? "true" : "false"} data-session-tab-id={session.id}>{session.title}</button>
                <button type="button" class="tab-close" aria-label={`Close ${session.title}`}><CodexIcon name="close-small" /></button>
              </div>
            ))}
          </nav>
          <div class="header-drag"></div>
          <div class="scope-actions">
            <button type="button" class="icon-button" data-surface-button="new" aria-label="New Session"><CodexIcon name="plus-small" /></button>
            <button type="button" class="icon-button" data-surface-button="terminal" data-spot-target="terminal" aria-label="New Terminal"><CodexIcon name="terminal" /></button>
            <button type="button" class="icon-button" aria-label="More actions"><CodexIcon name="chevron-down" /></button>
          </div>
          <button type="button" class="icon-button workspace-toggle" data-workspace-toggle aria-label="Open workspace panel" aria-pressed="false">
            <CodexIcon name="layout-right-partial" />
          </button>
        </div>
        <div class="workspace-l1">
          <div class="workspace-tabs">
            <button type="button" class="workspace-tab active" data-panel-button="changes"><CodexIcon name="review" /><span>Review</span><i><CodexIcon name="close-small" /></i></button>
            <button type="button" class="workspace-tab" data-panel-button="files"><CodexIcon name="file" /><span>Files</span></button>
            <button type="button" class="icon-button" aria-label="New workspace tab"><CodexIcon name="plus-small" /></button>
          </div>
          <span></span>
          <button type="button" class="icon-button panel-width-toggle" data-panel-maximize aria-label="Maximize workspace panel" aria-pressed="false"><CodexIcon name="expand" class="panel-expand-icon" /><CodexIcon name="collapse" class="panel-restore-icon" /></button>
          <button type="button" class="icon-button" data-panel-close aria-label="Close workspace panel"><CodexIcon name="layout-right-full" /></button>
        </div>
      </div>
    </header>

    <div class="app-body">
      <aside class="project-rail" aria-label="Projects and sessions">
        <div class="rail-global">
          <button type="button"><CodexIcon name="folder-add" /><span>New Project</span></button>
          <button type="button" data-surface-button="marketplace" data-spot-target="tools"><CodexIcon name="marketplace" /><span>Marketplace</span></button>
          <button type="button" data-surface-button="tasks"><CodexIcon name="checklist" /><span>Tasks</span></button>
          <button type="button" data-demo-open="standup" data-spot-target="prompt"><CodexIcon name="document-text" /><span>Standup</span></button>
        </div>
        <div class="rail-divider"></div>
        <div class="rail-scroll">
          <span class="rail-label">Projects</span>
          <button type="button" class="project-row"><CodexIcon name="folder" /><b>agent-app-benchmark</b></button>
          <button type="button" class="project-row"><CodexIcon name="folder" /><b>Claxedo</b></button>
          <div class="session-list">
            {claxedoSessions.map((session, index) => <button type="button" class:list={["session-row", { active: index === 0 }]} data-session-id={session.id}><span>{session.title}</span><small>{index === 0 ? "now" : `${index + 7}h`}</small></button>)}
            {terminalRows.map((session) => <button type="button" class="session-row terminal-row" data-session-id={session.id}><CodexIcon name="terminal" /><span>{session.title.toLowerCase()}</span></button>)}
            <button type="button" class="load-row">Load more</button>
          </div>
          <button type="button" class="project-row second-project"><CodexIcon name="folder" /><b>formlink</b></button>
          <div class="session-list">{formlinkSessions.length > 0 ? formlinkSessions.map((session) => <button type="button" class="session-row" data-session-id={session.id}><span>{session.title}</span><small>1d</small></button>) : <button type="button" class="session-row"><span>Project overview</span><small>9h</small></button>}</div>
        </div>
        <div class="workspace-account-wrap">
          <div class="workspace-account-menu" aria-label="Workspace menu">
            <div class="account-identity"><span><CodexIcon name="monitor" /></span><b>Acme · self-hosted on Cloudflare</b></div>
            <i></i>
            <button type="button"><CodexIcon name="warning" /><span>Diagnostics</span></button>
            <button type="button"><CodexIcon name="gauge" /><span>Usage</span></button>
            <button type="button"><CodexIcon name="settings-gear" /><span>Settings</span></button>
            <button type="button"><CodexIcon name="help" /><span>Help</span></button>
          </div>
          <button type="button" class="workspace-account" data-account-toggle data-spot-target="team" aria-expanded="false"><span class="account-device"><CodexIcon name="monitor" /></span><span>Acme</span><CodexIcon name="chevron-down" class="account-chevron" /></button>
        </div>
      </aside>

      <div class="stage-columns">
        <main class="workbench">
          <section class="session-surface chat-surface" aria-label="Claxedo graphical session">
            <div class="session-content">
              <div class="timeline-scroll">
                <div class="timeline-column">
                  <div class="session-name-row"><h2 data-session-title>{canvasSessions[0].title}</h2><button type="button" aria-label="Session options"><CodexIcon name="three-dots" /></button></div>
                  <article class="message user-message"><div data-transcript-user>{canvasSessions[0].user}</div></article>
                  <article class="message assistant-message"><p data-transcript-response="0">{canvasSessions[0].responses[0]}</p></article>
                  <button type="button" class="turn-fold" data-tool-card="0" aria-expanded="false"><CodexIcon name="chevron-right" /><b data-transcript-tool="0">{canvasSessions[0].tools[0]}</b><i></i></button>
                  <button type="button" class="tool-summary" data-tool-card="1" aria-expanded="false"><CodexIcon name="terminal" /><b data-transcript-tool="1">{canvasSessions[0].tools[1]}</b><span><CodexIcon name="chevron-down" /></span></button>
                  <article class="message assistant-message"><p data-transcript-response="1">{canvasSessions[0].responses[1]}</p></article>
                  <button type="button" class="tool-summary" data-tool-card="2" aria-expanded="false"><CodexIcon name="document-text" /><b data-transcript-tool="3">{canvasSessions[0].tools[3] ?? "Read config defaults"}</b><span><CodexIcon name="chevron-down" /></span></button>
                  <article class="message assistant-message"><p data-transcript-response="2">{canvasSessions[0].responses[2]}</p></article>
                  <button type="button" class="tool-summary running" data-tool-card="3" aria-expanded="false"><i></i><b data-transcript-tool="2">{canvasSessions[0].tools[2]}</b><span><CodexIcon name="chevron-down" /></span></button>
                </div>
              </div>

              <aside class="environment-card" aria-label="Session environment">
                <div class="environment-expanded">
                  <header><b data-session-place data-spot-target="place">{canvasSessions[0].place ?? "Environment"}</b><button type="button" data-environment-toggle aria-label="Collapse Environment"><CodexIcon name="chevron-double-right" /></button></header>
                  <div class="env-facts">
                    <div><CodexIcon name="folder" /><span data-session-context>{canvasSessions[0].context}</span></div>
                    <div><CodexIcon name="branch" /><span data-session-branch>{canvasSessions[0].branch}</span></div>
                  </div>
                  <section><small>Workspace</small><button type="button" data-panel-button="changes"><CodexIcon name="changes" /><span>Changes</span><em><b>+34</b> −8</em></button><button type="button" data-panel-button="files"><CodexIcon name="folder" /><span>Files</span></button><button type="button" data-panel-button="processes"><CodexIcon name="terminal" /><span>Processes</span><i></i><em>2</em></button></section>
                  <section><small>Repository</small><button type="button"><CodexIcon name="github" /><span>claxedo/claxedo</span><em><CodexIcon name="open-external" /></em></button></section>
                </div>
                <div class="environment-collapsed"><button type="button" data-panel-button="changes" aria-label="Open changes"><CodexIcon name="changes" /></button><button type="button" data-panel-button="files" aria-label="Open files"><CodexIcon name="folder" /></button><button type="button" data-panel-button="processes" aria-label="Open processes"><CodexIcon name="terminal" /></button><i></i><button type="button" data-environment-toggle aria-label="Expand Environment"><CodexIcon name="chevron-double-left" /></button></div>
              </aside>

              <div class="composer-zone">
                <button type="button" class="scroll-latest" data-scroll-latest aria-label="Scroll to latest message"><CodexIcon name="scroll-to-latest" /></button>
                <form class="composer" data-composer-form>
                  <textarea class="composer-input" data-composer-input aria-label="Session prompt" rows="2" placeholder="Ask anything, / for commands, @ for context..."></textarea>
                  <div class="composer-context-chip" data-composer-context-chip hidden><span>＠</span><b data-composer-context-label>Files</b><button type="button" data-context-remove aria-label="Remove context"><CodexIcon name="close-small" /></button></div>
                  <div class="composer-controls">
                    <div class="composer-left">
                      <div class="composer-popover add-popover" data-composer-popover="context" hidden><small>Add</small><button type="button" data-context-option="Images and files"><b>Images and files</b><em>⌘U</em></button><button type="button" data-context-option="Commands"><b>Commands</b><em>/</em></button><button type="button" data-context-option="Context"><b>Context</b><em>@</em></button><button type="button" data-context-option="Shell command"><b>Shell command</b><em>!</em></button></div>
                      <div class="composer-popover permission-popover" data-composer-popover="permission" hidden><small>Codex</small><button type="button" data-permission="Read only"><CodexIcon name="shield" /><span><b>Read only</b><i>Never asks; the sandbox permits reads only, so writes fail</i></span><em hidden><CodexIcon name="check" /></em></button><button type="button" data-permission="Workspace write" class="selected"><CodexIcon name="shield" /><span><b>Workspace write</b><i>Runs commands inside the workspace without asking; escalates outside it</i></span><em><CodexIcon name="check" /></em></button><button type="button" data-permission="Untrusted"><CodexIcon name="shield" /><span><b>Untrusted</b><i>Only trusted commands run without asking; anything else escalates</i></span><em hidden><CodexIcon name="check" /></em></button><button type="button" data-permission="Full access"><CodexIcon name="shield" /><span><b>Full access</b><i>Never asks; full filesystem and network access</i></span><em hidden><CodexIcon name="check" /></em></button></div>
                      <button type="button" class="round-control" data-composer-menu-trigger="context" aria-label="Add context" aria-expanded="false"><CodexIcon name="plus" /></button><button type="button" class="permission-control" data-composer-menu-trigger="permission" aria-label="Select permission mode" aria-expanded="false"><CodexIcon name="shield" /><b data-permission-label>Workspace write</b></button>
                    </div>
                    <div class="composer-right">
                      <div class="composer-popover harness-popover" data-composer-popover="harness" data-picker-open="model" hidden>
                        <button type="button" class="picker-section" data-harness-section="harness"><CodexIcon name="chevron-right" /><b>Harness</b><span data-current-harness>Codex</span></button>
                        <div class="picker-options harness-options" data-harness-panel="harness" hidden><small>Native SDK</small><button type="button" data-hero-harness="Claude" data-hero-model="Opus 5"><span class="harness-logo"><HarnessMark name="claude" /></span><b>Claude</b><em hidden><CodexIcon name="check" /></em></button><button type="button" data-hero-harness="Codex" data-hero-model="GPT-5.6-Luna" class="selected"><span class="harness-logo"><HarnessMark name="codex" /></span><b>Codex</b><em><CodexIcon name="check" /></em></button><button type="button" data-hero-harness="Cursor" data-hero-model="Composer 1"><span class="harness-logo"><HarnessMark name="cursor" /></span><b>Cursor</b><em hidden><CodexIcon name="check" /></em></button><small>Direct</small><button type="button" data-hero-harness="Pi" data-hero-model="Pi"><span class="harness-logo"><HarnessMark name="pi" /></span><b>Pi</b><em hidden><CodexIcon name="check" /></em></button><button type="button" data-hero-harness="OpenCode" data-hero-model="GPT-5.4"><span class="harness-logo"><HarnessMark name="opencode" /></span><b>OpenCode</b><em hidden><CodexIcon name="check" /></em></button></div>
                        <button type="button" class="picker-section active" data-harness-section="model"><CodexIcon name="chevron-down" /><b>Model</b><span data-hero-model-label>GPT-5.6-Luna</span></button>
                        <div class="picker-options model-options" data-harness-panel="model"><label><CodexIcon name="magnifying-glass" /><input type="search" aria-label="Search models" placeholder="Search models" /></label><div class="model-provider"><span>Codex App Server</span><b>Configured</b></div><button type="button" data-hero-model-choice="GPT-5.5"><span><b>GPT-5.5</b><i>Frontier model for complex coding, research, and real-world work.</i></span><em hidden><CodexIcon name="check" /></em></button><button type="button" data-hero-model-choice="GPT-5.6-Luna" class="selected"><span><b>GPT-5.6-Luna</b><i>Fast and affordable agentic coding model.</i></span><em><CodexIcon name="check" /></em></button><button type="button" data-hero-model-choice="GPT-5.6-Sol"><span><b>GPT-5.6-Sol</b><i>Latest frontier agentic coding model.</i></span><em hidden><CodexIcon name="check" /></em></button><button type="button" data-hero-model-choice="GPT-5.6-Terra"><span><b>GPT-5.6-Terra</b><i>Balanced agentic coding model for everyday work.</i></span><em hidden><CodexIcon name="check" /></em></button></div>
                        <button type="button" class="picker-section" data-harness-section="effort"><CodexIcon name="chevron-right" /><b>Effort</b><span data-hero-effort-label>Low</span></button>
                        <div class="picker-options effort-options" data-harness-panel="effort" hidden>{['Low','Medium','High','Xhigh','Max','Ultra'].map((effort) => <button type="button" data-hero-effort={effort} class:list={{ selected: effort === 'Low' }}><b>{effort}</b><em hidden={effort !== 'Low'}><CodexIcon name="check" /></em></button>)}</div>
                      </div>
                      <button type="button" class="harness-control" data-composer-menu-trigger="harness" aria-label="Select harness and model" aria-expanded="false"><span class="harness-logo" data-hero-harness-mark><HarnessMark name="codex" /></span><span data-hero-model-trigger>GPT-5.6-Luna</span><small data-hero-effort-trigger>Low</small><CodexIcon name="chevron-down" /></button><button type="submit" class="send" aria-label="Send"><CodexIcon name="send" /></button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </section>

          <section class="session-surface terminal-surface" aria-label="Claxedo terminal session">
            <div class="terminal-content" data-terminal-session="terminal-codex" hidden><p><b>›_ OpenAI Codex</b> <span class="term-muted">(v0.150.1)</span></p><p></p><p>model:       <strong>gpt-5.6-sol high · fast</strong></p><p>directory:   <strong>~/test/opencode</strong></p><p>permissions: <strong>YOLO mode</strong></p><p></p><p><span class="term-muted">MCP startup incomplete (failed: figma)</span></p><p></p><p>› <span class="term-muted">Ask Codex to do anything</span> <i class="term-cursor"></i></p></div>
            <div class="terminal-content" data-terminal-session="terminal-claude" hidden><p><b>✦ Claude Code</b> <span class="term-muted">v2.1.247</span></p><p>Opus 5 (1M context) · high effort</p><p>~/test/opencode</p><p></p><p><span class="term-muted">△ 1 MCP server needs authentication · run /mcp</span></p><p></p><p>❯ <span class="term-muted">Try “edit server.ts to…”</span> <i class="term-cursor"></i></p></div>
            <div class="terminal-content" data-terminal-session="default"><p><span class="term-path">~/claxedo</span> <span class="term-branch">dev*</span> codex --resume release-performance</p><p><span class="term-green">✓</span> Codex resumed release-performance</p><p>Tracing session switch and draft ownership…</p><p class="term-muted">$ bun test session-selection composer-isolation</p><p><span class="term-green">✓</span> 18 tests passed</p><p><span class="term-path">~/claxedo</span> <span class="term-branch">dev*</span> <i class="term-cursor"></i></p></div>
          </section>
          <section class="session-surface marketplace-surface" aria-label="Claxedo marketplace">
            <header class="market-head">
              <label class="file-search market-search"><CodexIcon name="magnifying-glass" /><input type="search" aria-label="Search plugins" placeholder="Search plugins, skills, MCP servers…" /></label>
              <div class="market-sources" role="tablist" aria-label="Marketplace sources">
                <button type="button" role="tab" aria-selected="true">All</button>
                <button type="button" role="tab" aria-selected="false">Claxedo<span>2</span></button>
                <button type="button" role="tab" aria-selected="false">Personal<span>139</span></button>
                <button type="button" class="market-add-source">+ Add source</button>
              </div>
            </header>
            <div class="market-scroll">
              <div class="market-group">
                <h3>Claxedo <span>2</span></h3>
                <div class="market-cards">
                  <article class="market-card" data-marketplace-plugin="composio"><i>Co</i><div><b>composio</b><p>Connect and operate 1000+ external apps through Composio Connect with managed OAuth and intelligent tool routing.</p></div><button type="button">Add</button></article>
                  <article class="market-card" data-marketplace-plugin="context7"><i>C7</i><div><b>context7</b><p>Up-to-date documentation lookup. Pull version-specific documentation and code examples directly from source repositories into your LLM context.</p></div><button type="button">Enable</button></article>
                </div>
              </div>
              <div class="market-group">
                <h3>Personal <span>139</span><em>installed for other harnesses</em></h3>
                <div class="market-rows">
                  {[
                    ["RU", "rust-analyzer-lsp", "claude", "claude-plugins-official"],
                    ["CO", "compound-engineering", "claude", "compound-engineering-plugin"],
                    ["FR", "frontend-design", "claude", "claude-plugins-official"],
                    ["Ph", "posthog", "claude", "claude-plugins-official"],
                    ["RA", "ralph-loop", "codex", "claude-plugins-official"],
                    ["BR", "browser", "codex", "openai-bundled"],
                    ["GH", "github", "codex", "openai-curated"],
                    ["CO", "comment-quality", "claude", "skill"],
                    ["TR", "trace-flow", "claude", "skill"],
                    ["BR", "browser-use", "agents", "skill"],
                  ].map(([mark, name, harness, source]) => <button type="button" class="market-row"><i>{mark}</i><b>{name}</b><small>{harness}</small><small>{source}</small></button>)}
                </div>
              </div>
            </div>
          </section>
          <section class="session-surface tasks-surface" aria-label="Claxedo tasks board">
            <header class="tasks-head">
              <b>Tasks</b>
              <div class="tasks-views" role="tablist" aria-label="Tasks views"><button type="button" role="tab" aria-selected="true">Board</button><button type="button" role="tab" aria-selected="false">List</button><button type="button" role="tab" aria-selected="false">Presets</button></div>
              <button type="button" class="tasks-new">+ New task</button>
            </header>
            <div class="board">
              {boardColumns.map((column) => (
                <div class="board-col" data-board-column={column.key}>
                  <h3><span>{column.label}</span><small>{column.cards.length}</small></h3>
                  {column.cards.map((card) => (
                    <article class="task-card" data-task-card={card.mark}>
                      <small>#{card.number}</small>
                      <b>{card.title}</b>
                      <div class="task-meta"><span class="task-harness"><HarnessMark name={card.harness} /></span><span>{card.preset}</span>{card.live ? <i class="task-live" aria-label="Session running"></i> : null}</div>
                    </article>
                  ))}
                </div>
              ))}
            </div>
          </section>
        </main>

        <aside class="workspace-panel" aria-label="Workspace panel">
          <div class="workspace-l2"><div class="review-toolbar"><button type="button" class="commit-scope"><span>Uncommitted</span><span>136</span><CodexIcon name="chevron-down" /></button><b>+335</b><i>−10,008</i><span></span><button type="button" aria-label="Sort changes"><CodexIcon name="expand-all" /></button><button type="button" data-panel-button="changes" aria-label="Open review"><CodexIcon name="split" /></button><button type="button" data-panel-button="files" aria-label="Open files"><CodexIcon name="file" /></button><button type="button" aria-label="Open changed file"><CodexIcon name="open-external" /></button><button type="button" data-panel-button="processes" aria-label="Open processes"><CodexIcon name="terminal" /></button></div></div>
          <div class="panel-view review-view" data-panel-view="changes">
            <div class="change-list">
              <div class="file-change removed"><span>YML</span><b>.github/workflows/docs-links.yml</b><small>Removed</small></div>
              <div class="file-change"><span>MD</span><b>CONTRIBUTING.md</b><small>+1 −1</small></div>
              <div class="file-change"><span>MD</span><b>README.md</b><small>+4 −4</small></div>
              <div class="file-change"><span>◉</span><b>bun.lock</b><small>+14 −1,652</small></div>
              <div class="file-change"><span>TS</span><b>packages/claxedo-app/e2e/playwright/marketing-screenshots.spec.ts</b><small>+4 −4</small></div>
              <div class="file-change"><span>TSX</span><b>packages/claxedo-app/src/app/workbench/rail/onboarding-empty-state.tsx</b><small>+1 −1</small></div>
              <div class="file-change"><span>TSX</span><b>packages/claxedo-app/src/app/workbench/workbench/workbench.tsx</b><small>+4 −5</small></div>
              <div class="file-change"><span>TS</span><b>packages/claxedo-app/src/features/terminal/core/backend/xterm.ts</b><small>−10</small></div>
              <div class="file-change"><span>TS</span><b>packages/claxedo-app/src/features/terminal/core/config.test.ts</b><small>+2 −5</small></div>
              <div class="file-change"><span>TS</span><b>packages/claxedo-app/src/features/terminal/core/config.ts</b><small>+2 −2</small></div>
