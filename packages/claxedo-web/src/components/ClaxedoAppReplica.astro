---
import HarnessMark from "./HarnessMark.astro"

type Tool = { icon: "read" | "run" | "mcp" | "edit"; label: string; detail: readonly string[] }
type Place = { kind: "computer" | "machine" | "sandbox"; label: string }
type ChatSession = {
  id: string
  title: string
  age: string
  harness: "codex" | "claude" | "cursor"
  place: Place
  spot?: "speed" | "place"
  user: string
  opening: string
  tools: readonly Tool[]
  reply: string
}

const harnessNames = { codex: "Codex", claude: "Claude Code", cursor: "Cursor" } as const

const sessions: readonly ChatSession[] = [
  {
    id: "usage-meter",
    title: "Fix usage meter",
    age: "now",
    harness: "codex",
    place: { kind: "computer", label: "This computer" },
    spot: "speed",
    user: "The usage meter undercounts Codex turns: 41k tokens in the meter, 118k on the dashboard. Find where it goes wrong, don't just scale it.",
    opening: "Tracing one usage event from the Codex adapter to the meter, with yesterday's session replayed from its event log.",
    tools: [
      { icon: "read", label: "Read 9 files", detail: ["src/usage/meter.ts", "src/usage/fold.ts", "src/harness/codex/usage-event.ts", "src/usage/meter.test.ts", "+ 5 more"] },
      { icon: "run", label: "Ran the meter tests", detail: ["$ bun test src/usage", "42 pass, 0 fail"] },
    ],
    reply: "Codex reports usage as a running total for the session, and the meter added every event as a delta. It now keeps the latest total: yesterday's session reads 118,204 tokens against the dashboard's 118k.",
  },
  {
    id: "standup",
    title: "Add a Standup page",
    age: "8m",
    harness: "claude",
    place: { kind: "computer", label: "This computer" },
    user: "Add a Standup page to the app that lists what every session in this project did today.",
    opening: "I'll build it as an app plugin with the Claxedo tools, so it lives in your sidebar.",
    tools: [
      { icon: "mcp", label: "claxedo · app_plugin_create", detail: ["Created standup/package.json", "Created standup/src/app.tsx"] },
      { icon: "mcp", label: "claxedo · app_plugin_check", detail: ["Typecheck and build passed, 0 diagnostics"] },
      { icon: "mcp", label: "claxedo · app_plugin_add", detail: ["Registered Standup", "Waiting for your approval in the app"] },
    ],
    reply: "Standup is registered. Approve it once and it shows up in the sidebar; every save I make after that goes live.",
  },
  {
    id: "relay-tokens",
    title: "Rotate relay tokens",
    age: "1h",
    harness: "codex",
    place: { kind: "sandbox", label: "Daytona sandbox" },
    spot: "place",
    user: "Rotate the relay tokens to EdDSA. Keep the old verifier for exactly one release.",
    opening: "Reading the token contract and both verifier paths first.",
    tools: [
      { icon: "read", label: "Read the token contract", detail: ["packages/workspace-relay/src/token.ts", "packages/workspace-relay/src/verify.ts"] },
      { icon: "edit", label: "Edited 4 files", detail: ["src/token.ts", "src/verify.ts", "src/verify-legacy.ts", "src/token.test.ts"] },
      { icon: "run", label: "Ran the contract suite", detail: ["$ bun test packages/workspace-relay", "118 pass, 0 fail"] },
    ],
    reply: "New tokens are EdDSA, and old ones still verify until the next release. Both verifiers pass the contract suite in the sandbox.",
  },
  {
    id: "release-notes",
    title: "Draft release notes",
    age: "3h",
    harness: "cursor",
    place: { kind: "machine", label: "studio-mac" },
    user: "Draft the release notes for this week from the merged pull requests. Group them by what a user notices.",
    opening: "Reading every pull request merged since the last tag.",
    tools: [
      { icon: "run", label: "Listed 14 merged pull requests", detail: ["$ gh pr list --state merged --base dev", "14 pull requests since the last tag"] },
      { icon: "edit", label: "Wrote RELEASE_NOTES.md", detail: ["New: 4", "Fixed: 7", "Changed: 3"] },
    ],
    reply: "The notes are in RELEASE_NOTES.md, grouped into New, Fixed and Changed, with each item linked to its pull request.",
  },
]


const plugins = [
  { mark: "C7", name: "context7", about: "Version-pinned library docs, pulled into the prompt." },
  { mark: "Co", name: "composio", about: "Connect and operate external apps through one MCP server." },
  { mark: "Fd", name: "frontend-design", about: "Skills for distinctive, production-grade interfaces." },
  { mark: "Ph", name: "posthog", about: "Query product analytics and errors from any session." },
]

const people = [
  { initial: "A", name: "Asha Rao", role: "Owner" },
  { initial: "M", name: "Maya Chen", role: "Admin" },
  { initial: "D", name: "Diego Lima", role: "Member" },
  { initial: "K", name: "Kenji Mori", role: "Member" },
]
---

<section class="demo" data-demo data-surface="chat" data-rail="closed" aria-label="Interactive preview of the Claxedo app">
  <div class="titlebar">
    <div class="titlebar-rail">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.25" y="2.75" width="11.5" height="10.5" rx="1.6"></rect><path d="M5.7 2.75v10.5"></path></svg>
    </div>
    <div class="titlebar-main">
      <button type="button" class="icon-button phone-only" data-demo-rail-toggle aria-label="Show sidebar" aria-expanded="false">
        <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.25" y="2.75" width="11.5" height="10.5" rx="1.6"></rect><path d="M5.7 2.75v10.5"></path></svg>
      </button>
      <span class="titlebar-actions">
        <span class="icon-button" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"></path></svg></span>
        <button type="button" class="icon-button" data-demo-open="terminal" data-spot-target="terminal" aria-label="Open the terminal">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="2.75" width="11" height="10.5" rx="1.7"></rect><path d="m5 6 2 2-2 2m4 0h2"></path></svg>
        </button>
        <span class="icon-button" aria-hidden="true"><svg viewBox="0 0 16 16"><rect x="2.25" y="2.75" width="11.5" height="10.5" rx="1.6"></rect><path d="M10.3 2.75v10.5"></path></svg></span>
      </span>
    </div>
  </div>

  <div class="body">
    <nav class="rail" aria-label="Demo sidebar">
      <div class="rail-global">
        <span class="row"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 4.5 1.5 1.5L7 3.5M3 9.5 4.5 11 7 8.5M9 5h4M9 10h4"></path></svg>Tasks</span>
        <button type="button" class="row" data-demo-row="marketplace" data-spot-target="tools" data-spot-opens="tools"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 6V4.8A3 3 0 0 1 8 2a3 3 0 0 1 3 2.8V6m-7 0h8l-.5 7h-7z"></path></svg>Marketplace</button>
        <button type="button" class="row" data-demo-open="standup" data-spot-target="prompt" data-spot-opens="prompt"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3.5h4v4H3zM9 3.5h4v4H9zM3 9.5h4v4H3zM11 9.5v4M9 11.5h4"></path></svg>Standup</button>
      </div>
      <div class="rail-projects">
        <small>Projects</small>
        <span class="row project"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 5.5h12v7.5H2zM2 5.5l2-2h4l1.2 2"></path></svg>claxedo</span>
        {sessions.map((session, index) => (
          <button type="button" class:list={["row", "session", { active: index === 0 }]} data-demo-row={session.id} data-spot-opens={session.spot} aria-current={index === 0 ? "page" : undefined}>
            <span>{session.title}</span><small>{session.age}</small>
          </button>
        ))}
        <button type="button" class="row session terminal-row" data-demo-row="terminal" data-spot-target="terminal" data-spot-opens="terminal">
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="2.75" width="11" height="10.5" rx="1.7"></rect><path d="m5 6 2 2-2 2m4 0h2"></path></svg><span>claude</span>
        </button>
        <span class="row project"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 5.5h12v7.5H2zM2 5.5l2-2h4l1.2 2"></path></svg>formlink</span>
      </div>
      <button type="button" class="row account" data-demo-row="team" data-spot-target="team" data-spot-opens="team"><i aria-hidden="true">A</i><span>Acme</span><small>6 people</small></button>
    </nav>

    <div class="main">
      {sessions.map((session, index) => (
        <article class="chat" data-demo-view={session.id} data-surface="chat" hidden={index !== 0} aria-label={session.title}>
          <div class="transcript">
            <header class="session-head">
              <h3>{session.title}</h3>
              <span class="place" data-spot-target="place">
                {session.place.kind === "sandbox"
                  ? <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 12.5h7.3a2.7 2.7 0 0 0 .4-5.4A4 4 0 0 0 4.4 6.4a3.1 3.1 0 0 0 .1 6.1z"></path></svg>
                  : <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4h11v7.2h-11zm3 9h5M8 11v2"></path></svg>}
                {session.place.label}
              </span>
            </header>
            <p class="user">{session.user}</p>
            <p class="assistant">{session.opening}</p>
            {session.tools.map((tool) => (
              <div class="tool">
                <button type="button" class="tool-row" aria-expanded="false">
                  {tool.icon === "read" && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5h5l3 3v8H4zM9 2.5v3h3"></path></svg>}
                  {tool.icon === "run" && <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="3" width="11" height="10" rx="1.5"></rect><path d="m5 6 2 2-2 2m4 0h2"></path></svg>}
                  {tool.icon === "mcp" && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2.5v3M10 2.5v3M4.5 5.5h7v2.5a3.5 3.5 0 0 1-7 0zM8 11.5v2"></path></svg>}
                  {tool.icon === "edit" && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m10.5 3 2.5 2.5-7 7H3.5V10z"></path></svg>}
                  <span>{tool.label}</span>
                  <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 4 4 4-4 4"></path></svg>
                </button>
                <div class="tool-detail"><div><pre>{tool.detail.join("\n")}</pre></div></div>
              </div>
            ))}
            <p class="assistant">{session.reply}</p>
          </div>
          <div class="composer">
            <span class="composer-input">Ask anything, / for commands, @ for context…</span>
            <span class="composer-controls">
              <span class="round" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10"></path></svg></span>
              <span class="permission"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2 3.5 4v3.5c0 3 1.8 5 4.5 6.5 2.7-1.5 4.5-3.5 4.5-6.5V4z"></path></svg>Permissions</span>
              <span class="harness"><HarnessMark name={session.harness} />{harnessNames[session.harness]}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 6.5 3.5 3 3.5-3"></path></svg></span>
              <span class="send" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 12V4m-4 4 4-4 4 4"></path></svg></span>
            </span>
          </div>
        </article>
      ))}
      <article class="page" data-demo-view="marketplace" data-surface="page" hidden aria-label="Marketplace">
        <header class="page-head"><h3>Marketplace</h3><span class="page-note">Installed for Claude Code, Codex, Cursor and OpenCode</span></header>
        <div class="cards">
          {plugins.map((plugin) => (
            <div class="card"><i aria-hidden="true">{plugin.mark}</i><div><b>{plugin.name}</b><p>{plugin.about}</p></div><span class="installed">Installed</span></div>
          ))}
        </div>
        <p class="page-foot">Plugins reach every environment you sign into.</p>
      </article>
      <article class="page" data-demo-view="team" data-surface="page" hidden aria-label="Organization">
        <header class="page-head"><h3>Acme</h3><span class="page-note">Self-hosted on your Cloudflare account</span></header>
        <div class="people">
          {people.map((person) => (
            <div class="person"><i aria-hidden="true">{person.initial}</i><b>{person.name}</b><span>{person.role}</span></div>
          ))}
        </div>
      </article>
      <article class="terminal" data-demo-view="terminal" data-surface="terminal" hidden aria-label="Terminal: claude">
        <pre><span class="dim">~/claxedo $</span> claude
<b>✻ Claude Code</b>
<span class="dim">  cwd: ~/claxedo</span>

<span class="prompt">&gt;</span> run the relay contract tests and tell me what failed

<span class="ok">⏺</span> Bash(bun test packages/workspace-relay)
<span class="dim">  ⎿  118 pass, 0 fail</span>

<span class="ok">⏺</span> All 118 relay contract tests pass. Nothing failed.

<span class="prompt">&gt;</span> <span class="cursor"></span></pre>
      </article>
    </div>
  </div>
</section>

<script>
  for (const demo of document.querySelectorAll<HTMLElement>("[data-demo]")) {
    const railToggle = demo.querySelector<HTMLButtonElement>("[data-demo-rail-toggle]")
    const setRail = (open: boolean) => {
      demo.dataset.rail = open ? "open" : "closed"
      railToggle?.setAttribute("aria-expanded", String(open))
      railToggle?.setAttribute("aria-label", open ? "Hide sidebar" : "Show sidebar")
    }
    const open = (id: string) => {
      const view = demo.querySelector<HTMLElement>(`[data-demo-view="${id}"]`)
      if (!view) return
      demo.querySelectorAll<HTMLElement>("[data-demo-view]").forEach((item) => { item.hidden = item !== view })
      demo.querySelectorAll<HTMLElement>("[data-demo-row]").forEach((row) => {
        const on = row.dataset.demoRow === id
        row.classList.toggle("active", on)
        if (on) row.setAttribute("aria-current", "page")
        else row.removeAttribute("aria-current")
      })
      demo.dataset.surface = view.dataset.surface ?? "chat"
      setRail(false)
    }
    demo.querySelectorAll<HTMLElement>("[data-demo-row]").forEach((row) => row.addEventListener("click", () => open(row.dataset.demoRow ?? "")))
    demo.querySelectorAll<HTMLElement>("[data-demo-open]").forEach((button) => button.addEventListener("click", () => open(button.dataset.demoOpen ?? "")))
    demo.querySelectorAll<HTMLButtonElement>(".tool-row").forEach((row) => row.addEventListener("click", () => {
      row.setAttribute("aria-expanded", String(row.getAttribute("aria-expanded") !== "true"))
    }))
    railToggle?.addEventListener("click", () => setRail(demo.dataset.rail !== "open"))
    const touched = (event: Event) => { if (event.isTrusted) demo.dispatchEvent(new CustomEvent("demo:touched")) }
    demo.addEventListener("pointerdown", touched)
    demo.addEventListener("keydown", touched)
    demo.addEventListener("demo:spot", (event) => {
      const { spot, open: reveal } = (event as CustomEvent<{ spot?: string; open?: boolean }>).detail
      if (spot) demo.dataset.spot = spot
      else delete demo.dataset.spot
      if (!spot || !reveal) return
      const opener = demo.querySelector<HTMLElement>(`[data-spot-opens="${spot}"]`)
      const id = opener?.dataset.demoRow ?? opener?.dataset.demoOpen
      if (id) open(id)
    })
  }
</script>

<style>
  .demo {
    --demo-bg: #0d0d0d;
    --demo-rail: #181818;
    --demo-border: #303030;
    --demo-row-hover: #282828;
    --demo-row-selected: #303030;
    --demo-bubble: #2b2b2b;
    --demo-composer: #212121;
    --demo-composer-border: #303030;
    --demo-strong: #f2f2f2;
    --demo-text: #dcdcdc;
    --demo-weak: #a3a3a3;
    --demo-weaker: #747474;
    --demo-icon: #bdbdbd;
    --demo-icon-weak: #8a8a8a;
    --demo-accent: #369ce8;
    --demo-success: #35bd70;
    --demo-inset: #1c1c1c;
    --demo-send: #f2f2f2;
    --demo-send-ink: #0d0d0d;
    --demo-edge: rgba(255, 255, 255, 0.12);
    --demo-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.8);
    --demo-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 38rem;
    border-radius: 12px;
    background: var(--demo-bg);
    box-shadow: 0 0 0 1px var(--demo-edge), var(--demo-shadow);
    color: var(--demo-text);
    font: 14px/1.625 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  @media (prefers-color-scheme: light) {
    .demo {
      --demo-bg: #ffffff;
      --demo-rail: #f9f9f9;
      --demo-border: #ededed;
      --demo-row-hover: rgba(0, 0, 0, 0.04);
      --demo-row-selected: rgba(26, 28, 31, 0.05);
      --demo-bubble: #ededed;
      --demo-composer: #ffffff;
      --demo-composer-border: #d8d8d8;
      --demo-strong: #1a1c1f;
      --demo-text: #4f4f4f;
      --demo-weak: #696a6c;
      --demo-weaker: #8c8d8f;
      --demo-icon: #6f6f6f;
      --demo-icon-weak: #999999;
      --demo-accent: #2f92df;
      --demo-success: #168447;
      --demo-inset: #f7f7f7;
      --demo-send: #1a1c1f;
      --demo-send-ink: #ffffff;
      --demo-edge: rgba(0, 0, 0, 0.1);
      --demo-shadow: 0 40px 80px -48px rgba(0, 0, 0, 0.25);
    }
  }

  svg { width: 16px; height: 16px; flex: 0 0 16px; fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  p, h3, pre { margin: 0; }
  button { font: inherit; color: inherit; text-align: left; background: none; border: 0; padding: 0; cursor: pointer; }
  button:focus-visible { outline: 2px solid var(--demo-accent); outline-offset: -2px; }

  .titlebar { display: flex; height: 36px; flex: 0 0 36px; border-bottom: 1px solid var(--demo-border); color: var(--demo-icon); }
  .titlebar-rail { display: flex; align-items: center; gap: 14px; width: 260px; flex: 0 0 260px; padding-left: 14px; border-right: 1px solid var(--demo-border); background: var(--demo-rail); }
  .lights { display: flex; gap: 8px; }
  .lights i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }
  .titlebar-main { display: flex; align-items: center; flex: 1; min-width: 0; padding: 0 8px; }
  .titlebar-actions { display: flex; gap: 2px; margin-left: auto; }
  .icon-button { position: relative; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 6px; }
  button.icon-button:hover { background: var(--demo-row-hover); color: var(--demo-strong); }
  .phone-only { display: none; }

  .body { position: relative; display: flex; flex: 1; min-height: 0; }
  .rail { display: flex; flex-direction: column; width: 260px; flex: 0 0 260px; border-right: 1px solid var(--demo-border); background: var(--demo-rail); overflow: hidden; }
  .rail-global { display: grid; gap: 1px; padding: 8px 6px; border-bottom: 1px solid var(--demo-border); }
  .rail-projects { display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; flex: 1; gap: 1px; padding: 12px 6px; }
  .rail-projects > small { padding: 0 10px 6px; color: var(--demo-weaker); font-size: 11px; font-weight: 500; text-transform: uppercase; }
  .row { display: flex; align-items: center; gap: 8px; width: 100%; min-height: 28px; padding-inline: 10px; border-radius: 6px; color: var(--demo-strong); font-size: 13px; line-height: 1.3; white-space: nowrap; }
  .row > svg { color: var(--demo-icon-weak); }
  button.row:hover { background: var(--demo-row-hover); }
  .project { font-weight: 500; }
  .session { justify-content: space-between; padding-left: 34px; color: var(--demo-weak); }
  .session > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .session small { color: var(--demo-weaker); font-size: 11px; }
  .row.active { background: var(--demo-row-selected); color: var(--demo-strong); }
  .terminal-row { justify-content: flex-start; font-family: var(--demo-mono); font-size: 12px; }
  .account { width: auto; margin: 8px 6px; min-height: 36px; }
  .account i { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--demo-accent); color: #fff; font: 600 10px/1 system-ui, sans-serif; font-style: normal; }
  .account small { margin-left: auto; color: var(--demo-weaker); font-size: 11px; }

  .main { position: relative; flex: 1; min-width: 0; }
  .chat, .terminal { position: absolute; inset: 0; }
  .chat[hidden], .terminal[hidden] { display: none; }
  .transcript { display: flex; flex-direction: column; gap: 14px; width: min(100%, 48rem); height: 100%; margin: 0 auto; padding: 16px 24px 150px; overflow: auto; scrollbar-width: none; }
  .session-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 32px; }
  .session-head h3 { color: var(--demo-strong); font-size: 14px; font-weight: 500; }
  .place { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 8px; border-radius: 6px; background: var(--demo-inset); color: var(--demo-weak); font-size: 12px; white-space: nowrap; }
  .place svg { width: 14px; height: 14px; flex-basis: 14px; }
  .user { align-self: flex-end; max-width: min(82%, 60ch); padding: 8px 12px; border-radius: 10px; background: var(--demo-bubble); color: var(--demo-strong); line-height: 1.5; }
  .assistant { color: var(--demo-text); text-wrap: pretty; }
  .tool { margin: -6px 0; }
  .tool-row { display: flex; align-items: center; gap: 8px; min-height: 28px; margin-left: -6px; padding: 0 6px; border-radius: 6px; color: var(--demo-weak); }
  .tool-row:hover { background: var(--demo-row-hover); color: var(--demo-strong); }
  .tool-row > svg:first-child { width: 14px; height: 14px; flex-basis: 14px; color: var(--demo-icon-weak); }
  .chevron { width: 12px; height: 12px; flex-basis: 12px; color: var(--demo-icon-weak); transition: rotate 200ms cubic-bezier(0.2, 0, 0, 1); }
  .tool-row[aria-expanded="true"] .chevron { rotate: 90deg; }
  .tool-detail { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 200ms cubic-bezier(0.2, 0, 0, 1); }
  .tool-row[aria-expanded="true"] + .tool-detail { grid-template-rows: 1fr; }
