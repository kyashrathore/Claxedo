<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-app-replica]")) {
    type DemoSession = { id: string; title: string; user: string; responses: string[]; tools: string[]; context: string; branch: string; surface?: "chat" | "terminal" }
    const sessions = new Map((JSON.parse(root.dataset.demoSessions!) as DemoSession[]).map((session) => [session.id, session]))
    const drafts = new Map<string, string>()
    const composerInput = root.querySelector<HTMLTextAreaElement>("[data-composer-input]")

    const setSurface = (surface: string) => { root.dataset.surface = surface === "new" ? "chat" : surface }

    const setSidebar = (open: boolean) => {
      root.dataset.sidebar = open ? "open" : "closed"
      root.querySelectorAll<HTMLButtonElement>("[data-sidebar-toggle]").forEach((toggle) => {
        const isRailToggle = toggle.closest(".rail-titlebar") !== null
        toggle.setAttribute("aria-pressed", String(isRailToggle && open))
        toggle.setAttribute("aria-label", isRailToggle ? "Hide Sidebar" : "Show Sidebar")
      })
    }
    root.querySelectorAll<HTMLButtonElement>("[data-sidebar-toggle]").forEach((button) => button.addEventListener("click", () => setSidebar(root.dataset.sidebar !== "open")))

    const selectSession = (id: string) => {
      const session = sessions.get(id)
      if (!session) return
      setSurface(session.surface ?? "chat")
      if (session.surface === "terminal") {
        const views = Array.from(root.querySelectorAll<HTMLElement>("[data-terminal-session]"))
        const activeView = views.find((view) => view.dataset.terminalSession === id) ?? views.find((view) => view.dataset.terminalSession === "default")
        views.forEach((view) => view.hidden = view !== activeView)
      }
      root.dataset.activeSession = id
      root.querySelectorAll<HTMLElement>("[data-session-id]").forEach((item) => item.classList.toggle("active", item.dataset.sessionId === id))
      root.querySelectorAll<HTMLElement>(".compact-tab").forEach((tab) => {
        const selected = tab.querySelector<HTMLElement>("[data-session-tab-id]")?.dataset.sessionTabId === id
        tab.dataset.selected = selected ? "true" : "false"
        tab.querySelector<HTMLButtonElement>("[role=tab]")?.setAttribute("aria-selected", String(selected))
      })
      root.querySelector<HTMLElement>("[data-session-title]")!.textContent = session.title
      root.querySelector<HTMLElement>(".timeline-column")?.classList.toggle("empty-session", session.user.length === 0)
      root.querySelector<HTMLElement>("[data-transcript-user]")!.textContent = session.user
      root.querySelector<HTMLElement>("[data-session-context]")!.textContent = session.context
      root.querySelector<HTMLElement>("[data-session-branch]")!.textContent = session.branch
      session.responses.forEach((copy, index) => { const row = root.querySelector<HTMLElement>(`[data-transcript-response="${index}"]`); if (row) row.textContent = copy })
      session.tools.forEach((copy, index) => { const row = root.querySelector<HTMLElement>(`[data-transcript-tool="${index}"]`); if (row) row.textContent = copy })
      if (composerInput) composerInput.value = drafts.get(id) ?? ""
      if (window.innerWidth < 768) setSidebar(false)
    }
    const bindSessionRow = (button: HTMLButtonElement) => button.addEventListener("click", () => selectSession(button.dataset.sessionId ?? ""))
    root.querySelectorAll<HTMLButtonElement>("[data-session-id]").forEach(bindSessionRow)
    root.querySelector<HTMLElement>(".compact-tabs")?.addEventListener("click", (event) => {
      const target = event.target as Element
      const close = target.closest<HTMLButtonElement>(".tab-close")
      if (close) {
        const tab = close.closest<HTMLElement>(".compact-tab")
        if (!tab) return
        tab.hidden = true
        if (tab.dataset.selected === "true") {
          const next = root.querySelector<HTMLElement>(".compact-tab:not([hidden]) [data-session-tab-id]")?.dataset.sessionTabId
          if (next) selectSession(next)
        }
        return
      }
      const tabButton = target.closest<HTMLButtonElement>("[data-session-tab-id]")
      if (tabButton) selectSession(tabButton.dataset.sessionTabId ?? "")
    })
    composerInput?.addEventListener("input", () => drafts.set(root.dataset.activeSession!, composerInput.value))
    root.querySelector<HTMLFormElement>("[data-composer-form]")?.addEventListener("submit", (event) => event.preventDefault())
    root.querySelector<HTMLButtonElement>("[data-scroll-latest]")?.addEventListener("click", () => root.querySelector<HTMLElement>(".timeline-scroll")?.scrollTo({ top: root.querySelector<HTMLElement>(".timeline-scroll")?.scrollHeight ?? 0, behavior: "smooth" }))
    let createdSessionCount = 0
    let createdTerminalCount = 0
    const addSessionEntry = (session: DemoSession) => {
      const row = root.querySelector<HTMLButtonElement>(".session-list [data-session-id]")!.cloneNode(true) as HTMLButtonElement
      row.classList.remove("active")
      row.dataset.sessionId = session.id
      row.querySelector("span")!.textContent = session.title
      row.querySelector("small")!.textContent = "now"
      root.querySelector(".session-list .load-row")?.before(row)
      bindSessionRow(row)

      const tab = root.querySelector<HTMLElement>(".compact-tab")!.cloneNode(true) as HTMLElement
      tab.hidden = false
      tab.dataset.selected = "false"
      const tabTargets = tab.querySelectorAll<HTMLElement>("[data-session-tab-id]")
      tabTargets.forEach((target) => target.dataset.sessionTabId = session.id)
      const prefix = tab.querySelector<HTMLButtonElement>(".tab-prefix")!
      prefix.setAttribute("aria-label", `Claxedo / ${session.title}`)
      const title = tab.querySelector<HTMLButtonElement>(".tab-title")!
      title.textContent = session.title
      title.setAttribute("aria-selected", "false")
      tab.querySelector<HTMLButtonElement>(".tab-close")!.setAttribute("aria-label", `Close ${session.title}`)
      root.querySelector(".compact-tabs")?.append(tab)
    }
    const createSession = (surface: "chat" | "terminal") => {
      const isTerminal = surface === "terminal"
      const sequence = isTerminal ? ++createdTerminalCount : ++createdSessionCount
      const title = isTerminal ? `Terminal ${sequence}` : sequence === 1 ? "New Session" : `New Session ${sequence}`
      const session: DemoSession = { id: `created-${surface}-${sequence}`, title, surface, user: "", responses: ["", "", ""], tools: ["", "", ""], context: "packages/claxedo-app", branch: "main" }
      sessions.set(session.id, session)
      addSessionEntry(session)
      selectSession(session.id)
    }
    root.querySelectorAll<HTMLButtonElement>("[data-surface-button]").forEach((button) => button.addEventListener("click", () => {
      const surface = button.dataset.surfaceButton ?? "chat"
      if (surface === "new") createSession("chat")
      else if (surface === "terminal") createSession("terminal")
      else setSurface(surface)
    }))

    const setPanelWidth = (full: boolean) => {
      root.dataset.panelWidth = full ? "full" : "split"
      root.querySelectorAll<HTMLButtonElement>("[data-panel-maximize]").forEach((button) => {
        button.setAttribute("aria-pressed", String(full))
        button.setAttribute("aria-label", full ? "Restore workspace panel width" : "Maximize workspace panel")
      })
    }
    const closePanel = () => { root.dataset.panel = "closed"; setPanelWidth(false); const toggle = root.querySelector<HTMLButtonElement>("[data-workspace-toggle]"); toggle?.setAttribute("aria-pressed", "false"); toggle?.setAttribute("aria-label", "Open workspace panel") }
    const setPanel = (panel: string) => {
      root.dataset.panel = "open"; root.dataset.panelViewActive = panel
      root.querySelectorAll<HTMLButtonElement>("[data-panel-button]").forEach((button) => button.classList.toggle("active", button.dataset.panelButton === panel))
      root.querySelectorAll<HTMLElement>("[data-panel-view]").forEach((view) => view.hidden = view.dataset.panelView !== panel)
      const toggle = root.querySelector<HTMLButtonElement>("[data-workspace-toggle]"); toggle?.setAttribute("aria-pressed", "true"); toggle?.setAttribute("aria-label", "Close workspace panel")
    }
    root.querySelectorAll<HTMLButtonElement>("[data-panel-button]").forEach((button) => button.addEventListener("click", () => setPanel(button.dataset.panelButton ?? "changes")))
    root.querySelectorAll<HTMLButtonElement>("[data-repo-folder]").forEach((button) => button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") === "true"
      root.querySelectorAll<HTMLButtonElement>("[data-repo-folder]").forEach((folder) => folder.setAttribute("aria-expanded", "false"))
      button.setAttribute("aria-expanded", String(!open))
      const children = root.querySelector<HTMLElement>("[data-repo-children]")
      if (children) {
        children.hidden = open
        if (!open) button.insertAdjacentElement("afterend", children)
      }
    }))
    root.querySelectorAll<HTMLButtonElement>("[data-panel-close]").forEach((button) => button.addEventListener("click", closePanel))
    root.querySelectorAll<HTMLButtonElement>("[data-panel-maximize]").forEach((button) => button.addEventListener("click", () => setPanelWidth(root.dataset.panelWidth !== "full")))
    root.querySelector<HTMLButtonElement>("[data-workspace-toggle]")?.addEventListener("click", () => root.dataset.panel === "closed" ? setPanel(root.dataset.panelViewActive ?? "changes") : closePanel())
    type ResponsiveBand = "mobile" | "compact" | "wide"
    const responsiveBand = (): ResponsiveBand => window.innerWidth < 768 ? "mobile" : window.innerWidth <= 920 ? "compact" : "wide"
    let currentBand: ResponsiveBand | undefined
    const applyResponsiveDefaults = () => {
      const nextBand = responsiveBand()
      if (nextBand === currentBand) return
      currentBand = nextBand
      setSidebar(false)
      if (nextBand === "wide") {
        root.dataset.environment = "expanded"
        closePanel()
      } else {
        root.dataset.environment = "collapsed"
        closePanel()
      }
    }
    applyResponsiveDefaults()
    window.addEventListener("resize", applyResponsiveDefaults, { passive: true })
    root.querySelectorAll<HTMLButtonElement>("[data-environment-toggle]").forEach((button) => button.addEventListener("click", () => root.dataset.environment = root.dataset.environment === "expanded" ? "collapsed" : "expanded"))
    root.querySelectorAll<HTMLButtonElement>("[data-tool-card]").forEach((button) => button.addEventListener("click", () => button.setAttribute("aria-expanded", String(button.getAttribute("aria-expanded") !== "true"))))

    const setComposerMenu = (menu: string) => { root.dataset.composerMenu = menu; root.querySelectorAll<HTMLElement>("[data-composer-popover]").forEach((popover) => popover.hidden = popover.dataset.composerPopover !== menu); root.querySelectorAll<HTMLButtonElement>("[data-composer-menu-trigger]").forEach((button) => button.setAttribute("aria-expanded", String(button.dataset.composerMenuTrigger === menu))) }
    root.querySelectorAll<HTMLButtonElement>("[data-composer-menu-trigger]").forEach((button) => button.addEventListener("click", () => { const menu = button.dataset.composerMenuTrigger ?? "closed"; setComposerMenu(root.dataset.composerMenu === menu ? "closed" : menu) }))
    root.querySelectorAll<HTMLButtonElement>("[data-context-option]").forEach((button) => button.addEventListener("click", () => { const chip = root.querySelector<HTMLElement>("[data-composer-context-chip]"); const label = root.querySelector<HTMLElement>("[data-composer-context-label]"); if (chip) chip.hidden = false; if (label) label.textContent = button.dataset.contextOption ?? "Files"; setComposerMenu("closed") }))
    root.querySelector<HTMLButtonElement>("[data-context-remove]")?.addEventListener("click", () => { const chip = root.querySelector<HTMLElement>("[data-composer-context-chip]"); if (chip) chip.hidden = true })
    root.querySelectorAll<HTMLButtonElement>("[data-permission]").forEach((button) => button.addEventListener("click", () => { root.querySelectorAll<HTMLButtonElement>("[data-permission]").forEach((item) => { const selected = item === button; item.classList.toggle("selected", selected); const mark = item.querySelector("em"); if (mark) mark.textContent = selected ? "✓" : "" }); root.querySelector<HTMLElement>("[data-permission-label]")!.textContent = button.dataset.permission ?? "Workspace Write"; setComposerMenu("closed") }))
    root.querySelectorAll<HTMLButtonElement>("[data-harness-section]").forEach((button) => button.addEventListener("click", () => {
      const section = button.dataset.harnessSection ?? "model"
      const popover = button.closest<HTMLElement>("[data-picker-open]")
      if (!popover) return
      popover.dataset.pickerOpen = section
      popover.querySelectorAll<HTMLButtonElement>("[data-harness-section]").forEach((row) => row.classList.toggle("active", row.dataset.harnessSection === section))
      popover.querySelectorAll<HTMLElement>("[data-harness-panel]").forEach((panel) => panel.hidden = panel.dataset.harnessPanel !== section)
    }))
    root.querySelectorAll<HTMLButtonElement>("[data-hero-harness]").forEach((button) => button.addEventListener("click", () => {
      root.querySelectorAll<HTMLButtonElement>("[data-hero-harness]").forEach((item) => { item.classList.toggle("selected", item === button); const check = item.querySelector("em"); if (check) check.textContent = item === button ? "✓" : "" })
      const harness = button.dataset.heroHarness ?? "Codex"
      const model = button.dataset.heroModel ?? "GPT-5.6-Luna"
      root.querySelector<HTMLElement>("[data-current-harness]")!.textContent = harness
      root.querySelector<HTMLElement>("[data-hero-model-label]")!.textContent = model
      root.querySelector<HTMLElement>("[data-hero-model-trigger]")!.textContent = model
      const source = button.querySelector<HTMLElement>(".harness-logo")
      const triggerMark = root.querySelector<HTMLElement>("[data-hero-harness-mark]")
      if (source && triggerMark) triggerMark.innerHTML = source.innerHTML
    }))
    root.querySelectorAll<HTMLButtonElement>("[data-hero-model-choice]").forEach((button) => button.addEventListener("click", () => {
      root.querySelectorAll<HTMLButtonElement>("[data-hero-model-choice]").forEach((item) => { item.classList.toggle("selected", item === button); const check = item.querySelector("em"); if (check) check.textContent = item === button ? "✓" : "" })
      const model = button.dataset.heroModelChoice ?? "GPT-5.6-Luna"
      root.querySelector<HTMLElement>("[data-hero-model-label]")!.textContent = model
      root.querySelector<HTMLElement>("[data-hero-model-trigger]")!.textContent = model
    }))
    root.querySelectorAll<HTMLButtonElement>("[data-hero-effort]").forEach((button) => button.addEventListener("click", () => {
      root.querySelectorAll<HTMLButtonElement>("[data-hero-effort]").forEach((item) => { item.classList.toggle("selected", item === button); const check = item.querySelector("em"); if (check) check.textContent = item === button ? "✓" : "" })
      const effort = button.dataset.heroEffort ?? "Low"
      root.querySelector<HTMLElement>("[data-hero-effort-label]")!.textContent = effort
      root.querySelector<HTMLElement>("[data-hero-effort-trigger]")!.textContent = effort
    }))
    root.querySelector<HTMLButtonElement>("[data-account-toggle]")?.addEventListener("click", (event) => { const open = root.dataset.account === "open"; root.dataset.account = open ? "closed" : "open"; (event.currentTarget as HTMLButtonElement).setAttribute("aria-expanded", String(!open)) })
  }
</script>

