---
import type { GetStaticPaths } from "astro"
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import Footer from "../../components/Footer.astro"
import DownloadMenu from "../../components/DownloadMenu.astro"
import ComparisonTable from "../../components/ComparisonTable.astro"
import ComparisonSources from "../../components/ComparisonSources.astro"
import { comparisonIsExpired, publicComparisons, type Competitor } from "../../content/competitors"

export const getStaticPaths = (() =>
  publicComparisons.map((competitor) => ({ params: { competitor: competitor.slug }, props: { competitor } }))) satisfies GetStaticPaths

interface Props { competitor: Competitor }
const { competitor } = Astro.props
const expired = comparisonIsExpired(competitor)
---

<Layout
  title={`Claxedo vs. ${competitor.name} — a sourced comparison`}
  description={`How Claxedo compares to ${competitor.name}: ${competitor.tagline}`}
  noindex={expired}
>
  <div class="shell">
    <Nav active="compare" />
    <main id="main-content">
      <section class="cmp-hero">
        <div class="cmp-hero-inner">
          <a href="/compare" class="cmp-back">← All comparisons</a>
          <p class="eyebrow">{competitor.category}</p>
          <h1 class="display">Claxedo vs. {competitor.name}</h1>
          <p class="cmp-verdict">{competitor.verdict}</p>
          <div class="actions">
            <DownloadMenu placement={`compare-${competitor.slug}`} />
          </div>
          {expired && <p class="cmp-notice" role="status">This comparison is past its review date. It stays at its URL but is excluded from search until re-verified.</p>}
        </div>
      </section>

      <section class="section">
        <div class="section-inner">
          <p class="eyebrow">01 · Side by side</p>
          <h2 class="section-title">The capabilities that decide it.</h2>
          <ComparisonTable competitor={competitor} />
        </div>
      </section>

      <section class="section dark-band">
        <div class="section-inner cmp-two-col">
          <div>
            <p class="eyebrow">02 · Where {competitor.name} is genuinely better</p>
            <ul class="cmp-list cmp-list-edge">{competitor.genuineEdge.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div>
            <p class="eyebrow">03 · Where Claxedo differs</p>
            <ul class="cmp-list cmp-list-diff">{competitor.claxedoDiffers.map((item) => <li>{item}</li>)}</ul>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-inner">
          <p class="eyebrow">04 · Which should you pick</p>
          <div class="cmp-choose">
            <article><span>Choose {competitor.name} if</span><p>{competitor.chooseThem}</p></article>
            <article class="cmp-choose-us"><span>Choose Claxedo if</span><p>{competitor.chooseClaxedo}</p></article>
          </div>
        </div>
      </section>

      <section class="section dark-band">
        <div class="section-inner cmp-close">
          <ComparisonSources competitor={competitor} />
          <div>
            <p class="eyebrow">05 · Make your own call</p>
            <h2 class="section-title">Use the workspace. Read the source.</h2>
            <p class="section-copy">Every claim here links to a first-party source. The fastest way to compare is to run both.</p>
            <div class="actions"><DownloadMenu placement={`compare-close-${competitor.slug}`} /><a class="btn-secondary" href="/compare">See all comparisons</a></div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .cmp-hero { padding: clamp(3rem, 7vw, 6rem) var(--gutter) clamp(3rem, 6vw, 5rem); border-bottom: 1px solid var(--line); }
  .cmp-hero-inner { max-width: 72rem; margin-inline: auto; }
  .cmp-back { display: inline-block; margin-bottom: 2.5rem; color: var(--ink-faint); font: 500 .8rem var(--font-sans); text-decoration: none; }
  .cmp-back:hover { color: var(--ink); }
  .cmp-hero .display { max-width: 16ch; margin-bottom: 1.6rem; font-size: clamp(2.4rem, 5.2vw, 3.8rem); }
  .cmp-verdict { max-width: 52rem; margin-bottom: 2rem; color: var(--ink-soft); font-size: clamp(1.05rem, 1.5vw, 1.28rem); line-height: 1.6; text-wrap: pretty; }
  .cmp-notice { margin-top: 2rem; padding: .9rem 1.1rem; border: 1px solid var(--warn-text); border-radius: var(--radius); background: var(--warn-bg); color: var(--warn-text); font-size: .85rem; }

  .cmp-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .cmp-list { margin: 1.5rem 0 0; padding: 0; list-style: none; display: grid; gap: .8rem; }
  .cmp-list li { position: relative; padding-left: 1.5rem; color: var(--ink-soft); font-size: .95rem; line-height: 1.55; }
  .cmp-list li::before { position: absolute; left: 0; top: 0; font: 500 .95rem/1.5 var(--font-mono); }
  .cmp-list-edge li::before { content: "+"; color: var(--ink-faint); }
  .cmp-list-diff li::before { content: "→"; color: var(--accent-text); }

  .cmp-choose { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2.5rem; }
  .cmp-choose article { min-height: 11rem; display: grid; align-content: start; gap: 1rem; padding: 1.6rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); }
  .cmp-choose span { color: var(--ink-faint); font: 500 .68rem var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .cmp-choose p { margin: 0; color: var(--ink-soft); font-size: 1rem; line-height: 1.6; }
  .cmp-choose-us { background: color-mix(in srgb, var(--accent) 8%, var(--surface)); border-color: color-mix(in srgb, var(--accent) 22%, var(--line)); }
  .cmp-choose-us span { color: var(--accent-text); }
  .cmp-choose-us p { color: var(--ink); }

  .cmp-close { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .cmp-close .section-copy { margin: 1rem 0 2rem; }

  @media (max-width: 46rem) { .cmp-two-col, .cmp-choose, .cmp-close { grid-template-columns: 1fr; } }
</style>
