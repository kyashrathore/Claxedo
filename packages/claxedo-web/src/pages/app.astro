---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import DownloadMenu from "../components/DownloadMenu.astro"
---

<Layout title="Claxedo is one product" description="The Claxedo app is part of the Claxedo connected agent workspace." noindex={true} canonicalPath="/">
  <div class="shell">
    <Nav />
    <main id="main-content" class="transition-page">
      <p class="eyebrow">Route transition</p>
      <h1 class="display">The app is Claxedo.</h1>
      <p class="section-copy">Claxedo Desktop and Claxedo Web are clients for one connected agent workspace. Product information now lives on the Claxedo homepage.</p>
      <div class="actions"><a class="btn-secondary" href="/">Go to Claxedo</a><DownloadMenu placement="app-transition" /></div>
    </main>
    <Footer />
  </div>
</Layout>

<style>.transition-page { min-height: 65vh; padding: var(--section) var(--gutter); } .transition-page .section-copy { margin-bottom: 2rem; }</style>
