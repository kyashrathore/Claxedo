---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import DownloadMenu from "../components/DownloadMenu.astro"

const harnesses = ["Claude Code", "Codex", "Gemini CLI"]

const proof = [
  {
    tag: "Every agent, as itself",
    title: "Run it in a terminal — or in chat",
    desc: "Drive an agent straight from a terminal with keyboard shortcuts, or talk to it in chat — both work on the same session, and Claxedo manages its status, hooks, and lifecycle either way. Model-agnostic isn't enough: Claude Code, Codex, and Gemini CLI run as themselves, not flattened into one loop.",
  },
  {
    tag: "One session",
    title: "Local, cloud, or split",
    desc: "Run the whole loop on your machine. Or in the cloud. Or split it — brain central, hands local — so reasoning runs hosted while tools execute right next to your code, where they're fast. Same session, your call, on your own sandbox provider.",
  },
  {
    tag: "Feedback loop",
    title: "It runs what it builds",
    desc: "The agent doesn't just write code — it runs it and watches what happens. It manages your processes and reads their output, and tests what it built in an in-app browser, feeding results straight back into the loop.",
    tags: ["process management — now", "in-app browser testing — at release"],
  },
  {
    tag: "Review",
    title: "Inspect diffs before anything lands",
    desc: "Open a dedicated review surface for changed files, session diffs, and comments before you decide what ships — built for multi-agent work.",
  },
]

const everything = [
  { h: "Built-in terminal", p: "A real terminal alongside your agents." },
  { h: "Git worktrees", p: "Isolate parallel work without conflicts." },
  { h: "Cross-platform", p: "macOS, Windows, and Linux." },
  { h: "Themes & shortcuts", p: "Bend the environment to your habits, not the reverse." },
  { h: "Workspace-aware MCP", p: "Context that follows the active workspace, not just the file." },
  { h: "Panes, tabs & groups", p: "Many workspaces open at once; split into side-by-side panes on demand." },
]

const trust = ["MIT licensed", "BYO harness + model", "Your backend or ours", "Hosting is the only paid tier"]

const faq = [
  { q: "Isn't this just another Codex clone?", a: "No — Codex runs only OpenAI models. Claxedo runs Claude Code, Codex, and Gemini CLI, each as itself, and the whole app is MIT-licensed and open." },
  { q: "Another open app that's slow?", a: "Performance is the point — the app is built to stay responsive as sessions, panes, and diffs pile up. Download it and judge the feel yourself; it's free." },
  { q: "What does it cost?", a: "The app is free and open source. You pay your model provider directly. Managed hosting is the only paid tier." },
  { q: "Which agents are supported?", a: "Any CLI coding agent — Claude Code, Codex, Gemini CLI, and more — each in its own managed terminal, with status and hooks handled for you." },
  { q: "What if my vendor starts metering my automation?", a: "That's exactly why Claxedo is harness-neutral. Switch harness or model without losing your skills, plugins, or setup." },
  { q: "What platforms?", a: "macOS, Linux, and Windows." },
]
---

<Layout title="Claxedo App — Every coding agent, one app that stays fast">
  <div class="page-frame">
    <Nav active="app" />

    <section class="hero">
      <div class="hero-copy">
        <span class="hero-kicker" data-reveal="1"><span class="dot"></span> The app — the front of your stack</span>
        <h1 class="hero-title" data-reveal="2">Every coding agent. One app that <span class="accent">stays fast.</span></h1>
        <p class="hero-sub" data-reveal="3">
          Claude Code, Codex, Gemini CLI — run them as themselves, local or cloud, with
          your skills synced across all of them. MIT-licensed, like every layer under it.
          Point it at our hosted backend, or at one you deployed yourself.
        </p>
        <div class="hero-actions" data-reveal="4">
          <DownloadMenu />
          <a class="btn-secondary" href="#tour">See the workspace ↓</a>
        </div>
        <p class="hero-note" data-reveal="5">macOS · Windows · Linux — free and open source.</p>
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// The problem</span>
        <h2 class="section-title">Open tools make you trade UX for freedom. Closed tools lock you in.</h2>
        <p class="section-lead">
          You shouldn't have to pick. The polished agent apps are single-vendor and
          charge a toll. The open ones are honest but fragmented — every harness
          configured separately, no shared skills, no real feedback loop. Claxedo is the
          one that's open <em>and</em> fast <em>and</em> neutral.
        </p>
      </div>
    </section>

    <section class="section section--ruled marquee">
      <span class="section-tag">// The thing no one else does</span>
      <h2 class="marquee-statement">Write a skill once. It works in every agent — local and cloud.</h2>
      <p class="marquee-sub">
        Every other multi-agent tool makes you set up each harness separately. Claxedo
        keeps your skills, plugins, and MCP servers in one library and syncs them to all
        of them. Change a skill, every agent has it.
      </p>
      <div class="sync-viz" aria-hidden="true">
        <span class="sync-source">◆ one skill library</span>
        <span class="sync-arrows">→→</span>
        <div class="sync-targets">
          {harnesses.map((h) => <span class="chip"><span class="dot"></span>{h}</span>)}
        </div>
      </div>
    </section>

    <section id="tour" class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// The workspace</span>
        <h2 class="section-title">Two agents, one workspace, your phone in the loop.</h2>
        <p class="section-lead">
          Sessions live in tabs and split panes. Each harness runs as itself in a real
          terminal, the same skills loaded in every one — and any session, including the
          ones on your laptop, is reachable from the web or your phone.
        </p>
      </div>

      <div class="stage" aria-label="Illustration of the Claxedo workspace: two agent sessions side by side with a phone following one of them.">
        <div class="frame" role="img" aria-hidden="true">
          <div class="frame-bar">
            <span class="frame-dots"><i></i><i></i><i></i></span>
            <span class="frame-tab is-on">api-server</span>
            <span class="frame-tab">web-app</span>
            <span class="frame-tab frame-tab--plus">+</span>
            <span class="frame-sync"><span class="dot"></span>skills synced</span>
          </div>
          <div class="frame-body">
            <div class="pane">
              <div class="pane-head">
                <span class="pane-agent">claude code</span>
                <span class="pane-place">local</span>
              </div>
              <div class="pane-term">
                <p><span class="t-dim">$</span> claude <span class="t-dim">— fix the failing session test</span></p>
                <p><span class="t-ok">✓</span> read workspace-runtime/src/session.test.ts</p>
                <p><span class="t-ok">✓</span> bun test — 14 passing, 1 fixed</p>
                <p><span class="t-dim">tokens 12.4k · turn 3</span></p>
                <p class="t-cursor"><span class="t-dim">›</span> <span class="caret"></span></p>
              </div>
            </div>
            <div class="pane">
              <div class="pane-head">
                <span class="pane-agent">codex</span>
                <span class="pane-place pane-place--cloud">cloud · box-1</span>
              </div>
              <div class="pane-term">
                <p><span class="t-dim">$</span> codex <span class="t-dim">— refactor auth middleware</span></p>
                <p><span class="t-run">▸</span> editing src/auth/session.ts</p>
                <p><span class="t-dim">staged diff</span> <span class="t-add">+42</span> <span class="t-del">−17</span></p>
                <p><span class="t-dim">same skills, same MCP — synced by the backend</span></p>
                <p class="t-cursor"><span class="t-dim">›</span> <span class="caret"></span></p>
              </div>
            </div>
          </div>
          <div class="frame-status">
            <span>2 sessions · 1 local · 1 cloud</span>
            <span class="t-dim">relay: connected — no inbound ports</span>
          </div>
        </div>

        <div class="phone" aria-hidden="true">
          <div class="phone-bar"><i></i></div>
          <div class="phone-body">
            <p class="phone-title">api-server<span class="t-dim"> · claude code</span></p>
            <p class="t-ok">✓ 14 passing, 1 fixed</p>
            <p class="t-dim">waiting on approval:</p>
            <p class="phone-tool">run: git push origin fix/session</p>
            <div class="phone-actions">
              <span class="phone-btn phone-btn--yes">Approve</span>
              <span class="phone-btn">Deny</span>
            </div>
          </div>
        </div>
      </div>
      <p class="stage-caption">An illustration, not a screenshot — download the real thing and judge it yourself.</p>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// What it does</span>
        <h2 class="section-title">Built for real coding sessions.</h2>
      </div>
      <div class="cards cards--two">
        {proof.map((item) => (
          <article class="card">
            <span class="proof-tag">{item.tag}</span>
            <div class="card-head"><h3>{item.title}</h3></div>
            <p>{item.desc}</p>
            {item.tags && (
              <div class="chips" style="margin-top:1rem">
                {item.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// Stays fast</span>
        <h2 class="section-title">Speed you feel as the session grows.</h2>
        <p class="section-lead">
          More agents, more panes, more diffs — and the app stays responsive.
          Performance isn't a benchmark we quote; it's what you notice after ten tabs
          open all day.
        </p>
      </div>
      <div class="cards cards--two">
        {everything.map((item) => (
          <article class="card">
            <div class="card-head"><h3>{item.h}</h3></div>
            <p>{item.p}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// Why you can trust it</span>
        <h2 class="section-title">MIT — the app, and everything under it.</h2>
        <p class="section-lead">
          The whole stack is MIT-licensed and open: the app, the backend it talks to, the
          relay, and the packages they're built from. You bring your harness and your
          model. Run our hosted backend, or deploy your own with one command — same
          published code either way. Hosting is the only thing we'd ever charge for.
        </p>
      </div>
      <div class="chips">
        {trust.map((t) => <span class="chip"><span class="dot"></span>{t}</span>)}
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// FAQ</span>
        <h2 class="section-title">Questions, answered.</h2>
      </div>
      <div class="faq-list" style="border-top:none">
        {faq.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section section--ruled cta-band">
      <span class="section-tag">// Get started</span>
      <h2 class="section-title">Bring the agent. Bring the model. Keep the speed.</h2>
      <div class="hero-actions">
        <DownloadMenu />
        <a class="btn-secondary" href="/#deploy">Deploy the stack it runs on →</a>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  /* ---- Workspace stage (crafted illustration, no screenshots) ---- */
  .stage {
    position: relative;
    max-width: 62rem;
  }

  .frame {
    border: var(--bw) solid var(--border);
    background: hsl(0, 9%, 7%);
    color: hsl(0, 4%, 78%);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.75;
    box-shadow: 0 24px 70px color-mix(in srgb, var(--text-strong) 16%, transparent);
  }

  .frame-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: var(--bw) solid hsl(0, 4%, 18%);
  }

  .frame-dots { display: inline-flex; gap: 6px; margin-right: 6px; }
  .frame-dots i { width: 10px; height: 10px; border-radius: 999px; background: hsl(0, 4%, 24%); }

  .frame-tab {
    padding: 3px 12px;
    font-size: 12px;
    color: hsl(0, 3%, 55%);
    border: 1px solid hsl(0, 4%, 20%);
  }
  .frame-tab.is-on { color: hsl(62, 60%, 82%); border-color: hsl(62, 30%, 34%); background: hsl(62, 24%, 12%); }
  .frame-tab--plus { border-style: dashed; }

  .frame-sync {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(0, 3%, 55%);
  }
  .frame-sync .dot { width: 7px; height: 7px; border-radius: 999px; background: var(--accent); }

  .frame-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .pane + .pane { border-left: var(--bw) solid hsl(0, 4%, 18%); }

  .pane-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 9px 16px;
    border-bottom: 1px solid hsl(0, 4%, 16%);
  }

  .pane-agent {
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 11.5px;
    color: hsl(0, 4%, 86%);
  }

  .pane-place {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: hsl(0, 3%, 52%);
    border: 1px solid hsl(0, 4%, 22%);
    padding: 1px 8px;
  }
  .pane-place--cloud { color: hsl(62, 50%, 74%); border-color: hsl(62, 26%, 30%); }

  .pane-term { padding: 14px 16px 16px; min-height: 11.5rem; }
  .pane-term p { margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .t-dim { color: hsl(0, 3%, 48%); }
  .t-ok { color: hsl(140, 42%, 62%); }
  .t-run { color: hsl(62, 60%, 72%); }
  .t-add { color: hsl(140, 42%, 62%); }
  .t-del { color: hsl(4, 60%, 66%); }

  .t-cursor { margin-top: 0.5rem; }
  .caret {
    display: inline-block;
    width: 8px;
    height: 15px;
    vertical-align: -2px;
    background: hsl(62, 60%, 72%);
    animation: caret-blink 1.1s steps(1) infinite;
  }
  @keyframes caret-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }

  .frame-status {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 8px 16px;
    border-top: var(--bw) solid hsl(0, 4%, 18%);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: hsl(0, 3%, 58%);
  }

  /* phone follows the same session — overlapped composition */
  .phone {
    position: absolute;
    right: -1rem;
    bottom: -2.4rem;
    width: 15.5rem;
    border: var(--bw) solid var(--border);
    background: hsl(0, 9%, 9%);
    color: hsl(0, 4%, 78%);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    box-shadow: 0 18px 50px color-mix(in srgb, var(--text-strong) 22%, transparent);
  }

  .phone-bar { display: grid; place-items: center; padding: 7px 0 2px; }
  .phone-bar i { width: 4rem; height: 4px; border-radius: 999px; background: hsl(0, 4%, 24%); }

  .phone-body { padding: 10px 14px 14px; }
  .phone-body p { margin: 0 0 2px; }
  .phone-title { color: hsl(0, 4%, 88%); font-weight: 500; }

  .phone-tool {
    margin-top: 4px;
    padding: 6px 9px;
    border: 1px solid hsl(0, 4%, 22%);
    background: hsl(0, 8%, 12%);
    color: hsl(0, 4%, 82%);
    font-size: 11.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .phone-actions { display: flex; gap: 8px; margin-top: 10px; }
  .phone-btn {
    flex: 1;
    text-align: center;
    padding: 6px 0;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid hsl(0, 4%, 26%);
    color: hsl(0, 3%, 62%);
  }
  .phone-btn--yes { background: var(--accent); border-color: var(--accent); color: var(--accent-text); }

  .stage-caption {
    margin-top: 3.4rem;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-weak);
  }

  .proof-tag {
    display: inline-block;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-weak);
  }

  @media (max-width: 52rem) {
    .frame-body { grid-template-columns: 1fr; }
    .pane + .pane { border-left: none; border-top: var(--bw) solid hsl(0, 4%, 18%); }
    .phone {
      position: static;
      width: 100%;
      max-width: 20rem;
      margin: 1rem 0 0 auto;
    }
    .stage-caption { margin-top: 1.25rem; }
  }
</style>
