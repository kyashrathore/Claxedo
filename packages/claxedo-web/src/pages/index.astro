---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import ClaxedoAppReplica from "../components/ClaxedoAppReplica.astro"
import DownloadMenu from "../components/DownloadMenu.astro"
import { requireClaim } from "../content/claims"
import { home, site, type HomeLine } from "../content/site"

for (const id of [...home.benchmark.claims, ...home.closing.claims, ...home.lines.flatMap((line) => line.claims)]) requireClaim(id)

const parts = (line: HomeLine) => {
  const at = line.text.indexOf(line.loud)
  return [
    { text: line.text.slice(0, at), loud: false },
    { text: line.loud, loud: true },
    { text: line.text.slice(at + line.loud.length), loud: false },
  ].filter((part) => part.text.trim().length > 0)
}
const speedProof = home.lines.find((line) => line.id === home.benchmark.line)?.proof
---

<Layout title={`Claxedo — ${site.headline}`} description={site.description}>
  <Nav />
  <main id="main-content" class="home">
    <h1 class="sr-only">Claxedo</h1>
    <section class="story" aria-label="What Claxedo does" data-story style={`--steps:${home.lines.length}`}>
      <div class="pin" data-pin>
        <ol class="stage" data-stage>
          {home.lines.map((line, index) => (
            <li class:list={["stage-line", { "is-in": index === 0 }]} data-stage-line={line.id}>
              <p class="sentence">
                {parts(line).map((part) => <span class:list={[part.loud ? "loud" : "muted"]}>{part.text}</span>)}
              </p>
              <span class="proof-slot">
                {line.proof && line.id !== home.benchmark.line && <a class="quiet-link" href={line.proof.href} data-proof>{line.proof.label}</a>}
              </span>
            </li>
          ))}
        </ol>
        <div class="demo-area">
          <div class="demo-frame" data-zoom>
            <ClaxedoAppReplica />
            <div class="scrim" data-metrics>
              <dl class="metrics">
                {home.benchmark.metrics.map((metric) => (
                  <div class="metric">
                    <dt><b>{metric.lead}</b><span>{metric.label}</span></dt>
                    <dd>{"value" in metric ? `${metric.vs} · ${metric.value}` : metric.vs}</dd>
                  </div>
                ))}
              </dl>
              {speedProof && <a class="quiet-link" href={speedProof.href}>See the benchmark</a>}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="stills" aria-label="What Claxedo does">
      {home.lines.map((line) => (
        <article class="still">
          <p class="sentence">
            {parts(line).map((part) => <span class:list={[part.loud ? "loud" : "muted"]}>{part.text}</span>)}
          </p>
          <span class="proof-slot">{line.proof && <a class="quiet-link" href={line.proof.href}>{line.id === home.benchmark.line ? "See the benchmark" : line.proof.label}</a>}</span>
          {home.benchmark.line === line.id && (
            <dl class="metrics still-metrics">
              {home.benchmark.metrics.map((metric) => (
                <div class="metric">
                  <dt><b>{metric.lead}</b><span>{metric.label}</span></dt>
                  <dd>{"value" in metric ? `${metric.vs} · ${metric.value}` : metric.vs}</dd>
                </div>
              ))}
            </dl>
          )}
          <picture class="still-image">
            <source media="(prefers-color-scheme: dark)" srcset={`/home/demo-${line.id}-dark.jpg`} />
            <img src={`/home/demo-${line.id}-light.jpg`} alt={`The Claxedo app for “${line.text}”`} width="1330" height="675" loading="lazy" decoding="async" />
          </picture>
        </article>
      ))}
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="closing-row">
        <h2 id="closing-title">{home.closing.title}</h2>
        <DownloadMenu placement="closing" />
      </div>
      <p>{home.closing.note}</p>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const story = document.querySelector<HTMLElement>("[data-story]")
  const demo = document.querySelector<HTMLElement>("[data-demo]")
  const still = window.matchMedia("(prefers-reduced-motion: reduce)")
  if (story && demo && !still.matches) {
    const lines = Array.from(story.querySelectorAll<HTMLElement>("[data-stage-line]"))
    const pin = story.querySelector<HTMLElement>("[data-pin]")!
    const frame = story.querySelector<HTMLElement>("[data-zoom]")!
    const metrics = story.querySelector<HTMLElement>("[data-metrics]")!
    const ENTER_AT = 0.55
    const LEAVE_AT = 0.45
    const HOLD_MS = 120
    const SETTLED_SPEED = 1.2
    // Below LEAVE_AT, so the metrics are fully gone before any later step can be showing.
    const METRICS_GONE_AT = 0.35
    let storyTop = 0
    let view = 1
    let zoomFrom = 1
    let current = -1
    let candidate = 0
    let idle = 0
    let slowSince = -1
    let request = 0
    let recent: [number, number][] = []

    const measure = () => {
      storyTop = story.offsetTop
      view = pin.offsetHeight
      zoomFrom = Number(getComputedStyle(frame).getPropertyValue("--zoom-from")) || 1
    }

    const enter = (step: number) => {
      clearTimeout(idle)
      slowSince = -1
      if (step === current) return
      current = step
      lines.forEach((line, i) => {
        const leaving = line.classList.contains("is-in") && i !== step
        line.classList.toggle("is-in", i === step)
        line.classList.toggle("is-out", leaving)
        if (leaving) window.setTimeout(() => line.classList.remove("is-out"), 200)
        line.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => { link.tabIndex = i === step ? 0 : -1 })
      })
      story.dataset.step = String(step)
      demo.dispatchEvent(new CustomEvent("demo:spot", { detail: { spot: lines[step].dataset.stageLine, open: true } }))
    }

    const update = () => {
      const y = scrollY
      const grow = Math.min(1, Math.max(0, y / (storyTop + view)))
      frame.style.scale = String(zoomFrom + (1 - zoomFrom) * grow)
      frame.classList.toggle("is-growing", grow > 0 && grow < 1)
      const fade = Math.min(1, y / (storyTop + METRICS_GONE_AT * view))
      metrics.style.setProperty("--fade", String(fade))
      metrics.classList.toggle("is-gone", fade >= 0.5)

      const now = performance.now()
      recent.push([now, y])
      recent = recent.filter(([t]) => now - t <= 120)
      const [firstT, firstY] = recent[0]
      const speed = now - firstT >= 32 ? Math.abs(y - firstY) / (now - firstT) : 0

      const position = (y - storyTop) / view
      while (candidate < lines.length - 1 && position >= candidate + ENTER_AT) candidate++
      while (candidate > 0 && position < candidate - 1 + LEAVE_AT) candidate--
      clearTimeout(idle)
      if (candidate === current) {
        slowSince = -1
        return
      }
      idle = window.setTimeout(() => enter(candidate), HOLD_MS)
      if (speed > SETTLED_SPEED) slowSince = -1
      else if (slowSince < 0) slowSince = now
      else if (now - slowSince >= HOLD_MS) enter(candidate)
    }

    addEventListener("scroll", () => {
      cancelAnimationFrame(request)
      request = requestAnimationFrame(update)
    }, { passive: true })
    addEventListener("resize", () => { measure(); update() }, { passive: true })
    lines.forEach((line, i) => line.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => { link.tabIndex = i === 0 ? 0 : -1 }))
    story.dataset.playing = "true"
    measure()
    update()
    enter(candidate)
  }
</script>

<style>
  :global(html:root) {
    --bg: #141517;
    --ink: #f2f2f3;
    --ink-soft: #8e9198;
    --ink-faint: #8e9198;
    --line: #26282b;
    --line-strong: #26282b;
    --quiet: #7d8087;
    --quiet-text: #8e9198;
  }
  @media (prefers-color-scheme: light) {
    :global(html:root) {
      --bg: #f6f6f7;
      --ink: #121316;
      --ink-soft: #6e7178;
      --ink-faint: #6e7178;
      --line: #e3e4e7;
      --line-strong: #e3e4e7;
      --quiet: #8b8e95;
      --quiet-text: #6e7178;
    }
  }
  :global(html) { scroll-behavior: auto; }
  :global(.nav) { position: relative; }

  .home {
    --column: min(100% - 4rem, 75rem);
    --view: 100vh;
    --stage-size: clamp(2.5rem, 5vw, 4.5rem);
    --line-box: calc(var(--stage-size) * 1.05 * 2);
    --head: calc(clamp(1rem, 3vh, 2rem) + var(--line-box) + 2.75rem);
  }

  @supports (height: 100svh) { .home { --view: 100svh; } }
  .story { position: relative; height: calc(var(--steps) * var(--view)); overflow-anchor: none; }
  .pin { position: sticky; top: 0; display: grid; grid-template-rows: var(--head) minmax(0, 1fr); height: var(--view); overflow: clip; }

  .stage { position: relative; width: var(--column); margin: 0 auto; padding: 0; list-style: none; }
  .stage-line {
    position: absolute;
    inset: clamp(1rem, 3vh, 2rem) 0 0;
    display: grid;
    grid-template-rows: var(--line-box) 2.75rem;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
  }
  .stage-line.is-in { opacity: 1; transform: none; pointer-events: auto; transition: opacity 380ms cubic-bezier(0.2, 0, 0, 1) 120ms, transform 380ms cubic-bezier(0.2, 0, 0, 1) 120ms; }
  .stage-line.is-out { opacity: 0; transform: translateY(-3px); transition: opacity 160ms ease-out, transform 160ms ease-out; }
  .sentence { align-self: end; max-width: 30ch; margin: 0; font: 600 var(--stage-size)/1.05 var(--font-display); letter-spacing: -.02em; text-wrap: balance; }
  .loud { color: var(--ink); }
  .muted { color: var(--quiet); font-weight: 400; }
  .proof-slot { display: flex; align-items: center; }

  .quiet-link { color: var(--quiet-text); font: 400 .875rem/1.4 var(--font-sans); text-decoration: none; }
  .quiet-link:hover { color: var(--ink); text-decoration: underline; text-underline-offset: .2em; }

  .demo-area { display: grid; justify-items: center; align-content: start; min-height: 0; }
  .demo-frame.is-growing { will-change: scale; }
  .demo-frame {
    --zoom-from: .88;
    position: relative;
    width: min(var(--column), (var(--view) - var(--head) - 2rem) * 1.9);
    height: min(75vh, var(--view) - var(--head) - 2rem);
    transform-origin: 50% 0;
    scale: var(--zoom-from);
  }

  .scrim {
    position: absolute;
    inset: 37px 1px 1px;
    z-index: 30;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: clamp(1.5rem, 4vh, 2.5rem);
    border-radius: 0 0 13px 13px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    opacity: calc(1 - var(--fade, 0));
  }
  /* Numerals half-faded over a sharp transcript read as ghosts; they clear by mid-fade while the blur carries the rest. */
  .scrim > * { opacity: calc(1 - 2 * var(--fade, 0)); }
  .scrim.is-gone { pointer-events: none; }
  .metrics { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(1.25rem, 3.5vh, 2.25rem) clamp(2.5rem, 5vw, 4.5rem); max-width: 64rem; margin: 0; }
  .metric { display: grid; justify-items: start; gap: .5rem; }
  .metric dt { display: grid; gap: .5rem; }
  .metric b { color: var(--ink); font: 600 clamp(4rem, min(8.5vw, 11vh), 8.5rem)/.9 var(--font-display); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .metric dt span { color: var(--ink); font: 500 1.125rem/1.3 var(--font-sans); }
  .metric dd { margin: 0; color: var(--quiet-text); font: 400 .8125rem/1.45 var(--font-sans); }

  .stills { display: none; }

  .closing { width: var(--column); margin: 0 auto; padding: clamp(4rem, 10vh, 7rem) 0 clamp(4rem, 9vw, 6.5rem); }
  .closing-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .closing h2 { margin: 0; font: 600 clamp(2rem, 3.6vw, 3.25rem)/1.05 var(--font-display); letter-spacing: -.02em; }
  .closing p { margin: .75rem 0 0; color: var(--quiet-text); font: 400 .9375rem/1.5 var(--font-sans); }

  @media (max-width: 47.99rem) {
    .home { --column: calc(100% - 2rem); --stage-size: min(2.5rem, 10vw); --line-box: calc(var(--stage-size) * 1.05 * 3); }
    .demo-frame { --zoom-from: 1; width: var(--column); }
    .scrim { place-content: center stretch; padding: 1rem; gap: 1.25rem; }
    .metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 1rem; }
    .metric b { font-size: 3.5rem; }
    .metric dt span { font-size: 1rem; }
    .metric dd { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .story { display: none; }
    .stills { display: grid; gap: clamp(3.5rem, 8vw, 6rem); width: var(--column); margin: 0 auto; padding: clamp(2rem, 5vh, 3.5rem) 0 0; }
    .still { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.25rem 2rem; align-items: end; }
    .still .sentence { max-width: none; }
    .still-metrics { grid-column: 1 / -1; justify-content: start; }
    .still-metrics .metric b { font-size: clamp(3rem, 6vw, 5.5rem); }
    .still-image { grid-column: 1 / -1; }
    .still-image img { display: block; width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--line); }
  }
</style>
