---
import Layout from "../layouts/Layout.astro"

const clean = (value: string | undefined) => value?.trim().replace(/\/+$/, "")
const appUrl =
  clean(import.meta.env.PUBLIC_CLAXEDO_APP_URL) ??
  clean(import.meta.env.CLAXEDO_APP_URL) ??
  (import.meta.env.DEV ? "http://localhost:4444" : "https://app.claxedo.com")
const previewSrc = `${appUrl}?demo=1&embed=1`

const hero = {
  src: "/screenshots/hero-attached-review.png",
  alt: "Claxedo review workspace preview",
}

const wins = [
  "Run multiple AI coding agents side by side",
  "Review changes before they hit your codebase",
  "Keep terminals, processes, and workspace context organized",
]

const guide = [
  "Side-by-side panes for parallel implementation work",
  "Managed terminals for Claude Code, Codex, Gemini CLI, and more",
  "A dedicated review surface for changed files and diffs",
]

const compare = [
  {
    title: "OpenCode",
    desc: "Open source AI coding foundation for sessions, model routing, tool use, and the core coding loop.",
  },
  {
    title: "Claxedo",
    desc: "Desktop workspace layer for parallel agent workflows, review, process control, and multi-pane work.",
  },
]

const proof = [
  {
    tag: "Parallel runs",
    title: "Run multiple implementation tasks at once",
    desc: "Split panes across active branches, keep each agent in its own terminal, and watch work progress without tab chaos.",
    src: "/screenshots/multi-pane-dark.png",
    alt: "Claxedo multi-pane workspace",
  },
  {
    tag: "Review surface",
    title: "Inspect diffs before anything lands",
    desc: "Open a dedicated review workspace for changed files, session diffs, and comments before you decide what ships.",
    src: "/screenshots/review-workspace-dark.png",
    alt: "Claxedo review workspace",
  },
  {
    tag: "Agent support",
    title: "Use the coding agents you already prefer",
    desc: "Claude Code, Codex, Gemini CLI, Amp, Cursor agent, and other CLI tools all fit into the same workspace model.",
    src: "/screenshots/all-coding-agent-dark.png",
    alt: "Claxedo workspace with multiple coding agents",
  },
]

const claxedo = [
  {
    title: "Panes, tabs, and groups",
    desc: "Keep multiple workspaces open without nested clicks, then split active work into side-by-side panes when you need parallel focus.",
  },
  {
    title: "Any CLI coding agent",
    desc: "Run Claude Code, Codex, Gemini CLI, Pi, Amp, Cursor agent, or any other coding CLI in its own managed terminal.",
  },
  {
    title: "Agent lifecycle awareness",
    desc: "See which agents are running, waiting, or finished, then stop or restart them from the workspace when needed.",
  },
  {
    title: "Process management",
    desc: "Configure shared processes, auto-run them across workspaces, avoid port collisions, and keep state per process.",
  },
  {
    title: "Workspace-aware MCP",
    desc: "Use Model Context Protocol with awareness of the active workspace instead of only the current file.",
  },
  {
    title: "First-class AI review",
    desc: "Inspect changed files, unified diffs, and agent output from a review surface built for multi-agent work.",
  },
  {
    title: "Pages in the workspace",
    desc: "Write specs, notes, prompts, and working docs inside the same workspace as the implementation work.",
  },
  {
    title: "Mobile access",
    desc: "Open the web workspace from a tablet or phone when you need to check progress away from your desk.",
  },
]

const base = [
  {
    title: "Built on OpenCode",
    desc: "Claxedo inherits the open source foundation, active upstream development, and transparent implementation model.",
  },
  {
    title: "Any model, any provider",
    desc: "Use Anthropic, OpenAI, OpenRouter, or any compatible endpoint with your own API keys.",
  },
  {
    title: "Themes and shortcuts",
    desc: "Customize the environment with themes and keyboard shortcuts instead of adapting to fixed defaults.",
  },
]

const soon = {
  title: "Doc lifecycle tooling",
  desc: "Spec pages already ship today. Broader document flow from dump to explore to design to implement is still on the roadmap.",
}

const faq = [
  {
    q: "What is Claxedo?",
    a: "Claxedo is a desktop workspace built on top of OpenCode. It adds multi-pane layouts, project tabs, process management, and a review surface so you can run multiple AI coding workflows in parallel.",
  },
  {
    q: "How does it relate to OpenCode?",
    a: "OpenCode is the open source foundation that handles AI sessions, model routing, and tool use. Claxedo syncs daily with upstream OpenCode and adds the workspace layer on top.",
  },
  {
    q: "Which coding agents does it support?",
    a: "Any CLI-based coding agent, including Claude Code, Codex, Gemini CLI, Amp, Cursor agent, and others. Each agent runs in its own managed terminal inside the workspace.",
  },
  {
    q: "Do I need my own API keys?",
    a: "Yes. Claxedo is a local workspace, not a hosted service. You bring your own API keys for whichever model provider you use.",
  },
  {
    q: "Is there a free trial?",
    a: "There is an interactive browser preview on this site that uses demo data and mocked services. The full desktop app requires a license.",
  },
  {
    q: "What platforms are supported?",
    a: "macOS and Linux today. Windows support is planned.",
  },
]

const pricing = {
  price: "$159",
  now: "$99",
  href: "https://github.com/kyashrathore/Claxedo/releases",
  list: [
    "Unlimited projects",
    "Unlimited parallel agents",
    "Multi-pane workspace",
    "All agent integrations",
    "Process management",
    "Workspace-aware MCP",
    "Page editor",
    "GitHub source code access",
    "Discord community access",
    "Lifetime support",
  ],
  trust: [
    "One-time purchase",
    "macOS and Linux today",
    "Bring your own API keys",
  ],
  facts: [
    {
      q: "Supports",
      a: "Any CLI coding agent",
    },
    {
      q: "Trial",
      a: "Interactive browser preview",
    },
    {
      q: "Desktop",
      a: "License required for the full app",
    },
    {
      q: "Windows",
      a: "Planned",
    },
  ],
}
---

<Layout
  title="Claxedo — Parallel AI Coding Workspace"
  description="Do more parallel work with any AI coding agent. Claxedo is the desktop workspace for multi-agent coding, review, process control, and workspace-aware context, built on OpenCode."
>
  <div class="page-frame">
    <nav class="nav">
      <a href="/" class="nav-logo">
        <svg class="brand-mark" viewBox="-100 -90 200 180" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" aria-hidden="true">
          <path class="brand-mark-arc" d="M 38,-72 A 84,84 0 1 0 38,72"></path>
          <circle class="brand-mark-dot" cx="38" cy="-72" r="5"></circle>
          <circle class="brand-mark-core" cx="38" cy="-72" r="2"></circle>
          <circle class="brand-mark-dot" cx="38" cy="72" r="5"></circle>
          <circle class="brand-mark-core" cx="38" cy="72" r="2"></circle>
        </svg>
        <span>Claxedo</span>
      </a>
      <div class="nav-links">
        <a href="#demo">Demo</a>
        <a href="#features">Features</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
      </div>
      <div class="nav-actions">
        <a href="/try" class="btn-secondary">Try Browser Preview</a>
        <a href={pricing.href} class="btn-primary">Get The App</a>
      </div>
    </nav>

    <section class="hero">
      <div class="hero-copy">
        <span class="hero-kicker">Desktop workspace for parallel coding</span>
        <h1 class="hero-title">Do more parallel work with any AI coding agent</h1>
        <p class="hero-sub">
          Claxedo gives you a multi-pane desktop workspace to run Claude Code, Codex,
          Gemini CLI, and more, with review, process control, and workspace-aware context.
          Built on OpenCode.
        </p>
        <div class="hero-actions">
          <a href="/try" class="btn-primary">Try Browser Preview</a>
          <a href="#pricing" class="btn-secondary">See Pricing</a>
        </div>
      </div>
      <div class="hero-meta">
        <div class="hero-badges">
          <span>Built on OpenCode</span>
          <span>macOS + Linux</span>
          <span>Bring your own API keys</span>
        </div>
        <p class="hero-note">
          Use the browser preview to understand the workflow first. The desktop app
          is where you connect real projects, agents, and processes.
        </p>
      </div>
    </section>

    <section class="wins" aria-label="Why teams buy Claxedo">
      <div class="wins-grid">
        {wins.map((item) => (
          <article class="win">
            <span class="win-mark">{">>"}</span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="demo" class="demo-copy">
      <div>
        <span class="section-tag">// Browser preview</span>
        <h2>Explore the Claxedo workflow in browser</h2>
      </div>
      <div class="demo-body">
        <p>
          This browser preview is backed by demo data and mocked services. Use it to
          understand the workspace model, navigation, and review flow before moving
          into the full desktop app.
        </p>
        <ul class="demo-list">
          {guide.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <div class="demo-actions">
          <a href="/try" class="btn-primary">Open Browser Preview</a>
          <a href="#pricing" class="btn-secondary">See Desktop Pricing</a>
        </div>
      </div>
    </section>

    <section class="preview">
      <div class="preview-sticky" id="preview-sticky">
        <div class="preview-perspective">
          <div class="preview-frame" id="hero-frame">
            <div class="preview-shell" id="preview-shell">
              <div class="preview-poster-frame">
                <img
                  id="demo-poster"
                  src={hero.src}
                  alt={hero.alt}
                  class="preview-poster"
                  width="3024"
                  height="1654"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </div>
              <iframe
                id="demo-frame"
                class="preview-app"
                title="Claxedo browser preview"
                loading="lazy"
                tabindex="-1"
                data-src={previewSrc}
              ></iframe>
              <div class="preview-banner" id="preview-banner" role="status" aria-live="polite">
                <span class="preview-dot" aria-hidden="true"></span>
                <span id="preview-banner-text">Loading browser preview...</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="compare-section">
      <div class="compare-header">
        <span class="section-tag">// Relationship</span>
        <h2>OpenCode gives you the foundation. Claxedo gives you the workspace layer.</h2>
      </div>
      <div class="compare-grid">
        {compare.map((item) => (
          <article class="compare-card">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="proof-section">
      <div class="proof-header">
        <span class="section-tag">// Use cases</span>
        <h2>What the workflow looks like in practice</h2>
      </div>
      <div class="proof-grid">
        {proof.map((item) => (
          <article class="proof-card">
            <img
              src={item.src}
              alt={item.alt}
              width="1200"
              height="780"
              loading="lazy"
              decoding="async"
            />
            <div class="proof-copy">
              <span class="proof-tag">{item.tag}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="features" class="features-section">
      <div class="features-header">
        <span class="section-tag">// Available now</span>
        <h2>What you get in Claxedo today</h2>
      </div>
      <div class="features-grid">
        {claxedo.map((item) => (
          <article class="feature-cell">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
      <div class="base-section">
        <div class="base-head">
          <span class="section-tag">// OpenCode foundation</span>
          <h3>Claxedo keeps the OpenCode strengths underneath the workspace layer.</h3>
        </div>
        <div class="base-grid">
          {base.map((item) => (
            <article class="base-card">
              <h4>{item.title}</h4>
              <p>{item.desc}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="soon-card">
        <span class="section-tag">// Coming soon</span>
        <h3>{soon.title}</h3>
        <p>{soon.desc}</p>
      </div>
    </section>

    <section id="pricing" class="pricing">
      <div class="pricing-header">
        <span class="section-tag">// Pricing</span>
        <h2>One price, everything included</h2>
      </div>
      <div class="pricing-layout">
        <div class="pricing-card">
          <div class="pricing-card-top">
            <div class="pricing-price">
              <span class="pricing-amount-old">{pricing.price}</span>
              <span class="pricing-amount">{pricing.now}</span>
              <span class="pricing-period">USD</span>
            </div>
            <p class="pricing-early">Early bird pricing</p>
          </div>
          <ul class="pricing-trust">
            {pricing.trust.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <ul class="pricing-features">
            {pricing.list.map((item) => (
              <li><span class="check">+</span> {item}</li>
            ))}
          </ul>
          <div class="pricing-actions">
            <a href={pricing.href} class="btn-primary pricing-cta">Get The Desktop App</a>
            <a href="/try" class="btn-secondary pricing-cta-secondary">Try The Browser Preview</a>
          </div>
          <p class="pricing-note">
            The browser preview uses demo data and mocked services. The full desktop app requires a license.
          </p>
        </div>
        <div class="pricing-facts">
          <div class="facts-head">
            <span class="section-tag">// Quick answers</span>
            <h3>Put the buying objections next to the price.</h3>
          </div>
          <div class="facts-grid">
            {pricing.facts.map((item) => (
              <article class="fact">
                <span>{item.q}</span>
                <strong>{item.a}</strong>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="faq-section">
      <div class="faq-header">
        <span class="section-tag">// FAQ</span>
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <footer class="footer">
      <div class="footer-grid">
        <div class="footer-col">
          <a href="#demo">Browser preview</a>
        </div>
        <div class="footer-col">
          <a href="#features">Features</a>
        </div>
        <div class="footer-col">
          <a href="#pricing">Pricing</a>
        </div>
        <div class="footer-col">
          <a href="https://github.com/opencode-ai/opencode">OpenCode</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>
          Built on <a href="https://github.com/opencode-ai/opencode">OpenCode</a>.
          Synced daily with upstream.
        </p>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .page-frame {
    --padding: 3rem;
    --vpad: 1.5rem;
    max-width: 76rem;
    margin: 1rem auto;
    border: var(--bw) solid var(--border);
    overflow: visible;
    background: var(--bg);
  }

  @media (max-width: 30rem) {
    .page-frame {
      --padding: 1rem;
      --vpad: 0.75rem;
      margin: 0.5rem auto;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: var(--vpad) var(--padding);
    border-bottom: var(--bw) solid var(--border);
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--text-strong);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .brand-mark {
    width: 18px;
    height: 18px;
    overflow: visible;
    flex: none;
    color: var(--text-strong);
  }

  .brand-mark-arc {
    stroke: currentColor;
    stroke-width: 6;
  }

  .brand-mark-dot {
    fill: currentColor;
  }

  .brand-mark-core {
    fill: var(--bg);
  }

  .nav-links,
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-links a {
    font-size: 0.92rem;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--text-strong);
  }

  .nav .btn-primary,
  .nav .btn-secondary {
    padding: 8px 14px;
    font-size: 0.86rem;
  }

  .hero,
  .wins,
  .demo-copy,
  .compare-section,
  .proof-section,
  .features-section,
  .pricing,
  .faq-header,
  .footer-bottom {
    padding: var(--padding);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.75fr);
    gap: calc(var(--padding) * 0.75);
    align-items: end;
  }

  .hero-copy {
    max-width: 44rem;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-weak);
  }

  .hero-title {
    font-size: clamp(2.25rem, 6vw, 4.75rem);
    line-height: 0.96;
    font-weight: 600;
    letter-spacing: -0.06em;
    color: var(--text-strong);
    text-transform: uppercase;
    text-wrap: balance;
    margin-bottom: 1.25rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text);
    max-width: 42rem;
    margin-bottom: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-meta {
    display: grid;
    gap: 1rem;
    align-self: stretch;
    padding: 1.25rem;
    border: var(--bw) solid var(--border);
    background: var(--bg-weak);
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-badges span {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    color: var(--text-weak);
    background: var(--bg);
  }

  .hero-note {
    color: var(--text);
    line-height: 1.7;
    max-width: 22rem;
  }

  .wins {
    border-top: var(--bw) solid var(--border);
  }

  .wins-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border: var(--bw) solid var(--border);
  }

  .win {
    display: flex;
    gap: 12px;
    padding: 1rem 1.1rem;
    min-height: 100%;
    border-right: var(--bw) solid var(--border);
    background: var(--bg-weak);
  }

  .win:last-child {
    border-right: none;
  }

  .win-mark {
    color: var(--text-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
    flex: none;
  }

  .win p {
    color: var(--text-strong);
    line-height: 1.6;
  }

  .demo-copy {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: calc(var(--padding) * 0.75);
    align-items: start;
    border-top: var(--bw) solid var(--border);
  }

  .section-tag {
    display: block;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-weak);
  }

  .demo-copy h2,
  .compare-header h2,
  .proof-header h2,
  .features-header h2,
  .pricing-header h2,
  .faq-header h2 {
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--text-strong);
    text-wrap: balance;
  }

  .demo-body {
    max-width: 40rem;
  }

  .demo-body p {
    color: var(--text);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .demo-list {
    display: grid;
    gap: 10px;
    margin: 0 0 1.25rem;
    padding-left: 1.2rem;
    color: var(--text-strong);
  }

  .demo-list li {
    line-height: 1.6;
  }

  .demo-actions,
  .pricing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .preview {
    position: relative;
    height: 160vh;
    border-top: var(--bw) solid var(--border);
  }

  .preview-sticky {
    --bleed: 0px;
    position: sticky;
    top: 5rem;
    height: calc(100vh - 5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    margin-left: calc(var(--bleed) * -1);
    margin-right: calc(var(--bleed) * -1);
  }

  .preview-perspective {
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
    overflow: clip;
    width: 100%;
    height: 100%;
  }

  .preview-frame {
    width: 100%;
    height: 100%;
    border: var(--bw) solid var(--border);
    overflow: hidden;
    will-change: transform, opacity;
    transform: translateY(28px) scale(0.965) rotateX(1.6deg);
    opacity: 0.76;
    transition: transform 0.1s linear, opacity 0.1s linear;
  }

  .preview-shell {
    --poster-zoom: 1.02;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: hsl(0, 9%, 7%);
  }

  .preview-poster-frame,
  .preview-poster,
  .preview-app {
    position: absolute;
    inset: 0;
  }

  .preview-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transform: scale(var(--poster-zoom));
    transform-origin: top left;
    background: hsl(0, 9%, 7%);
    transition: opacity 0.45s ease, transform 0.45s ease, filter 0.45s ease;
  }

  .preview-app {
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transform: scale(1.015);
    transition: opacity 0.45s ease, transform 0.45s ease;
    background: hsl(0, 9%, 7%);
    pointer-events: none;
  }

  .preview-banner {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
