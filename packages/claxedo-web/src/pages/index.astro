---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import ClaxedoAppReplica from "../components/ClaxedoAppReplica.astro"
import IconSprite from "../components/IconSprite.astro"
import MacDownload from "../components/MacDownload.astro"
import HeroSky from "../components/HeroSky.astro"
import Scene from "../components/Scene.astro"
import AgentPicker from "../components/crops/AgentPicker.astro"
import DeployTerminal from "../components/crops/DeployTerminal.astro"
import MachineList from "../components/crops/MachineList.astro"
import MarketplaceCard from "../components/crops/MarketplaceCard.astro"
import OrganizationSettings from "../components/crops/OrganizationSettings.astro"
import ReopenCard from "../components/crops/ReopenCard.astro"
import StandupPage from "../components/crops/StandupPage.astro"
import TerminalChat from "../components/crops/TerminalChat.astro"
import { requireClaim } from "../content/claims"
import { routes } from "../content/routes"
import { home, homeBlocks, site } from "../content/site"

for (const block of homeBlocks) for (const id of block.claims) requireClaim(id)
---

<Layout title={`Claxedo: ${home.hero.title}`} description={site.description} lightOnly>
  <Nav />
  <IconSprite />
  <main id="main-content" class="home">
    <section class="hero">
      <HeroSky />
      <div class="intro">
        <h1>{home.hero.title}</h1>
        <p class="lede">{home.hero.subtitle}</p>
        <MacDownload placement="hero" />
        <a class="quiet-link" href={routes.app}>Open in browser</a>
      </div>
      <div class="stage">
        <div class="window"><ClaxedoAppReplica /></div>
      </div>
    </section>

    <section class="block">
      <header class="section-head">
        <h2>{home.extend.title}</h2>
        <p>{home.extend.subtitle} <a class="quiet-link" href={home.benchmark.href}>See the {home.benchmark.date} benchmark</a></p>
      </header>
      <dl class="metrics">
        {home.benchmark.metrics.map((metric) => (
          <div class="metric">
            <dt><span class="lead">{metric.lead}</span><span class="label">{metric.label}</span></dt>
            <dd>{metric.detail}</dd>
          </div>
        ))}
      </dl>
      <Scene scene="amber" class="panel wide after-metrics"><div class="crop centered"><StandupPage /></div></Scene>
    </section>

    <section class="block">
      <header class="section-head">
        <h2>{home.openSource.title}</h2>
        <p>{home.openSource.subtitle} <a class="quiet-link" href={home.openSource.href}>Deployment guide</a></p>
      </header>
      <div class="two-up">
        <Scene scene="pier" class="panel"><div class="crop centered" style="--crop-w: 30rem"><OrganizationSettings /></div></Scene>
        <Scene scene="dusk" class="panel"><div class="crop centered" style="--crop-w: 28rem"><DeployTerminal /></div></Scene>
      </div>
    </section>

    <section class="block">
      <header class="section-head">
        <h2>{home.sandbox.title}</h2>
        <p>{home.sandbox.subtitle}</p>
      </header>
      <div class="two-up">
        <Scene scene="harbor" class="panel"><div class="crop centered" style="--crop-w: 24rem"><MachineList /></div></Scene>
        <Scene scene="tide" class="panel"><div class="crop centered" style="--crop-w: 20rem"><ReopenCard /></div></Scene>
      </div>
    </section>

    <section class="block">
      <header class="section-head">
        <h2>{home.plugins.title}</h2>
        <p>{home.plugins.subtitle}</p>
      </header>
      <Scene scene="lagoon" class="panel wide"><div class="crop centered" style="--crop-w: 29rem"><MarketplaceCard /></div></Scene>
    </section>

    <section class="block">
      <header class="section-head">
        <h2>{home.workflow.title}</h2>
        <p>{home.workflow.subtitle}</p>
      </header>
      <div class="two-up">
        <Scene scene="ash" class="panel"><div class="crop"><AgentPicker /></div></Scene>
        <Scene scene="slate" class="panel"><div class="crop"><TerminalChat /></div></Scene>
      </div>
    </section>

    <section class="closing">
      <h2>{home.closing.text}</h2>
      <MacDownload placement="closing" />
      <a class="quiet-link" href={routes.download}>Windows, Linux and Intel Macs</a>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  :global(html:root) {
    color-scheme: light;
    --bg: #fcfcfc;
    --ink: #0f0f0f;
    --ink-soft: #6b6b6b;
    --ink-faint: #6b6b6b;
    --ink-weakest: #8a8a8a;
    --line: #e8e8e8;
    --line-strong: #e8e8e8;
    --accent-hover: #000000;
    --surface-raised: #ffffff;
  }

  .home {
    --edge: clamp(1rem, 5.5vw, 5rem);
    --width: min(100% - 2 * var(--edge), 80rem);
    overflow-x: clip;
  }
  :global(.nav) { background: var(--bg); backdrop-filter: none; }
  :global(.nav-links a) { font-size: .9375rem; font-weight: 400; }
  :global(.nav .btn-pill) { font-weight: 400; font-size: .875rem; }
  .home :global(.btn-pill) { min-height: 2.75rem; padding: 0 1.4rem; font: 400 1rem/1 var(--font-sans); letter-spacing: -.01em; }
  .quiet-link { color: var(--ink-soft); font-size: .9375rem; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: .25em; }
  .quiet-link:hover { color: var(--ink); text-decoration-color: currentColor; }

  h1, h2, h3 { font-family: var(--font-display); font-weight: 400; color: var(--ink); text-wrap: balance; }

  .hero { --window-h: clamp(30rem, 48vw, 44rem); position: relative; isolation: isolate; padding-top: clamp(2rem, 3.5vw, 2.5rem); }
  .hero :global(.hero-sky) { bottom: calc(var(--window-h) * .55); }
  .intro { color: #ffffff; text-shadow: 0 1px 28px rgb(8 24 48 / .28); }
  .intro h1 { color: inherit; }
  .intro .lede { color: #ffffff; }
  .intro .quiet-link { color: #ffffff; text-decoration-color: rgb(255 255 255 / .45); }
  .intro .quiet-link:hover { color: #ffffff; text-decoration-color: currentColor; }
  .intro :global(.btn-pill) { text-shadow: none; }
  .intro { display: grid; justify-items: center; gap: 0; width: var(--width); margin-inline: auto; text-align: center; }
  h1 { max-width: 12em; margin: 0; font-size: clamp(2.5rem, 4.4vw, 4rem); line-height: 1.06; letter-spacing: -.025em; }
  .lede { max-width: 34rem; margin: 1rem 0 1.75rem; color: var(--ink-soft); font-size: 1.25rem; line-height: 1.45; text-wrap: balance; }
  .intro .quiet-link { margin-top: .75rem; font-size: .875rem; }

  .stage { position: relative; width: min(100% - 2 * var(--edge), 72rem); margin: 3rem auto 0; }
  .window { position: relative; z-index: 1; height: var(--window-h); }

  .block { width: var(--width); margin: clamp(6rem, 11vw, 9.5rem) auto 0; }
  .section-head { margin-bottom: 2.5rem; }
  h2 { max-width: 24em; margin: 0; font-size: clamp(2rem, 3.2vw, 2.5rem); line-height: 1.1; letter-spacing: -.025em; }
  .section-head p { max-width: 52rem; margin: .75rem 0 0; color: var(--ink-soft); font-size: 1.25rem; line-height: 1.45; }
  .section-head .quiet-link { font-size: inherit; white-space: nowrap; }

  .metrics { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2rem; margin: 0; }
  .metric { display: grid; align-content: start; gap: .75rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .metric dt { display: grid; gap: .5rem; }
  .lead { font: 400 clamp(3.5rem, 6.7vw, 6rem)/.9 var(--font-display); letter-spacing: -.05em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .label { color: var(--ink); font-size: 1.0625rem; }
  .metric dd { margin: 0; color: var(--ink-soft); font-size: .875rem; line-height: 1.5; }

  .two-up { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .block :global(.panel) { height: 25rem; }
  .block :global(.panel.wide) { height: 28rem; }
  .block :global(.panel.after-metrics) { margin-top: 3.5rem; }
  .crop { position: absolute; inset: 2.75rem 0 0 8%; transform-origin: 0 0; }
  .crop.centered { left: 50%; width: var(--crop-w, 44rem); translate: -50% 0; }

  .closing { display: grid; justify-items: center; gap: 1.25rem; width: var(--width); margin: clamp(7rem, 13vw, 11rem) auto 0; text-align: center; }
  .closing h2 { max-width: none; margin: 0 0 .75rem; }
  .closing .quiet-link { font-size: .875rem; }

  @media (prefers-reduced-motion: no-preference) {
    .intro, .stage { animation: rise .8s cubic-bezier(.2, .7, .2, 1) both; }
    .stage { animation-delay: .12s; }
    @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  }

  @media (max-width: 60rem) {
    .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 2.5rem; }
  }
  @media (max-width: 47.99rem) {
    .lede { font-size: 1.125rem; }
    .hero { --window-h: 32rem; }
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1rem; }
    .two-up { grid-template-columns: minmax(0, 1fr); }
    .block :global(.panel), .block :global(.panel.wide) { height: auto; aspect-ratio: 1.05; }
    .block :global(.panel.after-metrics) { margin-top: 2.5rem; }
    .crop, .crop.centered { inset: 1.75rem 0 0 6%; width: auto; translate: none; scale: .78; }
  }
</style>
