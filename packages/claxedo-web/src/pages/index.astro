<style>
  /* ===== Navigation ===== */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  :global(body.preview-nav-hidden) .nav {
    opacity: 0;
    transform: translateY(-110%);
    pointer-events: none;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 17px;
    color: var(--text);
  }

  .nav-logo-icon {
    color: var(--accent-text);
  }

  .nav-links {
    display: flex;
    gap: 32px;
  }

  .nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-link-subtle {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.15s;
  }

  .nav-link-subtle:hover {
    color: var(--text);
  }

  .btn-sm {
    padding: 8px 16px;
    font-size: 13px;
  }

  .btn-lg {
    padding: 14px 28px;
    font-size: 16px;
  }

  /* ===== Hero ===== */
  .hero {
    padding: 140px 0 60px;
    text-align: center;
  }

  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 28px;
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
  }

  .hero-title {
    font-size: clamp(36px, 5.5vw, 56px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
    color: var(--text);
  }

  .hero-subtitle {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 36px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ===== Product Preview (Scroll Animated) ===== */
  .preview {
    position: relative;
    height: 220vh;
    padding: 0;
  }

  .preview .container-wide {
    height: 100%;
    max-width: none;
    width: 100vw;
    padding: 0;
  }

  .preview-perspective {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
    overflow: clip;
  }

  .preview-frame {
    --preview-full: 0;
    width: calc(90vw + 10vw * var(--preview-full));
    height: calc(64vh + 36vh * var(--preview-full));
    max-width: none;
    border-radius: calc(var(--radius-xl) * (1 - var(--preview-full)));
    overflow: hidden;
    box-shadow: var(--shadow-lg), 0 0 0 1px var(--border);
    will-change: transform, opacity;
    transform: translateY(40px) scale(0.95) rotateX(2deg);
    opacity: 0.7;
    transition: transform 0.1s linear, opacity 0.1s linear, box-shadow 0.2s ease;
  }

  .preview-frame.is-fullscreen {
    box-shadow: none;
  }

  .preview-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .preview-live {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: block;
    border: 0;
    background: #0a0a0f;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* ===== Value Props ===== */
  .value-props {
    padding: 60px 0;
  }

  .props-grid {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 48px;
  }

  .prop {
    text-align: center;
    max-width: 240px;
  }

  .prop-number {
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 8px;
  }

  .prop-label {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .prop-sep {
    width: 1px;
    height: 60px;
    background: var(--border);
    margin-top: 8px;
  }

  /* ===== Divider ===== */
  .divider {
    padding: 0;
  }

  .divider hr {
    border: none;
    border-top: 1px solid var(--border);
  }

  /* ===== Feature Sections ===== */
  .feature-section {
    padding: 80px 0;
  }

  .feature-section.alt {
    background: var(--bg-subtle);
  }

  .feature-header {
    margin-bottom: 48px;
    max-width: 640px;
  }

  .feature-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 16px;
    padding: 4px 10px;
    background: var(--accent-light);
    border-radius: var(--radius-sm);
  }

  .feature-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .feature-lead {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* ===== Feature 01: Card Switcher ===== */
  .feature01-body {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 32px;
    align-items: start;
  }

  .feature01-cards {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .feature01-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    color: var(--text);
  }

  .feature01-card:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-sm);
  }

  .feature01-card.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-light);
    background: var(--accent-light);
  }

  .feature01-card-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border-radius: var(--radius-sm);
    color: var(--accent);
  }

  .feature01-card.active .feature01-card-icon {
    background: var(--accent-medium);
  }

  .feature01-card-text h3 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .feature01-card-text p {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .feature01-display {
    position: sticky;
    top: 80px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border);
    aspect-ratio: 16 / 10;
    background: var(--bg-muted);
    min-width: 0;
  }

  .feature01-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .feature01-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature01-img.active {
    opacity: 1;
  }

  /* ===== App Window (shared — Feature 03 only now) ===== */
  .app-window {
    background: var(--dark-bg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--dark-border);
    box-shadow: var(--shadow-lg);
  }

  .app-chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--dark-bg);
    border-bottom: 1px solid var(--dark-border);
  }

  .chrome-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .chrome-red { background: #ff5f57; }
  .chrome-yellow { background: #febc2e; }
  .chrome-green { background: #28c840; }

  .chrome-title {
    font-size: 12px;
    font-weight: 500;
    color: var(--dark-text-weak);
    margin-left: 8px;
  }

  /* ===== Feature 02: Workspace Demo (theme-aware) ===== */
  .ws-demo {
    background: var(--bg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  /* Workspace breadcrumb bar (36px) */
  .ws-bar {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 12px;
