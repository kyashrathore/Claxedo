---
import Layout from '../layouts/Layout.astro';

const previewSrc = import.meta.env.DEV ? 'http://localhost:4444' : 'https://app.claxedo.com';

const comparison = [
  { feature: 'AI coding sessions', opencode: true, claxedo: true },
  { feature: 'Theme & keyboard shortcuts', opencode: true, claxedo: true },
  { feature: 'Any model, any provider', opencode: true, claxedo: true },
  { feature: 'Multi-pane IDE layout', opencode: false, claxedo: true },
  { feature: 'Multi-project workspace tabs', opencode: false, claxedo: true },
  { feature: 'Agent lifecycle awareness', opencode: false, claxedo: true },
  { feature: 'Instant agent terminals', opencode: false, claxedo: true },
  { feature: 'Process management', opencode: false, claxedo: true },
  { feature: 'Workspace-aware MCP', opencode: false, claxedo: true },
  { feature: 'Page editor with AI', opencode: false, claxedo: true },
  { feature: 'Mobile responsive', opencode: false, claxedo: true },
];

const gridFeatures = [
  {
    icon: 'terminal',
    color: '#ef4444',
    title: 'Instant agent terminals',
    description: 'Launch Claude, Codex, or any custom command directly as a terminal tab. No manual setup, no configuration files.',
  },
  {
    icon: 'keyboard',
    color: '#22c55e',
    title: 'Keyboard-first navigation',
    description: 'Everything is accessible via keyboard. Switch panes, tabs, workspaces, and agents without touching the mouse.',
  },
  {
    icon: 'mobile',
    color: '#8b5cf6',
    title: 'Mobile responsive',
    description: 'Fully responsive UI. Connect remotely from mobile via Tailscale or Cloudflare to monitor running sessions.',
  },
  {
    icon: 'provider',
    color: '#3b82f6',
    title: 'Any model, any provider',
    description: 'Works with every provider OpenCode supports — Anthropic, OpenAI, Google, Ollama, and custom endpoints.',
  },
  {
    icon: 'foundation',
    color: '#f59e0b',
    title: 'Built on OpenCode',
    description: 'All core OpenCode features with daily upstream sync. Themes, keybindings, local-first architecture.',
  },
  {
    icon: 'share',
    color: '#06b6d4',
    title: 'Shared when needed, local when it matters',
    description: 'Critical infrastructure can be shared across your team. Personal scripts and experiments stay private.',
  },
];

const featureCards = [
  {
    id: 'multi-workspaces',
    icon: 'workspaces',
    title: 'Multi-project workspaces',
    description: 'Color-coded workspace tabs for formlink, opencode, misty-cactus — all running parallel Claude sessions.',
    light: '/screenshots/multi-project-light.png',
    dark: '/screenshots/multi-project-dark.png',
  },
  {
    id: 'panel-groups',
    icon: 'panels',
    title: 'Side-by-side panel groups',
    description: 'Independent split panes — session on the left, terminal on the right, each with their own tab bar.',
    light: '/screenshots/multi-group-light.png',
    dark: '/screenshots/multi-group-dark.png',
  },
  {
    id: 'multi-panes',
    icon: 'grid',
    title: 'Multiple panes in one tab',
    description: 'Claude session, diff review, and new pane picker open simultaneously in one view.',
    light: '/screenshots/multi-pane-light.png',
    dark: '/screenshots/multi-pane-dark.png',
  },
  {
    id: 'processes',
    icon: 'process',
    title: 'Process management',
    description: 'Dev server logs, error diagnostics, and background processes managed from one place.',
    light: '/screenshots/long-running-process-light.png',
    dark: '/screenshots/long-running-process-dark.png',
  },
];

const pricingTiers = [
  {
    id: 'self-hosted',
    name: 'Self-Hosted',
    price: '$0',
    period: '',
    subtitle: 'For developers who self-host',
    features: [
      'Unlimited projects',
      'Unlimited parallel agents',
      'Multi-pane workspace',
      'All agent integrations',
      'Process management',
      'Workspace-aware MCP',
      'Page editor',
      'Community support',
    ],
    cta: 'Download',
    ctaHref: 'https://github.com/kyashrathore/Claxedo/releases',
    highlighted: false,
  },
  {
    id: 'cloud',
    name: 'Cloud',
    price: '$19',
    period: 'per month',
    subtitle: 'Managed hosting, zero setup',
    features: [
      'Everything in Self-Hosted',
      'Cloud-hosted workspaces',
      'Remote access from any device',
      'Automatic updates',
      'Encrypted workspace sync',
      'Sandbox agent runtime',
      'Priority email support',
    ],
    cta: 'Get Started',
    ctaHref: 'https://github.com/kyashrathore/Claxedo',
    highlighted: true,
  },
  {
    id: 'team',
    name: 'Team',
    price: '$49',
    period: 'per seat / month',
    subtitle: 'For teams that ship together',
    features: [
      'Everything in Cloud',
      'Centralized billing',
      'Seat & user management',
      'Shared workspace templates',
      'Team council discussions',
      'SSO & access controls',
      'Dedicated support',
    ],
    cta: 'Contact Us',
    ctaHref: 'https://github.com/kyashrathore/Claxedo',
    highlighted: false,
  },
];

const agentStatuses = [
  {
    name: 'Claude #1',
    status: 'done',
    statusLabel: 'Completed',
    detail: 'Auth middleware done — 12 files changed',
    logo: 'claude',
    code: 'Added JWT validation middleware to all protected routes. Updated auth.config.ts with RS256 signing.',
  },
  {
    name: 'Codex #2',
    status: 'loading',
    statusLabel: 'Running',
    detail: 'Refactoring API handlers...',
    logo: 'codex',
    code: 'Converting REST handlers to use new response format. 8 of 14 endpoints migrated.',
  },
  {
    name: 'Aider #3',
    status: 'attention',
    statusLabel: 'Needs Input',
    detail: 'Waiting for confirmation on schema change',
    logo: 'aider',
    code: 'Schema migration ready: ALTER TABLE users ADD COLUMN mfa_enabled BOOLEAN DEFAULT false. Approve?',
  },
  {
    name: 'Claude #4',
    status: 'loading',
    statusLabel: 'Running',
    detail: 'Updating test suite...',
    logo: 'claude',
    code: 'Running test suite updates for auth changes. Adding integration tests for new middleware.',
  },
];
---

<Layout title="Claxedo — The Parallel AI Workspace">
  <!-- Navigation -->
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <svg class="nav-logo-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>Claxedo</span>
      </a>
      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#compare">Compare</a>
        <a href="#pricing">Pricing</a>
      </div>
      <div class="nav-actions">
        <a href="https://github.com/kyashrathore/Claxedo" class="nav-link-subtle">GitHub</a>
        <a href="https://github.com/kyashrathore/Claxedo/releases" class="btn-primary btn-sm">Download</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Built on OpenCode
      </div>
      <h1 class="hero-title">
        The parallel AI workspace<br />
        built on <span class="serif-italic">OpenCode</span>
      </h1>
      <p class="hero-subtitle">
        Keep multiple projects, workspaces, AI sessions, and terminals open at once.
        Claxedo extends OpenCode with a powerful multi-pane layout, instant agent terminals,
        and workspace-aware AI context.
      </p>
      <div class="hero-actions">
        <a href="https://github.com/kyashrathore/Claxedo/releases" class="btn-primary">
          Get Started
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a href="https://github.com/kyashrathore/Claxedo" class="btn-secondary">
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- Product Preview — scroll animated hero -->
  <section class="preview">
    <div class="container-wide">
      <div class="preview-perspective" id="hero-perspective">
        <div class="preview-frame" id="hero-frame">
          <iframe
            src={previewSrc}
            title="Claxedo Live App"
            class="preview-live"
            loading="eager"
            allow="clipboard-write"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Value Props -->
  <section class="value-props">
    <div class="container">
      <div class="props-grid">
        <div class="prop">
          <div class="prop-number">10+</div>
          <div class="prop-label">Parallel agents across multiple projects and workspaces</div>
        </div>
        <div class="prop-sep"></div>
        <div class="prop">
          <div class="prop-number">6</div>
          <div class="prop-label">Supported agent types with lifecycle awareness</div>
        </div>
        <div class="prop-sep"></div>
        <div class="prop">
          <div class="prop-number">Daily</div>
          <div class="prop-label">Upstream sync with OpenCode for latest features</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Divider -->
  <div class="divider"><div class="container"><hr /></div></div>

  <!-- Feature 01: Interactive Card Switcher -->
  <section id="features" class="feature-section">
    <div class="container-wide">
      <div class="feature-header">
        <span class="feature-num">01</span>
        <h2 class="feature-title">Work across multiple projects and workspaces at once</h2>
        <p class="feature-lead">
          The most important Claxedo feature. A layout built for parallel development,
          where multiple projects, workspaces, sessions, terminals, and files coexist in one persistent view.
        </p>
      </div>
      <div class="feature01-body">
        <div class="feature01-cards" id="feature01-cards">
          {featureCards.map((card, i) => (
            <button
              class={`feature01-card ${i === 0 ? 'active' : ''}`}
              data-index={i}
              data-light={card.light}
            >
              <div class="feature01-card-icon">
                {card.icon === 'workspaces' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="9" rx="1"></rect>
                    <rect x="14" y="3" width="7" height="5" rx="1"></rect>
                    <rect x="14" y="12" width="7" height="9" rx="1"></rect>
                    <rect x="3" y="16" width="7" height="5" rx="1"></rect>
                  </svg>
                )}
                {card.icon === 'panels' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <line x1="12" y1="3" x2="12" y2="21"></line>
                  </svg>
                )}
                {card.icon === 'grid' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                  </svg>
                )}
                {card.icon === 'process' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20v-6M6 20V10M18 20V4"></path>
                  </svg>
                )}
              </div>
              <div class="feature01-card-text">
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </div>
            </button>
          ))}
        </div>
        <div class="feature01-display" id="feature01-display">
          {featureCards.map((card, i) => (
            <picture class={`feature01-img ${i === 0 ? 'active' : ''}`} data-index={i}>
              <source srcset={card.dark} media="(prefers-color-scheme: dark)" />
              <img src={card.light} alt={card.title} loading={i === 0 ? 'eager' : 'lazy'} />
            </picture>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Feature 02: Agent Status — Exact App Tab Bar -->
  <section class="feature-section alt" id="feature02-section">
    <div class="container-wide">
      <div class="feature-header">
        <span class="feature-num">02</span>
        <h2 class="feature-title">See what every agent is doing, in real time</h2>
        <p class="feature-lead">
          When several agents run at the same time, you should not have to manually check each one.
          Claxedo makes background activity visible so you stay in flow and respond only when needed.
        </p>
      </div>
      <div class="ws-demo" id="agent-demo">
        <!-- Workspace breadcrumb bar (36px) -->
        <div class="ws-bar">
          <button class="ws-sidebar-toggle" aria-label="Toggle sidebar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
          </button>
          <span class="ws-prefix">Default workspace:</span>
          <div class="ws-path">
            <span class="ws-project">opencode</span>
            <span class="ws-sep">/</span>
            <button class="ws-workspace-btn">
              <span class="ws-wt-dot" style="background: #22c55e"></span>
              <span class="ws-workspace-name highlighted">misty-cactus</span>
            </button>
            <span class="ws-sep">/</span>
            <button class="ws-workspace-btn">
              <span class="ws-wt-dot" style="background: #3b82f6"></span>
              <span class="ws-workspace-name">main</span>
            </button>
            <button class="ws-add-btn" aria-label="New worktree">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </button>
          </div>
          <button class="ws-kebab" aria-label="More workspaces">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.5"></circle><circle cx="12" cy="12" r="1.5"></circle><circle cx="12" cy="19" r="1.5"></circle></svg>
          </button>
        </div>
        <!-- Main layout: collapsed sidebar + content -->
        <div class="ws-layout">
          <!-- Collapsed sidebar strip -->
          <div class="ws-sidebar">
            <span class="ws-badge" style="--badge-bg: #6366f1">F</span>
            <span class="ws-badge" style="--badge-bg: #f59e0b">O</span>
          </div>
          <!-- Content area -->
          <div class="ws-main">
            <!-- Tab bar (40px) -->
            <div class="ws-tabbar" id="agent-demo-tabs">
              <button class="ws-tab processes-tab">
                <span>Processes</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
              </button>
              {agentStatuses.map((agent, i) => (
                <button
                  class={`ws-tab agent-tab ${i === 0 ? 'active' : ''}`}
                  data-index={i}
                  style={`--wt-color: ${['#4ade80', '#fbbf24', '#c084fc', '#fb923c'][i]}`}
                >
                  <span class="ws-tab-label">{agent.name}</span>
                  <span class={`ws-tab-dot ${agent.status}`} data-agent-index={i}></span>
                  <span class="ws-tab-close">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </span>
                </button>
              ))}
              <div class="ws-tab-actions">
                <button class="ws-action-btn" title="New Session">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
                <button class="ws-action-btn" title="Claude"><span class="ws-letter">C</span></button>
                <button class="ws-action-btn" title="Codex"><span class="ws-letter">X</span></button>
                <button class="ws-action-btn" title="Terminal">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                </button>
                <button class="ws-action-btn" title="Page">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                </button>
                <button class="ws-action-btn" title="More">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
              </div>
            </div>
            <!-- Session content panels -->
            <div class="ws-content" id="agent-demo-content">
              {agentStatuses.map((agent, i) => (
                <div class={`ws-panel ${i === 0 ? 'active' : ''}`} data-index={i}>
                  <div class="ws-panel-header">
                    <span class={`ws-panel-dot ${agent.status}`} data-agent-index={i}></span>
                    <span class="ws-session-id">@{agent.name.toLowerCase().replace(/\s+#/,'-')}-{['auth-middleware','api-refactor','schema-migration','test-suite'][i]}</span>
                    <div class="ws-panel-tools">
                      <button class="ws-panel-btn" title="Split">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect><line x1="12" y1="3" x2="12" y2="21"></line></svg>
                      </button>
                      <button class="ws-panel-btn" title="Maximize">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg>
                      </button>
                      <button class="ws-panel-btn" title="Close">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                      </button>
                    </div>
                  </div>
                  <div class="ws-panel-body">
                    <div class="ws-panel-status">
                      <span class={`ws-status-badge ${agent.status}`}>{agent.statusLabel}</span>
                      <span class="ws-status-detail">{agent.detail}</span>
                    </div>
                    <div class="ws-panel-code">
                      <pre><code>{agent.code}</code></pre>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature 03: MCP — Static Session Document UI -->
  <section class="feature-section">
    <div class="container-wide">
      <div class="feature-header">
        <span class="feature-num">03</span>
        <h2 class="feature-title">Give AI real workspace context, not just prompts</h2>
        <p class="feature-lead">
          Claxedo MCP turns the workspace into a richer operating environment for AI.
          Agents can reference tabs, inspect panes, read terminal output, access process logs,
          and work with the real state of your project.
        </p>
      </div>
      <div class="app-window">
        <div class="app-chrome">
          <span class="chrome-dot chrome-red"></span>
          <span class="chrome-dot chrome-yellow"></span>
          <span class="chrome-dot chrome-green"></span>
          <span class="chrome-title">Session</span>
        </div>
        <!-- Session document — exact app replica -->
        <div class="session-panel">
          <div class="session-messages">
            <!-- Turn 1: User prompt referencing pane context -->
            <div class="session-turn">
              <div class="session-turn-user">
                <div class="session-msg-bubble">look at the error in pane 2 terminal and fix the type error in the file it mentions</div>
              </div>
            </div>
            <!-- Turn 1: AI response with tool calls -->
            <div class="session-turn">
              <div class="session-turn-assistant">
                <div class="session-tool-call">
                  <div class="session-tool-header">
                    <svg class="session-tool-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                    <span>read_terminal_output</span>
                    <span class="session-tool-args">pane: 2</span>
                  </div>
                </div>
                <div class="session-assistant-text">
                  <p>Found <code>TypeError: Property 'items' does not exist on type 'unknown'</code> in <span class="session-file-ref">src/api/handlers.ts:47</span>. The response data needs a type assertion.</p>
                </div>
                <div class="session-tool-call">
                  <div class="session-tool-header">
                    <svg class="session-tool-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    <span>edit_file</span>
                    <span class="session-tool-args">src/api/handlers.ts</span>
                  </div>
                  <div class="session-tool-diff">
                    <div class="diff-line diff-remove">- const items = response.data.items;</div>
                    <div class="diff-line diff-add">+ const items = (response.data as ApiResponse).items;</div>
                  </div>
                </div>
                <div class="session-assistant-text">
                  <p>Fixed. The handler was accessing <code>.items</code> on an untyped response. Added the <code>ApiResponse</code> type assertion.</p>
                </div>
              </div>
            </div>
            <!-- Turn 2: User prompt referencing process logs -->
            <div class="session-turn">
              <div class="session-turn-user">
                <div class="session-msg-bubble">check the dev server logs for the crash and add the missing env variable</div>
              </div>
            </div>
            <!-- Turn 2: AI response -->
            <div class="session-turn">
              <div class="session-turn-assistant">
                <div class="session-tool-call">
                  <div class="session-tool-header">
                    <svg class="session-tool-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20v-6M6 20V10M18 20V4"></path></svg>
                    <span>read_process_logs</span>
                    <span class="session-tool-args">process: dev-server</span>
                  </div>
                </div>
                <div class="session-assistant-text">
                  <p>The dev server crashed because <code>DATABASE_URL</code> is not set. Adding it to your <span class="session-file-ref">.env</span> file.</p>
                </div>
              </div>
            </div>
          </div>
          <!-- Prompt input dock -->
          <div class="session-composer">
            <div class="session-input-wrap">
              <div class="session-input-field">
                <span class="session-placeholder">Message Claude...</span>
              </div>
              <div class="session-input-actions">
                <button class="session-attach-btn">
