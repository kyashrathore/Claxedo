---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import ClaxedoAppReplica from "../components/ClaxedoAppReplica.astro"
import CodexIcon from "../components/CodexIcon.astro"
import { requireClaim } from "../content/claims"
import { home, site, type HomeLine } from "../content/site"

for (const id of [...home.benchmark.claims, ...home.lines.flatMap((line) => line.claims)]) requireClaim(id)

const holdMs = { speed: 5200, prompt: 3600, team: 3600, place: 3600, tools: 3600, terminal: 3800 } as const
const split = (line: HomeLine) => {
  const at = line.text.indexOf(line.loud)
  return [
    { text: line.text.slice(0, at), loud: false },
    { text: line.loud, loud: true },
    { text: line.text.slice(at + line.loud.length), loud: false },
  ].filter((part) => part.text.trim().length > 0)
}
const words = (text: string) => text.trim().split(/\s+/)
---

<Layout title={`Claxedo — ${site.headline}`} description={site.description}>
  <Nav />
  <main id="main-content" class="home">
    <h1 class="sr-only">Claxedo</h1>
    <section class="intro" aria-label="What Claxedo does" data-stage-root>
      <ol class="stage" data-stage>
        {home.lines.map((line, index) => {
          let order = 0
          return (
            <li class:list={["stage-line", { "is-in": index === 0 }]} data-stage-line={line.id} data-hold={holdMs[line.id]}>
              <p class="sentence">
                <span class="sr-only">{line.text}</span>
                <span class="voice" aria-hidden="true">
                  {split(line).map((part) => (
                    <span class:list={["part", part.loud ? "loud" : "muted"]}>
                      {words(part.text).map((word) => <><span class="word" style={`--i:${order++}`}>{word}</span>{" "}</>)}
                    </span>
                  ))}
                </span>
              </p>
              {home.benchmark.line === line.id && (
                <dl class="metrics">
                  {home.benchmark.metrics.map((metric, i) => (
                    <div class="metric" style={`--i:${i}`}>
                      <dt>{metric.name}</dt>
                      <dd><b>{metric.value}</b>{metric.compare.map((text) => <span>{text}</span>)}</dd>
                    </div>
                  ))}
                </dl>
              )}
              <span class="proof-cell">
                {line.proof && <a class="proof" href={line.proof.href} data-proof>{line.proof.label}</a>}
              </span>
            </li>
          )
        })}
      </ol>
      <div class="rail-row">
        <a class="proof slot" data-link-slot hidden>
          <span data-link-label></span>
          <CodexIcon name="open-external" />
        </a>
        <div class="controls" data-stage-controls hidden>
          <div class="steps" role="group" aria-label="Choose a line">
            {home.lines.map((line, index) => (
              <button type="button" class="step" data-step={index} aria-label={line.text} aria-current={index === 0 ? "step" : undefined}><i></i></button>
            ))}
          </div>
          <button type="button" class="pause" data-stage-pause aria-label="Pause" aria-pressed="false">
            <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5v9M10.5 3.5v9"></path></svg>
            <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5z"></path></svg>
          </button>
        </div>
      </div>
    </section>
    <div class="preview" data-zoom>
      <ClaxedoAppReplica />
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const root = document.querySelector<HTMLElement>("[data-stage-root]")
  const demo = document.querySelector<HTMLElement>("[data-demo]")
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)")
  if (root && !reduce.matches) {
    const stage = root.querySelector<HTMLElement>("[data-stage]")!
    const lines = Array.from(stage.querySelectorAll<HTMLElement>("[data-stage-line]"))
    const controls = root.querySelector<HTMLElement>("[data-stage-controls]")!
    const steps = Array.from(controls.querySelectorAll<HTMLButtonElement>("[data-step]"))
    const pauseButton = controls.querySelector<HTMLButtonElement>("[data-stage-pause]")!
    const reasons = new Set<string>()
    let index = 0
    let fill: Animation | undefined

    const slot = root.querySelector<HTMLAnchorElement>("[data-link-slot]")!
    const slotLabel = slot.querySelector<HTMLElement>("[data-link-label]")!
    stage.querySelectorAll<HTMLAnchorElement>("[data-proof]").forEach((link) => { link.tabIndex = -1 })
    controls.hidden = false
    slot.hidden = false
    root.dataset.playing = "true"

    const syncSlot = (line: HTMLElement) => {
      const proof = line.querySelector<HTMLAnchorElement>("[data-proof]")
      slot.classList.toggle("is-empty", !proof)
      if (proof) {
        slot.href = proof.href
        slotLabel.textContent = proof.textContent
      } else {
        slot.removeAttribute("href")
        slotLabel.textContent = ""
      }
    }

    const syncDemo = (line: HTMLElement) => {
      if (!demo) return
      demo.dispatchEvent(new CustomEvent("demo:spot", { detail: { spot: line.dataset.stageLine, open: true } }))
    }

    const applyPause = () => {
      const paused = reasons.size > 0
      root.dataset.paused = String(paused)
      if (paused) fill?.pause()
      else fill?.play()
      const byUser = reasons.has("user") || reasons.has("demo")
      pauseButton.setAttribute("aria-pressed", String(byUser))
      pauseButton.setAttribute("aria-label", byUser ? "Play" : "Pause")
    }

    const show = (next: number) => {
      const from = lines[index]
      const to = lines[next]
      if (from !== to) {
        from.classList.remove("is-in")
        from.classList.add("is-out")
        const settle = (event: AnimationEvent) => {
          if (event.target !== from) return
          from.classList.remove("is-out")
          from.removeEventListener("animationend", settle)
        }
        from.addEventListener("animationend", settle)
      }
      to.classList.remove("is-out", "is-in")
      void to.offsetWidth
      to.classList.add("is-in")
      index = next
      steps.forEach((step, i) => {
        step.classList.toggle("is-done", i < next)
        if (i === next) step.setAttribute("aria-current", "step")
        else step.removeAttribute("aria-current")
      })
      fill?.cancel()
      fill = steps[next].querySelector("i")!.animate([{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }], {
        duration: Number(to.dataset.hold),
        easing: "linear",
        fill: "forwards",
      })
      fill.onfinish = () => show((index + 1) % lines.length)
      syncSlot(to)
      syncDemo(to)
      applyPause()
    }

    const hold = (reason: string, on: boolean) => {
      if (on) reasons.add(reason)
      else reasons.delete(reason)
      applyPause()
    }

    steps.forEach((step, i) => step.addEventListener("click", () => show(i)))
    controls.querySelector(".steps")!.addEventListener("keydown", (event) => {
      const key = (event as KeyboardEvent).key
      if (key !== "ArrowRight" && key !== "ArrowLeft") return
      event.preventDefault()
      const focused = steps.indexOf(document.activeElement as HTMLButtonElement)
      const next = ((focused < 0 ? index : focused) + (key === "ArrowRight" ? 1 : lines.length - 1)) % lines.length
      show(next)
      steps[next].focus()
    })
    pauseButton.addEventListener("click", () => {
      const resume = reasons.has("user") || reasons.has("demo")
      reasons.delete("demo")
      hold("user", !resume)
    })
    stage.addEventListener("pointerenter", () => hold("hover", true))
    stage.addEventListener("pointerleave", () => hold("hover", false))
    stage.addEventListener("focusin", (event) => {
      hold("focus", true)
      const line = (event.target as Element).closest<HTMLElement>("[data-stage-line]")
      if (line && line !== lines[index]) show(lines.indexOf(line))
    })
    stage.addEventListener("focusout", (event) => {
      if (!stage.contains(event.relatedTarget as Node | null)) hold("focus", false)
    })
    demo?.addEventListener("demo:touched", () => hold("demo", true))
    document.addEventListener("visibilitychange", () => hold("hidden", document.hidden))

    show(0)
  }
</script>

<script>
  const preview = document.querySelector<HTMLElement>("[data-zoom]")
  const wide = window.matchMedia("(min-width: 48rem)")
  const still = window.matchMedia("(prefers-reduced-motion: reduce)")
  const scrollLinked = CSS.supports("animation-timeline: scroll()")
  if (preview) {
    let frame = 0
    const zoomTo = () => {
      const { offsetWidth: width, offsetHeight: height } = preview
      const byArea = Math.sqrt((0.75 * innerWidth * innerHeight) / (width * height))
      return Math.max(1, Math.min(byArea, (innerWidth - 32) / width, (innerHeight * 0.92) / height))
    }
    const measure = () => {
      const to = wide.matches ? zoomTo() : 1
      preview.style.setProperty("--zoom-to", to.toFixed(3))
      preview.style.setProperty("--zoom-extra", `${Math.round((to - 1) * preview.offsetHeight)}px`)
      follow()
    }
    const follow = () => {
      if (scrollLinked || still.matches || !wide.matches) return preview.style.removeProperty("scale")
      const progress = Math.min(1, Math.max(0, scrollY / (innerHeight * 0.4)))
      preview.style.scale = String(1 + (Number(preview.style.getPropertyValue("--zoom-to")) - 1) * progress)
    }
    measure()
    addEventListener("resize", measure, { passive: true })
    if (!scrollLinked) addEventListener("scroll", () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(follow) }, { passive: true })
  }
</script>

<style>
  .home { --home-width: min(100% - 2 * var(--gutter), 75rem); }
  .intro { width: var(--home-width); margin: 0 auto; padding-block: clamp(1.75rem, 5vh, 3rem) clamp(1.5rem, 3.5vh, 2.25rem); }

  .stage {
    --stage-size: clamp(2.1rem, 4.4vw, 4rem);
    --line-box: calc(var(--stage-size) * 1.06 * 2);
    --strip-box: 5.5rem;
    position: relative;
    height: calc(var(--line-box) + var(--strip-box) + 1.25rem);
    margin: 0;
    padding: 0;
    overflow-x: clip;
    list-style: none;
  }
  .stage-line {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: var(--line-box) var(--strip-box);
    row-gap: 1.25rem;
    opacity: 0;
    pointer-events: none;
  }
  .stage-line.is-in, .stage-line.is-out { opacity: 1; }
  .stage-line.is-in { pointer-events: auto; }
  .stage-line.is-out { animation: line-out 240ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  @keyframes line-out { to { opacity: 0; transform: translateY(-8px); filter: blur(3px); } }
  .intro[data-paused="true"] .stage-line.is-in, .intro[data-paused="true"] .stage-line.is-in * { animation-play-state: paused; }

  .sentence { align-self: end; max-width: 22ch; margin: 0; font: 700 var(--stage-size)/1.06 var(--font-display); letter-spacing: -.038em; text-wrap: balance; }
  .voice { display: block; }
  .loud { color: var(--ink); }
  .muted { color: var(--ink-faint); }
  .word { display: inline-block; }
  .stage-line.is-in .loud .word { animation: word-in 620ms cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(var(--i) * 55ms); }
  .stage-line.is-in .muted .word { animation: muted-in 700ms cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(380ms + var(--i) * 40ms); }
  @keyframes word-in { from { opacity: 0; transform: translateY(.35em); clip-path: inset(0 0 100% 0); } to { opacity: 1; transform: none; clip-path: inset(-.2em -.1em -.25em -.1em); } }
  @keyframes muted-in { from { opacity: 0; filter: blur(4px); } }

  .metrics { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.5rem; align-self: start; margin: 0; }
  .metric { display: grid; gap: .2rem; padding-top: .7rem; border-top: 1px solid var(--line-strong); }
  .metric dt { color: var(--ink-faint); font-size: .8125rem; }
  .metric dd { display: grid; margin: 0; }
  .metric b { margin-bottom: .15rem; color: var(--ink); font: 650 1.375rem/1.1 var(--font-display); letter-spacing: -.02em; }
  .metric span { color: var(--ink-faint); font-size: .75rem; line-height: 1.35; }
  .stage-line.is-in .metric { animation: metric-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(700ms + var(--i) * 70ms); }
  @keyframes metric-in { from { opacity: 0; transform: translateY(8px); } }

  .intro[data-playing="true"] .proof-cell { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .proof { display: inline-flex; align-items: center; gap: .3rem; min-height: 2rem; color: var(--ink-soft); font-size: .875rem; text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: .2em; }
  .proof:hover { color: var(--ink); text-decoration-color: currentColor; }
  .proof :global(svg) { width: 1rem; height: 1rem; }
  .rail-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2rem; margin-top: .5rem; }
  .slot { min-width: 14rem; }
  .slot[hidden] { display: none; }
  .slot.is-empty { visibility: hidden; }

  .controls { display: flex; align-items: center; gap: .75rem; }
  .controls[hidden] { display: none; }
  .steps { display: flex; gap: .375rem; }
  .step { position: relative; display: block; width: 2.5rem; height: 1.5rem; padding: 0; border: 0; background: none; cursor: pointer; }
  .step::before { content: ""; position: absolute; inset: calc(50% - 1.5px) 0 auto; height: 3px; border-radius: 3px; background: var(--line-strong); }
  .step i { position: absolute; inset: calc(50% - 1.5px) 0 auto; height: 3px; border-radius: 3px; background: var(--ink); transform: scaleX(0); transform-origin: left; }
  .step.is-done i { transform: scaleX(1); }
  .step:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 4px; }
  .pause { position: relative; display: grid; place-items: center; width: 2rem; height: 2rem; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--ink-soft); cursor: pointer; }
  .pause:hover { background: var(--surface-hover); color: var(--ink); }
  .pause::after { content: ""; position: absolute; inset: -.25rem; }
  .pause svg { grid-area: 1 / 1; width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: opacity 200ms cubic-bezier(0.2, 0, 0, 1), scale 200ms cubic-bezier(0.2, 0, 0, 1), filter 200ms cubic-bezier(0.2, 0, 0, 1); }
  .pause .icon-play { fill: currentColor; stroke: none; opacity: 0; scale: .25; filter: blur(4px); }
  .pause[aria-pressed="true"] .icon-play { opacity: 1; scale: 1; filter: none; }
  .pause[aria-pressed="true"] .icon-pause { opacity: 0; scale: .25; filter: blur(4px); }

  .preview { --zoom-to: 1; --zoom-extra: 0px; width: var(--home-width); margin: 0 auto calc(clamp(4rem, 8vw, 6rem) + var(--zoom-extra)); transform-origin: 50% 0; }
  @keyframes demo-zoom { from { scale: 1; } to { scale: var(--zoom-to); } }
  @supports (animation-timeline: scroll()) {
    @media (min-width: 48rem) and (prefers-reduced-motion: no-preference) {
      .preview { animation: demo-zoom linear both; animation-timeline: scroll(root); animation-range: 0 40vh; }
    }
  }
  @media (min-width: 48rem) and (prefers-reduced-motion: reduce) {
    .preview { scale: var(--zoom-to); }
  }

  @media (max-width: 38rem) {
    .home { --home-width: calc(100% - 2rem); }
    .stage { --stage-size: 2rem; --line-box: calc(var(--stage-size) * 1.06 * 3); --strip-box: 14rem; }
    .metrics { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .metric { grid-template-columns: 6.5rem minmax(0, 1fr); align-items: center; padding: .4rem 0; }
    .metric dd { grid-template-columns: 4.75rem minmax(0, 1fr); column-gap: .5rem; align-items: center; }
    .metric b { grid-row: span 2; margin: 0; font-size: 1.0625rem; }
    .rail-row { flex-direction: column-reverse; align-items: flex-start; gap: .25rem; }
    .step { width: 1.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage { display: grid; gap: 1.25rem; height: auto; --stage-size: clamp(1.5rem, 2.6vw, 2.1rem); }
    .stage-line { position: static; grid-template-columns: minmax(0, 1fr) 15rem; grid-template-rows: auto; gap: .75rem 2rem; opacity: 1; pointer-events: auto; }
    .sentence { align-self: start; max-width: none; }
    .metrics { grid-column: 1; grid-row: 2; }
    .proof-cell { grid-column: 2; grid-row: 1; align-self: center; }
    .stage-line *, .stage-line *::after { animation: none !important; }
  }
</style>
