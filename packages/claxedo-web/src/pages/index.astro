---
import Layout from '../layouts/Layout.astro';

const clean = (value: string | undefined) => value?.trim().replace(/\/+$/, '');
const appUrl =
  clean(import.meta.env.PUBLIC_CLAXEDO_APP_URL) ??
  clean(import.meta.env.CLAXEDO_APP_URL) ??
  (import.meta.env.DEV ? 'http://localhost:4444' : 'https://app.claxedo.com');
const previewSrc = `${appUrl}?demo=1&embed=1`;

const hero = {
  src: '/screenshots/hero-attached-review.png',
  alt: 'Claxedo review workspace preview',
};

const features = [
  { title: 'Strong open source foundation', desc: 'Built on OpenCode \u2014 a fully open source AI coding tool with an active community and transparent development.', from: 'opencode' },
  { title: 'Any model, any provider', desc: 'Use any LLM through OpenRouter, Anthropic, OpenAI, or any compatible API endpoint.', from: 'opencode' },
  { title: 'Theme & keyboard shortcuts', desc: 'Customize your environment with themes and rebindable keyboard shortcuts.', from: 'opencode' },
  { title: 'Panes, tabs & groups', desc: 'Split panes for side-by-side viewing. Tabs across workspaces and projects without nested clicks. Multi tab groups for better organisation.', from: 'claxedo' },
  { title: 'Any CLI coding agent', desc: 'Run Claude Code, Codex, Gemini CLI, Pi, Amp, Cursor agent, or any coding CLI \u2014 each in its own managed terminal.', from: 'claxedo' },
  { title: 'Agent lifecycle awareness', desc: 'See which agents are running, waiting, or finished. Restart or stop them from the workspace.', from: 'claxedo' },
  { title: 'Process management', desc: 'Configure processes, auto-run them across all workspaces, avoid port conflicts, and manage state per process.', from: 'claxedo' },
  { title: 'Workspace-aware MCP', desc: 'Model Context Protocol integration that understands your full workspace, not just the active file.', from: 'claxedo' },
  { title: 'Spec-driven pages', desc: 'Write specs, notes, and prompts inside the workspace. Coming soon: doc lifecycle from dump to explore to design to implement.', from: 'claxedo' },
  { title: 'First class AI review', desc: 'A dedicated review surface for diffs, changed files, and agent output. Inspect every change before shipping.', from: 'claxedo' },
  { title: 'Connect on mobile', desc: 'Access your workspace from a tablet or phone through the web version when you\u2019re away from your desk.', from: 'claxedo' },
];

const faq = [
  {
    q: 'What is Claxedo?',
    a: 'Claxedo is a desktop workspace built on top of OpenCode. It adds multi-pane layouts, project tabs, process management, and a review surface so you can run multiple AI coding workflows in parallel.',
  },
  {
    q: 'How does it relate to OpenCode?',
    a: 'OpenCode is the open source foundation that handles AI sessions, model routing, and tool use. Claxedo syncs daily with upstream OpenCode and adds the workspace layer on top. You get all OpenCode features plus everything Claxedo adds.',
  },
  {
    q: 'Which coding agents does it support?',
    a: 'Any CLI-based coding agent \u2014 Claude Code, Codex, Gemini CLI, Amp, Cursor agent, and others. Each agent runs in its own managed terminal inside the workspace.',
  },
  {
    q: 'Do I need my own API keys?',
    a: 'Yes. Claxedo is a local workspace, not a hosted service. You bring your own API keys for whichever model provider you use \u2014 Anthropic, OpenAI, OpenRouter, or any compatible endpoint.',
  },
  {
    q: 'Is there a free trial?',
    a: 'There is a live demo on this site you can try immediately. The full desktop app requires a license.',
  },
  {
    q: 'What platforms are supported?',
    a: 'macOS and Linux. Windows support is planned.',
  },
];

const pricing = {
  price: '$159',
  earlyBird: '$99',
  features: [
    'Unlimited projects',
    'Unlimited parallel agents',
    'Multi-pane workspace',
    'All agent integrations',
    'Process management',
    'Workspace-aware MCP',
    'Page editor',
    'GitHub source code access',
    'Discord community access',
    'Lifetime support',
  ],
  ctaHref: 'https://github.com/kyashrathore/Claxedo/releases',
};

---

<Layout title="Claxedo — The Parallel AI Workspace">
  <div class="page-frame">
    <!-- Navigation -->
    <nav class="nav">
      <a href="/" class="nav-logo">
        <svg class="brand-mark" viewBox="-100 -90 200 180" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" aria-hidden="true">
          <path class="brand-mark-arc" d="M 38,-72 A 84,84 0 1 0 38,72"></path>
          <circle class="brand-mark-dot" cx="38" cy="-72" r="5"></circle>
          <circle class="brand-mark-core" cx="38" cy="-72" r="2"></circle>
          <circle class="brand-mark-dot" cx="38" cy="72" r="5"></circle>
          <circle class="brand-mark-core" cx="38" cy="72" r="2"></circle>
        </svg>
        <span>Claxedo</span>
      </a>
      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#pricing">Pricing</a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
      <h1 class="hero-title">
        The parallel AI workspace<br />
        built on OpenCode
      </h1>
      <p class="hero-sub">
        Keep multiple projects, workspaces, AI sessions, and terminals open at once.
        Claxedo extends OpenCode with a powerful multi-pane layout, instant agent terminals,
        and workspace-aware AI context.
      </p>
      <div class="hero-actions">
        <a href="#pricing" class="btn-primary">Buy Now</a>
      </div>
    </section>

    <!-- Product Preview — bleeds out on scroll, returns -->
    <section class="preview">
      <div class="preview-sticky" id="preview-sticky">
        <div class="preview-perspective" id="hero-perspective">
          <div class="preview-frame" id="hero-frame">
            <div class="preview-shell" id="preview-shell">
              <div class="preview-poster-frame">
                <img
                  id="demo-poster"
                  src={hero.src}
                  alt={hero.alt}
                  class="preview-poster"
                  width="3024"
                  height="1654"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </div>
              <iframe
                id="demo-frame"
                class="preview-app"
                title="Claxedo live preview"
                loading="lazy"
                tabindex="-1"
                data-src={previewSrc}
              ></iframe>
              <div class="preview-banner" id="preview-banner" role="status" aria-live="polite">
                <span class="preview-dot" aria-hidden="true"></span>
                <span id="preview-banner-text">Loading live workspace&hellip;</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="features-section">
      <div class="features-header">
        <span class="section-tag">// Features</span>
        <h2>What Claxedo adds to OpenCode</h2>
      </div>
      <div class="features-grid">
        {features.map((f) => (
          <article class="feature-cell">
            <div class="feature-top">
              <h3>{f.title}</h3>
              <span class={`feature-tag ${f.from}`}>{f.from === 'opencode' ? 'OpenCode' : 'Claxedo'}</span>
            </div>
            <p>{f.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="pricing">
      <div class="pricing-header">
        <span class="section-tag">// Pricing</span>
        <h2>One price, everything included</h2>
      </div>
      <div class="pricing-card">
        <div class="pricing-card-top">
          <div class="pricing-price">
            <span class="pricing-amount-old">{pricing.price}</span>
            <span class="pricing-amount">{pricing.earlyBird}</span>
            <span class="pricing-period">USD</span>
          </div>
          <p class="pricing-early">Early bird pricing &mdash; limited time</p>
        </div>
        <ul class="pricing-features">
          {pricing.features.map((f) => (
            <li><span class="check">{'\u2713'}</span> {f}</li>
          ))}
        </ul>
        <a href={pricing.ctaHref} class="btn-primary pricing-cta">Buy Now</a>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq-section">
      <div class="faq-header">
        <span class="section-tag">// FAQ</span>
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-grid">
        <div class="footer-col">
          <a href="#features">Features</a>
        </div>
        <div class="footer-col">
          <a href="#pricing">Pricing</a>
        </div>
        <div class="footer-col">
          <a href="https://github.com/opencode-ai/opencode">OpenCode</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>Built on <a href="https://github.com/opencode-ai/opencode">OpenCode</a>. Synced daily with upstream.</p>
      </div>
    </footer>
  </div>
</Layout>

<style>
  /* ===== Page Frame (OpenCode bordered document) ===== */
  .page-frame {
    --padding: 3rem;
    --vpad: 1.5rem;
    max-width: 72rem;
    margin: 1rem auto;
    border: var(--bw) solid var(--border);
    overflow: visible;
  }

  @media (max-width: 30rem) {
    .page-frame {
      --padding: 1rem;
      --vpad: 0.75rem;
      margin: 0.5rem auto;
    }
  }

  /* ===== Navigation ===== */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--vpad) var(--padding);
    border-bottom: var(--bw) solid var(--border);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--text-strong);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .brand-mark {
    width: 18px;
    height: 18px;
    overflow: visible;
    flex: none;
    color: var(--text-strong);
  }

  .brand-mark-arc {
    stroke: currentColor;
    stroke-width: 6;
  }

  .brand-mark-dot {
    fill: currentColor;
  }

  .brand-mark-core {
    fill: var(--bg);
  }

  .nav-links {
    display: flex;
    gap: 32px;
  }

  .nav-links a {
    font-size: 1rem;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--text-strong);
  }

  /* ===== Hero ===== */
  .hero {
    padding: var(--padding);
  }

  .hero-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.25;
    text-transform: uppercase;
    color: var(--text-strong);
    margin-bottom: var(--vpad);
  }

  .hero-sub {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
    margin-bottom: calc(var(--vpad) * 1.5);
    max-width: 560px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
  }

  /* ===== Product Preview (Full Bleed, Scroll Animated) ===== */
  .preview {
    position: relative;
    height: 220vh;
  }

  .preview-sticky {
    --bleed: 0px;
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    margin-left: calc(var(--bleed) * -1);
    margin-right: calc(var(--bleed) * -1);
  }

  .preview-perspective {
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
    overflow: clip;
    flex: 1;
    width: 100%;
  }

  .preview-frame {
    width: 100%;
    height: 100%;
    border: var(--bw) solid var(--border);
    overflow: hidden;
    will-change: transform, opacity;
    transform: translateY(40px) scale(0.95) rotateX(2deg);
    opacity: 0.7;
    transition: transform 0.1s linear, opacity 0.1s linear;
  }

  .preview-shell {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: hsl(0, 9%, 7%);
  }

  .preview-poster-frame {
    position: absolute;
    inset: 0;
    display: block;
  }

  .preview-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: top center;
    background: hsl(0, 9%, 7%);
    transition: opacity 0.45s ease, transform 0.45s ease, filter 0.45s ease;
  }

  .preview-app {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transform: scale(1.015);
    transition: opacity 0.45s ease, transform 0.45s ease;
    background: hsl(0, 9%, 7%);
    pointer-events: none;
  }

  .preview-banner {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border: var(--bw) solid hsl(0, 4%, 23%);
    background: hsl(0, 9%, 7%);
    color: hsl(0, 4%, 71%);
    font-size: 13px;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .preview-dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    animation: pulse 1.6s ease-in-out infinite;
  }

  .preview-shell.is-live .preview-poster {
    opacity: 0;
    transform: scale(1.015);
    filter: blur(10px);
  }

  .preview-shell.is-live .preview-app {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .preview-shell.is-live .preview-banner {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* ===== Features ===== */
  .features-header {
    padding: var(--padding);
    padding-bottom: var(--vpad);
  }

  .section-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-weak);
    margin-bottom: 12px;
  }

  .features-header h2 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--text-strong);
    line-height: 1.25;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: var(--bw) solid var(--border);
  }

  .feature-cell {
    padding: calc(var(--vpad) * 0.8) calc(var(--padding) * 0.5);
    border-bottom: var(--bw) solid var(--border);
    border-right: var(--bw) solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .feature-cell:nth-child(3n) {
    border-right: none;
  }

  /* last row: remove bottom border */
  .feature-cell:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .feature-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .feature-cell h3 {
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--text-strong);
    letter-spacing: -0.02em;
  }

  .feature-tag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border: 1px solid var(--border);
    color: var(--text-weak);
  }

  .feature-tag.claxedo {
    color: var(--text-strong);
    border-color: var(--text-strong);
  }

  .feature-cell p {
    color: var(--text);
    line-height: 1.6;
  }

  /* ===== Pricing ===== */
  .pricing {
    border-top: var(--bw) solid var(--border);
    padding: var(--padding);
  }

  .pricing-header {
    margin-bottom: var(--vpad);
  }

  .pricing-header h2 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .pricing-card {
    padding: calc(var(--vpad) * 1.5) calc(var(--padding) * 0.67);
    display: flex;
    flex-direction: column;
    border: var(--bw) solid var(--border);
    max-width: 480px;
  }

  .pricing-card-top {
    margin-bottom: var(--vpad);
  }

  .pricing-tier {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-weak);
    margin-bottom: 16px;
  }

  .pricing-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
  }

  .pricing-amount-old {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--text-weaker);
    text-decoration: line-through;
  }

  .pricing-amount {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.03em;
  }

  .pricing-period {
    font-size: 1rem;
    color: var(--text-weak);
  }

  .pricing-early {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-weak);
    margin-top: 4px;
  }

  .pricing-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: calc(var(--vpad) * 1.5);
  }

  .pricing-features li {
    color: var(--text);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.4;
  }

  .pricing-features li.muted {
    color: var(--text-weaker);
  }

  .pricing-features li.muted .check,
  .pricing-features li.muted .dash {
    color: var(--text-weaker);
  }

  .pricing-cta {
    display: block;
    text-align: center;
    margin-top: auto;
  }

  .pricing-note {
    margin-top: var(--vpad);
    font-size: 12px;
    color: var(--text-weak);
  }

  /* ===== FAQ ===== */
  .faq-section {
    border-top: var(--bw) solid var(--border);
  }

  .faq-header {
    padding: var(--padding);
    padding-bottom: var(--vpad);
  }

  .faq-header h2 {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--text-strong);
    line-height: 1.25;
  }

  .faq-list {
    border-top: var(--bw) solid var(--border);
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: var(--vpad) var(--padding);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-weight: 500;
    color: var(--text-strong);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    color: var(--text-weak);
    transition: transform 0.2s ease;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    margin-top: 12px;
    color: var(--text);
    line-height: 1.6;
    max-width: 48rem;
  }

  /* ===== Footer ===== */
  .footer {
    border-top: var(--bw) solid var(--border);
  }

  .footer-grid {
    display: flex;
  }

  .footer-col {
    flex: 1;
    padding: var(--vpad) var(--padding);
    text-align: center;
    text-transform: uppercase;
  }

  .footer-col + .footer-col {
    border-left: var(--bw) solid var(--border);
  }

  .footer-col a {
    color: var(--text);
    transition: color 0.15s;
  }

  .footer-col a:hover {
    color: var(--text-strong);
  }

  .footer-bottom {
    border-top: var(--bw) solid var(--border);
    padding: var(--vpad) var(--padding);
  }

  .footer-bottom p {
    color: var(--text-weak);
    font-size: 12px;
  }

  .footer-bottom a {
    color: var(--text-strong);
  }

  /* ===== Responsive ===== */
  @media (max-width: 60rem) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .feature-cell:nth-child(3n) {
      border-right: var(--bw) solid var(--border);
    }

    .feature-cell:nth-child(2n) {
      border-right: none;
    }

    .feature-cell:nth-last-child(-n+2) {
      border-bottom: var(--bw) solid var(--border);
    }

    .feature-cell:nth-last-child(-n+1) {
      border-bottom: none;
    }
  }

  @media (max-width: 40rem) {
    .features-grid {
      grid-template-columns: 1fr;
    }

    .feature-cell {
      border-right: none;
    }

    .feature-cell:nth-child(3n) {
      border-right: none;
    }

    .feature-cell:nth-last-child(-n+2) {
      border-bottom: var(--bw) solid var(--border);
    }

    .feature-cell:last-child {
      border-bottom: none;
    }
    .nav-links {
      display: none;
    }

    .footer-grid {
      flex-direction: column;
    }

    .footer-col + .footer-col {
      border-left: none;
      border-top: var(--bw) solid var(--border);
    }
  }
</style>

<script>
  const shell = document.getElementById('preview-shell');
  const frame = document.getElementById('demo-frame') as HTMLIFrameElement | null;
  const text = document.getElementById('preview-banner-text');
  let boot = false;
  let live = false;
  let wait = 0;

  function start() {
    if (boot || !shell || !frame) return;
    const next = frame.dataset.src;
    if (!next) return;
    boot = true;
    if (text) text.textContent = 'Loading live workspace\u2026';
    wait = window.setTimeout(() => {
      if (!live && text) text.textContent = 'Still waking up the live workspace\u2026';
    }, 3200);
    frame.src = next;
  }

  function ready() {
    live = true;
    window.clearTimeout(wait);
    shell?.classList.add('is-live');
    if (text) text.textContent = 'Live workspace ready';
  }

  frame?.addEventListener('load', ready, { once: true });

  if (shell && frame) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        start();
        io.disconnect();
      }, { rootMargin: '280px 0px' });
      io.observe(shell);
    }

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => start(), { timeout: 1600 });
    } else {
      window.setTimeout(() => start(), 900);
    }
  }

  // ===== Hero Scroll Animation (3D -> flat + bleed) =====
  const heroFrame = document.getElementById('hero-frame');
  const previewSection = document.querySelector<HTMLElement>('.preview');
  const previewSticky = document.getElementById('preview-sticky');

  if (heroFrame && previewSection && previewSticky) {
    const ease = (t: number) =>
      t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;

    const getMaxBleed = () => {
      const frameRect = previewSection.closest('.page-frame')?.getBoundingClientRect();
      return frameRect ? frameRect.left + parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--bw') || '2') : 0;
    };

    let currentBleed = 0;
    let targetBleed = 0;
    let rafId = 0;
    const LERP_SPEED = 0.04;

    const animateBleed = () => {
      const diff = targetBleed - currentBleed;
      if (Math.abs(diff) < 0.5) {
        currentBleed = targetBleed;
      } else {
        currentBleed += diff * LERP_SPEED;
        rafId = requestAnimationFrame(animateBleed);
      }
      previewSticky.style.setProperty('--bleed', `${currentBleed}px`);
    };

    const handleScroll = () => {
      const rect = previewSection.getBoundingClientRect();
      const windowH = window.innerHeight;

      const scrollable = Math.max(previewSection.offsetHeight - windowH, 1);
      const scrolled = Math.min(Math.max(-rect.top, 0), scrollable);
      const progress = scrolled / scrollable;

      // 3D intro: 0 → 0.4
      const introRaw = Math.min(progress / 0.4, 1);
      const intro = ease(introRaw);

      const translateY = 40 * (1 - intro);
      const scale = 0.95 + 0.05 * intro;
      const rotateX = 2 * (1 - intro);
      const opacity = 0.7 + 0.3 * intro;

      heroFrame.style.transform = `translateY(${translateY}px) scale(${scale}) rotateX(${rotateX}deg)`;
      heroFrame.style.opacity = String(opacity);

      // Bleed from first scroll to end of preview section
      const sectionEnd = previewSection.offsetTop + previewSection.offsetHeight - windowH;
      const bleedP = sectionEnd > 0 ? Math.min(Math.max(window.scrollY / sectionEnd, 0), 1) : 0;
      const maxBleed = getMaxBleed();

      // expand 0→0.3 (very slow), hold 0.3→0.7, contract 0.7→1.0 (gradual)
      if (bleedP < 0.3) {
        const t = bleedP / 0.3;
        targetBleed = t * t * t * t * maxBleed; // quartic ease-in
      } else if (bleedP < 0.7) {
        targetBleed = maxBleed;
      } else {
        const t = (bleedP - 0.7) / 0.3;
        targetBleed = (1 - t * t) * maxBleed; // quadratic ease-out for gentle contraction
      }

      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(animateBleed);
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }
</script>
