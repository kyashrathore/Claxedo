    overflow: hidden;
  }

  .ws-sidebar-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    margin-right: 8px;
    transition: background 0.1s, color 0.1s;
  }

  .ws-sidebar-toggle:hover {
    background: var(--bg-muted);
    color: var(--text-secondary);
  }

  .ws-prefix {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    margin-right: 8px;
    flex-shrink: 0;
  }

  .ws-path {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    flex: 1;
    overflow: hidden;
  }

  .ws-project {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .ws-sep {
    font-size: 13px;
    color: var(--text-weak);
    flex-shrink: 0;
  }

  .ws-workspace-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 6px;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.1s;
  }

  .ws-workspace-btn:hover {
    background: var(--bg-muted);
  }

  .ws-wt-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .ws-workspace-name {
    font-size: 13px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .ws-workspace-name.highlighted {
    color: var(--text);
    font-weight: 600;
  }

  .ws-add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: transparent;
    border: none;
    color: var(--text-weak);
    cursor: pointer;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    margin-left: 2px;
    transition: background 0.1s, color 0.1s;
  }

  .ws-add-btn:hover {
    background: var(--bg-muted);
    color: var(--text-secondary);
  }

  .ws-kebab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    margin-left: auto;
    border-left: 1px solid var(--border-subtle);
    padding-left: 8px;
    transition: color 0.1s;
  }

  .ws-kebab:hover { color: var(--text-secondary); }

  /* Main layout: sidebar + content */
  .ws-layout {
    display: flex;
    min-height: 280px;
  }

  /* Collapsed sidebar strip (40px) */
  .ws-sidebar {
    width: 40px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 0;
    border-right: 1px solid var(--border-subtle);
    background: var(--bg);
  }

  .ws-badge {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    background: var(--badge-bg);
    cursor: pointer;
    transition: opacity 0.1s;
  }

  .ws-badge:hover { opacity: 0.85; }

  /* Main content area */
  .ws-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Tab bar (40px) */
  .ws-tabbar {
    display: flex;
    align-items: center;
    height: 40px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
    padding-right: 8px;
    flex-shrink: 0;
  }

  /* Base tab */
  .ws-tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 8px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 450;
    font-family: var(--font-sans);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.12s, color 0.1s;
  }

  .ws-tab:hover {
    background: var(--bg-muted);
    color: var(--text-secondary);
  }

  /* Processes tab */
  .processes-tab {
    padding: 0 10px;
    gap: 4px;
    color: var(--text-muted);
  }

  .processes-tab svg {
    color: var(--success);
  }

  /* Agent tab — active state */
  .ws-tab.agent-tab {
    min-width: 80px;
    max-width: 200px;
  }

  .ws-tab.agent-tab.active {
    background: var(--surface);
    color: var(--text);
    font-weight: 500;
    border-top: 2px solid var(--wt-color, var(--accent));
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--surface);
    margin-bottom: -1px;
  }

  .ws-tab-label {
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  /* Status dots (10px) */
  .ws-tab-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: background 0.3s;
  }

  .ws-tab-dot.done { background: #22c55e; }
  .ws-tab-dot.loading { background: #f59e0b; animation: wsPulse 1s infinite; }
  .ws-tab-dot.attention {
    background: #ef4444;
    position: relative;
  }
  .ws-tab-dot.attention::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #f87171;
    animation: wsPing 1.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes wsPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @keyframes wsPing {
    75%, 100% { transform: scale(2); opacity: 0; }
  }

  /* Close button */
  .ws-tab-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--text-muted);
    opacity: 0;
    border-radius: var(--radius-sm);
    transition: opacity 0.1s, background 0.1s;
  }

  .ws-tab:hover .ws-tab-close,
  .ws-tab.active .ws-tab-close {
    opacity: 1;
  }

  .ws-tab-close:hover {
    background: var(--bg-muted);
    color: var(--text);
  }

  /* Action buttons */
  .ws-tab-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    border-left: 1px solid var(--border-subtle);
    margin-left: 2px;
  }

  .ws-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 40px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: background 0.1s, color 0.1s;
    flex-shrink: 0;
  }

  .ws-action-btn:hover {
    background: var(--bg-muted);
    color: var(--text-secondary);
  }

  .ws-letter {
    font-size: 12px;
    font-weight: 700;
    font-family: var(--font-sans);
  }

  /* Content panels */
  .ws-content {
    flex: 1;
    background: var(--surface);
    min-height: 200px;
    position: relative;
  }

  .ws-panel {
    display: none;
  }

  .ws-panel.active {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ws-panel-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .ws-panel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: background 0.3s;
  }

  .ws-panel-dot.done { background: #22c55e; }
  .ws-panel-dot.loading { background: #f59e0b; animation: wsPulse 1s infinite; }
  .ws-panel-dot.attention { background: #ef4444; }

  .ws-session-id {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }

  .ws-panel-tools {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
  }

  .ws-panel-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: transparent;
    border: none;
    color: var(--text-weak);
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: background 0.1s, color 0.1s;
  }

  .ws-panel-btn:hover {
    background: var(--bg-muted);
    color: var(--text-secondary);
  }

  .ws-panel-body {
    padding: 20px 24px;
    flex: 1;
  }

  .ws-panel-status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .ws-status-badge {
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 100px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .ws-status-badge.done { background: rgba(34, 197, 94, 0.12); color: #16a34a; }
  .ws-status-badge.loading { background: rgba(245, 158, 11, 0.12); color: #d97706; }
  .ws-status-badge.attention { background: rgba(239, 68, 68, 0.12); color: #dc2626; }

  @media (prefers-color-scheme: dark) {
    .ws-status-badge.done { color: #22c55e; }
    .ws-status-badge.loading { color: #f59e0b; }
    .ws-status-badge.attention { color: #ef4444; }
  }

  .ws-status-detail {
    font-size: 13px;
    color: var(--text-muted);
  }

  .ws-panel-code {
    background: var(--bg-subtle);
    border-radius: var(--radius-sm);
    padding: 16px 20px;
    border: 1px solid var(--border-subtle);
  }

  .ws-panel-code pre { margin: 0; }

  .ws-panel-code code {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    white-space: pre-wrap;
  }

  @keyframes statusFlash {
    0% { transform: scale(1); box-shadow: none; }
    50% { transform: scale(1.8); box-shadow: 0 0 12px rgba(34, 197, 94, 0.6); }
    100% { transform: scale(1); box-shadow: none; }
  }

  /* ===== Feature 03: Session Document ===== */
  .session-panel {
    background: #191515;
    display: flex;
    flex-direction: column;
    min-height: 480px;
    max-height: 580px;
  }

  .session-messages {
    flex: 1;
    padding: 32px 24px 16px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
    overflow-y: auto;
  }

  /* Each turn in timeline */
  .session-turn {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 4px;
  }

  .session-turn-user {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .session-msg-bubble {
    display: inline-block;
    max-width: min(82%, 56ch);
    background: #252121;
    border: 1px solid var(--dark-border);
    padding: 8px 14px;
    border-radius: var(--radius-md);
    font-size: 14px;
    line-height: 1.55;
    color: var(--dark-text-strong);
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Assistant response */
  .session-turn-assistant {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .session-assistant-text {
    font-size: 14px;
    line-height: 1.65;
    color: var(--dark-text-strong);
  }

  .session-assistant-text p {
    margin: 0;
  }

  .session-assistant-text code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--dark-bg);
    padding: 1px 5px;
    border-radius: 3px;
    color: #e8b4b8;
  }

  .session-file-ref {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #89b5ff;
  }

  /* Tool call blocks */
  .session-tool-call {
    background: var(--dark-bg);
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .session-tool-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--dark-text-weak);
  }

  .session-tool-icon {
    color: #89b5ff;
    flex-shrink: 0;
  }

  .session-tool-args {
    color: var(--dark-text-weak);
    opacity: 0.6;
    margin-left: auto;
    font-size: 11px;
  }

  .session-tool-diff {
    border-top: 1px solid var(--dark-border);
    padding: 8px 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
  }

  .diff-line {
    white-space: pre-wrap;
    word-break: break-all;
  }

  .diff-remove {
    color: #fc533a;
    background: rgba(252, 83, 58, 0.08);
    padding: 0 4px;
    margin: 0 -4px;
  }

  .diff-add {
    color: #22c55e;
    background: rgba(34, 197, 94, 0.08);
    padding: 0 4px;
    margin: 0 -4px;
  }

  /* Prompt input dock */
  .session-composer {
    padding: 12px 24px 16px;
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
  }

  .session-input-wrap {
    position: relative;
    background: var(--dark-bg);
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .session-input-field {
    padding: 8px 12px 44px 12px;
    min-height: 44px;
  }

  .session-placeholder {
    font-size: 14px;
    color: var(--dark-text-weak);
    pointer-events: none;
  }

  .session-input-actions {
    position: absolute;
    bottom: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .session-attach-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--dark-text-weak);
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }

  .session-attach-btn:hover {
    background: rgba(224, 183, 183, 0.086);
    color: var(--dark-text-strong);
  }

  .session-send-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    border: none;
    border-radius: var(--radius-sm);
    color: #fff;
    cursor: pointer;
    transition: background 0.15s;
  }

  .session-send-btn:hover {
    background: var(--accent-hover);
  }

  /* Agent/model tray */
  .session-tray {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0 0;
  }

  .session-tray-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--dark-text-weak);
    height: 28px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    background: var(--dark-bg);
    border: 1px solid var(--dark-border);
    cursor: default;
    white-space: nowrap;
  }

  .session-tray-pill svg {
    opacity: 0.5;
  }

  .session-tray-agent { font-weight: 500; }
  .session-tray-model { font-weight: 400; }

  .session-tray-divider {
    width: 1px;
    height: 16px;
    background: var(--dark-border);
  }

  .session-tray-mode {
    display: inline-flex;
    align-items: center;
    height: 28px;
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .session-mode-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 26px;
    color: var(--dark-text-weak);
    cursor: pointer;
  }

  .session-mode-btn.active-mode {
    background: var(--dark-bg);
    color: var(--dark-text-strong);
  }

  /* ===== Feature Grid ===== */
  /* ===== Power User Features (soloterm-style) ===== */
  .poweruser-section {
    padding: 100px 0;
    border-top: 1px solid var(--border);
  }

  .poweruser-header {
    text-align: center;
    margin-bottom: 72px;
  }

  .poweruser-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    padding: 6px 16px;
    border: 1px solid var(--border);
    border-radius: 100px;
    margin-bottom: 24px;
  }

  .poweruser-header h2 {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .poweruser-header p {
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto;
  }

  .poweruser-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 56px 80px;
    max-width: 900px;
    margin: 0 auto;
  }

  .poweruser-card {
    display: flex;
    flex-direction: column;
  }

  .poweruser-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    flex-shrink: 0;
  }

  .poweruser-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .poweruser-card p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-header h2 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .section-header p {
    font-size: 16px;
    color: var(--text-secondary);
  }

  /* ===== Agents ===== */
  /* ===== Feature Showcase (full-width screenshot sections) ===== */
  .feature-showcase {
    padding: 80px 0;
  }

  .feature-showcase.alt {
    background: var(--bg-subtle);
  }

  .showcase-header {
    max-width: 680px;
    margin-bottom: 48px;
  }

  .showcase-header .feature-num {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-text);
    margin-bottom: 12px;
  }

  .showcase-header .feature-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .showcase-header .feature-lead {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .showcase-screenshot {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  .showcase-screenshot img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ===== Comparison ===== */
  .compare-section {
    padding: 80px 0;
    background: var(--bg-subtle);
  }

  .compare-table-wrap {
    overflow-x: auto;
  }

  .compare-table {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    border-collapse: collapse;
    font-size: 14px;
  }

  .compare-table th,
  .compare-table td {
    padding: 14px 20px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .compare-table th {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .compare-table td {
    color: var(--text-secondary);
  }

  .highlight-col {
    background: var(--accent-light);
  }

  .check-mark {
    color: var(--success);
    font-weight: 700;
    font-size: 16px;
  }

  .dash-mark {
    color: var(--text-muted);
  }

  /* ===== Pricing ===== */
  .pricing-section {
    padding: 100px 0;
    background: var(--dark-bg);
    color: var(--dark-text);
  }

  .pricing-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .pricing-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .pricing-title {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--dark-text-strong);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--dark-bg-raised);
  }

  .pricing-card {
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--dark-border);
  }

  .pricing-card:last-child {
    border-right: none;
  }

  .pricing-card.highlighted {
    background: linear-gradient(180deg, var(--accent-light) 0%, transparent 60%);
  }

