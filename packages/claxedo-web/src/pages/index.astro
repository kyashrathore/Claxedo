</style>

<script>
  // ===== Feature 01: Card Switcher =====
  const cardsContainer = document.getElementById('feature01-cards');
  const displayContainer = document.getElementById('feature01-display');

  if (cardsContainer && displayContainer) {
    const cards = cardsContainer.querySelectorAll('.feature01-card');
    const imgs = displayContainer.querySelectorAll('.feature01-img');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const idx = card.getAttribute('data-index');
        cards.forEach((c) => c.classList.remove('active'));
        imgs.forEach((img) => img.classList.remove('active'));
        card.classList.add('active');
        const targetImg = displayContainer.querySelector(`.feature01-img[data-index="${idx}"]`);
        if (targetImg) targetImg.classList.add('active');
      });
    });
  }

  // ===== Feature 02: App Tab Switcher + Status Transition =====
  const tabBar = document.getElementById('agent-demo-tabs');
  const contentArea = document.getElementById('agent-demo-content');

  if (tabBar && contentArea) {
    const tabs = tabBar.querySelectorAll('.ws-tab.agent-tab');
    const panels = contentArea.querySelectorAll('.ws-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = tab.getAttribute('data-index');
        tabs.forEach((t) => t.classList.remove('active'));
        panels.forEach((p) => p.classList.remove('active'));
        tab.classList.add('active');
        const targetPanel = contentArea.querySelector(`.ws-panel[data-index="${idx}"]`);
        if (targetPanel) targetPanel.classList.add('active');
      });
    });

    // Agent #4 status transition on scroll into view
    let agent4Transitioned = false;
    const section = document.getElementById('feature02-section');

    if (section) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !agent4Transitioned) {
              agent4Transitioned = true;

              setTimeout(() => {
                // Update all status dots for agent index 3 (Claude #4)
                const dots = document.querySelectorAll<HTMLElement>('[data-agent-index="3"]');
                dots.forEach((dot) => {
                  dot.classList.remove('loading');
                  dot.classList.add('done');
                  dot.style.animation = 'statusFlash 0.6s ease';
                  dot.addEventListener('animationend', () => {
                    dot.style.animation = '';
                  }, { once: true });
                });

                // Update panel content
                const panel4 = panels[3];
                if (panel4) {
                  const badge = panel4.querySelector('.ws-status-badge');
                  if (badge) {
                    badge.classList.remove('loading');
                    badge.classList.add('done');
                    badge.textContent = 'Completed';
                  }
                  const detail = panel4.querySelector('.ws-status-detail');
                  if (detail) {
                    detail.textContent = 'Test suite updated — all passing';
                  }
                  const codeEl = panel4.querySelector('code');
                  if (codeEl) {
                    codeEl.textContent = 'All 47 tests passing. Auth middleware integration tests added. Coverage: 94%.';
                  }
                }

                // Play notification sound
                try {
                  const audio = new Audio('/ios.mp3');
                  audio.volume = 0.5;
                  audio.play().catch(() => {});
                } catch (_) {}
              }, 1200);
            }
          });
        },
        { threshold: 0.5 }
      );
      observer.observe(section);
    }
  }

  // ===== Hero Scroll Animation =====
  const heroFrame = document.getElementById('hero-frame');
  const heroPerspective = document.getElementById('hero-perspective');
  const previewSection = document.querySelector<HTMLElement>('.preview');
  const body = document.body;

  if (heroFrame && heroPerspective && previewSection) {
    const handleScroll = () => {
      const rect = previewSection.getBoundingClientRect();
      const windowH = window.innerHeight;

      const scrollable = Math.max(previewSection.offsetHeight - windowH, 1);
      const scrolled = Math.min(Math.max(-rect.top, 0), scrollable);
      const progress = scrolled / scrollable;

      const introRaw = Math.min(progress / 0.4, 1);
      const intro = introRaw < 0.5
        ? 2 * introRaw * introRaw
        : 1 - Math.pow(-2 * introRaw + 2, 2) / 2;

      const fullRaw = Math.min(Math.max((progress - 0.25) / 0.65, 0), 1);
      const full = fullRaw < 0.5
        ? 2 * fullRaw * fullRaw
        : 1 - Math.pow(-2 * fullRaw + 2, 2) / 2;

      const translateY = 40 * (1 - intro) * (1 - full);
      const scale = 0.95 + 0.05 * intro;
      const rotateX = 2 * (1 - intro) * (1 - full);
      const opacity = 0.7 + 0.3 * intro;

      heroFrame.style.setProperty('--preview-full', String(full));
      heroFrame.style.transform = `translateY(${translateY}px) scale(${scale}) rotateX(${rotateX}deg)`;
      heroFrame.style.opacity = String(opacity);
      heroFrame.classList.toggle('is-fullscreen', full > 0.92);

      const inScene = rect.top < windowH && rect.bottom > 0;
      body.classList.toggle('preview-nav-hidden', inScene && full > 0.45);
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Initial state
  }
</script>
