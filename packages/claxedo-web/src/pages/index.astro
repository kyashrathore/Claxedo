---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import DownloadMenu from "../components/DownloadMenu.astro"

const harnesses = ["Claude Code", "Codex", "Gemini CLI", "local · cloud · hybrid", "MIT"]
---

<Layout title="Claxedo — Every coding agent, in one fast app">
  <div class="page-frame">
    <Nav active="home" />

    <section class="home-hero">
      <div class="home-hero-inner">
        <span class="hero-kicker" data-reveal="1"><span class="dot"></span> Open source · Harness-agnostic</span>
        <h1 class="home-title" data-reveal="2">Every coding agent.<br />One fast app.</h1>
        <p class="home-sub" data-reveal="3">
          Claxedo runs Claude Code, Codex, and Gemini CLI side by side — local, cloud, or
          hybrid. No lock-in, no toll on the agents you already pay for. Built on an open
          framework you can build on too.
        </p>

        <div class="hero-actions" data-reveal="4">
          <DownloadMenu />
          <a class="btn-secondary" href="/app">Tour the app →</a>
        </div>

        <div class="home-chips" data-reveal="5">
          {harnesses.map((h) => <span class="chip"><span class="dot"></span>{h}</span>)}
        </div>

        <p class="home-fw" data-reveal="6">
          Building on Claxedo? <a href="/framework">Explore the open framework →</a>
        </p>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<style>
  .home-hero {
    min-height: calc(100svh - 9rem);
    display: flex;
    align-items: center;
    padding: var(--padding);
  }

  .home-hero-inner { max-width: 60rem; }

  .home-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    line-height: 0.98;
    font-weight: 650;
    letter-spacing: -0.045em;
    color: var(--text-strong);
    text-wrap: balance;
    margin: 1.25rem 0;
  }

  .home-sub {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--text);
    max-width: 46rem;
    text-wrap: pretty;
    margin-bottom: 1.75rem;
  }

  .home-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 1.75rem;
  }

  .home-fw {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-weak);
  }

  .home-fw a {
    color: var(--text-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 40rem) {
    .home-title { font-size: clamp(2.2rem, 13vw, 3.4rem); }
    .home-hero { min-height: calc(100svh - 7rem); }
  }
</style>
