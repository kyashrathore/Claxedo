---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import { downloads, github, version } from "../config"

type Download = (typeof downloads)[number]
const byPlatform = (prefix: string, exclude?: string) => downloads.filter((d) => d.platform.startsWith(prefix) && (!exclude || !d.platform.includes(exclude)))
const mac = byPlatform("macos-")
const windows = byPlatform("windows-")
const linux = [
  { arch: "x86_64", builds: byPlatform("linux-", "arm64") },
  { arch: "ARM64", builds: byPlatform("linux-arm64-") },
]
const track = (d: Download) => ({ "data-analytics-event": "download_app", "data-analytics-placement": "download-page", "data-analytics-platform": d.platform, "data-analytics-version": version })
const formatName = (d: Download) => d.format.replace(/^\./, "")
---

<Layout title="Download Claxedo Desktop" description="Download Claxedo Desktop for macOS, Windows, or Linux. Start locally without an account.">
  <div class="shell">
    <Nav active="download" />
    <main id="main-content">
      <section class="download-hero rule-grid">
        <div><p class="eyebrow">Claxedo Desktop · v{version}</p><h1 class="display">Start entirely local.</h1><p class="section-copy">Claxedo Desktop works locally without an account or subscription. Sign in when you want the connected Claxedo experience across browser, desktop, and remote workspaces.</p></div>
        <div class="local-card"><span>LOCAL MODE</span><strong>No account required</strong><p>Your work stays on the machine and uses the model and compute you configure.</p></div>
      </section>
      <section class="section" id="releases">
        <div class="section-inner"><p class="eyebrow">Choose a build</p><h2 class="section-title">Desktop releases</h2><div class="release-grid">
            <article class="release">
              <header><h3>macOS</h3><small>.dmg · v{version}</small></header>
              <div class="release-actions">{mac.map((d, i) => <a class={i === 0 ? "btn-primary" : "btn-secondary"} href={d.href} {...track(d)}>{d.label.replace("macOS ", "").replace(/[()]/g, "")}</a>)}</div>
            </article>
            <article class="release">
              <header><h3>Windows</h3><small>.exe · v{version}</small></header>
              <div class="release-actions">{windows.map((d) => <a class="btn-primary" href={d.href} {...track(d)}>Download for Windows</a>)}</div>
            </article>
            <article class="release">
              <header><h3>Linux</h3><small>AppImage · deb · rpm · v{version}</small></header>
              <div class="arch">{linux.map((row) => <div class="arch-row"><span>{row.arch}</span><div class="chips">{row.builds.map((d) => <a href={d.href} {...track(d)}>{formatName(d)}</a>)}</div></div>)}</div>
            </article>
          </div><p class="provenance">Artifacts are served from the <a href={`${github}/releases/tag/claxedo-v${version}`}>Claxedo GitHub release</a>. Code signing and checksums are shown only when the release publishes them.</p></div>
      </section>
      <section class="section dark-band"><div class="section-inner mode-steps"><div><span>01</span><h2>Start local</h2><p>Open a workspace and run sessions or terminals without a Claxedo account.</p></div><div><span>02</span><h2>Connect when useful</h2><p>Sign in to reach connected product capabilities across supported clients and machines.</p></div><div><span>03</span><h2>Keep your providers</h2><p>Bring model credentials, compute, and sandboxes. Claxedo does not include usage credits.</p></div></div></section>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  /* Content box must land on the same 72rem line as .section > .section-inner:
     those pad outside the 72rem box, this section pads inside it. */
  .download-hero { display: grid; grid-template-columns: 1.3fr .7fr; gap: 4rem; align-items: end; max-width: calc(72rem + 2 * var(--gutter)); margin-inline: auto; padding: var(--section) var(--gutter); }
  .download-hero > div:first-child { max-width: 56rem; }
  .local-card { padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); }
  .local-card span { display: inline-flex; align-items: center; gap: .45rem; color: var(--ink-faint); font: .66rem var(--font-mono); letter-spacing: .06em; }
  .local-card span::before { content: ""; width: .38rem; height: .38rem; border-radius: 50%; background: var(--success); }
  .local-card strong { display: block; margin: 2.5rem 0 .7rem; font: 500 1.4rem/1.2 var(--font-sans); letter-spacing: -.025em; }
  .local-card p { margin: 0; color: var(--ink-soft); font-size: .9rem; }
  .release-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2.5rem; }
  .release { display: flex; flex-direction: column; gap: 1.4rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); }
  .release header { display: flex; flex-direction: column; gap: .35rem; }
  .release h3 { margin: 0; font: var(--display-weight) 1.3rem/1.2 var(--font-display); letter-spacing: var(--display-tracking); }
  .release small { color: var(--ink-faint); font: .72rem var(--font-mono); }
  .release-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: auto; }
  .release-actions .btn-primary, .release-actions .btn-secondary { min-height: 2.5rem; padding: .6rem 1rem; }
  .arch { display: grid; gap: .75rem; margin-top: auto; }
  .arch-row { display: grid; grid-template-columns: 4.5rem 1fr; align-items: center; gap: .75rem; }
  .arch-row span { color: var(--ink-faint); font: 500 .7rem var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chips a { padding: .45rem .8rem; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--ink); font: 500 .8rem/1 var(--font-sans); text-decoration: none; transition: background .15s ease, border-color .15s ease; }
  .chips a:hover { background: var(--surface-raised); border-color: var(--ink-faint); }
  .provenance { max-width: 45rem; margin: 1.4rem 0 0; color: var(--ink-faint); font-size: .84rem; }
  .provenance a { color: var(--accent-text); }
  .mode-steps { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
  .mode-steps > div { min-height: 15rem; display: flex; flex-direction: column; padding: 1.4rem; background: var(--surface); }
  .mode-steps > div + div { border-left: 1px solid var(--line); }
  .mode-steps span { color: var(--ink-weakest); font: .68rem var(--font-mono); }
  .mode-steps h2 { margin-top: auto; font: 500 1.35rem/1.2 var(--font-sans); letter-spacing: -.025em; }
  .mode-steps p { font-size: .9rem; }
  @media (max-width: 48rem) { .download-hero, .mode-steps { grid-template-columns: 1fr; } .mode-steps > div + div { border-left: 0; border-top: 1px solid var(--line); } .release-grid { grid-template-columns: 1fr; } }
</style>
