---
import { shellUrl } from '../utils/shell-url';

const appUrl = await shellUrl(import.meta.env.DEV);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Try Claxedo — Browser Preview</title>
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #0c0c0c;
        color: #e0e0e0;
        height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 16px;
        background: #161616;
        border-bottom: 1px solid #2a2a2a;
        font-size: 0.85rem;
        flex-shrink: 0;
      }
      .topbar a {
        color: #888;
        text-decoration: none;
      }
      .topbar a:hover { color: #ccc; }
      .topbar .title {
        color: #b6b768;
        font-weight: 600;
      }
      .topbar .sep { color: #444; }
      .topbar .status {
        margin-left: auto;
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 500;
        background: #2f2a0a;
        color: #facc15;
      }

      .note {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 16px;
        border-bottom: 1px solid #2a2a2a;
        background: #131313;
        color: #b8b8b8;
        font-size: 0.82rem;
        line-height: 1.5;
      }

      .note strong {
        color: #f1f1f1;
      }

      #app-frame {
        flex: 1;
        width: 100%;
        border: none;
        background: #0c0c0c;
      }
    </style>
  </head>
  <body>
    <div class="topbar">
      <a href="/">Claxedo</a>
      <span class="sep">/</span>
      <span class="title">Browser Preview</span>
      <span class="status">Preview</span>
    </div>

    <div class="note">
      <strong>Preview only.</strong>
      <span>This browser experience uses demo data and mocked backend services. Real projects and agents run in the desktop app.</span>
    </div>

    <iframe id="app-frame" name="claxedo-demo" src={`${appUrl}?demo=1&embed=1`}></iframe>
  </body>
</html>
