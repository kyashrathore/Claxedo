---
import { Code } from "astro:components"
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import { docs, github } from "../config"

const THEME = "vesper"
const cookbook = `${github}/tree/dev/claxedo-cookbook`

const sections = [
  {
    num: "01",
    h: "Run any coding agent",
    p: "One runtime, many harnesses. The vendor is a value, not an architecture decision — Claude, Codex, Cursor, OpenCode, and Pi ship as factories, and a session picks one at creation. They run as themselves.",
    mods: ["agent-sdk-runtime"],
    file: "runtime.ts",
    code: `import { createAgentRuntime } from "@claxedo/agent-sdk-runtime"
import { createMemoryRuntimeStore } from "@claxedo/agent-sdk-runtime/stores/memory"
import { claude, codex, cursor } from "@claxedo/agent-sdk-runtime/harnesses"

const runtime = createAgentRuntime({
  store: createMemoryRuntimeStore(),
  harnesses: [claude({ access: "acp" }), codex(), cursor()],
})

// The vendor is data, not architecture.
const session = await runtime.sessions.create({
  directory: "/tmp/scratch",
  harness: { id: "claude", access: "acp" },
  model: { providerID: "claude", modelID: "default" },
})

await runtime.turns.start({ sessionId: session.id, agent: "", text: "Fix the failing test" })
// stream the loop: runtime.events.subscribe({ sessionId: session.id })`,
  },
  {
    num: "02",
    h: "Swap the harness mid-session",
    p: "Sessions aren't married to their vendor. One call updates a live session's harness or model — same session, same history. Claude plans, Codex continues.",
    mods: ["agent-sdk-runtime"],
    file: "switch.ts",
    code: `// Same session, same history — swap the harness AND the model between turns.
await runtime.config.update(session.id, {
  harness: { id: "codex", access: "acp" },
  model: { providerID: "codex", modelID: "default" },
})

await runtime.turns.start({
  sessionId: session.id,
  agent: "",
  text: "Pick up where Claude left off.",
})`,
  },
  {
    num: "03",
    h: "Sync extensions to every harness",
    p: "The layer nobody else ships: declare a skill and an MCP server once, and it's materialized into each harness's own native config — the exact files each tool reads. The same call runs on your laptop or a fresh cloud VM.",
    mods: ["agent-extensions"],
    file: "extensions.ts",
    code: `import { createAgentExtensions, type HarnessTarget } from "@claxedo/agent-extensions"

const targets: HarnessTarget[] = ["opencode", "claude", "codex", "cursor"]
const extensions = createAgentExtensions({ projectDir })

// One package — a SKILL.md and an MCP server — installed once...
await extensions.installCached({ packagePath: "extensions/team-kit", id: "team-kit", targets })

// ...materialized into every harness's NATIVE config:
//   .mcp.json (claude)         .codex/config.toml
//   .opencode/opencode.jsonc   .cursor/mcp.json`,
  },
  {
    num: "04",
    h: "Speak every harness",
    p: "agent-event-runtime folds each harness's raw wire frames onto one contract (AgentRuntimeEvent). To support a new harness — or your own agent loop — you write one HarnessEventAdapter; every client stays unchanged.",
    mods: ["agent-event-runtime"],
    file: "events.ts",
    code: `import { createAgentEventRuntime } from "@claxedo/agent-event-runtime"
import { claudeSdkAdapter } from "@claxedo/agent-event-runtime/harnesses/claude"
import { codexAppServerAdapter } from "@claxedo/agent-event-runtime/harnesses/codex"

const claude = createAgentEventRuntime({ harness: "claude-sdk", threadId, adapter: claudeSdkAdapter() })
const codex = createAgentEventRuntime({ harness: "codex-app-server", threadId, adapter: codexAppServerAdapter() })

// Two vendors' raw wire frames in -> identical canonical envelopes out.
const a = claude.ingest({ source: "claude.sdk.message", payload: claudeFrame }).events
const b = codex.ingest({ source: "codex.app-server", method: "item/agentMessage/delta", payload: codexFrame }).events

// Even garbage becomes a 'diagnostic' event — never a throw.`,
  },
  {
    num: "05",
    h: "Place the brain and the hands",
    p: "host (where the loop reasons) and toolSandbox (where the tools run) are separate. All local, all cloud, or split — brain hosted, hands next to the code. toolSandbox is late-bound and swappable; no host flip.",
    mods: ["agent-sdk-runtime"],
    file: "placement.ts",
    code: `import type { SessionEnvFactoryInput } from "@claxedo/agent-sdk-runtime"

const local: SessionEnvFactoryInput = { sessionId, mode: "local", host: "workspace" }
const cloud: SessionEnvFactoryInput = { sessionId, mode: "cloud", host: "central" }

// Split — the loop stays central, the hands move:
const split: SessionEnvFactoryInput = {
  sessionId,
  mode: "hybrid",
  host: "central",                                    // brain: fixed at creation
  toolSandbox: { kind: "workspace-runtime", workspaceId: "box-1" }, // hands: swappable
}`,
  },
  {
    num: "06",
    h: "One option flips placement",
    p: "The same workspace host serves loopback on your laptop or sits behind an authenticated relay on a VM — the difference is one exposure option. Files, search, git, diffs, managed processes, PTY, and SSE, all at /api/wr/*.",
    mods: ["workspace-runtime"],
    file: "serve.ts",
    code: `import {
  createWorkspaceRuntimeApp,
  loopbackWorkspaceRuntimeExposure,
  relayWorkspaceRuntimeExposure,
} from "@claxedo/workspace-runtime"

// Local: loopback, no relay, no token.
const local = createWorkspaceRuntimeApp({
  target: { workspaceId, directory },
  exposure: loopbackWorkspaceRuntimeExposure(),
})

// Cloud VM or a teammate's laptop: same app — ONE option changes.
const cloud = createWorkspaceRuntimeApp({
  target: { workspaceId, directory },
  exposure: relayWorkspaceRuntimeExposure({ key: hostKeys.publicKey, workspaceId, hostId }),
})
// serve local.app.fetch — bypassing the relay on the cloud host gets a 401.`,
  },
  {
    num: "07",
    h: "Mint access, reach anywhere",
    p: "Authenticate the human once — the verifier is swappable, Clerk by default — then mint a short-lived token scoped to ONE workspace and role. The relay verifies it and forwards: to a cloud VM, or down a reverse tunnel a laptop opened outbound.",
    mods: ["workspace-relay-protocol", "workspace-relay"],
    file: "connection.ts",
    code: `import { createClerkTokenVerifier } from "@claxedo/workspace-relay-protocol"
import { mintRuntimeAccessToken } from "@claxedo/workspace-relay"

const verifier = createClerkTokenVerifier({ issuer, jwksUrl }) // swappable — Clerk by default
const { subject, claims } = await verifier.verify(bearerToken)

const runtimeAccessToken = await mintRuntimeAccessToken(
  { subject, orgId: claims.org_id, workspaceId, hostId, role: "editor" },
  relayPrivateKey, "EdDSA",
)

// This ONE token reaches a cloud VM — or a laptop that dialed out.
// No inbound ports. No access to any other workspace.`,
  },
]

const hosting = [
  { h: "Employees-only auth", p: "Convex-gated access; only your org gets in. Verifier is swappable, Clerk by default." },
  { h: "Role-scoped tokens", p: "Each request carries a short-lived token scoped to one workspace + role — revocable by jti." },
  { h: "Reach any host", p: "One token reaches a cloud VM or a teammate's laptop, over a reverse tunnel — no inbound ports." },
  { h: "Org-level extensions", p: "Push skills, plugins, and MCP to the whole org; org policy wins over local." },
  { h: "Extend the platform", p: "Add a GitHub app, a Slack bot, or your own custom agents on top." },
  { h: "Event translation", p: "Normalize any harness onto one contract; plug in your own agent loop." },
]

const modules = [
  { name: "@claxedo/agent-sdk-runtime", p: "The agent loop + harness adapters (ACP, Native, OpenCode, Pi)." },
  { name: "@claxedo/agent-event-runtime", p: "Event translation — every harness onto one contract." },
  { name: "@claxedo/workspace-runtime", p: "Processes, PTY, VCS, LSP, sessions — the outer loop." },
  { name: "@claxedo/agent-extensions", p: "Sync skills, plugins, and MCP to every harness." },
  { name: "@claxedo/workspace-relay", p: "The secure tunnel to a cloud VM or a teammate's laptop." },
  { name: "@claxedo/workspace-relay-protocol", p: "Token verification and access claims." },
  { name: "@claxedo/mcp", p: "Drive the runtime over MCP — manage it by talking to it." },
  { name: "@claxedo/workgraph", p: "Decompose goals into task graphs of parallel agents." },
]

const targets = ["Your laptop", "Node.js / Bun", "Docker", "Cloud VM", "A teammate's laptop", "Any sandbox provider"]

const contrast = [
  { who: "Superset / Superconductor / Supacode", what: "Source-available (ELv2 / FSL) — restrictions on what you can ship." },
  { who: "Paseo", what: "AGPL — copyleft reaches into what you build." },
  { who: "OpenCode", what: "Genuinely open, but a monolithic app — adopt it whole." },
  { who: "Claxedo", what: "MIT, and composable modules — take one piece, ship a product, no strings.", us: true },
]

const faq = [
  { q: "Is this real code or marketing pseudocode?", a: "Real. Every import and call on this page is drawn from claxedo-cookbook — a set of runnable recipes in the repo — and checked against the published packages. The architecture diagram is traced from the source." },
  { q: "How do I add a harness Claxedo doesn't ship?", a: "Write a HarnessEventAdapter in agent-event-runtime: it folds the harness's raw frames onto the shared AgentRuntimeEvent contract. The projection and every client stay unchanged." },
  { q: "Does local traffic go through the relay?", a: "No. Local sessions talk to the workspace-runtime directly over loopback — no relay, no token. The relay exists only for hosted (cloud VM or user-hosted) sessions." },
  { q: "How is this different from LangChain or the OpenAI Agents SDK?", a: "Those give you the loop. Claxedo gives you the outer loop and hosting — processes/VCS/LSP/sessions, event translation, the relay, scoped access — the parts those SDKs don't touch." },
  { q: "What's the license?", a: "MIT — all of it." },
]
---

<Layout title="Claxedo Framework — The agent stack, as packages">
  <div class="page-frame">
    <Nav active="framework" />

    <section class="hero">
      <div class="hero-copy">
        <span class="hero-kicker" data-reveal="1"><span class="dot"></span> The framework · MIT</span>
        <h1 class="hero-title" data-reveal="2">The agent stack,<br />as packages.</h1>
        <p class="hero-sub" data-reveal="3">
          Not another agent SDK — the published MIT packages the Claxedo app is assembled
          from. Any harness, any model, run local or hosted. Compose the primitives, deploy
          them, and the stack is yours. The SDKs' job ends where Claxedo's begins.
        </p>
        <div class="hero-actions" data-reveal="4">
          <a class="btn-primary" href={docs}>Read the docs</a>
          <a class="btn-secondary" href={github}>Browse the modules</a>
        </div>
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// the architecture</span>
        <h2 class="section-title">Traced from the source — drag to pan, scroll to zoom.</h2>
        <p class="section-lead">
          Two transports, chosen per session. <strong>Local</strong> talks to the runtime
          directly — no relay. <strong>Hosted</strong> resolves a token from the control
          plane once, then the client talks to the relay directly. Events stream back
          through the translation layer.
        </p>
      </div>

      <div class="canvas" id="arch-canvas">
        <div class="canvas-toolbar">
          <button class="canvas-btn" data-act="in" aria-label="Zoom in">+</button>
          <button class="canvas-btn" data-act="out" aria-label="Zoom out">&#8722;</button>
          <button class="canvas-btn" data-act="reset" aria-label="Reset view">&#10227;</button>
          <button class="canvas-btn" data-act="fs" aria-label="Fullscreen">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M16 21h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
          </button>
        </div>
        <div class="canvas-hint">drag to pan · scroll to zoom</div>

        <svg class="canvas-svg" viewBox="0 0 1440 660" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Grounded Claxedo architecture diagram.">
          <defs>
            <marker id="ah" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrowhead" d="M0,0 L10,5 L0,10 z"></path></marker>
            <marker id="ahr" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrowhead-ret" d="M0,0 L10,5 L0,10 z"></path></marker>
          </defs>

          <g class="diagram-svg diagram-svg-inner" id="viewport">
            <!-- host group -->
            <rect class="grp" x="620" y="64" width="790" height="540"></rect>
            <text class="grp-lbl" x="638" y="88">HOST — your machine · cloud VM · or a teammate's laptop</text>

            <!-- nodes -->
            <g><rect class="box" x="40" y="292" width="190" height="96"></rect><text class="ttl" x="56" y="334">Claxedo app</text><text class="role" x="56" y="354">your client</text></g>
            <g><rect class="box" x="330" y="108" width="220" height="84"></rect><text class="ttl" x="346" y="142">Control plane</text><text class="role" x="346" y="162">resolve · auth · mint RAT</text></g>
            <g><rect class="box" x="330" y="300" width="220" height="84"></rect><text class="ttl" x="346" y="334">workspace-relay</text><text class="role" x="346" y="354">hosted only · verify RAT</text></g>

            <g><rect class="box" x="650" y="120" width="210" height="84"></rect><text class="ttl" x="666" y="154">workspace-runtime</text><text class="role" x="666" y="174">HTTP/WS · sessions</text></g>
            <g><rect class="box-key" x="900" y="120" width="200" height="84"></rect><text class="ttl" x="916" y="154">agent loop</text><text class="role" x="916" y="174">turn driver · AgentAdapter</text></g>
            <g><rect class="box" x="1150" y="120" width="240" height="84"></rect><text class="ttl" x="1166" y="154">runner adapters</text><text class="role" x="1166" y="174">ACP · Native · OpenCode · Pi</text></g>
            <g><rect class="box" x="650" y="252" width="210" height="84"></rect><text class="ttl" x="666" y="286">agent-extensions</text><text class="role" x="666" y="306">skills · plugins · MCP</text></g>
            <g><rect class="box" x="1150" y="252" width="240" height="84"></rect><text class="ttl" x="1166" y="286">model / provider</text><text class="role" x="1166" y="306">query() or spawn</text></g>
            <g><rect class="box-key" x="650" y="470" width="740" height="96"></rect><text class="ttl" x="666" y="508">agent-event-runtime — event translation</text><text class="role" x="666" y="530">vendor frames → AgentRuntimeEvent → OpenCode-compat</text></g>

            <!-- forward edges -->
            <line class="wire-dashed" x1="230" y1="316" x2="330" y2="156" marker-end="url(#ah)"></line>
            <g><rect class="clbl-bg" x="236" y="206" width="120" height="15"></rect><text class="clbl" x="296" y="217" text-anchor="middle">① resolve relayUrl + RAT</text></g>

            <line class="wire-accent" x1="230" y1="346" x2="330" y2="332" marker-end="url(#ah)"></line>
            <g><rect class="clbl-bg" x="234" y="356" width="118" height="15"></rect><text class="clbl" x="293" y="367" text-anchor="middle">② data · Bearer RAT (direct)</text></g>

            <line class="wire-dotted" x1="230" y1="334" x2="648" y2="168" marker-end="url(#ah)"></line>
            <g><rect class="clbl-bg" x="372" y="232" width="146" height="15"></rect><text class="clbl" x="445" y="243" text-anchor="middle">local · loopback (no relay)</text></g>

            <line class="wire-dashed" x1="440" y1="300" x2="440" y2="194" marker-end="url(#ah)"></line>
            <g><rect class="clbl-bg" x="452" y="240" width="58" height="15"></rect><text class="clbl" x="481" y="251" text-anchor="middle">verify RAT</text></g>

            <line class="wire-accent" x1="550" y1="330" x2="648" y2="178" marker-end="url(#ah)"></line>
            <g><rect class="clbl-bg" x="556" y="248" width="120" height="15"></rect><text class="clbl" x="616" y="259" text-anchor="middle">forward · VM / laptop</text></g>

            <line class="wire" x1="860" y1="162" x2="898" y2="162" marker-end="url(#ah)"></line>
            <g><rect class="clbl-bg" x="858" y="120" width="44" height="15"></rect><text class="clbl" x="880" y="131" text-anchor="middle">runs</text></g>

            <line class="wire" x1="1100" y1="162" x2="1148" y2="162" marker-end="url(#ah)"></line>
            <g><rect class="clbl-bg" x="1098" y="120" width="68" height="15"></rect><text class="clbl" x="1132" y="131" text-anchor="middle">sendMessage</text></g>

            <line class="wire" x1="1270" y1="204" x2="1270" y2="250" marker-end="url(#ah)"></line>
            <g><rect class="clbl-bg" x="1286" y="220" width="86" height="15"></rect><text class="clbl" x="1329" y="231" text-anchor="middle">query · spawn</text></g>

            <line class="wire" x1="810" y1="252" x2="950" y2="206" marker-end="url(#ah)"></line>
            <g><rect class="clbl-bg" x="846" y="224" width="74" height="15"></rect><text class="clbl" x="883" y="235" text-anchor="middle">feed the loop</text></g>

            <!-- return edges -->
            <polyline class="wire-ret" points="1390,200 1404,200 1404,500 1392,500" marker-end="url(#ahr)"></polyline>
            <g><rect class="clbl-bg" x="1330" y="214" width="86" height="15"></rect><text class="clbl" x="1373" y="225" text-anchor="middle">vendor frames →</text></g>

            <polyline class="wire-ret" points="648,518 300,518 135,518 135,390" marker-end="url(#ahr)"></polyline>
            <g><rect class="clbl-bg" x="300" y="510" width="330" height="15"></rect><text class="clbl" x="465" y="521" text-anchor="middle">AgentRuntimeEvent → OpenCode-compat → client (SSE)</text></g>

            <!-- central footnote -->
            <text class="clbl" x="40" y="600">host: central → the loop runs on the control plane (PiAdapter) — no workspace backing.</text>
          </g>
        </svg>
      </div>

      <div class="canvas-legend">
        <span class="lg"><svg viewBox="0 0 28 8"><line x1="1" y1="4" x2="27" y2="4" class="wire-accent"></line></svg> hosted data path</span>
        <span class="lg"><svg viewBox="0 0 28 8"><line x1="1" y1="4" x2="27" y2="4" class="wire-dotted"></line></svg> local (loopback)</span>
        <span class="lg"><svg viewBox="0 0 28 8"><line x1="1" y1="4" x2="27" y2="4" class="wire-dashed"></line></svg> resolve / verify</span>
        <span class="lg"><svg viewBox="0 0 28 8"><line x1="1" y1="4" x2="27" y2="4" class="wire-ret"></line></svg> events back (translated)</span>
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// The thesis</span>
        <h2 class="section-title">A coding agent is a brain and hands. You decide where each runs.</h2>
        <p class="section-lead">
          Most tools fuse the reasoning loop and its tools into one place and choose that
          place for you. Claxedo keeps them separable — the loop, the workspace, event
          translation, and the relay are pieces you compose, place, and swap. Plenty of
          tools can run in the cloud; few hand you the dial.
        </p>
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// In code</span>
        <h2 class="section-title">Every capability, in real code.</h2>
        <p class="section-lead">
          Each snippet maps to the actual modules — most are straight from <a href={cookbook} style="color:var(--text-strong);text-decoration:underline;text-underline-offset:3px">claxedo-cookbook</a>, a runnable Claxedo chat server.
        </p>
      </div>
      {sections.map((s) => (
        <div class="code-section">
          <div class="code-section-head">
            <span class="num">{s.num}</span>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
            <div class="mods">
              {s.mods.map((m) => <span class="mod">{m}</span>)}
            </div>
          </div>
          <div class="code-card">
            <div class="code-tab">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="file">{s.file}</span>
              <span class="lang">ts</span>
            </div>
            <Code code={s.code} lang="ts" theme={THEME} />
          </div>
        </div>
      ))}
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// Your own agent stack</span>
        <h2 class="section-title">Compose the primitives. Deploy them. That's your agent stack.</h2>
        <p class="section-lead">
          The same modules, composed and deployed on infrastructure you own — so your whole
          team gets one secure, extensible agent platform instead of a pile of CLIs.
        </p>
      </div>
      <div class="cards">
        {hosting.map((c) => (
          <article class="card">
            <div class="card-head"><h3>{c.h}</h3></div>
            <p>{c.p}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// The modules</span>
        <h2 class="section-title">MIT — take a module, not the whole app.</h2>
        <p class="section-lead">
          Not ELv2, not FSL, not AGPL, not "Apache in two years." Genuinely modular: the
          loop, the workspace, and the cloud are separate, swappable packages.
        </p>
      </div>
      <div class="cards cards--two">
        {modules.map((m) => (
          <article class="card">
            <div class="card-head"><h3 style="text-transform:none;font-family:var(--font-mono);font-size:0.86rem">{m.name}</h3></div>
            <p>{m.p}</p>
          </article>
        ))}
      </div>
      <div class="contrast">
        {contrast.map((row) => (
          <div class={`contrast-row${row.us ? " is-us" : ""}`}>
            <span class="who">{row.who}</span>
            <span class="what">{row.what}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// Run anywhere</span>
        <h2 class="section-title">From your laptop to any cloud.</h2>
        <p class="section-lead">Placement is a value, not a rewrite. The same runtime targets any of these.</p>
      </div>
      <div class="chips">
        {targets.map((t) => <span class="chip"><span class="dot"></span>{t}</span>)}
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// Proof</span>
        <h2 class="section-title">Don't take our word for it.</h2>
        <p class="section-lead">
          The Claxedo app — every harness, fast, skills synced everywhere — is built
          entirely on these modules. So is the cookbook. The framework isn't a side
          project; it's the thing the product stands on.
        </p>
      </div>
      <div class="hero-actions">
        <a class="btn-primary" href={cookbook}>Read the cookbook</a>
        <a class="btn-secondary" href="/app">See what's built on it →</a>
      </div>
    </section>

    <section class="section section--ruled">
      <div class="section-head">
        <span class="section-tag">// FAQ</span>
        <h2 class="section-title">Questions, answered.</h2>
      </div>
      <div class="faq-list" style="border-top:none">
        {faq.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section section--ruled cta-band">
      <span class="section-tag">// Get started</span>
      <h2 class="section-title">Build your own on the same modules.</h2>
      <div class="hero-actions">
        <a class="btn-primary" href={docs}>Read the docs</a>
        <a class="btn-secondary" href={github}>Browse on GitHub</a>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<script>
  const canvas = document.getElementById("arch-canvas")
  const svg = canvas?.querySelector<SVGSVGElement>(".canvas-svg")
  const vp = canvas?.querySelector<SVGGElement>("#viewport")

  if (canvas && svg && vp) {
    let scale = 1
    let tx = 0
    let ty = 0

    const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi)
    const apply = () => vp.setAttribute("transform", `translate(${tx} ${ty}) scale(${scale})`)

    const toRoot = (clientX: number, clientY: number) => {
      const ctm = svg.getScreenCTM()
      if (!ctm) return { x: 0, y: 0 }
      const pt = svg.createSVGPoint()
      pt.x = clientX
      pt.y = clientY
      const p = pt.matrixTransform(ctm.inverse())
      return { x: p.x, y: p.y }
    }

    const zoomAt = (clientX: number, clientY: number, factor: number) => {
      const next = clamp(scale * factor, 0.4, 4)
      const f = next / scale
      const p = toRoot(clientX, clientY)
      tx = p.x - f * (p.x - tx)
      ty = p.y - f * (p.y - ty)
      scale = next
      apply()
    }

    svg.addEventListener("wheel", (e) => {
      e.preventDefault()
      zoomAt(e.clientX, e.clientY, e.deltaY < 0 ? 1.12 : 1 / 1.12)
    }, { passive: false })

    let dragging = false
    let lastX = 0
    let lastY = 0
    canvas.addEventListener("pointerdown", (e) => {
      if ((e.target as HTMLElement).closest(".canvas-btn")) return
      dragging = true
      lastX = e.clientX
      lastY = e.clientY
      canvas.setPointerCapture(e.pointerId)
    })
    canvas.addEventListener("pointermove", (e) => {
      if (!dragging) return
      const ctm = svg.getScreenCTM()
      const k = ctm ? ctm.a : 1
      tx += (e.clientX - lastX) / k
      ty += (e.clientY - lastY) / k
      lastX = e.clientX
      lastY = e.clientY
      apply()
    })
    const stop = () => { dragging = false }
    canvas.addEventListener("pointerup", stop)
    canvas.addEventListener("pointercancel", stop)
    canvas.addEventListener("pointerleave", stop)

    // toolbar buttons (zoom about canvas center)
    canvas.querySelectorAll<HTMLButtonElement>(".canvas-btn").forEach((btn) => {
      btn.onclick = () => {
        const r = svg.getBoundingClientRect()
        const cx = r.left + r.width / 2
        const cy = r.top + r.height / 2
        const act = btn.dataset.act
        if (act === "in") zoomAt(cx, cy, 1.2)
        else if (act === "out") zoomAt(cx, cy, 1 / 1.2)
        else if (act === "reset") { scale = 1; tx = 0; ty = 0; apply() }
        else if (act === "fs") {
          if (document.fullscreenElement) document.exitFullscreen()
          else canvas.requestFullscreen?.()
        }
      }
    })

    apply()
  }
</script>
