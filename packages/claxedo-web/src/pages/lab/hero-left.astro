---
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import IconSprite from "../../components/IconSprite.astro"
import HomeHero from "../../components/HomeHero.astro"
import { requireClaim } from "../../content/claims"
import { home } from "../../content/site"
import "../../styles/home.css"

for (const id of home.hero.claims) requireClaim(id)
---

<Layout title={`Hero lab, left-aligned: ${home.hero.title}`} noindex lightOnly>
  <Nav />
  <IconSprite />
  <main id="main-content" class="home">
    <HomeHero title={home.hero.title} subtitle={home.hero.subtitle} align="left" />
  </main>
</Layout>
