---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import SectionHead from "../components/SectionHead.astro"
import { github, contact } from "../config"
import { routes } from "../content/routes"
---

<Layout title="Contact Claxedo" description="Reach the Claxedo team on GitHub or Discord for support, bug reports, security disclosures, and partnership questions." canonicalPath={routes.contact}>
  <Nav />
  <main id="main-content" class="page">
    <div class="page-head"><SectionHead as="h1" title="Contact.">Claxedo is built in the open. Every channel below is read by the people who build it.</SectionHead></div>
    <article class="prose">
      <h2>Support and bug reports</h2>
      <p>Open an issue on GitHub with the app version, your operating system and the steps that reproduce the problem: <a href={`${github}/issues`}>{github}/issues</a>. Feature requests and self-hosting questions go there too.</p>
      <h2>Community</h2>
      <p>Join the Discord for quick questions, shared setups and release notes: <a href={contact}>{contact}</a>.</p>
      <h2>Security</h2>
      <p>Report vulnerabilities privately through GitHub's security advisories, not in a public issue: <a href={`${github}/security/advisories/new`}>{github}/security/advisories/new</a>.</p>
      <h2>Downloads and source</h2>
      <ul>
        <li>Desktop downloads: <a href={routes.download}>claxedo.com/download</a></li>
        <li>Source code and releases: <a href={github}>{github}</a></li>
        <li>About the project: <a href={routes.about}>claxedo.com/about</a></li>
      </ul>
    </article>
  </main>
  <Footer />
</Layout>
