{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Workspace packages export `development` -> src/*.ts ahead of `types` ->
    // dist/*.d.ts, so typecheck reads sibling SOURCE and never needs a build.
    "customConditions": ["development"],
    "moduleDetection": "force",
    "noEmit": true,
    "rootDir": "./src",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
