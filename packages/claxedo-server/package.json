{
  "name": "@claxedo/server",
  "version": "1.0.0",
  "description": "Self-hostable control plane for Claxedo workspaces and sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyashrathore/Claxedo"
  },
  "homepage": "https://claxedo.com",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    ".env.example",
    "README.md",
    "scripts/**/*",
    "src/**/*",
    "!src/**/.cache",
    "!src/**/.cache/**",
    "!src/**/build",
    "!src/**/build/**",
    "!src/**/dist",
    "!src/**/dist/**",
    "!src/**/node_modules",
    "!src/**/node_modules/**",
    "!scripts/sandbox/Dockerfile",
    "!scripts/sandbox/.build",
    "!scripts/sandbox/.build/**",
    "!scripts/sandbox/cloudflare-worker",
    "!scripts/sandbox/cloudflare-worker/**",
    "!scripts/sandbox/live",
    "!scripts/sandbox/live/**",
    "tsconfig.json",
    "vitest.config.ts",
    "wrangler.toml"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./central-runtime": {
      "types": "./src/central-runtime.ts",
      "bun": "./src/central-runtime.ts",
      "development": "./src/central-runtime.ts",
      "import": "./src/central-runtime.ts",
      "default": "./src/central-runtime.ts"
    }
  },
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "CLAXEDO_WAKES=${CLAXEDO_WAKES:-1} node --conditions=development --import ../workspace-runtime/src/text-imports.mjs --import tsx --watch src/main.ts",
    "start": "node --conditions=development --import ../workspace-runtime/src/text-imports.mjs --import tsx src/main.ts",
    "start:hosted": "node --conditions=development --import ../workspace-runtime/src/text-imports.mjs --import tsx src/hosted-node.ts",
    "release:runtime": "bun run scripts/release/publish-runtime-packages.ts",
    "release:packages": "bun run scripts/release/publish-claxedo-packages.ts",
    "deploy:hosted": "bun run scripts/deploy/deploy-hosted.ts",
    "check:worker-safe": "bun run scripts/deploy/check-worker-safe.ts",
    "smoke:central": "bun run scripts/smoke/smoke-central.ts",
    "smoke:documents-r2": "wrangler dev --remote --port 8799 --config scripts/smoke/wrangler.documents-r2.toml",
    "smoke:documents-relay-harness": "bun run scripts/smoke/documents-relay-live-harness.ts",
    "smoke:documents-session": "bun run scripts/smoke/documents-session-roundtrip.ts",
    "smoke:interactive": "bun run scripts/smoke/smoke-interactive-session.ts",
    "smoke:runtime": "bun run scripts/smoke/smoke-runtime.ts",
    "smoke:workgraph": "bun run scripts/smoke/smoke-workgraph.ts",
    "stress:workgraph": "node ./node_modules/vitest/vitest.mjs run --config vitest.stress.config.ts --reporter=default",
    "check:package-boundary": "bun run scripts/maintenance/check-package-boundary.ts",
    "maintenance:normalize-sandbox-leases": "bun run scripts/maintenance/normalize-convex-sandbox-leases.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ./node_modules/vitest/vitest.mjs run --reporter=default --reporter=junit --outputFile.junit=.artifacts/unit/junit.xml",
    "test:live-ui": "node --import tsx scripts/sandbox/live/live-ui-test.ts",
    "sandbox:image": "bun run scripts/sandbox/build-sandbox-image.ts",
    "rebuild:native": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@claxedo/agent-extensions": "workspace:0.7.0",
    "@claxedo/agent-sdk-runtime": "workspace:0.7.0",
    "@claxedo/channels": "workspace:0.4.0",
    "@claxedo/connections": "0.4.0",
    "@claxedo/mcp": "workspace:0.4.0",
    "@claxedo/sandbox-manager": "workspace:0.7.0",
    "@claxedo/wakes": "workspace:0.3.0",
    "@claxedo/workgraph": "0.4.0",
    "@claxedo/workspace-relay": "workspace:0.7.0",
    "@claxedo/workspace-relay-protocol": "workspace:0.7.0",
    "@claxedo/workspace-runtime": "workspace:0.7.0",
    "@daytona/sdk": "0.200.1",
    "@opencode-ai/sdk-next": "workspace:*",
    "@hono/node-server": "1.19.11",
    "@hono/node-ws": "1.3.1",
    "@polar-sh/sdk": "0.49.0",
    "@sinclair/typebox": "^0.34.41",
    "@vercel/sandbox": "1.10.2",
    "better-auth": "1.6.25",
    "better-sqlite3": "13.0.1",
    "convex": "1.42.3",
    "drizzle-orm": "catalog:",
    "hono": "4.10.7",
    "jose": "6.2.4",
    "jsonc-parser": "3.3.1",
    "modal": "0.9.0",
    "node-pty": "1.1.0",
    "posthog-node": "4.18.0",
    "svix": "1.99.1",
    "tokentracker-cli": "0.75.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "22.0.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "convex-test": "0.0.54",
    "esbuild": "0.25.12",
    "miniflare": "4.20260722.0",
    "tsx": "4.22.3",
    "typescript": "catalog:",
    "vitest": "2.1.9",
    "wrangler": "4.114.0"
  }
}
