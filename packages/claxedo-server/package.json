{
  "name": "@claxedo/server",
  "version": "1.0.0",
  "description": "Self-hostable control plane for Claxedo workspaces and sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyashrathore/Claxedo"
  },
  "homepage": "https://claxedo.com",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    ".env.example",
    "README.md",
    "src/**/*",
    "!src/**/.cache",
    "!src/**/.cache/**",
    "!src/**/build",
    "!src/**/build/**",
    "!src/**/dist",
    "!src/**/dist/**",
    "!src/**/node_modules",
    "!src/**/node_modules/**",
    "tsconfig.json",
    "vitest.config.ts",
    "wrangler.toml"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./central-runtime": {
      "types": "./src/central-runtime.ts",
      "bun": "./src/central-runtime.ts",
      "development": "./src/central-runtime.ts",
      "import": "./src/central-runtime.ts",
      "default": "./src/central-runtime.ts"
    }
  },
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "CLAXEDO_WAKES=${CLAXEDO_WAKES:-1} node --conditions=development --import ../workspace-runtime/src/text-imports.mjs --import tsx --watch src/deployments/self-hosted-node/index.ts",
    "start": "node --conditions=development --import ../workspace-runtime/src/text-imports.mjs --import tsx src/deployments/self-hosted-node/index.ts",
    "start:hosted": "node --conditions=development --import ../workspace-runtime/src/text-imports.mjs --import tsx src/deployments/hosted-node/index.ts",
    "release:runtime": "bun run scripts/release/publish-runtime-packages.ts",
    "release:packages": "bun run scripts/release/publish-claxedo-packages.ts",
    "deploy:hosted": "bun run scripts/deploy/deploy-hosted.ts",
    "deploy:user-cloudflare:preflight": "bun run scripts/deploy/greenfield-user-deployed.ts --preflight",
    "deploy:user-cloudflare:cutover": "bun run scripts/deploy/cutover-better-auth-d1.ts",
    "deploy:user-cloudflare:prove-greenfield": "bun run scripts/deploy/prove-greenfield-target-absence.ts",
    "deploy:user-cloudflare:verify-paired-backup": "bun run scripts/deploy/verify-paired-d1-backup.ts",
    "deploy:user-cloudflare:verify-migration": "bun run scripts/deploy/verify-migration-evidence.ts",
    "deploy:user-cloudflare:owner-claim": "bun run scripts/deploy/provision-user-deployed-owner-claim.ts",
    "docs:user-cloudflare:check": "bun run scripts/deploy/greenfield-user-deployed.ts --check-guide",
    "docs:user-cloudflare:print": "bun run scripts/deploy/greenfield-user-deployed.ts --print-guide",
    "docs:user-cloudflare:write": "bun run scripts/deploy/greenfield-user-deployed.ts --write-guide",
    "auth:migration:generate": "node --import tsx scripts/deploy/generate-better-auth-d1-migration.ts",
    "typecheck:auth-d1": "tsc --noEmit -p tsconfig.auth-d1.json",
    "typecheck:services": "tsc --noEmit -p tsconfig.services.json",
    "build:hosted-node-boundary": "bun run scripts/boundary/build-hosted-node.ts",
    "smoke:hosted-node-boundary": "node scripts/boundary/smoke-hosted-node.mjs",
    "build:self-hosted-boundary": "bun run scripts/boundary/build-self-hosted.ts",
    "smoke:self-hosted-boundary": "node scripts/boundary/smoke-self-hosted.mjs",
    "build:workerd-boundary": "bun run scripts/boundary/build-workerd.ts",
    "smoke:workerd-boundary": "bun run scripts/boundary/smoke-workerd.ts",
    "check:worker-safe": "bun run scripts/deploy/check-worker-safe.ts",
    "smoke:central": "bun run scripts/smoke/smoke-central.ts",
    "smoke:documents-r2": "wrangler dev --remote --port 8799 --config scripts/smoke/wrangler.documents-r2.toml",
    "smoke:documents-relay-harness": "bun run scripts/smoke/documents-relay-live-harness.ts",
    "smoke:documents-session": "bun run scripts/smoke/documents-session-roundtrip.ts",
    "smoke:interactive": "bun run scripts/smoke/smoke-interactive-session.ts",
    "smoke:runtime": "bun run scripts/smoke/smoke-runtime.ts",
    "smoke:usage": "bun run scripts/smoke/smoke-usage-metering.ts && node ./node_modules/vitest/vitest.mjs run --config vitest.convex.config.ts ../../convex/usage-metering.policy.test.ts",
    "smoke:workgraph": "bun run scripts/smoke/smoke-workgraph.ts",
    "stress:workgraph": "node ./node_modules/vitest/vitest.mjs run --config vitest.stress.config.ts --reporter=default",
    "check:package-boundary": "bun run scripts/maintenance/check-package-boundary.ts",
    "maintenance:normalize-sandbox-leases": "bun run scripts/maintenance/normalize-convex-sandbox-leases.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.convex-tests.json",
    "test": "node ./node_modules/vitest/vitest.mjs run --reporter=default --reporter=junit --outputFile.junit=.artifacts/unit/junit.xml && bun run test:convex",
    "test:convex": "node ./node_modules/vitest/vitest.mjs run --config vitest.convex.config.ts --reporter=default --reporter=junit --outputFile.junit=.artifacts/unit/junit-convex.xml",
    "test:live-ui": "node --import tsx scripts/sandbox/live/live-ui-test.ts",
    "sandbox:image": "bun run scripts/sandbox/build-sandbox-image.ts",
    "rebuild:native": "npm rebuild better-sqlite3",
    "smoke:self-hosted-restart": "./scripts/smoke/self-hosted-restart.sh",
    "smoke:self-hosted-upgrade": "./scripts/smoke/self-hosted-upgrade.sh",
    "verify:closure": "bun ../../script/product-boundary/verify.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@claxedo/agent-event-runtime": "workspace:0.7.0",
    "@claxedo/agent-extensions": "workspace:0.7.0",
    "@claxedo/agent-sdk-runtime": "workspace:0.7.0",
    "@claxedo/channels": "workspace:0.4.0",
    "@claxedo/connections": "0.4.0",
    "@claxedo/local-server": "workspace:*",
    "@claxedo/mcp": "workspace:0.4.0",
    "@claxedo/sandbox-contract": "workspace:0.7.0",
    "@claxedo/sandbox-manager": "workspace:0.7.0",
    "@claxedo/service-contract": "workspace:*",
    "@claxedo/server-core": "workspace:*",
    "@claxedo/wakes": "workspace:0.4.0",
    "@claxedo/workgraph": "0.4.0",
    "@claxedo/workspace-relay": "workspace:0.7.0",
    "@claxedo/workspace-relay-protocol": "workspace:0.7.0",
    "@claxedo/workspace-runtime": "workspace:0.7.0",
    "@better-auth/kysely-adapter": "1.7.1",
    "@daytona/sdk": "0.200.1",
    "@hono/node-server": "1.19.11",
    "@hono/node-ws": "1.3.1",
    "@lydell/node-pty": "catalog:",
    "@opencode-ai/sdk-next": "workspace:*",
    "@polar-sh/sdk": "0.49.0",
    "@sinclair/typebox": "^0.34.41",
    "@vercel/sandbox": "1.10.2",
    "better-auth": "1.7.1",
    "better-sqlite3": "13.0.1",
    "convex": "1.42.3",
    "drizzle-orm": "catalog:",
    "hono": "4.10.7",
    "jose": "6.2.4",
    "jsonc-parser": "3.3.1",
    "kysely": "0.29.3",
    "modal": "0.9.0",
    "opencode": "workspace:*",
    "posthog-node": "4.18.0",
    "svix": "1.99.1",
    "tokentracker-cli": "0.91.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@edge-runtime/vm": "5.0.0",
    "@tsconfig/node-lts": "22.0.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "convex-test": "0.0.54",
    "esbuild": "0.25.12",
    "miniflare": "4.20260722.0",
    "tsx": "4.22.3",
    "typescript": "catalog:",
    "vitest": "2.1.9",
    "wrangler": "4.114.0"
  }
}
