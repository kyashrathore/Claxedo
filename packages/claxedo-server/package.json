{
  "name": "@claxedo/server",
  "version": "1.0.0",
  "description": "Claxedo control plane for workspaces and sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyashrathore/Claxedo"
  },
  "homepage": "https://claxedo.com",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    ".env.example",
    "README.md",
    "src/**/*",
    "!src/**/.cache",
    "!src/**/.cache/**",
    "!src/**/build",
    "!src/**/build/**",
    "!src/**/dist",
    "!src/**/dist/**",
    "!src/**/node_modules",
    "!src/**/node_modules/**",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "release:packages": "bun run scripts/release/publish-claxedo-packages.ts",
    "deploy:user-cloudflare": "bun run scripts/deploy/deploy-user-cloudflare.ts",
    "deploy:user-cloudflare:claim-owner": "bun run scripts/deploy/claim-owner.ts",
    "auth:migration:generate": "node --import tsx scripts/deploy/generate-better-auth-d1-migration.ts",
    "typecheck:auth-d1": "tsc --noEmit -p tsconfig.auth-d1.json",
    "typecheck:services": "tsc --noEmit -p tsconfig.services.json",
    "build:workerd-boundary": "bun run scripts/boundary/build-workerd.ts",
    "smoke:workerd-boundary": "node --import tsx scripts/boundary/smoke-workerd.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test/unit.mjs",
    "sandbox:image": "bun run scripts/sandbox/build-sandbox-image.ts",
    "rebuild:native": "npm rebuild better-sqlite3",
    "verify:closure": "bun ../../script/product-boundary/verify.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@claxedo/account-contract": "workspace:*",
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/process-ownership": "workspace:*",
    "@claxedo/channels": "workspace:*",
    "@claxedo/connections": "workspace:*",
    "@claxedo/egress-broker": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@claxedo/local-server": "workspace:*",
    "@claxedo/mcp": "workspace:*",
    "@claxedo/plugin-api": "workspace:*",
    "@claxedo/sandbox-contract": "workspace:*",
    "@claxedo/sandbox-manager": "workspace:*",
    "@claxedo/server-core": "workspace:*",
    "@claxedo/tasks": "workspace:*",
    "@claxedo/workspace-relay": "workspace:*",
    "@claxedo/workspace-relay-protocol": "workspace:*",
    "@claxedo/workspace-runtime": "workspace:*",
    "@better-auth/kysely-adapter": "1.7.1",
    "@hono/node-server": "1.19.11",
    "@hono/node-ws": "1.3.1",
    "@lydell/node-pty": "catalog:",
    "@sinclair/typebox": "^0.34.41",
    "better-auth": "1.7.1",
    "better-sqlite3": "13.0.1",
    "drizzle-orm": "catalog:",
    "hono": "4.12.34",
    "jose": "6.2.4",
    "kysely": "0.29.3",
    "posthog-node": "4.18.0",
    "tokentracker-cli": "0.91.0",
    "zod": "4.4.3",
    "@claxedo/session-core": "workspace:*"
  },
  "devDependencies": {
    "@claxedo/plugin-build": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@modelcontextprotocol/inspector": "2.4.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tsconfig/node-lts": "22.0.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "esbuild": "0.25.12",
    "miniflare": "4.20260722.0",
    "tsx": "4.22.3",
    "typescript": "catalog:",
    "vitest": "2.1.9",
    "wrangler": "4.114.0"
  }
}
