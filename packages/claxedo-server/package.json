{
  "name": "@opencode-ai/claxedo-server",
  "version": "1.0.0",
  "description": "Self-hostable control plane for Claxedo workspaces and sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyashrathore/Claxedo"
  },
  "homepage": "https://claxedo.com",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    ".env.example",
    "README.md",
    "scripts/**/*",
    "src/**/*",
    "!src/**/.cache",
    "!src/**/.cache/**",
    "!src/**/build",
    "!src/**/build/**",
    "!src/**/dist",
    "!src/**/dist/**",
    "!src/**/node_modules",
    "!src/**/node_modules/**",
    "!scripts/sandbox/Dockerfile",
    "!scripts/sandbox/cloudflare-worker",
    "!scripts/sandbox/cloudflare-worker/**",
    "!scripts/sandbox/live",
    "!scripts/sandbox/live/**",
    "tsconfig.json",
    "vitest.config.ts",
    "wrangler.toml"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./central-runtime": {
      "types": "./src/central-runtime.ts",
      "bun": "./src/central-runtime.ts",
      "development": "./src/central-runtime.ts",
      "import": "./src/central-runtime.ts",
      "default": "./src/central-runtime.ts"
    }
  },
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node --conditions=development --import ../workspace-runtime/src/text-imports.mjs --import tsx --watch src/main.ts",
    "start": "node --conditions=development --import ../workspace-runtime/src/text-imports.mjs --import tsx src/main.ts",
    "start:hosted": "node --conditions=development --import ../workspace-runtime/src/text-imports.mjs --import tsx src/hosted-node.ts",
    "release:runtime": "bun run scripts/release/publish-runtime-packages.ts",
    "deploy:hosted": "bun run scripts/deploy/deploy-hosted.ts",
    "check:worker-safe": "bun run scripts/deploy/check-worker-safe.ts",
    "smoke:central": "bun run scripts/smoke/smoke-central.ts",
    "smoke:runtime": "bun run scripts/smoke/smoke-runtime.ts",
    "check:package-boundary": "bun run scripts/maintenance/check-package-boundary.ts",
    "maintenance:normalize-sandbox-leases": "bun run scripts/maintenance/normalize-convex-sandbox-leases.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:live-ui": "node --import tsx scripts/sandbox/live/live-ui-test.ts",
    "sandbox:image": "bun run scripts/sandbox/build-sandbox-image.ts",
    "rebuild:native": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@claxedo/agent-extensions": "workspace:0.5.1",
    "@claxedo/agent-sdk-runtime": "workspace:0.5.1",
    "@claxedo/channels": "workspace:0.1.0",
    "@claxedo/connections": "0.1.0",
    "@claxedo/sandbox-manager": "workspace:0.5.1",
    "@claxedo/wakes": "workspace:0.1.0",
    "@claxedo/workgraph": "0.1.0",
    "@claxedo/workspace-relay": "workspace:0.5.1",
    "@claxedo/workspace-relay-protocol": "workspace:0.5.1",
    "@claxedo/workspace-runtime": "workspace:0.5.1",
    "@daytona/sdk": "0.192.0",
    "@hono/node-server": "1.19.11",
    "@hono/node-ws": "1.3.1",
    "@sinclair/typebox": "^0.34.41",
    "@vercel/sandbox": "1.10.2",
    "better-auth": "1.6.23",
    "better-sqlite3": "12.10.0",
    "convex": "1.39.1",
    "drizzle-orm": "0.45.1",
    "hono": "4.10.7",
    "jose": "6.0.11",
    "jsonc-parser": "3.3.1",
    "modal": "0.7.5",
    "node-pty": "1.1.0",
    "opencode": "workspace:*",
    "posthog-node": "4.18.0",
    "svix": "1.95.2",
    "tokentracker-cli": "0.75.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "22.0.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "esbuild": "0.25.12",
    "tsx": "4.22.3",
    "typescript": "5.8.2",
    "vitest": "2.1.9"
  }
}
