CLAXEDO_DATA_DIR=
CLAXEDO_STATE_DIR=
CLAXEDO_SERVER_URL=
CLAXEDO_AUTH_TOKEN=
# Required absolute repository directory used by local WorkGraph execution and background Sessions.
CLAXEDO_WORKGRAPH_REPOSITORY=/absolute/path/to/repository
# Content-free WorkGraph operational monitor thresholds.
CLAXEDO_WORKGRAPH_ALERT_WINDOW_MS=300000
CLAXEDO_WORKGRAPH_ALERT_COMMAND_ERRORS=10
CLAXEDO_WORKGRAPH_ALERT_RECONCILE_FAILURES=1
CLAXEDO_WORKGRAPH_ALERT_EXPIRED_RECOVERIES=3
CLAXEDO_WORKGRAPH_ALERT_GENERATION_FAILURES=3
CLAXEDO_WORKGRAPH_ALERT_CONNECTOR_AUTH_FAILURES=3
CLAXEDO_WORKGRAPH_ALERT_WORKSPACE_FAILURES=3
CLAXEDO_WORKGRAPH_ALERT_CLOSE_REQUIRED=5
CLAXEDO_WORKGRAPH_ALERT_BACKLOG=20
CLAXEDO_WORKGRAPH_ALERT_LAG_MS=600000
CLAXEDO_WORKSPACE_RELAY_URL=
CLAXEDO_RELAY_ISSUER=
CLAXEDO_RELAY_AUDIENCE=
CLAXEDO_RELAY_JWT_PRIVATE_KEY_JWK=
CLAXEDO_RELAY_HOST_PUBLIC_KEY_JWK=
CLAXEDO_RELAY_JWT_ALG=
CLAXEDO_SUPERVISOR_BACKPLANE_TOKEN=
CLAXEDO_CF_KV_URL=
CLAXEDO_CF_KV_TOKEN=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# One PostHog key carries product analytics AND error tracking. Absent = no
# client is built and nothing is sent. CLAXEDO_-prefixed names win; the
# unprefixed pair below stays supported for existing self-host deployments.
CLAXEDO_POSTHOG_KEY=
CLAXEDO_POSTHOG_HOST=
POSTHOG_KEY=
POSTHOG_HOST=
DAYTONA_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
VERCEL_TOKEN=
VERCEL_OIDC_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_SANDBOX_WORKER_URL=
SVIX_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
WHATSAPP_BAILEYS_AUTH_DIR=
