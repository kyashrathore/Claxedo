CLAXEDO_DATA_DIR=
CLAXEDO_STATE_DIR=
CLAXEDO_SERVER_URL=
CLAXEDO_AUTH_TOKEN=
# Required by `deploy:hosted`; never inferred from provider credentials.
# Certified target: better-auth-d1.
CLAXEDO_ADAPTER_PROFILE=
# Product policy: claxedo-hosted (multi-org + billing) or user-deployed
# (one org + no Claxedo billing).
CLAXEDO_PRODUCT_POSTURE=
# control-plane-only, or full-hosted with one explicit driver below.
CLAXEDO_SANDBOX_POSTURE=
CLAXEDO_SANDBOX_DRIVER=
# Build-bound identity for the Better Auth + D1 locked deployment. Each value
# is explicit and persisted in AUTH_DB before the Worker is deployed.
# Production and staging resources are mandatory and must be distinct. The
# release command selects exactly one set; generic values are never accepted.
CLAXEDO_PRODUCTION_DEPLOYMENT_ID=
CLAXEDO_STAGING_DEPLOYMENT_ID=
CLAXEDO_PRODUCTION_API_ORIGIN=
CLAXEDO_STAGING_API_ORIGIN=
CLAXEDO_PRODUCTION_APP_ORIGIN=
CLAXEDO_STAGING_APP_ORIGIN=
CLAXEDO_PRODUCTION_AUTH_D1_DATABASE_ID=
CLAXEDO_STAGING_AUTH_D1_DATABASE_ID=
CLAXEDO_PRODUCTION_AUTH_D1_DATABASE_NAME=
CLAXEDO_STAGING_AUTH_D1_DATABASE_NAME=
# Limiter namespaces are allocated deterministically from the environment's
# deployment ID and Worker name; they are not caller-selectable.
CLAXEDO_RELEASE_SEQUENCE=
CLAXEDO_RELEASE_ID=
# Required together for an explicit successor CAS; omit all four on first install.
CLAXEDO_PREVIOUS_RELEASE_ID=
CLAXEDO_PREVIOUS_STATE_REVISION=
CLAXEDO_PREVIOUS_PHASE=
CLAXEDO_PREVIOUS_PHASE_REVISION=
CLAXEDO_RELEASE_OPERATION_ID=
CLAXEDO_BOOTSTRAP_CONFIRM_WORKER_NAME=
# Separate from auth, migration, relay, sandbox, and optional-service secrets.
# Required by the authenticated persisted cutover operator API.
CLAXEDO_RELEASE_OPERATOR_SECRET=
# Typed cutover receipt inputs. The selected cutover command documents which
# subset is required; there is intentionally no arbitrary evidence JSON input.
CLAXEDO_CUTOVER_RECEIPT_ID=
CLAXEDO_CUTOVER_OPERATION_ID=
CLAXEDO_CUTOVER_SOURCE_SNAPSHOT_ID=
CLAXEDO_CUTOVER_MIGRATION_EVIDENCE_SHA256=
CLAXEDO_CUTOVER_SOURCE_SHA256=
CLAXEDO_CUTOVER_TARGET_ABSENCE_SHA256=
CLAXEDO_CUTOVER_DEPLOYMENT_MANIFEST_SHA256=
CLAXEDO_CUTOVER_CANARY_IDENTITY_HASH=
CLAXEDO_CUTOVER_CANARY_JOURNEY_ID=
CLAXEDO_CUTOVER_RECOVERY_EPOCH=
CLAXEDO_CUTOVER_AUTH_BACKUP_SHA256=
CLAXEDO_CUTOVER_CONTROL_PLANE_BACKUP_SHA256=
CLAXEDO_CUTOVER_MULTIPLAYER_IDENTITY_1_HASH=
CLAXEDO_CUTOVER_MULTIPLAYER_IDENTITY_2_HASH=
# Comma-separated: google, github, and/or email-password. OAuth-only profiles
# need no email provider; email-password requires a deployment-owned sender.
CLAXEDO_AUTH_METHODS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CLAXEDO_WORKSPACE_RELAY_URL=
CLAXEDO_RELAY_ISSUER=
CLAXEDO_RELAY_AUDIENCE=
CLAXEDO_RELAY_JWT_PRIVATE_KEY_JWK=
CLAXEDO_RELAY_HOST_PUBLIC_KEY_JWK=
CLAXEDO_RELAY_JWT_ALG=
CLAXEDO_SUPERVISOR_BACKPLANE_TOKEN=
CLAXEDO_CF_KV_URL=
CLAXEDO_CF_KV_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# One PostHog key carries product analytics AND error tracking. Absent = no
# client is built and nothing is sent. CLAXEDO_-prefixed names win; the
# unprefixed pair below stays supported for existing self-host deployments.
CLAXEDO_POSTHOG_KEY=
CLAXEDO_POSTHOG_HOST=
POSTHOG_KEY=
POSTHOG_HOST=
DAYTONA_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
VERCEL_TOKEN=
VERCEL_OIDC_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_SANDBOX_WORKER_URL=
SVIX_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
WHATSAPP_BAILEYS_AUTH_DIR=
