CLAXEDO_DATA_DIR=
CLAXEDO_STATE_DIR=
CLAXEDO_SERVER_URL=
CLAXEDO_AUTH_TOKEN=
# Signed mode of the Node composition the e2e suites boot (embedded Better Auth
# issuer). Leave unset for the unsigned, loopback-only posture. Read by
# src/deployments/self-hosted-node/embedded-auth.ts.
CLAXEDO_EMBEDDED_AUTH=
CLAXEDO_EMBEDDED_AUTH_SECRET=
CLAXEDO_EMBEDDED_AUTH_TRUSTED_ORIGINS=
# Comma-separated authenticated subject IDs allowed to manage this machine.
# Signed mode denies machine plugin reads/writes, enrollment and deletion of a
# workspace placed on this machine when empty. These are stable
# user IDs from the configured issuer, never email addresses or org roles.
# Restart the server after changing this list.
CLAXEDO_OPERATOR_SUBJECTS=
# `deploy:user-cloudflare` (public-docs/user-deployed-cloudflare.md). The
# origins are custom domains on your Cloudflare zone; every name defaults from
# CLAXEDO_WORKER_NAME and must not change after the first deploy.
CLAXEDO_API_ORIGIN=
CLAXEDO_APP_ORIGIN=
CLAXEDO_USER_DEPLOYED_ORGANIZATION_NAME=
CLAXEDO_USER_DEPLOYED_ORGANIZATION_ID=
CLAXEDO_WORKER_NAME=
CLAXEDO_APP_WORKER_NAME=
CLAXEDO_DEPLOYMENT_ID=
CLAXEDO_AUTH_D1_DATABASE_NAME=
CLAXEDO_CONTROL_PLANE_D1_DATABASE_NAME=
CLAXEDO_DOCUMENTS_BUCKET=
CLAXEDO_AGENT_PLUGINS_BUCKET=
# control-plane-only, or full-hosted with one explicit driver below.
CLAXEDO_SANDBOX_POSTURE=
CLAXEDO_SANDBOX_DRIVER=
# Comma-separated: google, github, and/or email-password. OAuth-only profiles
# can sign in without email; invitations and email-password need EMAIL + CLAXEDO_EMAIL_FROM.
CLAXEDO_AUTH_METHODS=
# Cloudflare Email Service requires Workers Paid and an onboarded sending domain.
CLAXEDO_EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CLAXEDO_WORKSPACE_RELAY_URL=
CLAXEDO_RELAY_ISSUER=
CLAXEDO_RELAY_AUDIENCE=
CLAXEDO_RELAY_JWT_PRIVATE_KEY_JWK=
CLAXEDO_RELAY_HOST_PUBLIC_KEY_JWK=
CLAXEDO_RELAY_JWT_ALG=
CLAXEDO_SUPERVISOR_BACKPLANE_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# One PostHog key carries product analytics AND error tracking. Absent = no
# client is built and nothing is sent. CLAXEDO_-prefixed names win over the
# unprefixed pair below.
CLAXEDO_POSTHOG_KEY=
CLAXEDO_POSTHOG_HOST=
POSTHOG_KEY=
POSTHOG_HOST=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
VERCEL_TOKEN=
VERCEL_OIDC_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_SANDBOX_WORKER_URL=
SVIX_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
WHATSAPP_BAILEYS_AUTH_DIR=
