{
  "name": "@claxedo/agent-event-runtime",
  "version": "0.10.0",
  "type": "module",
  "description": "Canonical agent event contracts and harness adapters: normalize Claude SDK, Codex, Cursor, and ACP event streams into one runtime event model",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/agent-event-runtime"
  },
  "keywords": [
    "claxedo",
    "agents",
    "events",
    "acp",
    "claude",
    "codex"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./contracts": {
      "development": "./src/contracts/index.ts",
      "bun": "./src/contracts/index.ts",
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts.mjs",
      "default": "./dist/contracts.mjs"
    },
    "./debug-trace": {
      "development": "./src/projections/debug-trace/index.ts",
      "bun": "./src/projections/debug-trace/index.ts",
      "types": "./dist/projections/debug-trace/index.d.ts",
      "import": "./dist/debug-trace.mjs",
      "default": "./dist/debug-trace.mjs"
    },
    "./client-presentation": {
      "development": "./src/projections/client-presentation/index.ts",
      "bun": "./src/projections/client-presentation/index.ts",
      "types": "./dist/projections/client-presentation/index.d.ts",
      "import": "./dist/client-presentation.mjs",
      "default": "./dist/client-presentation.mjs"
    },
    "./projections/debug-trace": {
      "development": "./src/projections/debug-trace/index.ts",
      "bun": "./src/projections/debug-trace/index.ts",
      "types": "./dist/projections/debug-trace/index.d.ts",
      "import": "./dist/debug-trace.mjs",
      "default": "./dist/debug-trace.mjs"
    },
    "./projections/client-presentation": {
      "development": "./src/projections/client-presentation/index.ts",
      "bun": "./src/projections/client-presentation/index.ts",
      "types": "./dist/projections/client-presentation/index.d.ts",
      "import": "./dist/client-presentation.mjs",
      "default": "./dist/client-presentation.mjs"
    },
    "./harnesses/acp": {
      "development": "./src/harnesses/acp/index.ts",
      "bun": "./src/harnesses/acp/index.ts",
      "types": "./dist/harnesses/acp/index.d.ts",
      "import": "./dist/harnesses/acp.mjs",
      "default": "./dist/harnesses/acp.mjs"
    },
    "./harnesses/claude": {
      "development": "./src/harnesses/claude/index.ts",
      "bun": "./src/harnesses/claude/index.ts",
      "types": "./dist/harnesses/claude/index.d.ts",
      "import": "./dist/harnesses/claude.mjs",
      "default": "./dist/harnesses/claude.mjs"
    },
    "./harnesses/codex": {
      "development": "./src/harnesses/codex/index.ts",
      "bun": "./src/harnesses/codex/index.ts",
      "types": "./dist/harnesses/codex/index.d.ts",
      "import": "./dist/harnesses/codex.mjs",
      "default": "./dist/harnesses/codex.mjs"
    },
    "./harnesses/cursor": {
      "development": "./src/harnesses/cursor/index.ts",
      "bun": "./src/harnesses/cursor/index.ts",
      "types": "./dist/harnesses/cursor/index.d.ts",
      "import": "./dist/harnesses/cursor.mjs",
      "default": "./dist/harnesses/cursor.mjs"
    },
    "./harnesses/pi": {
      "development": "./src/harnesses/pi/index.ts",
      "bun": "./src/harnesses/pi/index.ts",
      "types": "./dist/harnesses/pi/index.d.ts",
      "import": "./dist/harnesses/pi.mjs",
      "default": "./dist/harnesses/pi.mjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "docs",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "mkdir -p .artifacts/unit && node ../../scripts/test-deadline.mjs bun test src --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@anthropic-ai/sdk": "0.115.0",
    "@cursor/sdk": "1.0.24"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "esbuild": "0.25.12",
    "tsx": "4.22.3",
    "typescript": "catalog:"
  }
}
