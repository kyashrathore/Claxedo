{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "noUncheckedIndexedAccess": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
