{
  "name": "@claxedo/agent-runtime-stats",
  "version": "0.1.4",
  "description": "Analyze local AI coding-agent transcripts by minimum execution runtime",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-runtime-stats": "bin/agent-runtime-stats.js"
  },
  "files": [
    "bin",
    "src",
    "worker/migrations",
    "worker/src",
    "worker/README.md",
    "worker/tsconfig.json",
    "worker/wrangler.jsonc",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/behavior.test.js test/parsers.test.js",
    "worker:test": "bun test worker/src",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "worker:check": "bun run worker:test && bun run worker:typecheck && wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2",
    "wrangler": "4.114.0"
  }
}
