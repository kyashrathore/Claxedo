{
  "name": "@claxedo/app-v2",
  "version": "0.0.59",
  "private": true,
  "description": "Claxedo desktop and web application",
  "type": "module",
  "exports": {
    ".": "./src/app/entry/index.tsx",
    "./process-diagnostics-contract": "./src/features/processes/data/local-diagnostics.ts",
    "./content-security-policy": "./content-security-policy.ts"
  },
  "scripts": {
    "dev": "VITE_CLAXEDO_AUTH_ADAPTER=better-auth PORT=${PORT:-4445} vite --config vite.cloud.config.ts",
    "dev:local": "VITE_CLAXEDO_AUTH_ADAPTER=better-auth PORT=${PORT:-4445} vite --config vite.local.config.ts",
    "build": "VITE_CLAXEDO_AUTH_ADAPTER=better-auth node ./node_modules/vite/bin/vite.js build --config vite.cloud.config.ts",
    "build:local": "VITE_CLAXEDO_AUTH_ADAPTER=better-auth node ./node_modules/vite/bin/vite.js build --config vite.local.config.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsgo --noEmit -p tsconfig.e2e.json",
    "test": "bun test --conditions browser src",
    "check": "bun scripts/checks/run.ts",
    "e2e": "bun ./e2e/run.ts",
    "e2e:parity": "bun ./e2e/parity/run.ts",
    "e2e:perf-stream": "bun ./e2e/perf/run.ts"
  },
  "license": "MIT",
