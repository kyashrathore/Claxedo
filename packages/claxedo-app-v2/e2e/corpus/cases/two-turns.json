            "locations": [
              {
                "path": "{{workspace}}/README.md"
              }
            ],
            "text": "corpus\n"
          },
          {
            "kind": "text",
            "text": "Found one TODO."
          }
        ]
      }
    ]
  },
  "ready": "Found one TODO.",
  "interactions": [
    {
      "kind": "scroll",
      "to": "top"
    }
