{
  "name": "@claxedo/workgraph",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/server.ts",
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "typecheck": "bun x tsc --noEmit -p tsconfig.src.json",
    "typecheck:src": "bun x tsc --noEmit -p tsconfig.src.json",
    "typecheck:test": "bun x tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@composio/core": "0.8.1",
    "@hono/zod-validator": "0.4.2",
    "better-sqlite3": "12.10.0",
    "drizzle-orm": "0.45.1",
    "hono": "4.10.7",
    "ulid": "3.0.2",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "typescript": "5.8.2",
    "vitest": "2.1.9",
    "@types/bun": "catalog:"
  },
  "description": "An event-sourced work inbox for AI agents \u2014 mirror issues from GitHub/Linear/Jira, stage, run attempts, sync back.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./connectors": {
      "types": "./dist/connectors/index.d.ts",
      "import": "./dist/connectors/index.mjs",
      "default": "./dist/connectors/index.mjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ]
}
