{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Workspace packages export `development` -> src/*.ts ahead of `types` ->
    // dist/*.d.ts, so typecheck reads sibling SOURCE and never needs a build.
    "customConditions": ["development"],
    "types": ["node", "bun"],
    "noUncheckedIndexedAccess": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["src"]
}
