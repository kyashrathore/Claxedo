{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@claxedo/cli",
  "version": "0.2.1",
  "description": "The claxedo command: sign in, connect a machine to the control plane, manage which machines serve which folders, deploy",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/kyashrathore/Claxedo/tree/dev/packages/cli",
  "bugs": "https://github.com/kyashrathore/Claxedo/issues",
  "keywords": [
    "claxedo",
    "cli",
    "agents",
    "remote-access"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "claxedo": "dist/index.mjs"
  },
  "files": [
    "dist",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "verify:publish": "bun scripts/verify-publish.ts",
    "dev": "bun run src/index.ts",
    "test": "mkdir -p .artifacts/unit && node ../../script/test-deadline.mjs node ../../script/windows-test-timeout.mjs bun test src --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml && node ../../script/test-home/run.mjs node ../../script/test-deadline.mjs node --import tsx --test src/commands/connect-terminal.node-test.ts",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@claxedo/workspace-runtime": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@claxedo/account-contract": "workspace:*",
    "@claxedo/documents": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@claxedo/host-connector": "workspace:*",
    "@claxedo/host-serving": "workspace:*",
    "@claxedo/plugin-api": "workspace:*",
    "@claxedo/process-ownership": "workspace:*",
    "@claxedo/server-core": "workspace:*",
    "@claxedo/session-core": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "tsx": "4.22.3"
  }
}
