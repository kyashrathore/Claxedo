{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "#terminal-backend": ["./src/overrides/terminal/backend/xterm"],
      "@solid-primitives/active-element": ["../app/node_modules/@solid-primitives/active-element/dist/index.d.ts"],
      "@/*": ["./src/overrides/*", "../app/src/*"],
      "@claxedo/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "src/opencode-patches", "src/opencode-extensions", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
