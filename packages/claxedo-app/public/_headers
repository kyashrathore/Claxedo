# Vite emits content-hashed filenames under /assets (e.g. main-DUtf99h4.js), so
# they are immutable. Pages MERGES overlapping rules, so set Cache-Control once
# on the /assets/* catch-all and the MIME type on the specific extensions —
# every /assets file ends up with exactly one of each header (no duplicates).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js
  Content-Type: application/javascript

/assets/*.mjs
  Content-Type: application/javascript

/assets/*.css
  Content-Type: text/css

# Root-level scripts/styles may be unhashed (service worker, etc.) — keep the
# correct MIME but let Pages' default revalidation apply (no immutable cache).
/*.js
  Content-Type: application/javascript

/*.mjs
  Content-Type: application/javascript

/*.css
  Content-Type: text/css

# The SPA shell and client routes (/, /w/:id, /s/:id) serve index.html and MUST
# revalidate so a new deploy's asset references are picked up immediately.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
