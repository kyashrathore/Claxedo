{
  "name": "@claxedo/perf-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "run": "bun src/cli.ts run",
    "run:all": "bun src/cli.ts run --all",
    "run:debug": "bun src/cli.ts run --all --debug",
    "run:headed": "bun src/cli.ts run --all --headed",
    "report": "bun src/cli.ts report",
    "list": "bun src/cli.ts list",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "playwright": "1.59.1",
    "typescript": "5.8.2"
  }
}
