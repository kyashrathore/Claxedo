{
  "name": "@claxedo/perf-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "run": "bun src/cli.ts run",
    "run:all": "bun src/cli.ts run --all",
    "run:debug": "bun src/cli.ts run --all --debug",
    "run:headed": "bun src/cli.ts run --all --headed",
    "agent-driver": "bun src/agent-claxedo-driver.ts",
    "public-agent-driver": "bun src/public-agent-app-driver.ts",
    "public-benchmark": "bun src/public-benchmark.ts",
    "report": "bun src/cli.ts report",
    "list": "bun src/cli.ts list",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./test ./src",
    "benchmark:agent-app": "bun src/agent-app-benchmark.ts",
    "check:agent-experiment": "bun src/agent-experiment-check.ts",
    "verify": "bun run typecheck && bun run test",
    "run:diagnostics": "bun src/cli.ts run --all --suite diagnostics",
    "ci:diagnostics": "bun run verify && bun run run:diagnostics",
    "catalog": "bun src/cli.ts catalog"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/bun": "1.3.12",
    "playwright-core": "1.61.1",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "agent-app-benchmark": "github:kyashrathore/agent-app-benchmark#3089047b9dfb0b04beb6fc1d9e847f4b7d4f4fed"
  }
}
