{
  "name": "@claxedo/app",
  "version": "0.0.59",
  "private": true,
  "description": "Cloud extension package for OpenCode (Claxedo)",
  "type": "module",
  "exports": {
    ".": "./src/app/entry/index.tsx",
    "./process-diagnostics-contract": "./src/features/processes/data/local-diagnostics.ts"
  },
  "scripts": {
    "typecheck": "bun run lint:theme-tokens && bun run test:architecture && tsgo -b && bun run typecheck:e2e && bun run test:performance",
    "test:architecture": "bun test ./src/architecture",
    "lint:theme-tokens": "bun run scripts/check-theme-tokens.ts",
    "lint:eager-deps": "bun run scripts/check-forbidden-eager-deps.ts",
    "check:eager-chunk": "bun run scripts/check-main-chunk-markers.ts",
    "check:eager-chunk:build": "bun run build && bun run scripts/check-main-chunk-markers.ts",
    "check:local-bundle": "bun run scripts/check-local-bundle-identity.ts",
    "check:local-bundle:build": "bun run build:local && bun run scripts/check-local-bundle-identity.ts",
    "dev": "VITE_CLAXEDO_AUTH_ADAPTER=clerk vite --config vite.cloud.config.ts",
    "dev:local": "VITE_CLAXEDO_AUTH_ADAPTER=clerk vite --config vite.local.config.ts",
    "build": "VITE_CLAXEDO_AUTH_ADAPTER=clerk node ./node_modules/vite/bin/vite.js build --config vite.cloud.config.ts",
    "build:better-auth": "VITE_AUTH_ENABLED=true VITE_CLAXEDO_AUTH_ADAPTER=better-auth node ./node_modules/vite/bin/vite.js build --config vite.cloud.config.ts --outDir dist-better-auth",
    "check:browser-auth-bundles": "bun scripts/browser-auth-bundle-identity.ts clerk dist && bun scripts/browser-auth-bundle-identity.ts better-auth dist-better-auth",
    "check:browser-auth-bundles:build": "VITE_AUTH_ENABLED=true bun run build && bun run build:better-auth && bun run check:browser-auth-bundles",
    "build:e2e": "bun ./scripts/build-e2e-app.ts",
    "build:local": "VITE_CLAXEDO_AUTH_ADAPTER=clerk node ./node_modules/vite/bin/vite.js build --config vite.local.config.ts",
    "build:demo": "CLAXEDO_BUILD_TARGET=demo VITE_CLAXEDO_AUTH_ADAPTER=clerk node ./node_modules/vite/bin/vite.js build --config vite.cloud.config.ts",
    "build:marker-control": "VITE_CLAXEDO_AUTH_ADAPTER=clerk VITE_AUTH_ENABLED=true VITE_CLERK_PUBLISHABLE_KEY=pk_test_marker_control_not_a_real_key node ./node_modules/vite/bin/vite.js build --config vite.cloud.config.ts --outDir dist-marker-control",
    "deploy:pages:staging": "wrangler pages deploy dist --project-name ${CLAXEDO_PAGES_PROJECT:-claxedo-app-staging} --branch staging",
    "serve": "VITE_CLAXEDO_AUTH_ADAPTER=clerk node ./node_modules/vite/bin/vite.js preview --config vite.cloud.config.ts",
    "serve:e2e": "bun ./scripts/serve-e2e-app.ts",
    "verify:browser-parity": "bun ./scripts/capture-browser-parity.ts",
    "verify:browser-parity:strict": "CLAXEDO_BROWSER_PARITY_REQUIRE_BASELINE=1 bun ./scripts/capture-browser-parity.ts",
    "verify:browser-parity:update-baseline": "CLAXEDO_BROWSER_PARITY_UPDATE_BASELINE=1 bun ./scripts/capture-browser-parity.ts",
    "verify:p4-named-surfaces": "bun ./scripts/capture-p4-named-surfaces.ts",
    "verify:workspace-panel-interrupt-motion": "bun ./scripts/capture-workspace-panel-interrupt-motion.ts",
    "verify:app-shell-motion": "bun ./scripts/capture-app-shell-motion.ts",
    "verify:p4-review-reconnect-motion": "bun ./scripts/capture-p4-review-reconnect-motion.ts",
    "verify:workspace-tab-motion": "bun ./scripts/capture-workspace-tab-motion.ts",
    "verify:session-switch-hot-path": "bun ./scripts/capture-session-switch-hot-path.ts",
    "verify:command-palette-file-open-motion": "bun ./scripts/capture-command-palette-file-open-motion.ts",
    "test": "mkdir -p .artifacts/unit && node ../../scripts/test-deadline.mjs bun test --conditions=browser --preload ./happydom.ts ./src --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml && vitest run --config vitest.config.ts --reporter=default --reporter=junit --outputFile.junit=.artifacts/unit/junit-vitest.xml && bun run test:deployed-acceptance",
    "test:diagnostics-release": "bun test --conditions=browser --preload ./happydom.ts ./src/features/processes/data/local-diagnostics.test.ts ./src/features/processes/ui/diagnostics/model.test.ts && vitest run --config vitest.config.ts ./src/features/processes/ui/dialog-process-diagnostics.vitest.tsx",
    "test:watch": "bun test --watch --conditions=browser --preload ./happydom.ts ./src",
    "test:performance": "bun test --conditions=browser --preload ./happydom.ts ./src/features/session/ui/message-timeline-row-reuse.test.ts && vitest run --config vitest.config.ts ./src/app/workbench/context/directory-scope.vitest.tsx ./src/app/workbench/workbench/tests/F-mount-retention.vitest.tsx ./src/app/workbench/workbench/tests/N-reactivity.vitest.tsx",
    "test:vitest": "vitest run --config vitest.config.ts",
    "test:vitest:watch": "vitest --config vitest.config.ts",
    "test:e2e": "bun run ./scripts/run-e2e-auth-matrix.ts test:e2e:core:base test:e2e:onboarding",
    "test:e2e:single": "npx playwright test --config playwright.config.ts",
    "test:e2e:all": "CLAXEDO_E2E_SUITE=all npx playwright test --config playwright.config.ts",
    "test:e2e:core": "bun run ./scripts/run-e2e-auth-matrix.ts test:e2e:core:base test:e2e:onboarding",
    "test:e2e:core:base": "VITE_CLAXEDO_SETTINGS_CONNECTIONS_ENABLED=true VITE_CLAXEDO_SETTINGS_SANDBOX_PROVIDERS_ENABLED=true CLAXEDO_E2E_SUITE=core npx playwright test --config playwright.config.ts --grep-invert \"@workgraph-real|@tier-real|@onboarding-enabled\"",
    "test:e2e:onboarding": "VITE_CLAXEDO_ONBOARDING_V1=true CLAXEDO_E2E_SUITE=core npx playwright test --config playwright.config.ts --grep \"@onboarding-enabled\"",
    "test:e2e:documents:canary": "CLAXEDO_E2E_SUITE=core PLAYWRIGHT_VIDEO=0 npx playwright test --config playwright.config.ts e2e/playwright/documents-core.spec.ts --grep @documents-release-canary --workers=1 --retries=0",
    "test:e2e:workgraph": "VITE_CLAXEDO_WORKGRAPH_NAVIGATION_ENABLED=true VITE_CLAXEDO_SETTINGS_CONNECTIONS_ENABLED=true CLAXEDO_WORKGRAPH_REAL_E2E=1 CLAXEDO_E2E_SUITE=core npx playwright test --config playwright.config.ts e2e/playwright/core-workgraph.spec.ts",
    "test:e2e:real": "CLAXEDO_TIER_REAL_E2E=1 CLAXEDO_E2E_SUITE=core npx playwright test --config playwright.config.ts e2e/playwright/real-harness-local.spec.ts",
    "test:e2e:usage": "CLAXEDO_E2E_SUITE=core npx playwright test --config playwright.config.ts e2e/playwright/core-usage-dashboard.spec.ts",
    "test:e2e:desktop": "CLAXEDO_E2E_DESKTOP=1 CLAXEDO_E2E_SUITE=core npx playwright test --config playwright.config.ts --grep @surface-desktop",
    "test:e2e:desktop:real": "CLAXEDO_TIER_REAL_E2E=1 CLAXEDO_E2E_DESKTOP=1 CLAXEDO_E2E_SUITE=core PLAYWRIGHT_SKIP_WEBSERVER=1 npx playwright test --config playwright.config.ts e2e/playwright/real-desktop-signed-cloud.spec.ts",
    "test:e2e:live": "CLAXEDO_E2E_LIVE=1 CLAXEDO_E2E_SUITE=live npx playwright test --config playwright.config.ts",
    "test:e2e:mobile": "bun run ./scripts/run-e2e-auth-matrix.ts test:e2e:mobile:mode",
    "test:e2e:mobile:mode": "CLAXEDO_E2E_SUITE=core npx playwright test --project=mobile --config playwright.config.ts --grep-invert \"@workgraph-real\"",
    "test:e2e:marketing": "CLAXEDO_E2E_SUITE=marketing npx playwright test --config playwright.config.ts",
    "test:e2e:bun": "bun test e2e/playwright/*.test.ts e2e/bun/*.test.ts",
    "test:e2e:journey": "node ./node_modules/vitest/vitest.mjs run --config vitest.journey.config.ts",
    "test:deployed-acceptance": "node ./node_modules/vitest/vitest.mjs run --config vitest.deployed-acceptance.config.ts",
    "test:e2e:video": "PLAYWRIGHT_VIDEO=1 npx playwright test --config playwright.config.ts",
    "test:e2e:core:video": "PLAYWRIGHT_VIDEO=1 bun run test:e2e:core",
    "test:e2e:all:video": "CLAXEDO_E2E_SUITE=all PLAYWRIGHT_VIDEO=1 npx playwright test --config playwright.config.ts",
    "test:e2e:deployed-workgraph": "npx playwright test --config playwright.deployed.config.ts",
    "test:e2e:deployed-cloudflare": "bun run e2e/deployed-cloudflare-acceptance.ts",
    "typecheck:e2e": "tsgo -p tsconfig.e2e.json",
    "verify:closure": "bun ../../script/product-boundary/verify.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@axe-core/playwright": "4.12.1",
    "@claxedo/workspace-runtime": "workspace:*",
    "@clerk/testing": "2.2.7",
    "@happy-dom/global-registrator": "20.0.11",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@playwright/test": "1.61.1",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "@types/better-sqlite3": "7.6.13",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.12.2",
    "@types/qrcode": "1.5.6",
    "@types/shell-quote": "1.7.5",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "@xterm/headless": "6.1.0-beta.289",
    "better-sqlite3": "13.0.1",
    "jsdom": "26.1.0",
    "msw": "2.14.6",
    "openai": "6.26.0",
    "playwright-core": "1.61.1",
    "sharp": "0.34.5",
    "typescript": "catalog:",
    "vite": "7.1.4",
    "vite-plugin-solid": "2.11.10",
    "vitest": "2.1.9",
    "wrangler": "4.114.0"
  },
  "dependencies": {
