{
  "name": "@opencode-ai/claxedo-app",
  "version": "0.0.59",
  "description": "Cloud extension package for OpenCode (Claxedo)",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./extensions": "./src/extensions/index.ts",
    "./extensions/*": "./src/extensions/*.tsx",
    "./i18n": "./src/i18n/cloud-strings.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*.ts",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./pages": "./src/pages/index.ts",
    "./pages/*": "./src/pages/*.tsx",
    "./providers": "./src/providers/index.ts",
    "./providers/*": "./src/providers/*.tsx"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "dev": "CLAXEDO_OVERRIDES=1 vite --config vite.cloud.config.ts",
    "build": "CLAXEDO_OVERRIDES=1 vite build --config vite.cloud.config.ts",
    "build:demo": "CLAXEDO_BUILD_TARGET=demo CLAXEDO_OVERRIDES=1 vite build --config vite.cloud.config.ts",
    "serve": "CLAXEDO_OVERRIDES=1 vite preview --config vite.cloud.config.ts",
    "test": "bun test --conditions=browser --preload ./happydom.ts ./src",
    "test:watch": "bun test --watch --conditions=browser --preload ./happydom.ts ./src",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:ui:watch": "vitest --config vitest.config.ts",
    "test:e2e": "npx playwright test --config playwright.config.ts",
    "test:e2e:video": "PLAYWRIGHT_VIDEO=1 npx playwright test --config playwright.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@playwright/test": "^1.57.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/shell-quote": "^1.7.5",
    "@typescript/native-preview": "catalog:",
    "@xterm/headless": "^6.0.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.57.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "msw": "^2.12.10",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.35.0",
