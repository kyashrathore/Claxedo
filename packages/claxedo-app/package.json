{
  "name": "@claxedo/app",
  "version": "0.0.59",
  "private": true,
  "description": "Claxedo desktop and web application",
  "type": "module",
  "exports": {
    "./content-security-policy": "./content-security-policy.ts"
  },
  "scripts": {
    "dev": "VITE_CLAXEDO_AUTH_ADAPTER=better-auth PORT=${PORT:-4445} vite --config vite.cloud.config.ts",
    "build": "VITE_CLAXEDO_AUTH_ADAPTER=better-auth node ./node_modules/vite/bin/vite.js build --config vite.cloud.config.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsgo --noEmit -p tsconfig.e2e.json",
    "test": "bun test --conditions browser src e2e/harness",
    "check": "bun scripts/checks/run.ts",
    "e2e": "bun ./e2e/run.ts",
    "e2e:perf-stream": "bun ./e2e/perf/run.ts",
    "test:perf-harness": "bun run --cwd perf-harness verify"
  },
  "license": "MIT",
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/sdk": "0.115.0",
    "@axe-core/playwright": "4.12.1",
    "@claxedo/workspace-runtime": "workspace:*",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.1.11",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "@types/shell-quote": "1.7.5",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "openai": "6.26.0",
    "playwright-core": "1.61.1",
    "sharp": "0.34.5",
    "tailwindcss": "4.1.11",
    "typescript": "catalog:",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "7.1.4",
    "vite-plugin-solid": "2.11.10",
    "wrangler": "4.114.0"
  },
  "dependencies": {
    "@claxedo/account-contract": "workspace:*",
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@claxedo/plugin-api": "workspace:*",
    "@claxedo/tasks": "workspace:*",
    "@claxedo/usage-contract": "workspace:*",
    "@kobalte/core": "0.13.12",
    "@opencode-ai/ui": "workspace:*",
    "@pierre/diffs": "catalog:",
    "@shikijs/stream": "catalog:",
