{
  "name": "@claxedo/app",
  "version": "0.0.59",
  "private": true,
  "description": "Cloud extension package for OpenCode (Claxedo)",
  "type": "module",
  "exports": {
    ".": "./src/app/entry/index.tsx",
    "./context": "./src/app/providers/index.ts",
    "./extensions": "./src/features/extensions/data/index.ts",
    "./extensions/*": "./src/features/extensions/data/*.tsx",
    "./i18n": "./src/platform/i18n/cloud-strings.ts",
    "./process-diagnostics-contract": "./src/features/processes/data/local-diagnostics.ts",
    "./utils/*": "./src/lib/*.ts",
    "./components": "./src/app/controls/index.ts",
    "./components/server-row": "./src/app/connection/server-row.tsx",
    "./components/dialogs/select-server": "./src/app/dialogs/select-server.tsx",
    "./pages": "./src/app/routes/index.ts"
  },
  "scripts": {
    "typecheck": "bun run lint:theme-tokens && bun run test:architecture && tsgo -b && bun run test:performance",
    "test:architecture": "bun test ./src/architecture",
    "lint:theme-tokens": "bun run scripts/check-theme-tokens.ts",
    "lint:eager-deps": "bun run scripts/check-forbidden-eager-deps.ts",
    "check:eager-chunk": "bun run scripts/check-main-chunk-markers.ts",
    "check:eager-chunk:build": "bun run build && bun run scripts/check-main-chunk-markers.ts",
    "dev": "vite --config vite.cloud.config.ts",
    "build": "node ./node_modules/vite/bin/vite.js build --config vite.cloud.config.ts",
    "build:demo": "CLAXEDO_BUILD_TARGET=demo node ./node_modules/vite/bin/vite.js build --config vite.cloud.config.ts",
    "deploy:pages:staging": "wrangler pages deploy dist --project-name ${CLAXEDO_PAGES_PROJECT:-claxedo-app-staging} --branch staging",
    "serve": "node ./node_modules/vite/bin/vite.js preview --config vite.cloud.config.ts",
    "verify:browser-parity": "bun ./scripts/capture-browser-parity.ts",
    "verify:browser-parity:strict": "CLAXEDO_BROWSER_PARITY_REQUIRE_BASELINE=1 bun ./scripts/capture-browser-parity.ts",
    "verify:browser-parity:update-baseline": "CLAXEDO_BROWSER_PARITY_UPDATE_BASELINE=1 bun ./scripts/capture-browser-parity.ts",
    "verify:p4-named-surfaces": "bun ./scripts/capture-p4-named-surfaces.ts",
    "verify:workspace-panel-interrupt-motion": "bun ./scripts/capture-workspace-panel-interrupt-motion.ts",
    "verify:app-shell-motion": "bun ./scripts/capture-app-shell-motion.ts",
    "verify:p4-review-reconnect-motion": "bun ./scripts/capture-p4-review-reconnect-motion.ts",
    "verify:workspace-tab-motion": "bun ./scripts/capture-workspace-tab-motion.ts",
    "verify:session-switch-hot-path": "bun ./scripts/capture-session-switch-hot-path.ts",
    "verify:command-palette-file-open-motion": "bun ./scripts/capture-command-palette-file-open-motion.ts",
    "test": "bun test --conditions=browser --preload ./happydom.ts ./src",
    "test:diagnostics-release": "bun test --conditions=browser --preload ./happydom.ts ./src/features/processes/data/local-diagnostics.test.ts ./src/features/processes/ui/diagnostics/model.test.ts && vitest run --config vitest.config.ts ./src/features/processes/ui/dialog-process-diagnostics.vitest.tsx",
    "test:watch": "bun test --watch --conditions=browser --preload ./happydom.ts ./src",
    "test:performance": "bun test --conditions=browser --preload ./happydom.ts ./src/features/session/ui/message-timeline-row-reuse.test.ts && vitest run --config vitest.config.ts ./src/app/workbench/context/directory-scope.vitest.tsx ./src/app/workbench/workbench/tests/F-mount-retention.vitest.tsx ./src/app/workbench/workbench/tests/N-reactivity.vitest.tsx",
    "test:vitest": "vitest run --config vitest.config.ts",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:ui:watch": "vitest --config vitest.config.ts",
    "test:e2e": "npx playwright test --config playwright.config.ts",
    "test:e2e:all": "CLAXEDO_E2E_SUITE=all npx playwright test --config playwright.config.ts",
    "test:e2e:core": "bun run test:e2e:core:base && bun run test:e2e:workgraph",
    "test:e2e:core:base": "CLAXEDO_E2E_SUITE=core npx playwright test --config playwright.config.ts --grep-invert @workgraph-real",
    "test:e2e:documents:canary": "bun run test:e2e:documents:canary:mock && bun run test:e2e:documents:canary:live",
    "test:e2e:documents:canary:mock": "CLAXEDO_E2E_SUITE=core PLAYWRIGHT_VIDEO=0 npx playwright test --config playwright.config.ts e2e/playwright/documents-core.spec.ts --grep @documents-release-canary --workers=1 --retries=0",
    "test:e2e:documents:canary:live": "CLAXEDO_E2E_SUITE=all CLAXEDO_E2E_LIVE=1 CLAXEDO_E2E_LIVE_BACKEND_PORT=3301 VITE_CLAXEDO_SERVER_URL=http://127.0.0.1:3301 PLAYWRIGHT_VIDEO=0 npx playwright test --config playwright.config.ts e2e/playwright/live-documents-core.spec.ts --grep @documents-rich-live-canary --workers=1 --retries=0",
    "test:e2e:workgraph": "CLAXEDO_WORKGRAPH_REAL_E2E=1 CLAXEDO_E2E_SUITE=core npx playwright test --config playwright.config.ts e2e/playwright/core-workgraph.spec.ts",
    "test:e2e:mobile": "npx playwright test --project=mobile --config playwright.config.ts",
    "test:e2e:bun": "bun test e2e/playwright/*.test.ts e2e/bun/*.test.ts",
    "test:e2e:video": "PLAYWRIGHT_VIDEO=1 npx playwright test --config playwright.config.ts",
    "test:e2e:core:video": "PLAYWRIGHT_VIDEO=1 bun run test:e2e:core",
    "test:e2e:all:video": "CLAXEDO_E2E_SUITE=all PLAYWRIGHT_VIDEO=1 npx playwright test --config playwright.config.ts",
    "test:e2e:deployment": "CLAXEDO_E2E_SUITE=all npx playwright test --config playwright.config.ts e2e/playwright/deployment-portability-staging.spec.ts",
    "test:e2e:deployed-workgraph": "npx playwright test --config playwright.deployed.config.ts",
    "test:e2e:deployment:video": "CLAXEDO_E2E_SUITE=all PLAYWRIGHT_VIDEO=1 npx playwright test --config playwright.config.ts e2e/playwright/deployment-portability-staging.spec.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@clerk/testing": "2.2.7",
    "@happy-dom/global-registrator": "20.0.11",
    "@modelcontextprotocol/sdk": "1.25.2",
    "@playwright/test": "1.59.1",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "@types/luxon": "3.7.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.12.2",
    "@types/qrcode": "1.5.6",
    "@types/shell-quote": "1.7.5",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "@xterm/headless": "6.1.0-beta.220",
    "jsdom": "26.1.0",
    "msw": "2.14.6",
    "playwright-core": "1.59.1",
    "sharp": "0.34.5",
    "typescript": "catalog:",
    "vite": "7.1.4",
    "vite-plugin-solid": "2.11.10",
    "vitest": "2.1.9",
    "wrangler": "4.50.0"
  },
  "dependencies": {
    "@claxedo/agent-event-runtime": "workspace:0.6.0",
    "@claxedo/workgraph": "workspace:*",
    "@clerk/clerk-js": "5.125.10",
    "@json-render/core": "0.14.1",
    "@json-render/solid": "0.14.1",
    "@kobalte/core": "0.13.11",
    "@opencode-ai/core": "workspace:*",
    "@opencode-ai/sdk": "workspace:*",
    "@opencode-ai/session-ui": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@solid-primitives/active-element": "2.1.3",
    "@solid-primitives/event-bus": "1.1.2",
    "@solid-primitives/event-listener": "2.4.5",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/media": "2.3.3",
    "@solid-primitives/resize-observer": "2.1.3",
    "@solid-primitives/storage": "4.3.3",
    "@solid-primitives/timer": "1.4.4",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.15.4",
    "@tanstack/ai": "0.28.0",
    "@tanstack/ai-client": "0.16.3",
    "@tanstack/ai-solid": "0.13.4",
    "@tanstack/query-persist-client-core": "5.90.2",
    "@tanstack/query-sync-storage-persister": "5.90.2",
    "@tanstack/solid-query": "5.91.4",
    "@tanstack/solid-virtual": "catalog:",
    "@tiptap/core": "3.23.4",
    "@tiptap/extension-code-block": "3.23.4",
    "@tiptap/extension-color": "3.23.4",
    "@tiptap/extension-highlight": "3.23.4",
    "@tiptap/extension-image": "3.23.4",
    "@tiptap/extension-link": "3.23.4",
    "@tiptap/extension-table": "3.23.4",
    "@tiptap/extension-table-cell": "3.23.4",
    "@tiptap/extension-table-header": "3.23.4",
    "@tiptap/extension-table-row": "3.23.4",
    "@tiptap/extension-task-item": "3.23.4",
    "@tiptap/extension-task-list": "3.23.4",
    "@tiptap/extension-text-style": "3.23.4",
