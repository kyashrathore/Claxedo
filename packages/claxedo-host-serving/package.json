{
  "name": "@claxedo/host-serving",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "The serving half of machine-wide remote access: one relay connection per served workspace, the surface a relayed caller may reach on this machine, and the relay-exposed workspace runtime composition a host answers with",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/claxedo-host-serving"
  },
  "exports": {
    "./serving": {
      "types": "./src/serving.ts",
      "bun": "./src/serving.ts",
      "development": "./src/serving.ts",
      "import": "./src/serving.ts",
      "default": "./src/serving.ts"
    },
    "./surface": {
      "types": "./src/surface.ts",
      "bun": "./src/surface.ts",
      "development": "./src/surface.ts",
      "import": "./src/surface.ts",
      "default": "./src/surface.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "bun": "./src/runtime.ts",
      "development": "./src/runtime.ts",
      "import": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ./node_modules/vitest/vitest.mjs run --reporter=default --reporter=junit --outputFile.junit=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "@claxedo/server-core": "workspace:*",
    "@claxedo/workspace-runtime": "workspace:*",
    "@hono/node-server": "1.19.11",
    "hono": "4.12.34"
  },
  "devDependencies": {
    "@claxedo/workspace-relay": "workspace:*",
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "1.3.13",
    "jose": "6.0.11",
    "typescript": "catalog:",
    "vitest": "2.1.9"
  }
}
