{
  "name": "@claxedo/documents",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "The Documents plugin: the workspace runtime's hydration of a session's documents and their write-back",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/claxedo-documents"
  },
  "exports": {
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "bun": "./src/runtime/index.ts",
      "development": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "mkdir -p .artifacts/unit && node ../../script/test-home/run.mjs node ../../script/test-deadline.mjs bun test src --timeout 30000 --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "@claxedo/helpers": "workspace:*",
    "@claxedo/session-core": "workspace:*",
    "hono": "4.12.34",
    "jose": "6.0.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@claxedo/workspace-runtime": "workspace:*",
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "1.3.13",
    "typescript": "catalog:"
  }
}
