{
  "name": "@claxedo/documents",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "The Documents plugin: the document port, index and history, the local repository and managed backends, the hosted R2 backend, their HTTP routes, and the workspace runtime's hydration of a session's documents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/claxedo-documents"
  },
  "exports": {
    "./host/*": {
      "types": "./src/host/*.ts",
      "bun": "./src/host/*.ts",
      "development": "./src/host/*.ts",
      "import": "./src/host/*.ts",
      "default": "./src/host/*.ts"
    },
    "./local": {
      "types": "./src/local/index.ts",
      "bun": "./src/local/index.ts",
      "development": "./src/local/index.ts",
      "import": "./src/local/index.ts",
      "default": "./src/local/index.ts"
    },
    "./hosted": {
      "types": "./src/hosted/index.ts",
      "bun": "./src/hosted/index.ts",
      "development": "./src/hosted/index.ts",
      "import": "./src/hosted/index.ts",
      "default": "./src/hosted/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "bun": "./src/runtime/index.ts",
      "development": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "bun": "./src/testing.ts",
      "development": "./src/testing.ts",
      "import": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "mkdir -p .artifacts/unit && node ../../script/test-home/run.mjs node ../../script/test-deadline.mjs bun test src --path-ignore-patterns='**/local/plugin.test*' --timeout 30000 --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml && node ../../script/test-home/run.mjs node ../../script/test-deadline.mjs bun test src/local/plugin.test.ts --timeout 30000 --reporter=junit --reporter-outfile=.artifacts/unit/junit-local-git.xml"
  },
  "dependencies": {
    "@claxedo/helpers": "workspace:*",
    "@claxedo/server-core": "workspace:*",
    "@claxedo/session-core": "workspace:*",
    "@claxedo/workspace-runtime": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "4.12.34",
    "jose": "6.0.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "1.3.13",
    "typescript": "catalog:"
  }
}
