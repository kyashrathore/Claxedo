<!-- The session timeline — same shape as the Solid 2 view: header badges, a
     scrolling row list branching on precomputed row flags, and a composer.
     Validate with: native check -->
<column>
  <row gap="8" cross="center" padding="8">
    <text overflow="ellipsis" grow="1">{title}</text>
    <badge>{connection}</badge>
  </row>
  <separator />
  <scroll grow="1">
    <column gap="8" padding="12">
      <if test="{hasRows == false}">
        <text>No messages yet — say something below.</text>
      </if>
      <for each="rows" key="id" as="r">
        <if test="{r.isUser}">
          <card><column padding="8"><text wrap="true">{r.body}</text></column></card>
        </if>
        <if test="{r.isAssistant}">
          <markdown source="{r.body}" />
        </if>
        <if test="{r.isUser == false and r.isAssistant == false}">
          <text foreground="destructive" wrap="true">{r.body}</text>
        </if>
      </for>
    </column>
  </scroll>
  <separator />
  <row gap="8" padding="8" cross="end">
    <textarea grow="1" placeholder="Ask anything..." value="{draft}" on-input="draft_input" />
    <button variant="primary" on-press="submit" disabled="{canSend == false}">Send</button>
  </row>
</column>
