{
  "name": "@claxedo/opencode-server-adapter",
  "version": "0.1.0",
  "type": "module",
  "description": "Direct HTTP/SSE AgentHarnessAdapter for an externally managed OpenCode server",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outfile dist/index.mjs --target bun --format esm --external '@claxedo/*' && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@claxedo/agent-event-runtime": "workspace:*",
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/agent-sdk-runtime": "workspace:*",
    "@claxedo/helpers": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "typescript": "catalog:"
  }
}
