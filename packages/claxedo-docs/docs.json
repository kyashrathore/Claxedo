        "pages": [
          "cli/index",
          "sdk/index",
          "ecosystem/index",
          "integrations/index"
        ]
      },
      {
        "group": "Cookbook",
        "pages": [
          "cookbook/overview",
          "cookbook/01-hello-agent",
          "cookbook/02-harness-swap",
