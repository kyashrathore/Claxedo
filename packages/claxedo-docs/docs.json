{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Claxedo",
  "colors": {
    "primary": "#171717",
    "light": "#ededed",
    "dark": "#171717"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#f8f8f8",
      "dark": "#101010"
    }
  },
  "fonts": {
    "heading": {
      "family": "Bricolage Grotesque",
      "weight": 600
    },
    "body": {
      "family": "Geist"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "guides/introduction",
          "guides/install",
          "guides/see-it-in-action"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/layer-stack",
          "concepts/sessions-turns-events",
          "concepts/workspace-host",
          "concepts/extensions",
          "concepts/credentials"
        ]
      },
      {
        "group": "Deploy",
        "pages": [
          "deploy/cloudflare-full-stack"
        ]
      },
      {
        "group": "Packages",
        "pages": [
          "packages/index",
          {
            "group": "Agent runtime",
            "pages": [
              "packages/agent-event-runtime",
              "packages/agent-sdk-runtime"
            ]
          },
          {
            "group": "Workspace & sandboxes",
            "pages": [
              "packages/workspace-runtime",
              "packages/sandbox-manager"
            ]
          },
          {
            "group": "Relay",
            "pages": [
              "packages/workspace-relay",
              "packages/workspace-relay-protocol"
            ]
          },
          {
            "group": "Capabilities",
            "pages": [
              "packages/agent-extensions",
              "packages/mcp",
              "packages/channels",
              "packages/connections"
            ]
          },
          {
            "group": "WorkGraph & wakes",
            "pages": [
              "packages/workgraph",
              "packages/wakes"
            ]
          },
          {
            "group": "Control plane",
            "pages": [
              "packages/control-plane"
            ]
          }
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api/overview",
          "api/workspace-runtime",
          "api/relay",
          "api/mcp",
          "api/connections",
          "api/channels"
        ]
      },
      {
        "group": "SDK",
        "pages": [
          "sdk/index",
          "integrations/index"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/kyashrathore/Claxedo"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try Claxedo",
      "href": "https://claxedo.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "vscode",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/kyashrathore/Claxedo"
    }
  }
}
