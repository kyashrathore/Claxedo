            "pages": [
              "packages/agent-extensions",
              "packages/mcp",
              "packages/channels",
              "packages/connections"
            ]
          },
          {
            "group": "WorkGraph & wakes",
            "pages": [
              "packages/workgraph",
              "packages/wakes"
            ]
          },
          {
            "group": "Control plane",
            "pages": [
              "packages/control-plane"
            ]
          }
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api/overview",
          "api/workspace-runtime",
          "api/relay",
          "api/mcp",
          "api/connections",
          "api/channels"
        ]
      },
      {
