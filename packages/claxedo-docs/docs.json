        "pages": [
          "index",
          "guides/introduction",
          "guides/install",
          "guides/see-it-in-action"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/layer-stack",
          "concepts/sessions-hosts",
          "concepts/connections-capabilities",
          "concepts/credentials-sandbox",
          "concepts/extensions"
        ]
      },
      {
        "group": "Deploy",
        "pages": [
          "deploy/local",
          "deploy/private-vm",
          "deploy/relay-attached",
          "deploy/hosted-control-plane",
          "deploy/self-host-fly",
          "deploy/sandbox-drivers-secrets"
