{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Claxedo",
  "colors": {
    "primary": "#201d1d",
    "light": "#fdffcc",
    "dark": "#201d1d"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
