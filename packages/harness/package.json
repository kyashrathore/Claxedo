{
  "name": "@claxedo/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./providers": {
      "development": "./src/registry/providers/index.ts",
      "bun": "./src/registry/providers/index.ts",
      "types": "./dist/registry/providers/index.d.ts",
      "import": "./dist/registry/providers/index.js"
    },
    "./compose": {
      "development": "./src/compose.ts",
      "bun": "./src/compose.ts",
      "types": "./dist/compose.d.ts",
      "import": "./dist/compose.js"
    },
    "./broker": {
      "development": "./src/broker/index.ts",
      "bun": "./src/broker/index.ts",
      "types": "./dist/broker/index.d.ts",
      "import": "./dist/broker/index.js"
    },
    "./testing": {
      "development": "./src/test-support/index.ts",
      "bun": "./src/test-support/index.ts",
      "types": "./dist/test-support/index.d.ts",
      "import": "./dist/test-support/index.js"
    },
    "./contract": {
      "development": "./src/contract/index.ts",
      "bun": "./src/contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./translate": {
      "development": "./src/translate/index.ts",
      "bun": "./src/translate/index.ts",
      "types": "./dist/translate/index.d.ts",
      "import": "./dist/translate/index.js"
    },
    "./acp/translate": {
      "development": "./src/transports/acp/translate/index.ts",
      "bun": "./src/transports/acp/translate/index.ts",
      "types": "./dist/transports/acp/translate/index.d.ts",
      "import": "./dist/transports/acp/translate/index.js"
    },
    "./claude-sdk/translate": {
      "development": "./src/transports/claude-sdk/translate/index.ts",
      "bun": "./src/transports/claude-sdk/translate/index.ts",
      "types": "./dist/transports/claude-sdk/translate/index.d.ts",
      "import": "./dist/transports/claude-sdk/translate/index.js"
    },
    "./codex-app-server/translate": {
      "development": "./src/transports/codex-app-server/translate/index.ts",
      "bun": "./src/transports/codex-app-server/translate/index.ts",
      "types": "./dist/transports/codex-app-server/translate/index.d.ts",
      "import": "./dist/transports/codex-app-server/translate/index.js"
    },
    "./cursor-sdk/translate": {
      "development": "./src/transports/cursor-sdk/translate/index.ts",
      "bun": "./src/transports/cursor-sdk/translate/index.ts",
      "types": "./dist/transports/cursor-sdk/translate/index.d.ts",
      "import": "./dist/transports/cursor-sdk/translate/index.js"
    },
    "./pi-rpc/translate": {
      "development": "./src/transports/pi-rpc/translate/index.ts",
      "bun": "./src/transports/pi-rpc/translate/index.ts",
      "types": "./dist/transports/pi-rpc/translate/index.d.ts",
      "import": "./dist/transports/pi-rpc/translate/index.js"
    },
    "./opencode-sdk": {
      "development": "./src/transports/opencode-sdk/index.ts",
      "bun": "./src/transports/opencode-sdk/index.ts",
      "types": "./dist/transports/opencode-sdk/index.d.ts",
      "import": "./dist/transports/opencode-sdk/index.js"
    },
    "./opencode-sdk/*": {
      "development": "./src/transports/opencode-sdk/*.ts",
      "bun": "./src/transports/opencode-sdk/*.ts",
      "types": "./dist/transports/opencode-sdk/*.d.ts",
      "import": "./dist/transports/opencode-sdk/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run generate:codex-protocol && tsc -p tsconfig.build.json",
    "typecheck": "bun run generate:codex-protocol && tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "check": "bun scripts/check.ts",
    "test": "bun run check && bun test src scripts e2e/harness",
    "flows": "bun e2e/flows/run.ts",
    "corpus": "bun e2e/harness/corpus.ts",
    "generate:codex-protocol": "bun scripts/generate-codex-protocol.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@claxedo/agent-event-runtime": "workspace:*",
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@cursor/sdk": "1.0.24",
    "@opencode-ai/plugin": "0.0.0-beta-19271",
    "@opencode-ai/schema": "0.0.0-beta-19271",
    "@opencode-ai/sdk": "0.0.0-beta-19271"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@claxedo/sandbox-manager": "workspace:*",
    "@openai/codex": "0.156.1",
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "openai": "6.26.0",
    "typescript": "catalog:",
    "typescript-5": "npm:typescript@5.9.3"
  }
}
