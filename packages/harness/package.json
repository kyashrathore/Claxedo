{
  "name": "@claxedo/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./contract": {
      "development": "./src/contract/index.ts",
      "bun": "./src/contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "check": "bun scripts/check.ts",
    "test": "bun run check && bun test src scripts e2e/harness",
    "flows": "bun e2e/flows/run.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@claxedo/agent-event-runtime": "workspace:*",
    "@claxedo/agent-runtime-contract": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@claxedo/helpers": "workspace:*",
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "openai": "6.26.0",
    "typescript": "catalog:",
    "typescript-5": "npm:typescript@5.9.3"
  }
}
