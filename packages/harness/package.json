{
  "name": "@claxedo/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./broker": {
      "development": "./src/broker/index.ts",
      "bun": "./src/broker/index.ts",
      "types": "./dist/broker/index.d.ts",
      "import": "./dist/broker/index.js"
    },
    "./broker/test-support/port-cases": {
      "development": "./src/broker/test-support/port-cases.ts",
      "bun": "./src/broker/test-support/port-cases.ts",
      "types": "./dist/broker/test-support/port-cases.d.ts",
      "import": "./dist/broker/test-support/port-cases.js"
    },
    "./broker/test-support/behavior-cases": {
      "development": "./src/broker/test-support/behavior-cases.ts",
      "bun": "./src/broker/test-support/behavior-cases.ts",
      "types": "./dist/broker/test-support/behavior-cases.d.ts",
      "import": "./dist/broker/test-support/behavior-cases.js"
    },
    "./conformance/test-support/memory-ports": {
      "development": "./src/conformance/test-support/memory-ports.ts",
      "bun": "./src/conformance/test-support/memory-ports.ts",
      "types": "./dist/conformance/test-support/memory-ports.d.ts",
      "import": "./dist/conformance/test-support/memory-ports.js"
    },
    "./contract": {
      "development": "./src/contract/index.ts",
      "bun": "./src/contract/index.ts",
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./opencode-sdk": {
      "development": "./src/transports/opencode-sdk/index.ts",
      "bun": "./src/transports/opencode-sdk/index.ts",
      "types": "./dist/transports/opencode-sdk/index.d.ts",
      "import": "./dist/transports/opencode-sdk/index.js"
    },
    "./opencode-sdk/*": {
      "development": "./src/transports/opencode-sdk/*.ts",
      "bun": "./src/transports/opencode-sdk/*.ts",
      "types": "./dist/transports/opencode-sdk/*.d.ts",
      "import": "./dist/transports/opencode-sdk/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "check": "bun scripts/check.ts",
    "test": "bun run check && bun test src scripts e2e/harness",
    "flows": "bun e2e/flows/run.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@claxedo/agent-event-runtime": "workspace:*",
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@cursor/sdk": "1.0.24",
    "@opencode-ai/plugin": "0.0.0-beta-19271",
    "@opencode-ai/schema": "0.0.0-beta-19271",
    "@opencode-ai/sdk": "0.0.0-beta-19271"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@claxedo/sandbox-manager": "workspace:*",
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "openai": "6.26.0",
    "typescript": "catalog:",
    "typescript-5": "npm:typescript@5.9.3"
  }
}
