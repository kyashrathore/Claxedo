{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "lib": ["ESNext"],
    "types": ["bun"]
  },
  "include": ["src"]
}
