{
  "name": "@claxedo/channels",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Channel ingress for agent sessions: route GitHub, Slack, Telegram, Discord, and WhatsApp messages into Claxedo runtimes with dedup, session resolution, and approval bridging",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/claxedo-channels"
  },
  "keywords": [
    "claxedo",
    "agents",
    "channels",
    "webhooks",
    "chatops"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.mjs",
      "development": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ./node_modules/vitest/vitest.mjs run --reporter=default --reporter=junit --outputFile.junit=.artifacts/unit/junit.xml"
  },
  "dependencies": {
    "@chat-adapter/discord": "4.32.0",
    "@chat-adapter/github": "4.32.0",
    "@chat-adapter/slack": "4.32.0",
    "@chat-adapter/telegram": "4.32.0",
    "@chat-adapter/whatsapp": "4.32.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "chat": "4.32.0",
    "hono": "4.10.7"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "1.3.13",
    "typescript": "catalog:",
    "vitest": "2.1.9"
  }
}
