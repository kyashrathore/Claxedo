{
  "name": "@claxedo/server-core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Server-side primitives shared by the desktop-local and hosted Claxedo products: logging, data paths, the in-process event bus, and lazy initialization",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/claxedo-server-core"
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "bun": "./src/*.ts",
      "development": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ./node_modules/vitest/vitest.mjs run --reporter=default"
  },
  "devDependencies": {
    "@hono/node-server": "1.19.11",
    "@tsconfig/node-lts": "22.0.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.13",
    "typescript": "catalog:",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@claxedo/agent-event-runtime": "workspace:0.7.0",
    "@claxedo/agent-extensions": "workspace:0.7.0",
    "@claxedo/agent-sdk-runtime": "workspace:*",
    "@claxedo/sandbox-contract": "workspace:0.7.0",
    "@claxedo/usage-contract": "workspace:0.7.0",
    "@claxedo/workspace-relay": "workspace:0.7.0",
    "@claxedo/workspace-relay-protocol": "workspace:0.7.0",
    "@claxedo/workspace-runtime": "workspace:*",
    "@opencode-ai/sdk-next": "workspace:*",
    "better-sqlite3": "13.0.1",
    "drizzle-orm": "catalog:",
    "hono": "4.10.7",
    "jose": "6.2.4",
    "opencode": "workspace:*",
    "tokentracker-cli": "0.91.0"
  }
}
