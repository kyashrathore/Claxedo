{
  "name": "@claxedo/agent-runtime-contract",
  "version": "0.1.0",
  "type": "module",
  "description": "Dependency-free canonical contracts for Claxedo agent sessions, content, execution, errors, and events",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=browser --format=esm --outfile=dist/index.mjs && tsc -p tsconfig.build.json",
    "test:node": "node --test scripts/package.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "typescript": "catalog:"
  }
}
