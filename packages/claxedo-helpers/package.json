{
  "name": "@claxedo/helpers",
  "version": "0.1.0",
  "type": "module",
  "description": "Canonical small helpers shared across the workspace, one owner per behaviour",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyashrathore/Claxedo.git",
    "directory": "packages/claxedo-helpers"
  },
  "keywords": [
    "claxedo",
    "helpers",
    "guards",
    "utilities"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./guards": {
      "development": "./src/guards.ts",
      "bun": "./src/guards.ts",
      "types": "./dist/guards.d.ts",
      "import": "./dist/guards.mjs",
      "default": "./dist/guards.mjs"
    },
    "./string": {
      "development": "./src/string.ts",
      "bun": "./src/string.ts",
      "types": "./dist/string.d.ts",
      "import": "./dist/string.mjs",
      "default": "./dist/string.mjs"
    },
    "./fs": {
      "development": "./src/fs.ts",
      "bun": "./src/fs.ts",
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.mjs",
      "default": "./dist/fs.mjs"
    },
    "./path": {
      "development": "./src/path.ts",
      "bun": "./src/path.ts",
      "types": "./dist/path.d.ts",
      "import": "./dist/path.mjs",
      "default": "./dist/path.mjs"
    },
    "./process": {
      "development": "./src/process.ts",
      "bun": "./src/process.ts",
      "types": "./dist/process.d.ts",
      "import": "./dist/process.mjs",
      "default": "./dist/process.mjs"
    },
    "./net": {
      "development": "./src/net.ts",
      "bun": "./src/net.ts",
      "types": "./dist/net.d.ts",
      "import": "./dist/net.mjs",
      "default": "./dist/net.mjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "22.0.4",
    "@types/bun": "1.3.13",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
