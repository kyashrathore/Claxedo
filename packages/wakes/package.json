{
  "name": "@claxedo/wakes",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "typecheck": "bun x tsc --noEmit -p tsconfig.src.json",
    "typecheck:src": "bun x tsc --noEmit -p tsconfig.src.json",
    "typecheck:test": "bun x tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "typescript": "5.8.2",
    "vitest": "2.1.9",
    "@types/bun": "catalog:"
  },
  "description": "Resume an idle agent session from an out-of-band trigger — a durable wake fired by time, an external event, or an authorized approval.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ]
}
