{
  "name": "@claxedo/session-core",
  "version": "0.10.0",
  "type": "module",
  "description": "Runtime-neutral session storage, orchestration, projection and routes behind host ports",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./access-policy": {
      "development": "./src/session-access-policy.ts",
      "bun": "./src/session-access-policy.ts",
      "types": "./dist/session-access-policy.d.ts",
      "import": "./dist/access-policy.mjs",
      "default": "./dist/access-policy.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=browser --format=esm --packages=external --outfile=dist/index.mjs && bun build src/session-access-policy.ts --target=browser --format=esm --packages=external --outfile=dist/access-policy.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@claxedo/agent-runtime-contract": "workspace:*",
    "@claxedo/harness": "workspace:*",
    "@claxedo/helpers": "workspace:*",
    "@claxedo/workspace-relay-protocol": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "@claxedo/process-ownership": "workspace:*"
  }
}
