{
  "name": "@claxedo/plugin-tasks",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Tasks and presets over today's Tasks API, as a Claxedo app plugin",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "claxedo": {
    "id": "tasks",
    "name": "Tasks",
    "app": "./src/index.ts",
    "requires": ["tasks"],
    "routes": ["/api/claxedo/tasks"],
    "operations": []
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@claxedo/plugin-api": "workspace:*",
    "@claxedo/tasks": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "22.0.4",
    "solid-js": "1.9.12",
    "typescript": "catalog:"
  }
}
