#!/usr/bin/env bash
# Crabbox wrapper: loads Hetzner credentials and pins the pre-baked snapshot.
#
# crabbox reads HETZNER_TOKEN only from the process environment (no dotenv
# support), and the Hetzner snapshot image can only be overridden via the
# CRABBOX_HETZNER_IMAGE env var — neither is settable in .crabbox.yaml.
#
# Usage:
#   ./script/cbx warmup                       # lease a warm box, prints its slug
#   ./script/cbx run --id <slug> -- bun test  # reuse warm box (diff sync)
#   ./script/cbx stop <slug>                  # tear down when done
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

ENV_FILE="$ROOT/packages/claxedo-server/.env"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

# bun-ci-base-v3 snapshot (Hetzner image ID 412360550):
# ubuntu 26.04 + bun 1.3.14 + node 22 + python3 + umask 022 in bashrc +
# npx->bunx shim + playwright chromium (os-release spoofed to 24.04 for it) +
# warm bun install cache. Refresh with ./script/cbx-rebake.
export CRABBOX_HETZNER_IMAGE="${CRABBOX_HETZNER_IMAGE:-412360550}"

exec crabbox "$@"
