+/** Checked after the measured start so its round trip stays outside the clock. */
+async function requireLinuxBenchmarkWindow(page: BenchmarkPage) {
+  const facts = readRecord(await page.evaluate(() => ({
+    width: innerWidth,
+    height: innerHeight,
+    scale: devicePixelRatio,
+    dark: matchMedia("(prefers-color-scheme: dark)").matches,
+    screenX,
+    screenY,
+  })));
+  if (
+    facts.width !== LINUX_AGENT_APP_WINDOW.width ||
+    facts.height !== LINUX_AGENT_APP_WINDOW.viewportHeight ||
+    facts.scale !== LINUX_AGENT_APP_WINDOW.deviceScaleFactor ||
+    facts.dark !== true ||
+    facts.screenX !== 0 ||
+    facts.screenY !== 0
+  ) {
+    throw new Error(`Claxedo's window is not the Linux benchmark window: ${JSON.stringify(facts)}`);
+  }
+}
