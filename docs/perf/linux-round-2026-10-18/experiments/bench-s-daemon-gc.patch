From 22cfc76cfe044f83f56b7dc00af2d0fa53d75a14 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 21:29:55 +0000
Subject: [PATCH] The desktop daemon no longer runs a full garbage collection
 synchronously at the end of its entry's evaluation, which sat after the
 server asked to listen and before the listening callback that sends main the
 ready message the renderer waits on, and leaves the release of the bundle's
 evaluation garbage to the collection it already schedules one second later.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QtZVtcNTgBwKhSN8i2v1w2
---
 packages/claxedo-desktop/src/server/entry.ts | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/packages/claxedo-desktop/src/server/entry.ts b/packages/claxedo-desktop/src/server/entry.ts
index 8c6157b9..bd4b463f 100644
--- a/packages/claxedo-desktop/src/server/entry.ts
+++ b/packages/claxedo-desktop/src/server/entry.ts
@@ -216,8 +216,9 @@ function publishIdentity(identity: CreationIdentity | undefined) {
 
 // Bundle evaluation creates a large temporary object graph. The long-lived
 // server does not need it, so release it promptly instead of waiting for
-// machine-wide memory pressure to force a major collection.
-;(globalThis as typeof globalThis & { gc?: () => void }).gc?.()
+// machine-wide memory pressure to force a major collection. Not in this task:
+// it runs after `startLocalServer` asked to listen and before the listening
+// callback that sends main the ready message, which the renderer waits on.
 setTimeout(() => {
   ;(globalThis as typeof globalThis & { gc?: () => void }).gc?.()
 }, 1_000).unref()
-- 
