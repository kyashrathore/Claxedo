+const PREVIEW_SOURCE_LINES = 10
+const PREVIEW_CHARACTERS = 4096
+
+export function foldedPreviewLength(text: string): number {
+  let end = 0
+  for (let line = 0; line < PREVIEW_SOURCE_LINES; line++) {
+    const newline = text.indexOf("\n", end)
+    if (newline === -1) return Math.min(text.length, PREVIEW_CHARACTERS)
+    end = newline + 1
+  }
+  return Math.min(end, PREVIEW_CHARACTERS)
+}
