+/// <reference types="bun" />
+import { expect, test } from "bun:test"
+import { foldedPreviewLength } from "./folded-user-message-body"
+
+test("a folded plain prompt keeps ten source lines, so it still overflows the eight-line preview", () => {
+  const lines = Array.from({ length: 1_011 }, (_, index) => `Review fixture_${index} and implement the next improvement.`)
+  const text = lines.join("\n")
+  expect(text.slice(0, foldedPreviewLength(text))).toBe(`${lines.slice(0, 10).join("\n")}\n`)
+})
+
+test("a folded prompt with few long lines keeps 4,096 characters", () => {
+  const text = "word ".repeat(10_000)
+  expect(foldedPreviewLength(text)).toBe(4_096)
+})
+
+test("a short prompt is kept whole", () => {
+  const text = "one\ntwo\nthree"
+  expect(foldedPreviewLength(text)).toBe(text.length)
+})
