+export function sameOrder(previous: readonly SessionLocation[], next: readonly SessionLocation[]): boolean {
+  return previous.length === next.length && previous.every((ref, index) => {
+    const other = next[index]
+    return other !== undefined && ref.sessionId === other.sessionId && ref.projectId === other.projectId && ref.placementId === other.placementId
+  })
