index 00000000..51a69f52
--- /dev/null
+++ b/packages/claxedo-app/src/session/list/order.test.ts
@@ -0,0 +1,51 @@
+/// <reference types="bun" />
+import { expect, test } from "bun:test"
+import { createRoot } from "solid-js"
+import { placementId, projectId, sessionId, type Placement, type Server, type SessionRow } from "@/server"
+import type { RequestsInternal } from "../requests/store"
+import { createSessionList } from "./store"
+
+const PLACEMENT = { id: placementId("ws_alpha"), projectId: projectId("prj_alpha"), kind: "cloud", reachable: true, onThisMachine: false } as unknown as Placement
+const row = (id: string, lastHumanTurnAt: number): SessionRow => ({ ref: { projectId: projectId("prj_alpha"), placementId: placementId("ws_alpha"), sessionId: sessionId(id) }, title: id, createdAt: 1, updatedAt: 1, lastHumanTurnAt })
+
+const settled = () => new Promise((resolve) => setTimeout(resolve, 0))
+
+function liveList(rows: readonly SessionRow[]) {
+  const server = {
+    placements: { list: () => [PLACEMENT], load: async () => [PLACEMENT], byId: () => PLACEMENT },
+    sessions: { list: async () => ({ rows, statuses: new Map(), readers: new Map(), nextAfter: undefined }) },
+  } as unknown as Server
+  const requests = { openBySession: () => new Map() } as unknown as RequestsInternal
+  return createSessionList(server, requests, { showSettled: () => false, activityShown: () => false })
+}
+
+test("re-reading a row that keeps its place keeps the order the rail and timelines hold, while the row's view takes the new title", async () => {
+  await createRoot(async (dispose) => {
+    const older = row("ses_older", 10)
+    const newer = row("ses_newer", 20)
+    const list = liveList([newer, older])
+    list.start()
+    await settled()
+    const before = list.order()
+    expect(before.map((ref) => ref.sessionId)).toEqual([newer.ref.sessionId, older.ref.sessionId])
+    list.readRow({ ...older, ref: { ...older.ref }, title: "renamed" })
+    expect(list.order()).toBe(before)
+    expect(list.view(older.ref.sessionId)?.title).toBe("renamed")
+    dispose()
+  })
+})
+
+test("re-reading a row that moves ahead gives the list a new order", async () => {
+  await createRoot(async (dispose) => {
+    const older = row("ses_older", 10)
+    const newer = row("ses_newer", 20)
+    const list = liveList([newer, older])
+    list.start()
+    await settled()
+    const before = list.order()
+    list.readRow({ ...older, lastHumanTurnAt: 30 })
+    expect(list.order()).not.toBe(before)
+    expect(list.order().map((ref) => ref.sessionId)).toEqual([older.ref.sessionId, newer.ref.sessionId])
+    dispose()
+  })
+})
