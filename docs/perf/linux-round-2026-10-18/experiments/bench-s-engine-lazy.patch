From d74f4f52194a6c7416df1b00b19acd8fd092f72a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 22:21:19 +0000
Subject: [PATCH] Opening an OpenCode session no longer boots the embedded
 engine: a capabilities read with neither an attached session nor a draft,
 which is what the open view's todos and goal facts make for an unattached
 session, returns OpenCode's declared facts with no models instead of listing
 the engine's unbound catalog, so the engine starts with the session's first
 Start, attach or catalog read that needs it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QtZVtcNTgBwKhSN8i2v1w2
---
 packages/harness/src/conformance/opencode.test.ts         | 2 +-
 packages/harness/src/transports/opencode-sdk/README.md    | 2 +-
 packages/harness/src/transports/opencode-sdk/transport.ts | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/packages/harness/src/conformance/opencode.test.ts b/packages/harness/src/conformance/opencode.test.ts
index 57c449b5..a64b6875 100644
--- a/packages/harness/src/conformance/opencode.test.ts
+++ b/packages/harness/src/conformance/opencode.test.ts
@@ -669,7 +669,7 @@ test("capabilities report each model's effort variants, and accept only those",
     makeTransport: (services, state) => transport(services, state as OpenCodeBackend, {
       provider: { proof: proofProvider({}, { proof: { ...PROOF_MODEL, variants }, plain: { ...PROOF_MODEL, name: "Plain" } }) } }) })
   try {
-    const capabilities = await context.transport.capabilities({ directory: context.backend.directory })
+    const capabilities = await context.transport.capabilities({ directory: context.backend.directory, sessionId: context.session.binding.sessionId })
     expect(capabilities.effortLevels.status).toBe("resolved")
     expect(harnessEffortVerdict(capabilities.effortLevels, "proof", "high")).toBe("accepted")
     expect(harnessEffortVerdict(capabilities.effortLevels, "proof", "max")).toBe("refused")
diff --git a/packages/harness/src/transports/opencode-sdk/README.md b/packages/harness/src/transports/opencode-sdk/README.md
index 2765570b..24ec91f7 100644
--- a/packages/harness/src/transports/opencode-sdk/README.md
+++ b/packages/harness/src/transports/opencode-sdk/README.md
@@ -14,7 +14,7 @@ The host retains one event pump. Browser subscribers receive its fan-out through
 
 Event delivery is at least once after consumer acceptance. Events with both `durable.aggregateID` and `durable.seq` have an ordered per-aggregate position for checkpoints and downstream idempotency. Other events, including text deltas and usage updates, may be lost, duplicated or reordered during reconnect. They are invalidation hints: consumers re-read a snapshot rather than accumulate their payloads. In particular, turn usage closes by comparing the engine's session total before and after the turn, with a deadline, because step events can be missed. Recorded step usage keeps its durable identity. A failed total read yields a diagnostic without holding the turn. Consumers must be cheap and must not throw; a throwing consumer degrades health and is logged without killing the only pump. Stream loss degrades health and reconnects; a waiting turn asks the SDK for completion, then reads the authoritative session outcome. A broker abort interrupts the engine once, because the engine would otherwise keep running the prompt and billing it, then waits a bounded 5 s for the session to go idle and reads the outcome. The snapshot's outcome is mapped by the same translator as the terminal event, so a failed outcome is the harness's own error event in one shape; after the transport's own abort an `interrupted` outcome ends the turn as `cancelled`, because the engine also reports `interrupted` when it stops a turn itself, as it does after a denied permission, and only the abort is the person's stop. A snapshot without a terminal outcome is never turned into an `error` event: after an abort the turn ends with no event, and after stream loss it throws, because the contract reserves `error` events for the harness's reported outcome. A turn's variant is the resolved `turn.effort`, never the stored session config, which the host has already folded into that value.
 
-The catalog port fails on an unavailable engine rather than fabricating an empty list that the UI would treat as a real empty workspace. A capabilities read for a session lists that session's models; one with no session lists the models of the draft it carries, read as the provider catalog is, with the draft owner's accounts bound first, because the engine lists a vendor's models only once a binding enables that vendor and a Start checks its model against this list before any session exists; one with neither lists the engine's unbound catalog. A config options preview marks the model supplied by the caller as the select's current value so the contract can derive `resolvedModel`. The host supplies the current runtime-owned session model, or an explicitly requested preview model; draft previews use `draft.model`. An omitted model never resurrects the attachment's older config. Session config patches use the shared `applySessionConfigUpdate` contract. Its model list describes what the running host can execute, including effort variants and pricing tiers; The provider catalog operation, which only the workspace owner reaches and which never makes its caller the engine's owner, lists every integration the engine discovers, whether its provider is active, and the models it runs; Settings reads its connection rows from it. Location-scoped SDK lists return `{ location, data }`, so the port reads `data` explicitly.
+The catalog port fails on an unavailable engine rather than fabricating an empty list that the UI would treat as a real empty workspace. A capabilities read for a session lists that session's models; one with no session lists the models of the draft it carries, read as the provider catalog is, with the draft owner's accounts bound first, because the engine lists a vendor's models only once a binding enables that vendor and a Start checks its model against this list before any session exists; one with neither, such as the todos and goal facts of opening an unattached session, gets the declared facts with no models and never boots the engine. A config options preview marks the model supplied by the caller as the select's current value so the contract can derive `resolvedModel`. The host supplies the current runtime-owned session model, or an explicitly requested preview model; draft previews use `draft.model`. An omitted model never resurrects the attachment's older config. Session config patches use the shared `applySessionConfigUpdate` contract. Its model list describes what the running host can execute, including effort variants and pricing tiers; The provider catalog operation, which only the workspace owner reaches and which never makes its caller the engine's owner, lists every integration the engine discovers, whether its provider is active, and the models it runs; Settings reads its connection rows from it. Location-scoped SDK lists return `{ location, data }`, so the port reads `data` explicitly.
 
 The engine runs on the models.dev snapshot bundled with the pinned SDK: the host boots it with `models: { fetch: false }`, which turns off its fetch at start and every 5 minutes, so the models it lists change only with the engine version. `bundled-models.generated.ts` is that list for each vendor Claxedo brokers to, read from the engine with every vendor bound as a draft binds it; `bun run generate:opencode-models`, which the build runs, rewrites it, and a test fails when the installed engine is not the one it names. `openCodeBundledModels` serves it to the control plane, which lists a cloud preset's models before any workspace runs; a Start then reads the same list from the engine, which the conformance suite holds equal. A ChatGPT plan's models are read from the plan at run time, so that list has none of them. An engine database that already holds a fetched catalog keeps answering from it, because the engine reads its cache ahead of the snapshot.
 
diff --git a/packages/harness/src/transports/opencode-sdk/transport.ts b/packages/harness/src/transports/opencode-sdk/transport.ts
index 19e13fe4..a0ff0552 100644
--- a/packages/harness/src/transports/opencode-sdk/transport.ts
+++ b/packages/harness/src/transports/opencode-sdk/transport.ts
@@ -149,7 +149,7 @@ export class OpenCodeSdkTransport implements HarnessTransport {
     const entry = context.sessionId ? this.entries.get(context.sessionId) : undefined
     if (entry) return openCodeCapabilities(await this.runtime.catalog.models(entry.scope))
     if (context.draft) return openCodeCapabilities(await this.readAsDraft(context.draft, (scope) => this.runtime.catalog.models(scope)))
-    return openCodeCapabilities(await this.runtime.catalog.models(catalogScope(context.directory)))
+    return openCodeCapabilities([])
   }
 
   async prepare(directory: string) {
