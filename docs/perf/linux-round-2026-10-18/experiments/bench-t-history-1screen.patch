 packages/agent-runtime-contract/src/turn-page.ts   |  9 ++++++---
 .../session-core/src/routes/session-core.test.ts   |  4 ++--
 3 files changed, 18 insertions(+), 9 deletions(-)

diff --git a/packages/agent-runtime-contract/src/turn-page.test.ts b/packages/agent-runtime-contract/src/turn-page.test.ts
index ad1ec06b..4f3da88a 100644
--- a/packages/agent-runtime-contract/src/turn-page.test.ts
+++ b/packages/agent-runtime-contract/src/turn-page.test.ts
@@ -157,13 +157,19 @@ describe("estimateTurnLines", () => {
 })
 
 describe("readTurnPage", () => {
-  test("walks back from the newest turn until the estimate covers the viewport and two more screens", async () => {
+  test("a cold read walks back from the newest turn until the estimate covers the viewport", async () => {
     const turns = Array.from({ length: 10 }, (_, index) => workedTurn(`Prompt ${index}`, `Answer ${index}.`))
     const reader = turnReader(turns)
     const page = await readTurnPage(reader.read, viewport(10))
-    expect(page.turns.map((turn) => drawnTexts(turn)[0])).toEqual(["Prompt 5", "Prompt 6", "Prompt 7", "Prompt 8", "Prompt 9"])
-    expect(page.turns.map((turn) => turn.cursor)).toEqual(["cursor-5", "cursor-6", "cursor-7", "cursor-8", "cursor-9"])
-    expect(reader.calls).toEqual([undefined, "cursor-9", "cursor-8", "cursor-7", "cursor-6"])
+    expect(page.turns.map((turn) => drawnTexts(turn)[0])).toEqual(["Prompt 8", "Prompt 9"])
+    expect(page.turns.map((turn) => turn.cursor)).toEqual(["cursor-8", "cursor-9"])
+    expect(reader.calls).toEqual([undefined, "cursor-9"])
+  })
+
+  test("an older read walks back until the estimate covers the viewport and two more screens", async () => {
+    const turns = Array.from({ length: 12 }, (_, index) => workedTurn(`Prompt ${index}`, `Answer ${index}.`))
+    const page = await readTurnPage(turnReader(turns).read, { ...viewport(10), before: "cursor-11" })
+    expect(page.turns.map((turn) => drawnTexts(turn)[0])).toEqual(["Prompt 6", "Prompt 7", "Prompt 8", "Prompt 9", "Prompt 10"])
   })
 
   test("a session shorter than the fill is read whole, and its first turn carries no cursor", async () => {
diff --git a/packages/agent-runtime-contract/src/turn-page.ts b/packages/agent-runtime-contract/src/turn-page.ts
