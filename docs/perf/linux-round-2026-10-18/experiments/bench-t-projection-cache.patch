+test("a remounted completed body reuses its projection only while its text is unchanged", () => {
+  const first = project(undefined, texts[0]!, false, "part-remount")
+  expect(project(undefined, texts[0]!, false, "part-remount")).toBe(first)
+  const edited = project(undefined, `${texts[0]!} edited`, false, "part-remount")
+  expect(edited).not.toBe(first)
+  expect(edited.text).toBe(`${texts[0]!} edited`)
+  expect(project(undefined, texts[0]!, false)).not.toBe(project(undefined, texts[0]!, false))
+  expect(project(undefined, texts[0]!, true, "part-remount")).not.toBe(project(undefined, texts[0]!, true, "part-remount"))
+})
