 ## Why the rail and gutter work this way
 
-- The rail shows once the transcript has more than ten turns (`messageNavVisible`) and the pane fits the column plus a 60 px gutter on each side (`messageNavFits`). It mounts after the first reveal, in the frame its gutter first shows, so it appears with the rows that brought it.
+- The rail shows once the transcript has more than ten turns (`messageNavVisible`) and the pane fits the column plus a 60 px gutter on each side (`messageNavFits`). It mounts in the task after the first reveal's frame paints (`createMessageNavMount`, through the workbench's `afterNextPaint`), so building one item per turn of the outline is not part of the switch's first frame; the gutter it needs is decided before that frame paints (below), so the rows paint in their final place and the rail joins them one frame later.
 - The compact rail reaches 48 px into the pane (`left-3` plus its 36 px width); the gutter reserves 60 px so every row, including a wide table or diagram, has 12 px after it. The gutter pads both sides, so the column keeps its width and centre and the transcript does not shift.
 - The gutter is keyed off `data-session-timeline-nav-gutter` on the timeline root (`timeline-viewport.css`), set from the same memo that mounts the rail, never a `:has()` on the rail's own element. A `:has()` makes its subject a Blink invalidation anchor, and the timeline is the most mutated subtree in the app; no `:has()` may have an ancestor of the timeline as its subject.
 - The gutter is decided before first paint by the ResizeObserver alone (`createMessageNavRoom`): its first callback runs after the frame's layout and before that frame paints, and a flip after paint would shift the whole column and restart every pending paint-stability wait. A width read when the timeline mounts would force the new pane's whole layout inside the switch task.
diff --git a/packages/claxedo-app/src/session/view/timeline/message-nav-layout.ts b/packages/claxedo-app/src/session/view/timeline/message-nav-layout.ts
index 5295fe89..3d3a6d6c 100644
--- a/packages/claxedo-app/src/session/view/timeline/message-nav-layout.ts
+++ b/packages/claxedo-app/src/session/view/timeline/message-nav-layout.ts
@@ -1,5 +1,6 @@
-import { createSignal, onCleanup, type Accessor } from "solid-js"
+import { createEffect, createMemo, createSignal, onCleanup, untrack, type Accessor } from "solid-js"
 import { createResizeObserver } from "@solid-primitives/resize-observer"
+import { afterNextPaint } from "@/workbench"
 
 const WIDE_VIEWPORT_MIN_WIDTH = 1536
 const COMPACT_NAV_SAFE_GUTTER = 60
@@ -22,3 +23,12 @@ export function createMessageNavRoom(root: Accessor<HTMLElement | undefined>) {
   onCleanup(() => window.removeEventListener("resize", update))
   return hasRoom
 }
+
+export function createMessageNavMount(input: { active: Accessor<boolean>; revealed: Accessor<boolean>; gutterVisible: Accessor<boolean> }) {
+  const [revealPainted, setRevealPainted] = createSignal(false)
+  createEffect(() => {
+    if (!input.revealed() || untrack(revealPainted)) return
+    onCleanup(afterNextPaint(() => setRevealPainted(true)))
+  })
+  return createMemo<boolean>((mounted) => mounted || (input.active() && revealPainted() && input.gutterVisible()), false)
+}
