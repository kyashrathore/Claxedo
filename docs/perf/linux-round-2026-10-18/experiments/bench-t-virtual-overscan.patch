From fa69e86e606418da9d22634992959b93a74030cd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 21:33:25 +0000
Subject: [PATCH] A timeline's first view renders no overscan rows until the
 reader's first wheel, touch or pointer press raises the band to 6, so opening
 or returning to a session at its latest turn mounts only the rows on screen
 and no longer lays out the off-screen row above a tall reply, which in the
 benchmark's long rows is a 131 KB prompt.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QtZVtcNTgBwKhSN8i2v1w2
---
 packages/claxedo-app/src/session/view/timeline/README.md        | 2 +-
 .../claxedo-app/src/session/view/timeline/message-timeline.tsx  | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/packages/claxedo-app/src/session/view/timeline/README.md b/packages/claxedo-app/src/session/view/timeline/README.md
index 1a343b14..1585c780 100644
--- a/packages/claxedo-app/src/session/view/timeline/README.md
+++ b/packages/claxedo-app/src/session/view/timeline/README.md
@@ -88,7 +88,7 @@ The row builder is `Timeline.constructMessageRows` (`message-timeline.data.ts`);
 
 ## Why scrolling works this way
 
-- Overscan is 1 row until the reader's first wheel, touch or pointer press, then 6: 6 rows leave no blank band on a 1,400 px/frame flick, and 12 rows still left 443 px blank at 5,600 px/frame while doubling the worst renderer task (16 to 31 ms).
+- Overscan is 0 rows until the reader's first wheel, touch or pointer press, then 6. A first view mounts only the rows it shows: the row above a tall reply is often the turn's prompt, which can be as long as the reply (131 KB in the agent-app-benchmark's long rows) and would be laid out with nothing of it on screen. Rows that mount above the visible range later are compensated by the resize anchor, so the first upward scroll does not move the reader. 6 rows leave no blank band on a 1,400 px/frame flick, and 12 rows still left 443 px blank at 5,600 px/frame while doubling the worst renderer task (16 to 31 ms).
 - Opening at the end and staying at the end are different promises. `shouldAnchorBottom` opens a session on its latest turn; `followsEnd` holds while a turn is active (`turnActive`), and on a settled transcript only until the reader's first scroll gesture (the first view), because after that a size change is the reader opening a fold or tool row, and re-pinning to the new end takes them away from what they clicked. During the first view the virtualizer keeps the end and rows are measured before paint (`measureUnmeasuredRows`), so the first page, the latest turn's full read and late measurements land without moving the latest turn and a row never paints at its estimate and then shifts.
 - The virtualizer's `rangeExtractor` is a getter, not a stable closure. virtual-core memoizes `getVirtualIndexes` on the extractor's identity plus overscan, count and range; Solid signals read while the extractor runs are invisible to that memo, so a stable closure serves stale indexes. Reading the signals in the getter, inside the adapter's tracked options read, subscribes the virtualizer and mints a new identity.
 - The item-key function is a memo of the row keys, so its identity changes only when the rows do; a fresh closure on every options read would make virtual-core recompute every row's measurement on every adapter run. Size estimates read part text untracked: an estimate is a guess until the row is measured, and a tracked read would re-run the adapter on every delta of an unmeasured streaming row.
diff --git a/packages/claxedo-app/src/session/view/timeline/message-timeline.tsx b/packages/claxedo-app/src/session/view/timeline/message-timeline.tsx
index 0ce46594..d62b24cf 100644
--- a/packages/claxedo-app/src/session/view/timeline/message-timeline.tsx
+++ b/packages/claxedo-app/src/session/view/timeline/message-timeline.tsx
@@ -507,7 +507,7 @@ export function MessageTimeline(props: MessageTimelineProps) {
   })
   onCleanup(prepend.clear)
   const initialRowCount = timelineRows().length
-  const [renderOverscan, setRenderOverscan] = createSignal(1)
+  const [renderOverscan, setRenderOverscan] = createSignal(0)
   const [initialRevealReady, setInitialRevealReady] = createSignal(warmMeasurements || initialRowCount === 0)
   const [progressiveReady, setProgressiveReady] = createSignal(warmMeasurements || initialRowCount === 0)
   const messageNavMountReady = createMemo<boolean>((mounted) => mounted || (props.active() && initialRevealReady() && messageNavGutterVisible()), false)
