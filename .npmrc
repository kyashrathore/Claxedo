# npm's min-release-age is in days (supported from npm 11.10; older npm ignores it).
min-release-age=2
# First-party packages are exempt: we trust our own publishes and launch-day
# releases must install immediately. npm's exclusion list is still pending
# upstream (npm/cli#8994); this key is forward-compat and ignored until it
# ships. Bun already honors the equivalent exclude in bunfig.toml.
min-release-age-exclude=@claxedo/*
