+import koffi from "koffi";
+
+// Node-API binding for Electron's Node runtime. Keep the upstream flock
+// protocol: the kernel owns exclusion, and closing the fd releases the lock.
+function lock(fd, wouldBlock) {
+  const library = koffi.load(null);
+  try {
+    const flock = library.func("int flock(int fd, int operation)");
+    const result = flock(fd, 2 | 4);
+    const code = result === 0 ? 0 : koffi.errno();
+    if (result === 0) return { acquired: true };
+    if (code === wouldBlock) return { acquired: false, held: true };
+    return { acquired: false, held: false, code };
+  } finally {
+    library.unload();
+  }
+}
+export function lockDarwin(fd) { return lock(fd, 35); }
+export function lockLinux(fd) { return lock(fd, 11); }
