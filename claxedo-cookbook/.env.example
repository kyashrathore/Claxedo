# The recipes detect available harness binaries on PATH and skip what is
# missing — nothing here is strictly required. Set credentials only for the
# harnesses you want the live recipes (01, 02, 04) to exercise.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CURSOR_API_KEY=

# When installing the cookbook from a standalone clone (outside the monorepo),
# point this at a checkout so postinstall can link the @claxedo/* packages.
CLAXEDO_PACKAGES_ROOT=
