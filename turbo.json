{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // ONE generic `test` task, on purpose. This file used to carry only
    // package-scoped `<pkg>#test` entries, and turbo runs NOTHING for a task
    // name it has no entry for, so `bun turbo test` silently skipped every
    // package that was not listed. 27 packages have a `test` script; only 5
    // were listed, so 22 with real suites -- claxedo-server alone has 236 test
    // files / 2386 tests -- produced zero CI signal.
    //
    // A generic entry is also the only shape that stays correct as packages are
    // added: a new package with a `test` script is gated the day it lands, with
    // no turbo.json edit to forget. Add a `<pkg>#test` override ONLY for a
    // package that genuinely needs different deps/outputs -- an override
    // REPLACES this entry for that package rather than merging with it.
    //
    // `outputs` is where every suite writes its JUnit report (see each
    // package's `test` script); .github/workflows/test.yml publishes them via
    // packages/*/.artifacts/unit/junit.xml.
    //
    // Deliberately NO `dependsOn: ["^build"]` here. `@claxedo/server` depends
    // on `@opencode-ai/sdk-next`, which depends on `opencode`, and
    // `opencode#build` is broken repo-wide: packages/opencode/script/build.ts
    // builds an embedded web UI from `packages/app`, a directory the Claxedo
    // hard fork renamed to `packages/claxedo-app`, so it dies with
    // `ENOENT: Could not change directory to .../packages/app`. A `^build` here
    // drags that dead task into the graph and every test task fails on a build
    // error instead of on tests. Packages that need workspace deps built get
    // them from the explicit scoped `bun turbo build --filter=...` step in
    // .github/workflows/test.yml -- the same list typecheck.yml and the e2e
    // jobs already use.
    "test": {
      "outputs": [".artifacts/unit/junit.xml"],
      "passThroughEnv": ["*"]
    },
    // The relay's Bun-adapter suite drives real sockets with tight in-flight
    // budgets; sharing 2 CI cores with any other heavyweight suite starves it
    // past its timeouts (reproduced on a 2-core sim box: it passes alone —
    // even with 120s budgets it hangs under contention). The dependsOn edges
    // push it after the three big suites so it effectively runs last and
    // alone, without touching global concurrency.
    // workspace-runtime hosts the socket-heavy relay-e2e/host-tunnel suites;
    // under 2-core contention with server/app they miss their windows the same
    // way (CI: 203-vs-200 = fetch raced tunnel registration). Chain it after
    // the two big suites; relay then runs after runtime, effectively alone.
    "@claxedo/workspace-runtime#test": {
      "dependsOn": ["@claxedo/server#test", "@claxedo/app#test"],
      "outputs": [".artifacts/unit/junit.xml", ".artifacts/unit/junit-relay.xml"],
      "passThroughEnv": ["*"]
    },
    "@claxedo/workspace-relay#test": {
      // Also after opencode#test: the relay bun adapter suite is pure
      // socket/timer choreography and a DIFFERENT test hangs at the ceiling
      // each run whenever it shares the 2-core runner with opencode's 13k-test
      // bun process — isolation, not timeouts, is the fix (same reasoning as
      // the runtime edge above).
      "dependsOn": ["@claxedo/workspace-runtime#test", "opencode#test"],
      "outputs": [".artifacts/unit/junit.xml", ".artifacts/unit/junit-bun-adapter.xml", ".artifacts/unit/junit-workerd.xml"],
      "passThroughEnv": ["*"]
    },
    // The five suites that were already wired before this file grew a generic
    // `test` task. They keep `^build` so their behaviour is unchanged; none of
    // them reaches `opencode#build` through its dependency graph.
    "opencode#test": {
      "dependsOn": ["^build"],
      "outputs": [".artifacts/unit/junit.xml"],
      "passThroughEnv": ["*"]
    },
    "@opencode-ai/core#test": {
      "dependsOn": ["^build"],
      "outputs": [".artifacts/unit/junit.xml"],
      "passThroughEnv": ["*"]
    },
    "@opencode-ai/ui#test": {
      "dependsOn": ["^build"],
      "outputs": [".artifacts/unit/junit.xml"],
      "passThroughEnv": ["*"]
    },
    "@opencode-ai/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": [".artifacts/unit/junit.xml"],
      "passThroughEnv": ["*"]
    },
    "@claxedo/app#test": {
      "dependsOn": ["^build"],
      "outputs": [".artifacts/unit/junit.xml"],
      "passThroughEnv": ["*"]
    }
  }
}
