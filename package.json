{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd packages/opencode --conditions=browser src/index.ts",
    "dev:desktop": "bun --cwd packages/claxedo-desktop dev",
    "dev:storybook": "bun --cwd packages/storybook storybook",
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck",
    "test:architecture-ratchets": "bun ./script/product-boundary/verify.ts --all --source-only",
    "prepush": "bun run typecheck && bun run test:architecture-ratchets",
    "upgrade-opentui": "bun run script/upgrade-opentui.ts",
    "postinstall": "bun script/apply-dependency-patches.ts && bun packages/core/script/fix-node-pty.ts",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "sso": "aws sso login --sso-session=opencode --no-browser",
    "test": "echo 'do not run tests from root' && exit 1",
    "web:dev:local": "bun ./script/web-dev-local.ts",
    "docs:check-links": "bun ./script/check-doc-links.ts",
    "examples:verify": "bun ./script/verify-examples.ts",
    "examples:smoke:hosted-team": "bun ./script/smoke-hosted-team-example.ts",
    "examples:smoke:local": "bun ./script/smoke-local-examples.ts",
    "examples:smoke:extension-client": "bun ./script/smoke-extension-client-example.ts",
    "examples:smoke:runtime-only-host": "bun ./script/smoke-runtime-only-host.ts",
    "agent-extensions:smoke-package": "bun ./script/smoke-agent-extensions-package.ts",
    "diagnostics:verify": "bun --cwd packages/claxedo-desktop run test:diagnostics-release && bun --cwd packages/claxedo-app run test:diagnostics-release && bun --cwd packages/claxedo-app/perf-harness test"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/sdk/js",
      "examples/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.0-beta.83",
      "@effect/platform-node": "4.0.0-beta.83",
      "@effect/sql-sqlite-bun": "4.0.0-beta.83",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.3.14",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.1",
      "@hono/standard-validator": "0.2.0",
      "@hono/zod-validator": "0.4.2",
      "@opentui/core": "0.3.4",
      "@opentui/keymap": "0.3.4",
      "@opentui/solid": "0.3.4",
      "@tanstack/solid-virtual": "3.13.37",
      "@shikijs/stream": "4.2.0",
      "ulid": "3.0.2",
      "@kobalte/core": "0.13.12",
      "@types/luxon": "3.7.2",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.5",
      "@tsconfig/bun": "1.0.10",
      "@cloudflare/workers-types": "5.20260724.1",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@pierre/diffs": "1.2.10",
      "opentui-spinner": "0.0.7",
      "@solid-primitives/storage": "4.4.0",
      "@tailwindcss/vite": "4.3.3",
      "diff": "8.0.3",
      "dompurify": "3.4.12",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.83",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "fuzzysort": "3.1.0",
      "luxon": "3.7.2",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "remend": "1.3.0",
      "@playwright/test": "1.62.0",
      "semver": "7.8.5",
      "typescript": "7.0.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.4.3",
      "remeda": "2.39.0",
      "sst": "4.17.1",
      "shiki": "4.2.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.3.3",
      "vite": "7.1.4",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "solid-js": "1.9.12",
      "vite-plugin-solid": "2.11.14",
      "@lydell/node-pty": "1.2.0-beta.14",
      "mermaid": "11.16.0"
    }
  },
  "devDependencies": {
    "@actions/artifact": "5.0.1",
    "@tsconfig/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "@typescript/native-preview": "catalog:",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.9.6",
    "semver": "^7.6.0",
    "sst": "catalog:",
    "turbo": "2.10.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@claxedo/server-core": "workspace:*",
    "@claxedo/workgraph": "workspace:*",
    "@convex-dev/migrations": "0.3.5",
    "@opencode-ai/plugin": "workspace:*",
    "@opencode-ai/script": "workspace:*",
    "@opencode-ai/sdk": "workspace:*",
    "@solid-primitives/event-listener": "2.4.6",
    "@solid-primitives/resize-observer": "2.2.0",
    "convex": "1.42.3",
    "dompurify": "3.4.12",
    "heap-snapshot-toolkit": "1.1.3",
    "svix": "1.99.1",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "@vscode/windows-process-tree",
    "better-sqlite3",
    "esbuild",
    "protobufjs",
    "web-tree-sitter",
    "electron"
  ],
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "shiki": "catalog:",
    "@shikijs/types": "4.2.0",
    "@shikijs/transformers": "4.2.0",
    "@solid-primitives/event-listener": "2.4.6",
    "@solid-primitives/resize-observer": "2.2.0",
    "dompurify": "3.4.12"
  },
  "claxedoDependencyPatches": {
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@ai-sdk/xai@3.0.82": "patches/@ai-sdk%2Fxai@3.0.82.patch",
    "@ai-sdk/google@3.0.73": "patches/@ai-sdk%2Fgoogle@3.0.73.patch",
    "@modelcontextprotocol/sdk@1.29.0": "patches/@modelcontextprotocol%2Fsdk@1.29.0.patch",
    "@pierre/diffs@1.2.10": "patches/@pierre%2Fdiffs@1.2.10.patch",
    "@tanstack/solid-query@5.99.2": "patches/@tanstack%2Fsolid-query@5.99.2.patch",
    "@tanstack/virtual-core@3.17.8": "patches/@tanstack%2Fvirtual-core@3.17.8.patch",
    "@kobalte/core@0.13.12": "patches/@kobalte%2Fcore@0.13.12.patch",
    "tokentracker-cli@0.91.0": "patches/tokentracker-cli@0.91.0.patch"
  }
}
